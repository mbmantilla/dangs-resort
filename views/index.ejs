<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Dang's Resort | Island Living Retreat</title>

    <link href="https://fonts.googleapis.com/css2?family=Bodoni+Moda:ital,wght@0,400;0,600;1,400&family=Outfit:wght@200;300;400;600;700;800&display=swap" rel="stylesheet">

    <style>
        :root {
            --dark: #101010;
            --muted: #6f6f6f;
            --light: #f7f3ed;
            --paper: #fffdf9;
            --gold: #c7a36a;
            --blue: #0ea5e9;
            --green: #16a34a;
            --shadow: 0 30px 80px rgba(0,0,0,0.08);
            --radius: 28px;
        }

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        html {
            scroll-behavior: smooth;
        }

        body {
            font-family: 'Outfit', sans-serif;
            background: var(--paper);
            color: var(--dark);
            overflow-x: hidden;
        }

        a {
            text-decoration: none;
            color: inherit;
        }

        img {
            width: 100%;
            display: block;
        }

        .nav-bar {
            position: sticky;
            top: 0;
            z-index: 1000;
            background: rgba(255, 253, 249, 0.86);
            backdrop-filter: blur(18px);
            border-bottom: 1px solid rgba(0,0,0,0.06);
        }

        .nav-inner {
            max-width: 1240px;
            margin: auto;
            padding: 24px 6%;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .logo {
            font-size: 1.4rem;
            font-weight: 800;
            letter-spacing: 4px;
        }

        .logo span {
            color: var(--gold);
        }

        .nav-links {
            display: flex;
            align-items: center;
            gap: 34px;
        }

        .nav-links a {
            font-size: 0.72rem;
            letter-spacing: 2px;
            text-transform: uppercase;
            font-weight: 800;
            color: #222;
            position: relative;
        }

        .nav-links a::after {
            content: "";
            position: absolute;
            width: 0;
            height: 1px;
            left: 0;
            bottom: -6px;
            background: var(--gold);
            transition: 0.3s ease;
        }

        .nav-links a:hover::after {
            width: 100%;
        }

        .nav-action {
            background: var(--dark);
            color: white !important;
            padding: 12px 18px;
            border-radius: 999px;
        }

        .nav-action::after {
            display: none;
        }

        .hero-container {
            max-width: 1240px;
            margin: auto;
            padding: 78px 6% 40px;
        }

        .hero-layout {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 70px;
            align-items: center;
        }

        .stamped-header {
            display: flex;
            align-items: center;
            gap: 16px;
            margin-bottom: 22px;
        }

        .stamped-header .line {
            width: 44px;
            height: 1px;
            background: var(--gold);
        }

        .stamped-header p {
            font-size: 0.72rem;
            letter-spacing: 3px;
            color: var(--gold);
            font-weight: 800;
        }

        .hero-text-side h1 {
            font-family: 'Bodoni Moda', serif;
            font-size: clamp(4rem, 8vw, 7.5rem);
            font-weight: 400;
            line-height: 0.95;
            letter-spacing: -3px;
        }

        .hero-text-side .italic {
            font-style: italic;
            color: var(--gold);
        }

        .hero-copy {
            max-width: 470px;
            margin: 28px 0 30px;
            color: var(--muted);
            font-size: 1.05rem;
            line-height: 1.8;
        }

        .hero-buttons {
            display: flex;
            align-items: center;
            gap: 18px;
            flex-wrap: wrap;
        }

        .cta-black,
        .cta-gold {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            padding: 16px 28px;
            border-radius: 999px;
            font-size: 0.76rem;
            text-transform: uppercase;
            letter-spacing: 2px;
            font-weight: 800;
            transition: 0.3s ease;
        }

        .cta-black {
            background: var(--dark);
            color: white;
        }

        .cta-black:hover {
            transform: translateY(-3px);
            box-shadow: 0 18px 40px rgba(0,0,0,0.18);
        }

        .cta-gold {
            background: #efe3d0;
            color: #8a6731;
            border: none;
            cursor: pointer;
        }

        .cta-gold:hover {
            background: var(--gold);
            color: white;
        }

        .hero-visual-side {
            position: relative;
        }

        .image-mask {
            height: 620px;
            border-radius: 50% 50% 34px 34px;
            overflow: hidden;
            box-shadow: var(--shadow);
            position: relative;
        }

        .image-mask img {
            height: 100%;
            object-fit: cover;
            transition: transform 1.2s ease;
        }

        .image-mask:hover img {
            transform: scale(1.06);
        }

        .floating-card {
            position: absolute;
            left: -42px;
            bottom: 46px;
            background: rgba(255,255,255,0.9);
            backdrop-filter: blur(16px);
            border: 1px solid rgba(255,255,255,0.8);
            border-radius: 22px;
            padding: 20px;
            box-shadow: var(--shadow);
            width: 220px;
        }

        .floating-card small {
            color: var(--muted);
            text-transform: uppercase;
            letter-spacing: 2px;
            font-size: 0.68rem;
            font-weight: 800;
        }

        .floating-card strong {
            display: block;
            font-size: 1.4rem;
            margin-top: 8px;
        }

        .ticker {
            max-width: 1240px;
            margin: 60px auto 0;
            padding: 0 6%;
        }

        .ticker-track {
            background: var(--dark);
            color: white;
            border-radius: 999px;
            padding: 16px 0;
            overflow: hidden;
            white-space: nowrap;
        }

        .ticker-content {
            display: inline-block;
            animation: ticker 22s linear infinite;
            font-size: 0.75rem;
            text-transform: uppercase;
            letter-spacing: 3px;
            font-weight: 700;
        }

        .ticker-content span {
            margin: 0 34px;
            color: #f4e2bf;
        }

        @keyframes ticker {
            from { transform: translateX(0); }
            to { transform: translateX(-50%); }
        }

        .feature-grid {
            max-width: 1240px;
            margin: 90px auto;
            padding: 0 6%;
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 22px;
        }

        .feature-box {
            background: white;
            border: 1px solid rgba(0,0,0,0.06);
            border-radius: var(--radius);
            padding: 34px;
            transition: 0.3s ease;
            min-height: 210px;
        }

        .feature-box:hover {
            transform: translateY(-8px);
            box-shadow: var(--shadow);
        }

        .num {
            color: var(--gold);
            font-size: 0.82rem;
            font-weight: 800;
            letter-spacing: 2px;
        }

        .feature-box h3 {
            margin: 22px 0 10px;
            font-size: 1.3rem;
        }

        .feature-box p {
            color: var(--muted);
            line-height: 1.7;
        }

        .residence-section {
            max-width: 1240px;
            margin: 110px auto;
            padding: 0 6%;
        }

        .section-head {
            display: flex;
            justify-content: space-between;
            align-items: flex-end;
            gap: 24px;
            margin-bottom: 34px;
        }

        .section-intro h2 {
            font-family: 'Bodoni Moda', serif;
            font-size: clamp(2.7rem, 5vw, 5rem);
            font-weight: 500;
            letter-spacing: -2px;
        }

        .section-intro p {
            color: var(--muted);
            margin-top: 10px;
            letter-spacing: 1px;
        }

        .room-tools {
            display: flex;
            gap: 12px;
            flex-wrap: wrap;
            justify-content: flex-end;
        }

        .room-tools input,
        .room-tools select {
            border: 1px solid rgba(0,0,0,0.1);
            background: white;
            padding: 14px 16px;
            border-radius: 999px;
            outline: none;
            font-family: inherit;
            min-width: 190px;
        }

        .residence-cards {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 28px;
        }

        .res-item {
            background: white;
            border-radius: var(--radius);
            overflow: hidden;
            border: 1px solid rgba(0,0,0,0.06);
            transition: 0.35s ease;
        }

        .res-item:hover {
            transform: translateY(-10px);
            box-shadow: var(--shadow);
        }

        .res-media {
            height: 390px;
            position: relative;
            overflow: hidden;
        }

        .res-media img {
            height: 100%;
            object-fit: cover;
            transition: transform 0.8s ease;
        }

        .res-item:hover .res-media img {
            transform: scale(1.08);
        }

        .res-hover {
            position: absolute;
            inset: 0;
            background: linear-gradient(to top, rgba(0,0,0,0.62), transparent);
            display: flex;
            align-items: flex-end;
            padding: 24px;
            opacity: 0;
            transition: 0.35s ease;
        }

        .res-item:hover .res-hover {
            opacity: 1;
        }

        .res-hover a {
            width: 100%;
            border: none;
            background: white;
            color: var(--dark);
            border-radius: 999px;
            padding: 15px 18px;
            font-weight: 800;
            text-transform: uppercase;
            letter-spacing: 1.5px;
            text-align: center;
            font-size: 0.74rem;
            transition: 0.25s ease;
        }

        .res-hover a:hover {
            background: var(--gold);
            color: white;
        }

        .res-details {
            padding: 24px;
        }

        .res-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 14px;
        }

        .category {
            color: var(--gold);
            font-size: 0.68rem;
            text-transform: uppercase;
            letter-spacing: 2px;
            font-weight: 900;
        }

        .price {
            font-weight: 800;
            color: var(--dark);
        }

        .res-details h3 {
            font-size: 1.25rem;
        }

        .empty-rooms {
            grid-column: 1 / -1;
            background: #fff;
            border: 1px dashed #d6d6d6;
            border-radius: var(--radius);
            padding: 70px 30px;
            text-align: center;
            color: var(--muted);
        }

        .story-section {
            max-width: 1240px;
            margin: 120px auto;
            padding: 0 6%;
            display: grid;
            grid-template-columns: 0.9fr 1.1fr;
            gap: 60px;
            align-items: center;
        }

        .story-image {
            height: 560px;
            border-radius: var(--radius);
            overflow: hidden;
            box-shadow: var(--shadow);
        }

        .story-image img {
            height: 100%;
            object-fit: cover;
        }

        .story-content h2 {
            font-family: 'Bodoni Moda', serif;
            font-size: clamp(2.5rem, 5vw, 5rem);
            line-height: 1;
            margin-bottom: 24px;
        }

        .story-content p {
            color: var(--muted);
            line-height: 1.9;
            font-size: 1.05rem;
            margin-bottom: 18px;
        }

        .mini-stats {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 18px;
            margin-top: 34px;
        }

        .mini-stat {
            background: #fff;
            border: 1px solid rgba(0,0,0,0.06);
            border-radius: 20px;
            padding: 22px;
        }

        .mini-stat strong {
            display: block;
            font-size: 1.8rem;
        }

        .mini-stat span {
            color: var(--muted);
            font-size: 0.8rem;
        }

        .modal-backdrop {
            position: fixed;
            inset: 0;
            background: rgba(0,0,0,0.65);
            backdrop-filter: blur(10px);
            z-index: 3000;
            display: none;
            align-items: center;
            justify-content: center;
            padding: 20px;
        }

        .modal-backdrop.active {
            display: flex;
        }

        .film-modal {
            background: white;
            border-radius: 28px;
            max-width: 780px;
            width: 100%;
            overflow: hidden;
            box-shadow: 0 40px 100px rgba(0,0,0,0.25);
        }

        .film-preview {
            height: 390px;
            background:
                linear-gradient(rgba(0,0,0,0.18), rgba(0,0,0,0.45)),
                url('https://images.unsplash.com/photo-1507525428034-b723cf961d3e?auto=format&fit=crop&w=1200&q=80');
            background-size: cover;
            background-position: center;
            display: flex;
            align-items: center;
            justify-content: center;
            color: white;
            font-size: 4rem;
        }

        .film-info {
            padding: 32px;
        }

        .film-info h3 {
            font-size: 1.8rem;
            margin-bottom: 10px;
        }

        .film-info p {
            color: var(--muted);
            line-height: 1.7;
            margin-bottom: 24px;
        }

        .close-modal {
            border: none;
            background: var(--dark);
            color: white;
            border-radius: 999px;
            padding: 13px 22px;
            cursor: pointer;
            font-weight: 800;
        }

        .footer {
            margin-top: 120px;
            padding: 40px 6%;
            border-top: 1px solid rgba(0,0,0,0.08);
            color: var(--muted);
            display: flex;
            justify-content: space-between;
            gap: 20px;
            flex-wrap: wrap;
        }

        .reveal {
            opacity: 0;
            transform: translateY(28px);
            transition: 0.8s ease;
        }

        .reveal.visible {
            opacity: 1;
            transform: translateY(0);
        }

        @media (max-width: 980px) {
            .hero-layout,
            .story-section,
            .feature-grid,
            .residence-cards {
                grid-template-columns: 1fr;
            }

            .image-mask {
                height: 500px;
            }

            .floating-card {
                left: 20px;
            }

            .section-head {
                flex-direction: column;
                align-items: flex-start;
            }

            .room-tools {
                width: 100%;
                justify-content: flex-start;
            }

            .room-tools input,
            .room-tools select {
                width: 100%;
            }
        }

        @media (max-width: 640px) {
            .nav-inner {
                flex-direction: column;
                gap: 18px;
            }

            .nav-links {
                gap: 16px;
                flex-wrap: wrap;
                justify-content: center;
            }

            .hero-container {
                padding-top: 44px;
            }

            .hero-text-side h1 {
                font-size: 3.5rem;
            }

            .image-mask {
                height: 380px;
            }

            .feature-box,
            .admin-card {
                padding: 24px;
            }

            .res-media {
                height: 330px;
            }

            .mini-stats {
                grid-template-columns: 1fr;
            }
        }
    </style>
</head>
<body>

    <nav class="nav-bar">
        <div class="nav-inner">
            <a href="/" class="logo">DANG'S<span>.</span></a>

            <div class="nav-links">
                <a href="#experience">Experience</a>
                <a href="#residences">Residences</a>
                <a href="#story">Story</a>

                <% if (user) { %>
                    <a href="/dashboard" class="nav-action">My Account</a>
                <% } else { %>
                    <a href="/login" class="nav-action">Sign In</a>
                <% } %>
            </div>
        </div>
    </nav>

    <header class="hero-container">
        <div class="hero-layout">
            <div class="hero-text-side reveal">
                <div class="stamped-header">
                    <span class="line"></span>
                    <p>ESTABLISHED 2026</p>
                </div>

                <h1>The Art of <br><span class="italic">Island</span> Living</h1>

                <p class="hero-copy">
                    Escape into a coastal sanctuary made for slow mornings, warm sunsets,
                    and restful stays in the heart of Abuyog.
                </p>

                <div class="hero-buttons">
                    <a href="#residences" class="cta-black">Reserve a Room</a>
                    <button type="button" class="cta-gold" onclick="openFilm()">Watch Film</button>
                </div>
            </div>

            <div class="hero-visual-side reveal">
                <div class="image-mask">
                    <img src="https://images.unsplash.com/photo-1520250497591-112f2f40a3f4?auto=format&fit=crop&w=1200&q=80" alt="Dang's Resort island pool">
                </div>

                <div class="floating-card">
                    <small>Guest Favorite</small>
                    <strong>Ocean View Suite</strong>
                    <p style="color:#777; margin-top:6px; line-height:1.5;">Private comfort with coastal scenery.</p>
                </div>
            </div>
        </div>
    </header>

    <section class="ticker">
        <div class="ticker-track">
            <div class="ticker-content">
                <span>Coastal Retreat</span>
                <span>Private Rooms</span>
                <span>Island Living</span>
                <span>Secure Booking</span>
                <span>Local Hospitality</span>
                <span>Coastal Retreat</span>
                <span>Private Rooms</span>
                <span>Island Living</span>
                <span>Secure Booking</span>
                <span>Local Hospitality</span>
            </div>
        </div>
    </section>

    <section id="experience" class="feature-grid">
        <div class="feature-box reveal">
            <span class="num">01</span>
            <div class="content">
                <h3>Instant Access</h3>
                <p>View available rooms and reserve your preferred stay in just a few clicks.</p>
            </div>
        </div>

        <div class="feature-box reveal">
            <span class="num">02</span>
            <div class="content">
                <h3>Curated Comfort</h3>
                <p>Each residence is designed for calm, privacy, and refreshing resort comfort.</p>
            </div>
        </div>

        <div class="feature-box reveal">
            <span class="num">03</span>
            <div class="content">
                <h3>Coastal Safety</h3>
                <p>Organized guest records, booking status, and secure reservation processing.</p>
            </div>
        </div>
    </section>

    <section id="residences" class="residence-section">
        <div class="section-head reveal">
            <div class="section-intro">
                <h2>The Residences</h2>
                <p>Select your perfect vantage point.</p>
            </div>

            <div class="room-tools">
                <input type="text" id="roomSearch" placeholder="Search room name..." onkeyup="filterRooms()">

                <select id="roomType" onchange="filterRooms()">
                    <option value="all">All Types</option>
                    <% 
                        const types = [];
                        rooms.forEach(room => {
                            if (room.type && !types.includes(room.type)) types.push(room.type);
                        });
                    %>
                    <% types.forEach(type => { %>
                        <option value="<%= type.toLowerCase() %>"><%= type %></option>
                    <% }) %>
                </select>
            </div>
        </div>

        <div class="residence-cards" id="roomGrid">
            <% if (rooms && rooms.length > 0) { %>
                <% rooms.forEach(room => { %>
                    <div class="res-item reveal"
                         data-name="<%= (room.name || '').toLowerCase() %>"
                         data-type="<%= (room.type || '').toLowerCase() %>">

                        <div class="res-media">
                            <img src="<%= room.image_url || 'https://images.unsplash.com/photo-1566073771259-6a8506099945?auto=format&fit=crop&w=900&q=80' %>"
                                 alt="<%= room.name %>">

                            <div class="res-hover">
                                <% if (user) { %>
                                    <a href="/book/<%= room.id %>">Check Availability</a>
                                <% } else { %>
                                    <a href="/login">Sign In to Reserve</a>
                                <% } %>
                            </div>
                        </div>

                        <div class="res-details">
                            <div class="res-header">
                                <span class="category"><%= room.type || 'Residence' %></span>
                                <span class="price">₱<%= Number(room.price || 0).toLocaleString() %></span>
                            </div>

                            <h3><%= room.name %></h3>
                        </div>
                    </div>
                <% }) %>
            <% } else { %>
                <div class="empty-rooms">
                    <h3>No residences available yet.</h3>
                    <p>Please check again later.</p>
                </div>
            <% } %>
        </div>
    </section>

    <section id="story" class="story-section">
        <div class="story-image reveal">
            <img src="https://images.unsplash.com/photo-1507525428034-b723cf961d3e?auto=format&fit=crop&w=1200&q=80" alt="Coastal beach">
        </div>

        <div class="story-content reveal">
            <h2>Designed for rest, built for memories.</h2>

            <p>
                Dang's Resort brings together simple coastal elegance and practical booking convenience.
                Guests can explore available rooms, reserve their stay, and enjoy a smoother resort experience.
            </p>

            <p>
                Whether it is a family stay, a quiet weekend, or a beachfront escape, each residence is made to feel personal,
                private, and memorable.
            </p>

            <div class="mini-stats">
                <div class="mini-stat">
                    <strong><%= rooms ? rooms.length : 0 %>+</strong>
                    <span>Residences</span>
                </div>

                <div class="mini-stat">
                    <strong>24/7</strong>
                    <span>Online Access</span>
                </div>

                <div class="mini-stat">
                    <strong>2026</strong>
                    <span>Established</span>
                </div>
            </div>
        </div>
    </section>

    <div id="filmModal" class="modal-backdrop" onclick="closeFilm(event)">
        <div class="film-modal">
            <div class="film-preview">▶</div>

            <div class="film-info">
                <h3>A glimpse of island living.</h3>
                <p>
                    Imagine calm waves, warm sunlight, fresh air, and a private space made for slowing down.
                    This is the Dang's Resort experience.
                </p>

                <button type="button" class="close-modal" onclick="closeFilm()">Close Preview</button>
            </div>
        </div>
    </div>

    <footer class="footer">
        <p>&copy; 2026 Dang's Resort Retreats. All rights reserved.</p>
        <p>Abuyog Coastal Sanctuary</p>
    </footer>

    <script>
        function filterRooms() {
            const search = document.getElementById('roomSearch').value.toLowerCase().trim();
            const type = document.getElementById('roomType').value;
            const cards = document.querySelectorAll('.res-item');

            cards.forEach(card => {
                const roomName = card.dataset.name || '';
                const roomType = card.dataset.type || '';

                const matchesSearch = roomName.includes(search);
                const matchesType = type === 'all' || roomType === type;

                card.style.display = matchesSearch && matchesType ? '' : 'none';
            });
        }

        function openFilm() {
            document.getElementById('filmModal').classList.add('active');
        }

        function closeFilm(event) {
            if (!event || event.target.id === 'filmModal' || event.target.classList.contains('close-modal')) {
                document.getElementById('filmModal').classList.remove('active');
            }
        }

        const revealElements = document.querySelectorAll('.reveal');

        const revealObserver = new IntersectionObserver((entries) => {
            entries.forEach(entry => {
                if (entry.isIntersecting) {
                    entry.target.classList.add('visible');
                }
            });
        }, { threshold: 0.15 });

        revealElements.forEach(el => revealObserver.observe(el));
    </script>

</body>
