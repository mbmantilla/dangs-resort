<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<meta name="theme-color" content="#050509">
<title>Dang's Resort | Luxury Island Retreat</title>

<link href="https://fonts.googleapis.com/css2?family=Bodoni+Moda:ital,wght@0,400;0,500;0,600;1,400&family=Outfit:wght@200;300;400;500;600;700;800;900&display=swap" rel="stylesheet">
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">

<style>
:root {
    --bg: #050509;
    --bg-2: #090912;
    --card: rgba(255,255,255,0.075);
    --card-2: rgba(255,255,255,0.115);
    --border: rgba(255,255,255,0.13);
    --border-gold: rgba(215,176,102,0.35);
    --text: #4d3400;
    --muted: #a7a7b5;
    --muted-2: #737688;
    --gold: #d7b066;
    --gold-soft: #f4dca2;
    --gold-dark: #8f642c;
    --teal: #14b8a6;
    --blue: #0ea5e9;
    --green: #10b981;
    --rose: #f43f5e;
    --shadow: 0 30px 90px rgba(0,0,0,0.42);
    --shadow-soft: 0 16px 50px rgba(0,0,0,0.28);
    --radius: 34px;
    --radius-lg: 54px;
    --ease: cubic-bezier(.22,1,.36,1);
    --font-main: 'Outfit', system-ui, sans-serif;
    --font-display: 'Bodoni Moda', Georgia, serif;
}

* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

html {
    scroll-behavior: smooth;
}

body {
    min-height: 100vh;
    font-family: var(--font-main);
    color: var(--text);
    background:
        radial-gradient(circle at 10% 8%, rgba(215,176,102,.18), transparent 28%),
        radial-gradient(circle at 90% 3%, rgba(14,165,233,.16), transparent 30%),
        radial-gradient(circle at 50% 100%, rgba(20,184,166,.12), transparent 35%),
        linear-gradient(135deg, #030305 0%, #090912 45%, #11111a 100%);
    overflow-x: hidden;
}

body.menu-open,
body.modal-open {
    overflow: hidden;
}

a {
    color: inherit;
    text-decoration: none;
}

button,
input,
select {
    font: inherit;
}

img {
    width: 100%;
    display: block;
}

.site {
    position: relative;
    min-height: 100vh;
    isolation: isolate;
    overflow: hidden;
}

.ambient {
    position: fixed;
    inset: 0;
    z-index: -10;
    pointer-events: none;
    overflow: hidden;
}

.ambient::before {
    content: "";
    position: absolute;
    inset: 0;
    background-image:
        linear-gradient(rgba(255,255,255,.035) 1px, transparent 1px),
        linear-gradient(90deg, rgba(255,255,255,.035) 1px, transparent 1px);
    background-size: 48px 48px;
    mask-image: linear-gradient(to bottom, black 0%, transparent 84%);
}

.orb {
    position: absolute;
    border-radius: 999px;
    filter: blur(34px);
    animation: orbFloat 18s var(--ease) infinite alternate;
}

.orb.gold {
    width: 460px;
    height: 460px;
    left: -170px;
    top: -130px;
    background: rgba(215,176,102,.24);
}

.orb.blue {
    width: 520px;
    height: 520px;
    right: -220px;
    top: 16%;
    background: rgba(14,165,233,.17);
    animation-delay: -6s;
}

.orb.teal {
    width: 500px;
    height: 500px;
    left: 34%;
    bottom: -290px;
    background: rgba(20,184,166,.12);
    animation-delay: -10s;
}

.grain {
    position: fixed;
    inset: 0;
    z-index: -8;
    opacity: .065;
    pointer-events: none;
    background-image:
        radial-gradient(circle at 25% 25%, #fff 1px, transparent 1px),
        radial-gradient(circle at 75% 75%, #fff 1px, transparent 1px);
    background-size: 26px 26px;
}

.top-glow {
    position: fixed;
    left: 0;
    right: 0;
    top: 0;
    z-index: 2000;
    height: 1px;
    background: linear-gradient(90deg, transparent, var(--gold-soft), var(--blue), transparent);
    opacity: .85;
    pointer-events: none;
}

@keyframes orbFloat {
    from {
        transform: translate3d(0,0,0) scale(1);
    }
    50% {
        transform: translate3d(48px,36px,0) scale(1.08);
    }
    to {
        transform: translate3d(-32px,60px,0) scale(.96);
    }
}

.container {
    width: min(1280px, calc(100% - 32px));
    margin: 0 auto;
}

.nav-bar {
    position: sticky;
    top: 0;
    z-index: 1000;
    background: rgba(5,5,9,.76);
    border-bottom: 1px solid var(--border);
    backdrop-filter: blur(24px);
    box-shadow: 0 12px 38px rgba(0,0,0,.2);
}

.nav-inner {
    min-height: 84px;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 24px;
}

.logo {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    font-size: 1rem;
    font-weight: 900;
    letter-spacing: .28em;
    text-transform: uppercase;
    color: #fff;
    z-index: 5;
}

.logo-mark {
    width: 42px;
    height: 42px;
    border-radius: 17px;
    display: grid;
    place-items: center;
    color: #050509;
    background: linear-gradient(135deg, var(--gold-soft), var(--gold));
    box-shadow: 0 18px 42px rgba(215,176,102,.18);
}

.logo span {
    color: var(--gold);
}

.nav-links {
    display: flex;
    align-items: center;
    gap: 32px;
}

.nav-links a {
    position: relative;
    color: rgba(255,247,232,.78);
    font-size: .7rem;
    font-weight: 900;
    letter-spacing: .18em;
    text-transform: uppercase;
    transition: .25s var(--ease);
}

.nav-links a::after {
    content: "";
    position: absolute;
    left: 0;
    bottom: -8px;
    width: 0;
    height: 1px;
    background: linear-gradient(90deg, var(--gold), transparent);
    transition: width .28s var(--ease);
}

.nav-links a:hover {
    color: white;
    transform: translateY(-1px);
}

.nav-links a:hover::after {
    width: 100%;
}

.nav-action {
    min-height: 44px;
    padding: 0 18px;
    border-radius: 999px;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    color: #050509 !important;
    background: linear-gradient(135deg, var(--gold-soft), var(--gold));
    box-shadow: 0 18px 42px rgba(215,176,102,.18);
}

.nav-action::after {
    display: none;
}

.nav-toggle {
    display: none;
    width: 48px;
    height: 48px;
    border: 1px solid var(--border);
    border-radius: 18px;
    color: #fff;
    background: var(--card);
    cursor: pointer;
    z-index: 5;
}

.hero {
    padding: clamp(44px, 7vw, 100px) 0 42px;
}

.hero-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.08fr) minmax(360px, .92fr);
    gap: clamp(38px, 6vw, 82px);
    align-items: center;
}

.eyebrow {
    min-height: 38px;
    padding: 0 15px;
    border-radius: 999px;
    display: inline-flex;
    align-items: center;
    gap: 11px;
    color: var(--gold-soft);
    background: rgba(255,255,255,.07);
    border: 1px solid var(--border);
    backdrop-filter: blur(18px);
    font-size: .68rem;
    font-weight: 900;
    letter-spacing: .2em;
    text-transform: uppercase;
    margin-bottom: 24px;
}

.hero h1 {
    margin: 0;
    font-family: var(--font-display);
    font-size: clamp(4rem, 8.2vw, 8.4rem);
    line-height: .88;
    font-weight: 400;
    letter-spacing: -.07em;
    color: white;
}

.hero h1 em {
    color: var(--gold-soft);
    font-style: italic;
    text-shadow: 0 18px 50px rgba(215,176,102,.2);
}

.hero-copy {
    max-width: 570px;
    margin: 30px 0 32px;
    color: var(--muted);
    font-size: clamp(1rem, 1.6vw, 1.15rem);
    line-height: 1.88;
}

.hero-actions {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 16px;
}

.btn {
    min-height: 58px;
    padding: 0 24px;
    border: 0;
    border-radius: 999px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    cursor: pointer;
    font-size: .74rem;
    font-weight: 900;
    letter-spacing: .16em;
    text-transform: uppercase;
    transition: .28s var(--ease);
}

.btn-gold {
    color: #050509;
    background: linear-gradient(135deg, var(--gold-soft), var(--gold));
    box-shadow: 0 24px 58px rgba(215,176,102,.18);
}

.btn-glass {
    color: #fff;
    background: var(--card);
    border: 1px solid var(--border);
    backdrop-filter: blur(18px);
}

.btn-outline {
    color: rgba(255,247,232,.86);
    background: transparent;
    border: 1px solid rgba(215,176,102,.35);
}

.btn:hover {
    transform: translateY(-4px);
    box-shadow: var(--shadow);
}

.hero-trust {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 14px;
    margin-top: 34px;
}

.trust-pill {
    min-height: 42px;
    padding: 0 14px;
    border-radius: 999px;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    color: rgba(255,247,232,.78);
    background: rgba(255,255,255,.06);
    border: 1px solid var(--border);
    font-size: .74rem;
    font-weight: 800;
}

.trust-pill i {
    color: var(--gold);
}

.hero-visual {
    position: relative;
}

.hero-image {
    position: relative;
    height: clamp(500px, 52vw, 690px);
    overflow: hidden;
    border-radius: 52% 52% 38px 38px;
    border: 1px solid rgba(215,176,102,.28);
    box-shadow: var(--shadow);
    isolation: isolate;
}

.hero-image::before {
    content: "";
    position: absolute;
    inset: 0;
    z-index: 2;
    background:
        linear-gradient(to bottom, rgba(0,0,0,.04), rgba(0,0,0,.38)),
        radial-gradient(circle at 50% 0%, rgba(215,176,102,.26), transparent 42%);
}

.hero-image::after {
    content: "";
    position: absolute;
    inset: 24px;
    z-index: 3;
    border-radius: 50% 50% 28px 28px;
    border: 1px solid rgba(255,255,255,.22);
}

.hero-image img {
    height: 100%;
    object-fit: cover;
    transform: scale(1.02);
    transition: transform 1.2s var(--ease);
}

.hero-image:hover img {
    transform: scale(1.08);
}

.float-card,
.availability-card {
    position: absolute;
    z-index: 5;
    padding: 20px;
    border-radius: 26px;
    color: white;
    background: rgba(7,7,10,.72);
    border: 1px solid var(--border);
    backdrop-filter: blur(22px);
    box-shadow: var(--shadow);
    animation: floatSoft 4.4s ease-in-out infinite;
}

.float-card {
    left: -42px;
    bottom: 46px;
    width: 250px;
}

.availability-card {
    right: -24px;
    top: 64px;
    width: 190px;
    animation-delay: -1.6s;
}

.float-icon {
    width: 42px;
    height: 42px;
    border-radius: 16px;
    display: grid;
    place-items: center;
    color: #050509;
    background: linear-gradient(135deg, var(--gold-soft), var(--gold));
    margin-bottom: 14px;
}

.float-card small,
.availability-card span {
    display: block;
    color: var(--gold-soft);
    text-transform: uppercase;
    letter-spacing: .18em;
    font-size: .64rem;
    font-weight: 900;
}

.float-card strong,
.availability-card strong {
    display: block;
    margin-top: 7px;
    font-size: 1.2rem;
    line-height: 1.2;
}

.float-card p {
    margin-top: 7px;
    color: rgba(255,247,232,.68);
    line-height: 1.55;
    font-size: .86rem;
}

@keyframes floatSoft {
    0%, 100% {
        transform: translateY(0);
    }
    50% {
        transform: translateY(-10px);
    }
}

.ticker {
    margin: 58px auto 0;
}

.ticker-track {
    position: relative;
    border-radius: 999px;
    overflow: hidden;
    color: var(--text);
    background: linear-gradient(90deg, rgba(215,176,102,.18), rgba(255,255,255,.06), rgba(14,165,233,.10));
    border: 1px solid var(--border);
    box-shadow: var(--shadow-soft);
    backdrop-filter: blur(18px);
    white-space: nowrap;
}

.ticker-content {
    display: inline-flex;
    align-items: center;
    animation: ticker 24s linear infinite;
}

.ticker-content span {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    padding: 18px 34px;
    color: rgba(255,247,232,.78);
    font-size: .72rem;
    font-weight: 900;
    letter-spacing: .22em;
    text-transform: uppercase;
}

.ticker-content i {
    color: var(--gold);
}

@keyframes ticker {
    from {
        transform: translateX(0);
    }
    to {
        transform: translateX(-50%);
    }
}

.features {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 22px;
    margin: 90px auto;
}

.feature-card {
    position: relative;
    min-height: 240px;
    padding: 32px;
    border-radius: var(--radius);
    background: rgba(255,255,255,.06);
    border: 1px solid var(--border);
    box-shadow: var(--shadow-soft);
    backdrop-filter: blur(18px);
    overflow: hidden;
    transition: .32s var(--ease);
}

.feature-card::before {
    content: "";
    position: absolute;
    inset: 0;
    background:
        radial-gradient(circle at 0% 0%, rgba(215,176,102,.12), transparent 35%),
        radial-gradient(circle at 100% 100%, rgba(14,165,233,.09), transparent 35%);
}

.feature-card:hover {
    transform: translateY(-10px);
    border-color: var(--border-gold);
    box-shadow: var(--shadow);
}

.feature-top {
    position: relative;
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 14px;
    margin-bottom: 30px;
}

.feature-num {
    color: var(--gold-soft);
    font-size: .72rem;
    font-weight: 900;
    letter-spacing: .18em;
    text-transform: uppercase;
}

.feature-icon {
    width: 52px;
    height: 52px;
    border-radius: 20px;
    display: grid;
    place-items: center;
    color: #050509;
    background: linear-gradient(135deg, var(--gold-soft), var(--gold));
}

.feature-card h3,
.feature-card p {
    position: relative;
}

.feature-card h3 {
    color: #fff;
    font-size: 1.32rem;
    font-weight: 800;
    margin-bottom: 12px;
}

.feature-card p {
    color: var(--muted);
    line-height: 1.74;
    font-size: .96rem;
}

.section-head {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    gap: 28px;
    margin-bottom: 36px;
}

.kicker {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    min-height: 36px;
    padding: 0 13px;
    border-radius: 999px;
    color: var(--gold-soft);
    background: rgba(215,176,102,.10);
    border: 1px solid rgba(215,176,102,.20);
    font-size: .66rem;
    font-weight: 900;
    letter-spacing: .18em;
    text-transform: uppercase;
    margin-bottom: 14px;
}

.section-title {
    margin: 0;
    font-family: var(--font-display);
    color: white;
    font-size: clamp(2.8rem, 5.8vw, 5.6rem);
    font-weight: 400;
    line-height: .95;
    letter-spacing: -.055em;
}

.section-copy {
    color: var(--muted);
    margin-top: 14px;
    line-height: 1.7;
    font-size: 1.02rem;
}

.room-tools {
    display: flex;
    align-items: center;
    gap: 12px;
    flex-wrap: wrap;
    justify-content: flex-end;
}

.tool {
    position: relative;
}

.tool i {
    position: absolute;
    top: 50%;
    left: 16px;
    transform: translateY(-50%);
    color: var(--gold);
    pointer-events: none;
}

.tool input,
.tool select {
    min-width: 210px;
    min-height: 52px;
    padding: 0 18px 0 46px;
    border-radius: 999px;
    outline: none;
    color: var(--text);
    background: rgba(255,255,255,.075);
    border: 1px solid var(--border);
    backdrop-filter: blur(16px);
    font-weight: 700;
}

.tool select {
    appearance: none;
    cursor: pointer;
    padding-right: 44px;
}

.select-tool::after {
    content: "\f078";
    position: absolute;
    right: 18px;
    top: 50%;
    transform: translateY(-50%);
    color: var(--gold);
    font-family: "Font Awesome 6 Free";
    font-weight: 900;
    font-size: .72rem;
    pointer-events: none;
}

.tool input::placeholder {
    color: rgba(255,247,232,.52);
}

.tool input:focus,
.tool select:focus {
    border-color: rgba(215,176,102,.48);
    box-shadow: 0 0 0 4px rgba(215,176,102,.10);
}

.residences {
    margin: 118px auto;
}

.room-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 28px;
}

.room-card {
    position: relative;
    border-radius: var(--radius);
    overflow: hidden;
    background: rgba(255,255,255,.064);
    border: 1px solid var(--border);
    box-shadow: var(--shadow-soft);
    backdrop-filter: blur(18px);
    transition: .35s var(--ease);
}

.room-card:hover {
    transform: translateY(-12px);
    border-color: var(--border-gold);
    box-shadow: var(--shadow);
}

.room-media {
    position: relative;
    height: 410px;
    overflow: hidden;
    background: linear-gradient(135deg, rgba(215,176,102,.16), rgba(14,165,233,.10));
}

.room-media::after {
    content: "";
    position: absolute;
    inset: 0;
    background:
        linear-gradient(to top, rgba(0,0,0,.58), transparent 60%),
        radial-gradient(circle at 50% 0%, rgba(215,176,102,.16), transparent 40%);
}

.room-media img {
    height: 100%;
    object-fit: cover;
    transform: scale(1.02);
    transition: transform .9s var(--ease);
}

.room-card:hover .room-media img {
    transform: scale(1.10);
}

.room-badge {
    position: absolute;
    top: 18px;
    left: 18px;
    z-index: 2;
    min-height: 38px;
    padding: 0 12px;
    border-radius: 999px;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    color: #050509;
    background: linear-gradient(135deg, var(--gold-soft), var(--gold));
    font-size: .64rem;
    font-weight: 900;
    letter-spacing: .13em;
    text-transform: uppercase;
}

.room-hover {
    position: absolute;
    inset: 0;
    z-index: 4;
    padding: 24px;
    display: flex;
    align-items: flex-end;
    background: linear-gradient(to top, rgba(3,3,5,.82), rgba(3,3,5,.10));
    opacity: 0;
    transition: opacity .35s var(--ease);
}

.room-card:hover .room-hover {
    opacity: 1;
}

.room-hover a {
    width: 100%;
    min-height: 54px;
    padding: 0 18px;
    border-radius: 999px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    color: #050509;
    background: linear-gradient(135deg, var(--gold-soft), var(--gold));
    font-size: .72rem;
    font-weight: 900;
    letter-spacing: .14em;
    text-align: center;
    text-transform: uppercase;
}

.room-details {
    padding: 24px;
}

.room-head {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 14px;
    margin-bottom: 14px;
}

.category {
    color: var(--gold-soft);
    font-size: .66rem;
    font-weight: 900;
    letter-spacing: .16em;
    text-transform: uppercase;
}

.price {
    min-height: 36px;
    padding: 0 12px;
    border-radius: 999px;
    display: inline-flex;
    align-items: center;
    color: var(--gold-soft);
    background: rgba(215,176,102,.10);
    border: 1px solid rgba(215,176,102,.18);
    font-size: .88rem;
    font-weight: 900;
    white-space: nowrap;
}

.room-details h3 {
    color: white;
    font-size: 1.28rem;
    font-weight: 800;
    line-height: 1.25;
}

.room-meta {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 9px;
    margin-top: 18px;
}

.room-meta span {
    min-height: 34px;
    padding: 0 10px;
    border-radius: 999px;
    display: inline-flex;
    align-items: center;
    gap: 7px;
    color: rgba(255,247,232,.70);
    background: rgba(255,255,255,.07);
    border: 1px solid var(--border);
    font-size: .72rem;
    font-weight: 800;
}

.room-meta i {
    color: var(--gold);
}

.empty-rooms {
    grid-column: 1 / -1;
    padding: 70px 30px;
    border-radius: var(--radius);
    text-align: center;
    color: var(--muted);
    background: rgba(255,255,255,.06);
    border: 1px dashed rgba(215,176,102,.30);
}

.empty-icon {
    width: 78px;
    height: 78px;
    margin: 0 auto 18px;
    border-radius: 28px;
    display: grid;
    place-items: center;
    color: #050509;
    background: linear-gradient(135deg, var(--gold-soft), var(--gold));
    font-size: 1.8rem;
}

.empty-rooms h3 {
    color: white;
    font-size: 1.7rem;
    margin-bottom: 8px;
}

.story {
    display: grid;
    grid-template-columns: minmax(340px, .92fr) minmax(0, 1.08fr);
    gap: clamp(38px, 6vw, 72px);
    align-items: center;
    margin: 122px auto;
}

.story-image {
    position: relative;
    height: 590px;
    border-radius: var(--radius-lg);
    overflow: hidden;
    border: 1px solid var(--border);
    box-shadow: var(--shadow);
}

.story-image::after {
    content: "";
    position: absolute;
    inset: 0;
    background:
        linear-gradient(to top, rgba(3,3,5,.45), transparent),
        radial-gradient(circle at 30% 0%, rgba(215,176,102,.20), transparent 40%);
}

.story-image img {
    height: 100%;
    object-fit: cover;
    transform: scale(1.02);
    transition: transform 1s var(--ease);
}

.story-image:hover img {
    transform: scale(1.08);
}

.story h2,
.signature h2 {
    margin: 0 0 24px;
    font-family: var(--font-display);
    color: white;
    font-size: clamp(2.6rem, 5.2vw, 5.2rem);
    font-weight: 400;
    line-height: .98;
    letter-spacing: -.055em;
}

.story p,
.signature p {
    color: var(--muted);
    line-height: 1.9;
    font-size: 1.04rem;
    margin-bottom: 18px;
}

.mini-stats {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 16px;
    margin-top: 34px;
}

.mini-stat {
    min-height: 124px;
    padding: 22px;
    border-radius: 24px;
    background: rgba(255,255,255,.06);
    border: 1px solid var(--border);
    backdrop-filter: blur(16px);
    transition: .28s var(--ease);
}

.mini-stat:hover {
    transform: translateY(-6px);
    border-color: var(--border-gold);
}

.mini-stat i {
    color: var(--gold);
    margin-bottom: 14px;
}

.mini-stat strong {
    display: block;
    color: white;
    font-size: 1.82rem;
    font-weight: 900;
}

.mini-stat span {
    display: block;
    margin-top: 8px;
    color: var(--muted);
    font-size: .78rem;
    font-weight: 800;
}

.signature {
    margin: 110px auto 40px;
    padding: clamp(28px, 4vw, 48px);
    border-radius: var(--radius-lg);
    background:
        radial-gradient(circle at 10% 0%, rgba(215,176,102,.20), transparent 32%),
        linear-gradient(135deg, rgba(255,255,255,.075), rgba(255,255,255,.045));
    border: 1px solid var(--border);
    box-shadow: var(--shadow-soft);
    backdrop-filter: blur(18px);
}

.signature-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.1fr) minmax(280px, .9fr);
    gap: 28px;
    align-items: center;
}

.signature-points {
    display: grid;
    gap: 14px;
}

.signature-point {
    padding: 16px;
    border-radius: 22px;
    display: flex;
    align-items: flex-start;
    gap: 12px;
    background: rgba(3,3,5,.30);
    border: 1px solid var(--border);
}

.signature-point i {
    width: 40px;
    height: 40px;
    min-width: 40px;
    border-radius: 16px;
    display: grid;
    place-items: center;
    color: #050509;
    background: linear-gradient(135deg, var(--gold-soft), var(--gold));
}

.signature-point strong {
    display: block;
    color: white;
    font-size: .95rem;
    margin-bottom: 4px;
}

.signature-point span {
    color: var(--muted);
    font-size: .84rem;
    line-height: 1.55;
}

.modal-backdrop {
    position: fixed;
    inset: 0;
    z-index: 3000;
    display: none;
    align-items: center;
    justify-content: center;
    padding: 22px;
    background: rgba(0,0,0,.72);
    backdrop-filter: blur(14px);
}

.modal-backdrop.active {
    display: flex;
    animation: fadeIn .25s ease both;
}

.film-modal {
    width: min(840px, 100%);
    overflow: hidden;
    border-radius: var(--radius);
    background: rgba(7,7,10,.94);
    border: 1px solid var(--border);
    box-shadow: var(--shadow);
    animation: modalPop .36s var(--ease) both;
}

.film-preview {
    height: 420px;
    display: grid;
    place-items: center;
    background:
        linear-gradient(rgba(0,0,0,.12), rgba(0,0,0,.48)),
        url('https://images.unsplash.com/photo-1507525428034-b723cf961d3e?auto=format&fit=crop&w=1200&q=80');
    background-size: cover;
    background-position: center;
}

.play-button {
    width: 94px;
    height: 94px;
    border-radius: 999px;
    display: grid;
    place-items: center;
    color: #050509;
    background: linear-gradient(135deg, var(--gold-soft), var(--gold));
    animation: pulsePlay 2s ease-in-out infinite;
}

@keyframes pulsePlay {
    0%, 100% {
        transform: scale(1);
        box-shadow: 0 0 0 0 rgba(215,176,102,.28);
    }
    50% {
        transform: scale(1.04);
        box-shadow: 0 0 0 18px rgba(215,176,102,0);
    }
}

.film-info {
    padding: 32px;
}

.film-info h3 {
    color: white;
    font-family: var(--font-display);
    font-size: 2.1rem;
    font-weight: 400;
    line-height: 1.1;
    margin-bottom: 12px;
}

.film-info p {
    color: var(--muted);
    line-height: 1.8;
    margin-bottom: 24px;
}

.close-modal {
    min-height: 48px;
    padding: 0 18px;
    border: 0;
    border-radius: 999px;
    cursor: pointer;
    color: #050509;
    background: linear-gradient(135deg, var(--gold-soft), var(--gold));
    font-size: .72rem;
    font-weight: 900;
    letter-spacing: .14em;
    text-transform: uppercase;
}

.footer {
    margin-top: 120px;
    padding: 34px 0 44px;
    border-top: 1px solid var(--border);
}

.footer-inner {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 20px;
    flex-wrap: wrap;
    color: var(--muted);
    font-size: .9rem;
}

.footer-brand {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    color: white;
    font-weight: 900;
    letter-spacing: .12em;
    text-transform: uppercase;
}

.footer-brand i {
    color: var(--gold);
}

.reveal {
    opacity: 0;
    transform: translateY(32px);
    transition: opacity .86s var(--ease), transform .86s var(--ease);
}

.reveal.visible {
    opacity: 1;
    transform: translateY(0);
}

.delay-1 {
    transition-delay: .08s;
}

.delay-2 {
    transition-delay: .16s;
}

.delay-3 {
    transition-delay: .24s;
}

@keyframes fadeIn {
    from { opacity: 0; }
    to { opacity: 1; }
}

@keyframes modalPop {
    from {
        opacity: 0;
        transform: translateY(22px) scale(.96);
    }
    to {
        opacity: 1;
        transform: translateY(0) scale(1);
    }
}

@media (max-width: 1180px) {
    .hero-grid,
    .story,
    .signature-grid {
        grid-template-columns: 1fr;
    }

    .hero-visual {
        max-width: 720px;
        width: 100%;
        margin: 0 auto;
    }

    .section-head {
        align-items: flex-start;
        flex-direction: column;
    }

    .room-tools {
        width: 100%;
        justify-content: flex-start;
    }

    .features,
    .room-grid {
        grid-template-columns: repeat(2, minmax(0, 1fr));
    }
}

@media (max-width: 860px) {
    .nav-toggle {
        display: grid;
        place-items: center;
    }

    .nav-links {
        position: fixed;
        top: 0;
        right: 0;
        bottom: 0;
        width: min(360px, 86vw);
        padding: 108px 26px 28px;
        align-items: stretch;
        flex-direction: column;
        gap: 12px;
        background: rgba(7,7,10,.94);
        border-left: 1px solid var(--border);
        box-shadow: var(--shadow);
        backdrop-filter: blur(24px);
        transform: translateX(104%);
        transition: transform .32s var(--ease);
    }

    body.menu-open .nav-links {
        transform: translateX(0);
    }

    .nav-links a {
        width: 100%;
        min-height: 50px;
        padding: 0 16px;
        border-radius: 18px;
        display: inline-flex;
        align-items: center;
        background: rgba(255,255,255,.055);
        border: 1px solid var(--border);
    }

    .nav-links a::after {
        display: none;
    }

    .features,
    .room-grid,
    .mini-stats {
        grid-template-columns: 1fr;
    }

    .float-card {
        left: 18px;
        bottom: 22px;
    }

    .availability-card {
        right: 18px;
        top: 22px;
    }

    .story-image {
        height: 460px;
    }
}

@media (max-width: 640px) {
    .container {
        width: min(100% - 24px, 1280px);
    }

    .nav-inner {
        min-height: 74px;
    }

    .logo {
        font-size: .92rem;
        letter-spacing: .22em;
    }

    .logo-mark {
        width: 38px;
        height: 38px;
        border-radius: 15px;
    }

    .hero {
        padding-top: 38px;
    }

    .hero h1 {
        font-size: clamp(3.4rem, 18vw, 5rem);
    }

    .hero-actions,
    .hero-trust {
        align-items: stretch;
        flex-direction: column;
    }

    .btn,
    .trust-pill {
        width: 100%;
    }

    .hero-image {
        height: 430px;
        border-radius: 50% 50% 28px 28px;
    }

    .float-card,
    .availability-card {
        position: relative;
        left: auto;
        right: auto;
        top: auto;
        bottom: auto;
        width: 100%;
        margin-top: 14px;
    }

    .room-media {
        height: 340px;
    }

    .room-tools {
        flex-direction: column;
    }

    .tool,
    .tool input,
    .tool select {
        width: 100%;
        min-width: 0;
    }

    .story-image {
        height: 380px;
        border-radius: 32px;
    }

    .film-preview {
        height: 310px;
    }

    .film-info {
        padding: 24px;
    }

    .footer-inner {
        align-items: flex-start;
        flex-direction: column;
    }
}

@media (max-width: 420px) {
    .section-title,
    .story h2,
    .signature h2 {
        font-size: 2.7rem;
    }

    .feature-card,
    .signature {
        padding: 24px;
        border-radius: 30px;
    }

    .room-details {
        padding: 20px;
    }

    .room-head {
        align-items: flex-start;
        flex-direction: column;
    }
}

@media print {
    body {
        background: white;
        color: black;
    }

    .ambient,
    .grain,
    .top-glow,
    .nav-bar,
    .ticker,
    .modal-backdrop,
    .hero-actions,
    .room-tools {
        display: none !important;
    }

    .reveal {
        opacity: 1 !important;
        transform: none !important;
    }
}

@media (prefers-reduced-motion: reduce) {
    *,
    *::before,
    *::after {
        animation-duration: .01ms !important;
        animation-iteration-count: 1 !important;
        scroll-behavior: auto !important;
        transition-duration: .01ms !important;
    }
}
</style>
</head>

<body>
<%
    const safeRooms = typeof rooms !== 'undefined' && Array.isArray(rooms) ? rooms : [];
    const safeUser = typeof user !== 'undefined' ? user : null;

    const pesoFormat = function (value) {
        return Number(value || 0).toLocaleString('en-PH', {
            minimumFractionDigits: 0,
            maximumFractionDigits: 2
        });
    };

    const roomTypes = [];

    safeRooms.forEach(function (room) {
        const roomType = room && room.type ? String(room.type) : '';

        if (roomType && !roomTypes.includes(roomType)) {
            roomTypes.push(roomType);
        }
    });
%>

<div class="site">
    <div class="top-glow"></div>

    <div class="ambient">
        <span class="orb gold"></span>
        <span class="orb blue"></span>
        <span class="orb teal"></span>
    </div>

    <div class="grain"></div>

    <nav class="nav-bar">
        <div class="nav-inner container">
            <a href="/" class="logo">
                <span class="logo-mark">
                    <i class="fa-solid fa-water"></i>
                </span>
                DANG'S<span>.</span>
            </a>

            <button type="button" class="nav-toggle" onclick="toggleMenu()" aria-label="Toggle navigation">
                <i class="fa-solid fa-bars"></i>
            </button>

            <div class="nav-links" id="navLinks">
                <a href="#experience" onclick="closeMenu()">Experience</a>
                <a href="#residences" onclick="closeMenu()">Residences</a>
                <a href="#story" onclick="closeMenu()">Story</a>
                <a href="#signature" onclick="closeMenu()">Amenities</a>

                <% if (safeUser) { %>
                    <a href="/dashboard" class="nav-action">
                        <i class="fa-solid fa-user"></i>
                        My Account
                    </a>
                <% } else { %>
                    <a href="/login" class="nav-action">
                        <i class="fa-solid fa-right-to-bracket"></i>
                        Sign In
                    </a>
                <% } %>
            </div>
        </div>
    </nav>

    <header class="hero container">
        <div class="hero-grid">
            <div class="hero-copy-side reveal">
                <span class="eyebrow">
                    <i class="fa-solid fa-crown"></i>
                    Established 2026
                </span>

                <h1>
                    The Art of <br>
                    <em>Island</em> Living
                </h1>

                <p class="hero-copy">
                    Escape into a luxury coastal sanctuary designed for slow mornings, warm sunsets, private comfort, and seamless online reservations in Abuyog.
                </p>

                <div class="hero-actions">
                    <a href="#residences" class="btn btn-gold">
                        <i class="fa-solid fa-calendar-check"></i>
                        Reserve Now
                    </a>

                    <button type="button" class="btn btn-glass" onclick="openFilm()">
                        <i class="fa-solid fa-play"></i>
                        Watch Film
                    </button>

                    <% if (safeUser) { %>
                        <a href="/dashboard" class="btn btn-outline">
                            <i class="fa-solid fa-user"></i>
                            My Dashboard
                        </a>
                    <% } else { %>
                        <a href="/register" class="btn btn-outline">
                            <i class="fa-solid fa-user-plus"></i>
                            Create Account
                        </a>
                    <% } %>
                </div>

                <div class="hero-trust">
                    <span class="trust-pill">
                        <i class="fa-solid fa-shield-halved"></i>
                        Secure Booking
                    </span>

                    <span class="trust-pill">
                        <i class="fa-solid fa-wallet"></i>
                        Online Payment
                    </span>

                    <span class="trust-pill">
                        <i class="fa-solid fa-umbrella-beach"></i>
                        Coastal Retreat
                    </span>
                </div>
            </div>

            <div class="hero-visual reveal delay-1">
                <div class="hero-image">
                    <img 
                        src="https://images.unsplash.com/photo-1520250497591-112f2f40a3f4?auto=format&fit=crop&w=1200&q=80" 
                        alt="Dang's Resort island pool"
                    >
                </div>

                <div class="availability-card">
                    <span>
                        <i class="fa-solid fa-circle-check"></i>
                        Available Online
                    </span>

                    <strong>
                        <%= safeRooms.length %> residence<%= safeRooms.length === 1 ? '' : 's' %> ready to view
                    </strong>
                </div>

                <div class="float-card">
                    <div class="float-icon">
                        <i class="fa-solid fa-gem"></i>
                    </div>

                    <small>Guest Favorite</small>
                    <strong>Ocean View Suite</strong>
                    <p>Private comfort, calm atmosphere, and elevated coastal scenery.</p>
                </div>
            </div>
        </div>
    </header>

    <section class="ticker container">
        <div class="ticker-track">
            <div class="ticker-content">
                <span><i class="fa-solid fa-star"></i> Coastal Retreat</span>
                <span><i class="fa-solid fa-bed"></i> Private Rooms</span>
                <span><i class="fa-solid fa-water"></i> Island Living</span>
                <span><i class="fa-solid fa-lock"></i> Secure Booking</span>
                <span><i class="fa-solid fa-heart"></i> Local Hospitality</span>
                <span><i class="fa-solid fa-star"></i> Coastal Retreat</span>
                <span><i class="fa-solid fa-bed"></i> Private Rooms</span>
                <span><i class="fa-solid fa-water"></i> Island Living</span>
                <span><i class="fa-solid fa-lock"></i> Secure Booking</span>
                <span><i class="fa-solid fa-heart"></i> Local Hospitality</span>
            </div>
        </div>
    </section>

    <section id="experience" class="features container">
        <div class="feature-card reveal">
            <div class="feature-top">
                <span class="feature-num">01 / Arrival</span>
                <div class="feature-icon">
                    <i class="fa-solid fa-key"></i>
                </div>
            </div>

            <h3>Instant Access</h3>
            <p>View available rooms and reserve your preferred stay in just a few clicks through a smooth guest booking flow.</p>
        </div>

        <div class="feature-card reveal delay-1">
            <div class="feature-top">
                <span class="feature-num">02 / Comfort</span>
                <div class="feature-icon">
                    <i class="fa-solid fa-spa"></i>
                </div>
            </div>

            <h3>Curated Comfort</h3>
            <p>Every residence is styled for calm, privacy, and refreshing resort comfort after a full coastal day.</p>
        </div>

        <div class="feature-card reveal delay-2">
            <div class="feature-top">
                <span class="feature-num">03 / Trust</span>
                <div class="feature-icon">
                    <i class="fa-solid fa-shield-heart"></i>
                </div>
            </div>

            <h3>Coastal Safety</h3>
            <p>Organized guest records, booking status visibility, and secure reservation processing support every stay.</p>
        </div>
    </section>

    <section id="residences" class="residences container">
        <div class="section-head reveal">
            <div>
                <span class="kicker">
                    <i class="fa-solid fa-hotel"></i>
                    Luxury Residences
                </span>

                <h2 class="section-title">The Residences</h2>
                <p class="section-copy">Select your perfect vantage point for rest, privacy, and coastal atmosphere.</p>
            </div>

            <div class="room-tools">
                <div class="tool">
                    <i class="fa-solid fa-magnifying-glass"></i>

                    <input 
                        type="text" 
                        id="roomSearch" 
                        placeholder="Search room name..." 
                        onkeyup="filterRooms()"
                    >
                </div>

                <div class="tool select-tool">
                    <i class="fa-solid fa-filter"></i>

                    <select id="roomType" onchange="filterRooms()">
                        <option value="all">All Types</option>
                        <% roomTypes.forEach(function (type) { %>
                            <option value="<%= String(type).toLowerCase() %>">
                                <%= type %>
                            </option>
                        <% }) %>
                    </select>
                </div>
            </div>
        </div>

        <div class="room-grid" id="roomGrid">
            <% if (safeRooms.length > 0) { %>
                <% safeRooms.forEach(function (room, index) { 
                    const roomName = room.name || 'Luxury Residence';
                    const roomType = room.type || 'Residence';
                    const roomImage = room.image_url || 'https://images.unsplash.com/photo-1566073771259-6a8506099945?auto=format&fit=crop&w=900&q=80';
                %>
                    <div 
                        class="room-card reveal"
                        data-name="<%= String(roomName).toLowerCase() %>"
                        data-type="<%= String(roomType).toLowerCase() %>"
                    >
                        <div class="room-media">
                            <img 
                                src="<%= roomImage %>"
                                alt="<%= roomName %>"
                                onerror="this.onerror=null; this.src='https://images.unsplash.com/photo-1566073771259-6a8506099945?auto=format&fit=crop&w=900&q=80';"
                            >

                            <span class="room-badge">
                                <i class="fa-solid fa-gem"></i>
                                Residence <%= String(index + 1).padStart(2, '0') %>
                            </span>

                            <div class="room-hover">
                                <% if (safeUser) { %>
                                    <a href="/book/<%= room.id %>">
                                        <i class="fa-solid fa-calendar-check"></i>
                                        Check Availability
                                    </a>
                                <% } else { %>
                                    <a href="/login">
                                        <i class="fa-solid fa-right-to-bracket"></i>
                                        Sign In to Reserve
                                    </a>
                                <% } %>
                            </div>
                        </div>

                        <div class="room-details">
                            <div class="room-head">
                                <span class="category">
                                    <%= roomType %>
                                </span>

                                <span class="price">
                                    ₱<%= pesoFormat(room.price) %>
                                </span>
                            </div>

                            <h3><%= roomName %></h3>

                            <div class="room-meta">
                                <span>
                                    <i class="fa-solid fa-wifi"></i>
                                    Online Booking
                                </span>

                                <span>
                                    <i class="fa-solid fa-water"></i>
                                    Coastal Stay
                                </span>
                            </div>
                        </div>
                    </div>
                <% }) %>
            <% } else { %>
                <div class="empty-rooms">
                    <div class="empty-icon">
                        <i class="fa-solid fa-hotel"></i>
                    </div>

                    <h3>No residences available yet.</h3>
                    <p>Please check again later for updated room listings.</p>
                </div>
            <% } %>
        </div>
    </section>

    <section id="story" class="story container">
        <div class="story-image reveal">
            <img 
                src="https://images.unsplash.com/photo-1507525428034-b723cf961d3e?auto=format&fit=crop&w=1200&q=80" 
                alt="Coastal beach"
            >
        </div>

        <div class="story-content reveal delay-1">
            <span class="kicker">
                <i class="fa-solid fa-feather"></i>
                Our Story
            </span>

            <h2>Designed for rest, built for memories.</h2>

            <p>
                Dang's Resort brings together simple coastal elegance and practical booking convenience. Guests can explore available rooms, reserve their stay, and enjoy a smoother resort experience from arrival to checkout.
            </p>

            <p>
                Whether it is a family stay, a quiet weekend, or a beachfront escape, each residence is made to feel personal, private, and memorable.
            </p>

            <div class="mini-stats">
                <div class="mini-stat">
                    <i class="fa-solid fa-hotel"></i>
                    <strong><%= safeRooms.length %>+</strong>
                    <span>Residences</span>
                </div>

                <div class="mini-stat">
                    <i class="fa-solid fa-globe"></i>
                    <strong>24/7</strong>
                    <span>Online Access</span>
                </div>

                <div class="mini-stat">
                    <i class="fa-solid fa-calendar-days"></i>
                    <strong>2026</strong>
                    <span>Established</span>
                </div>
            </div>
        </div>
    </section>

    <section id="signature" class="signature container reveal">
        <div class="signature-grid">
            <div>
                <span class="kicker">
                    <i class="fa-solid fa-crown"></i>
                    Signature Experience
                </span>

                <h2>Dark elegance by the coast.</h2>

                <p>
                    A luxury-inspired digital welcome page that feels cinematic, premium, and easy to use on any device while keeping the original booking logic intact.
                </p>
            </div>

            <div class="signature-points">
                <div class="signature-point">
                    <i class="fa-solid fa-mobile-screen"></i>
                    <div>
                        <strong>Mobile-friendly layout</strong>
                        <span>Cards, navigation, filters, and actions adapt smoothly for phones and tablets.</span>
                    </div>
                </div>

                <div class="signature-point">
                    <i class="fa-solid fa-wand-magic-sparkles"></i>
                    <div>
                        <strong>Animated luxury interface</strong>
                        <span>Scroll reveals, floating cards, premium glow effects, and elegant hover interactions.</span>
                    </div>
                </div>

                <div class="signature-point">
                    <i class="fa-solid fa-lock"></i>
                    <div>
                        <strong>Preserved booking flow</strong>
                        <span>Guests still sign in before reserving, while logged-in users can proceed to book rooms.</span>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <div id="filmModal" class="modal-backdrop" onclick="closeFilm(event)">
        <div class="film-modal">
            <div class="film-preview">
                <div class="play-button">
                    <i class="fa-solid fa-play"></i>
                </div>
            </div>

            <div class="film-info">
                <h3>A glimpse of island living.</h3>
                <p>Imagine calm waves, warm sunlight, fresh air, private rooms, and a resort experience made for slowing down. This is the Dang's Resort atmosphere.</p>

                <button type="button" class="close-modal" onclick="closeFilm()">
                    <i class="fa-solid fa-xmark"></i>
                    Close Preview
                </button>
            </div>
        </div>
    </div>

    <footer class="footer">
        <div class="footer-inner container">
            <p class="footer-brand">
                <i class="fa-solid fa-water"></i>
                Dang's Resort
            </p>

            <p>&copy; 2026 Dang's Resort Retreats. All rights reserved.</p>

            <p>
                <i class="fa-solid fa-location-dot"></i>
                Abuyog Coastal Sanctuary
            </p>
        </div>
    </footer>
</div>

<script>
function toggleMenu() {
    document.body.classList.toggle('menu-open');
}

function closeMenu() {
    document.body.classList.remove('menu-open');
}

function filterRooms() {
    const searchInput = document.getElementById('roomSearch');
    const typeInput = document.getElementById('roomType');
    const cards = document.querySelectorAll('.room-card');

    const search = searchInput ? searchInput.value.toLowerCase().trim() : '';
    const type = typeInput ? typeInput.value : 'all';

    cards.forEach(function (card) {
        const roomName = card.dataset.name || '';
        const roomType = card.dataset.type || '';
        const matchesSearch = roomName.includes(search);
        const matchesType = type === 'all' || roomType === type;

        card.style.display = matchesSearch && matchesType ? '' : 'none';
    });
}

function openFilm() {
    const modal = document.getElementById('filmModal');

    if (!modal) return;

    modal.classList.add('active');
    document.body.classList.add('modal-open');
}

function closeFilm(event) {
    const modal = document.getElementById('filmModal');

    if (!modal) return;

    if (!event || event.target.id === 'filmModal' || event.target.closest('.close-modal')) {
        modal.classList.remove('active');
        document.body.classList.remove('modal-open');
    }
}

const revealElements = document.querySelectorAll('.reveal');

const revealObserver = new IntersectionObserver(function (entries) {
    entries.forEach(function (entry) {
        if (entry.isIntersecting) {
            entry.target.classList.add('visible');
        }
    });
}, { threshold: 0.15 });

revealElements.forEach(function (el) {
    revealObserver.observe(el);
});

document.addEventListener('keydown', function (event) {
    if (event.key === 'Escape') {
        closeMenu();
        closeFilm();
    }
});

document.querySelectorAll('.nav-links a').forEach(function (link) {
    link.addEventListener('click', closeMenu);
});
</script>

</body>
</html>