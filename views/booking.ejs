<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<title>Finalize Your Retreat | Dang's Resort</title>
<link href="https://fonts.googleapis.com/css2?family=Tenor+Sans&family=Inter:wght@300;400;600&display=swap" rel="stylesheet">
<style>
:root {
    --gold: #c5a880;
    --dark: #1a1a1a;
    --bg: #fdfdfd;
}
body {
    background: var(--bg);
    font-family: 'Inter', sans-serif;
    color: var(--dark);
    margin: 0;
    padding: 40px 5%;
}
.booking-card {
    max-width: 900px;
    margin: 0 auto;
    background: white;
    display: grid;
    grid-template-columns: 1fr 1fr;
    box-shadow: 0 20px 50px rgba(0,0,0,0.05);
    border-radius: 20px;
    overflow: hidden;
}
.form-section { padding: 40px; }
.payment-section {
    background: #fdfaf5;
    padding: 40px;
    border-left: 1px solid #f1e6d5;
    text-align: center;
}
h1, h3 {
    font-family: 'Tenor Sans', serif;
    text-transform: uppercase;
    letter-spacing: 2px;
}
h1 { grid-column: span 2; padding: 0 40px; margin-top: 40px; font-size: 2rem; }
label {
    display: block;
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 1px;
    margin-bottom: 5px;
    color: var(--gold);
    font-weight: 600;
}
input, textarea {
    width: 100%;
    padding: 12px;
    margin-bottom: 20px;
    border: 1px solid #eee;
    background: #fafafa;
    box-sizing: border-box;
    border-radius: 8px;
}
input[readonly] { background:#f5f5f5; }
.btn-submit {
    background: var(--dark);
    color: white;
    border: none;
    padding: 15px;
    width: 100%;
    cursor: pointer;
    text-transform: uppercase;
    letter-spacing: 2px;
    font-weight: 600;
    transition: 0.3s;
}
.btn-submit:hover { background: var(--gold); }
.room-summary { font-size: 14px; margin-bottom: 30px; color: #666; }
.qr-code {
    width: 220px;
    height: 220px;
    background: white;
    margin: 20px auto;
    border: 1px solid #eee;
    padding: 10px;
}
.qr-code img { width: 100%; height: 100%; object-fit: contain; }
</style>
</head>
<body>

<div class="booking-card">
    <h1>Confirm Your Sanctuary<span>.</span></h1>

    <div class="form-section">
        <div class="room-summary">
            Selected: <strong><%= room.name %></strong><br>
            Rate: ₱<span id="roomPrice"><%= room.price %></span> / night
        </div>

        <form action="/book/confirm/<%= room.id %>" method="POST" id="bookingForm">
            <label>Guest Full Name</label>
            <input type="text" name="guest_name" value="<%= user.username %>" required>

            <label>Phone Number</label>
            <input type="tel" name="phone" placeholder="+63 000 000 0000" required>

            <label>Check-in Date</label>
            <input type="date" name="check_in" id="checkIn" required>

            <label>Check-out Date</label>
            <input type="date" name="check_out" id="checkOut" required>

            <label>Special Requests</label>
            <textarea name="requests" rows="3" placeholder="Dietary needs, bed preference..."></textarea>

            <label>Reference Number</label>
            <input type="text" name="ref_code" placeholder="Enter Ref #" required>

            <label>Total Amount to Pay</label>
            <input type="text" name="total_price" id="totalPrice" value="<%= room.price %>" readonly>

            <!-- Hidden input to fix SQL insertion for booking_date -->
            <input type="hidden" name="booking_date" id="bookingDate" value="<%= new Date().toISOString().split('T')[0] %>">
        </form>
    </div>

    <div class="payment-section">
        <h3>Online Payment</h3>
        <p style="font-size: 12px;">Scan to pay via GCash or Bank Transfer</p>
        
        <div class="qr-code">
            <img src="/uploads/payment_qr.png" alt="Payment QR Code">
        </div>

        <p style="font-size: 10px; color: #888;">Your status will show 'Pending' until verified.</p>

        <button type="submit" form="bookingForm" class="btn-submit">Finalize Booking</button>
    </div>
</div>

<script>
const roomPrice = parseFloat('<%= room.price %>');
const checkInEl = document.getElementById('checkIn');
const checkOutEl = document.getElementById('checkOut');
const totalEl = document.getElementById('totalPrice');
const bookingDateEl = document.getElementById('bookingDate');

function updateTotal() {
    const checkInDate = new Date(checkInEl.value);
    const checkOutDate = new Date(checkOutEl.value);

    if (checkInDate && checkOutDate && checkOutDate > checkInDate) {
        const diffTime = checkOutDate - checkInDate;
        const diffDays = Math.ceil(diffTime / (1000 * 60 * 60 * 24));
        const total = roomPrice * diffDays;
        totalEl.value = total.toFixed(2); // numeric value for backend
    } else {
        totalEl.value = roomPrice.toFixed(2);
    }

    // Update booking date dynamically
    bookingDateEl.value = new Date().toISOString().split('T')[0];
}

checkInEl.addEventListener('change', updateTotal);
checkOutEl.addEventListener('change', updateTotal);
</script>

</body>
</html>