    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const body = document.body;
            const menuToggle = document.getElementById('menuToggle');
            const mobileMenu = document.getElementById('mobileMenu');
            const mobileClose = document.getElementById('mobileClose');
            const screenOverlay = document.getElementById('screenOverlay');
            const floatingTop = document.getElementById('floatingTop');
            const bookingForm = document.getElementById('bookingForm');
            const submitBtn = document.getElementById('submitBtn');

            const checkInEl = document.getElementById('checkIn');
            const checkOutEl = document.getElementById('checkOut');
            const totalEl = document.getElementById('totalPrice');
            const bookingDateEl = document.getElementById('bookingDate');
            const dateWarning = document.getElementById('dateWarning');
            const nightCountEl = document.getElementById('nightCount');
            const nightPluralEl = document.getElementById('nightPlural');
            const visualTotalEl = document.getElementById('visualTotal');
            const paymentAmountEl = document.getElementById('paymentAmount');
            const toast = document.getElementById('toast');
            const toastMessage = document.getElementById('toastMessage');

            const roomPrice = Number('<%= roomPrice %>') || 0;

            function openMobileMenu() {
                if (!mobileMenu || !screenOverlay) return;

                mobileMenu.classList.add('show');
                screenOverlay.classList.add('show');
                body.classList.add('menu-open');
            }

            function closeMobileMenu() {
                if (!mobileMenu || !screenOverlay) return;

                mobileMenu.classList.remove('show');
                screenOverlay.classList.remove('show');
                body.classList.remove('menu-open');
            }

            function formatPeso(value) {
                return Number(value || 0).toLocaleString('en-PH', {
                    minimumFractionDigits: 0,
                    maximumFractionDigits: 2
                });
            }

            function toDateOnly(date) {
                return new Date(date.getFullYear(), date.getMonth(), date.getDate());
            }

            function setCheckoutMinimum() {
                if (!checkInEl || !checkOutEl) return;

                if (!checkInEl.value) {
                    return;
                }

                const checkInDate = new Date(checkInEl.value);
                const nextDay = new Date(checkInDate);

                nextDay.setDate(nextDay.getDate() + 1);

                const nextDateString = nextDay.toISOString().split('T')[0];

                checkOutEl.min = nextDateString;

                if (checkOutEl.value && checkOutEl.value <= checkInEl.value) {
                    checkOutEl.value = nextDateString;
                }
            }

            function updateTotal() {
                if (!checkInEl || !checkOutEl || !totalEl) return;

                const checkInValue = checkInEl.value;
                const checkOutValue = checkOutEl.value;

                let nights = 1;
                let total = roomPrice;
                let isValidRange = true;

                if (checkInValue && checkOutValue) {
                    const checkInDate = toDateOnly(new Date(checkInValue));
                    const checkOutDate = toDateOnly(new Date(checkOutValue));

                    if (checkOutDate > checkInDate) {
                        const diffTime = checkOutDate - checkInDate;
                        nights = Math.ceil(diffTime / (1000 * 60 * 60 * 24));
                        total = roomPrice * nights;
                        isValidRange = true;
                    } else {
                        nights = 1;
                        total = roomPrice;
                        isValidRange = false;
                    }
                }

                totalEl.value = total.toFixed(2);

                if (nightCountEl) {
                    nightCountEl.textContent = nights;
                }

                if (nightPluralEl) {
                    nightPluralEl.textContent = nights === 1 ? '' : 's';
                }

                if (visualTotalEl) {
                    visualTotalEl.textContent = formatPeso(total);
                }

                if (paymentAmountEl) {
                    paymentAmountEl.textContent = formatPeso(total);
                }

                if (bookingDateEl) {
                    bookingDateEl.value = new Date().toISOString().split('T')[0];
                }

                if (dateWarning) {
                    if (!isValidRange && checkInValue && checkOutValue) {
                        dateWarning.classList.add('show');
                    } else {
                        dateWarning.classList.remove('show');
                    }
                }

                if (submitBtn) {
                    submitBtn.disabled = !isValidRange;
                }
            }

            function showToast(message) {
                if (!toast || !toastMessage) return;

                toastMessage.textContent = message;
                toast.classList.add('show');

                setTimeout(function () {
                    toast.classList.remove('show');
                }, 3200);
            }

            if (menuToggle) {
                menuToggle.addEventListener('click', openMobileMenu);
            }

            if (mobileClose) {
                mobileClose.addEventListener('click', closeMobileMenu);
            }

            if (screenOverlay) {
                screenOverlay.addEventListener('click', closeMobileMenu);
            }

            document.querySelectorAll('.mobile-menu a').forEach(function (link) {
                link.addEventListener('click', closeMobileMenu);
            });

            document.addEventListener('keydown', function (event) {
                if (event.key === 'Escape') {
                    closeMobileMenu();
                }
            });

            if (checkInEl) {
                checkInEl.addEventListener('change', function () {
                    setCheckoutMinimum();
                    updateTotal();
                });
            }

            if (checkOutEl) {
                checkOutEl.addEventListener('change', updateTotal);
            }

            if (bookingForm) {
                bookingForm.addEventListener('submit', function (event) {
                    updateTotal();

                    if (submitBtn && submitBtn.disabled) {
                        event.preventDefault();
                        showToast('Please choose a valid check-out date after your check-in date.');
                        return;
                    }

                    const requiredFields = bookingForm.querySelectorAll('[required]');
                    let firstInvalid = null;

                    requiredFields.forEach(function (field) {
                        if (!field.value.trim()) {
                            firstInvalid = firstInvalid || field;
                        }
                    });

                    if (firstInvalid) {
                        event.preventDefault();
                        firstInvalid.focus();
                        showToast('Please complete all required booking details.');
                    }
                });
            }

            window.addEventListener('scroll', function () {
                if (!floatingTop) return;

                if (window.scrollY > 450) {
                    floatingTop.classList.add('show');
                } else {
                    floatingTop.classList.remove('show');
                }
            });

            if (floatingTop) {
                floatingTop.addEventListener('click', function () {
                    window.scrollTo({
                        top: 0,
                        behavior: 'smooth'
                    });
                });
            }

            setCheckoutMinimum();
            updateTotal();
        });
    </script>
</body>

</html>
