<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">

    <meta 
        name="viewport" 
        content="width=device-width, initial-scale=1.0"
    >

    <meta 
        name="theme-color" 
        content="#0891b2"
    >

    <title>Finalize Your Retreat | Dang's Beach Resort</title>

    <!-- Google Fonts -->
    <link 
        href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&family=Tenor+Sans&display=swap" 
        rel="stylesheet"
    >

    <!-- Font Awesome Icons -->
    <link 
        rel="stylesheet" 
        href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css"
    >

    <style>
        :root {
            --font-main: 'Inter', sans-serif;
            --font-display: 'Tenor Sans', serif;

            --ocean-50: #ecfeff;
            --ocean-100: #cffafe;
            --ocean-200: #a5f3fc;
            --ocean-300: #67e8f9;
            --ocean-400: #22d3ee;
            --ocean-500: #06b6d4;
            --ocean-600: #0891b2;
            --ocean-700: #0e7490;
            --ocean-800: #155e75;
            --ocean-900: #164e63;

            --sea-50: #f0fdfa;
            --sea-100: #ccfbf1;
            --sea-200: #99f6e4;
            --sea-300: #5eead4;
            --sea-400: #2dd4bf;
            --sea-500: #14b8a6;
            --sea-600: #0d9488;
            --sea-700: #0f766e;
            --sea-800: #115e59;
            --sea-900: #134e4a;

            --sand-50: #fffaf0;
            --sand-100: #fef3c7;
            --sand-200: #fde68a;
            --sand-300: #fcd34d;
            --sand-400: #fbbf24;
            --sand-500: #f59e0b;
            --sand-600: #d97706;
            --sand-700: #b45309;
            --sand-800: #92400e;
            --sand-900: #78350f;

            --rose-50: #fff1f2;
            --rose-100: #ffe4e6;
            --rose-200: #fecdd3;
            --rose-500: #f43f5e;
            --rose-600: #e11d48;
            --rose-700: #be123c;

            --emerald-50: #ecfdf5;
            --emerald-100: #d1fae5;
            --emerald-200: #a7f3d0;
            --emerald-500: #10b981;
            --emerald-600: #059669;
            --emerald-700: #047857;

            --slate-50: #f8fafc;
            --slate-100: #f1f5f9;
            --slate-200: #e2e8f0;
            --slate-300: #cbd5e1;
            --slate-400: #94a3b8;
            --slate-500: #64748b;
            --slate-600: #475569;
            --slate-700: #334155;
            --slate-800: #1e293b;
            --slate-900: #0f172a;
            --slate-950: #020617;

            --white: #ffffff;
            --black: #000000;

            --page-bg: #f8fcff;
            --surface: rgba(255, 255, 255, 0.86);
            --surface-strong: rgba(255, 255, 255, 0.94);
            --surface-solid: #ffffff;
            --surface-muted: rgba(248, 250, 252, 0.78);

            --border: rgba(148, 163, 184, 0.22);
            --border-strong: rgba(148, 163, 184, 0.42);
            --border-glow: rgba(6, 182, 212, 0.28);

            --text-main: #0f172a;
            --text-soft: #475569;
            --text-muted: #94a3b8;
            --text-white: #f8fafc;

            --shadow-xs: 0 4px 12px rgba(15, 23, 42, 0.06);
            --shadow-sm: 0 10px 28px rgba(15, 23, 42, 0.08);
            --shadow-md: 0 18px 42px rgba(15, 23, 42, 0.10);
            --shadow-lg: 0 30px 80px rgba(15, 23, 42, 0.16);
            --shadow-xl: 0 44px 120px rgba(15, 23, 42, 0.22);
            --shadow-ocean: 0 24px 56px rgba(8, 145, 178, 0.24);
            --shadow-teal: 0 24px 56px rgba(20, 184, 166, 0.22);
            --shadow-sand: 0 24px 56px rgba(245, 158, 11, 0.20);

            --radius-xs: 8px;
            --radius-sm: 12px;
            --radius-md: 18px;
            --radius-lg: 24px;
            --radius-xl: 32px;
            --radius-2xl: 42px;
            --radius-3xl: 56px;
            --radius-full: 999px;

            --ease: cubic-bezier(0.22, 1, 0.36, 1);
            --ease-bounce: cubic-bezier(0.34, 1.56, 0.64, 1);

            --container: 1180px;
            --nav-height: 84px;
        }

        * {
            box-sizing: border-box;
        }

        *::before,
        *::after {
            box-sizing: border-box;
        }

        html {
            width: 100%;
            min-height: 100%;
            scroll-behavior: smooth;
        }

        body {
            width: 100%;
            min-height: 100vh;
            margin: 0;
            color: var(--text-main);
            font-family: var(--font-main);
            background:
                radial-gradient(circle at 8% 8%, rgba(103, 232, 249, 0.34), transparent 28%),
                radial-gradient(circle at 94% 12%, rgba(45, 212, 191, 0.30), transparent 30%),
                radial-gradient(circle at 52% 100%, rgba(251, 191, 36, 0.15), transparent 36%),
                linear-gradient(135deg, #f8fcff 0%, #ecfeff 38%, #f0fdfa 100%);
            overflow-x: hidden;
        }

        body.modal-open,
        body.menu-open {
            overflow: hidden;
        }

        a {
            color: inherit;
        }

        button,
        input,
        select,
        textarea {
            font: inherit;
        }

        button {
            -webkit-tap-highlight-color: transparent;
        }

        img {
            max-width: 100%;
            display: block;
        }

        ::selection {
            background: rgba(6, 182, 212, 0.22);
            color: var(--slate-950);
        }

        ::-webkit-scrollbar {
            width: 10px;
            height: 10px;
        }

        ::-webkit-scrollbar-track {
            background: rgba(226, 232, 240, 0.5);
        }

        ::-webkit-scrollbar-thumb {
            background: linear-gradient(180deg, var(--ocean-500), var(--sea-500));
            border-radius: var(--radius-full);
        }

        ::-webkit-scrollbar-thumb:hover {
            background: linear-gradient(180deg, var(--ocean-600), var(--sea-600));
        }

        .page-shell {
            position: relative;
            min-height: 100vh;
            isolation: isolate;
            overflow: hidden;
        }

        .ambient-bg {
            position: fixed;
            inset: 0;
            z-index: -5;
            pointer-events: none;
            overflow: hidden;
        }

        .ambient-bg::before {
            content: "";
            position: absolute;
            inset: 0;
            background-image:
                linear-gradient(rgba(8, 145, 178, 0.045) 1px, transparent 1px),
                linear-gradient(90deg, rgba(8, 145, 178, 0.045) 1px, transparent 1px);
            background-size: 44px 44px;
            mask-image: linear-gradient(to bottom, black 0%, transparent 84%);
        }

        .glow-orb {
            position: absolute;
            width: 420px;
            height: 420px;
            border-radius: var(--radius-full);
            filter: blur(26px);
            opacity: 0.42;
            animation: orbDrift 16s var(--ease) infinite alternate;
        }

        .glow-orb.orb-one {
            top: -140px;
            left: -110px;
            background: rgba(34, 211, 238, 0.48);
        }

        .glow-orb.orb-two {
            top: 120px;
            right: -160px;
            background: rgba(20, 184, 166, 0.42);
            animation-delay: -5s;
        }

        .glow-orb.orb-three {
            width: 500px;
            height: 500px;
            left: 35%;
            bottom: -260px;
            background: rgba(251, 191, 36, 0.20);
            animation-delay: -9s;
        }

        .floating-shape {
            position: fixed;
            z-index: -3;
            pointer-events: none;
            border-radius: var(--radius-full);
            border: 1px solid rgba(14, 116, 144, 0.12);
            background: rgba(255, 255, 255, 0.28);
            backdrop-filter: blur(10px);
            animation: shapeFloat 10s ease-in-out infinite;
        }

        .floating-shape.shape-one {
            width: 74px;
            height: 74px;
            left: 8%;
            top: 34%;
        }

        .floating-shape.shape-two {
            width: 46px;
            height: 46px;
            right: 12%;
            top: 46%;
            animation-delay: -3s;
        }

        .floating-shape.shape-three {
            width: 96px;
            height: 96px;
            right: 20%;
            bottom: 12%;
            animation-delay: -6s;
        }

        .page-noise {
            position: fixed;
            inset: 0;
            z-index: -2;
            opacity: 0.05;
            pointer-events: none;
            background-image:
                radial-gradient(circle at 25% 25%, #000 1px, transparent 1px),
                radial-gradient(circle at 75% 75%, #000 1px, transparent 1px);
            background-size: 24px 24px;
        }

        @keyframes orbDrift {
            0% {
                transform: translate3d(0, 0, 0) scale(1);
            }

            50% {
                transform: translate3d(44px, 30px, 0) scale(1.08);
            }

            100% {
                transform: translate3d(-28px, 60px, 0) scale(0.95);
            }
        }

        @keyframes shapeFloat {
            0%,
            100% {
                transform: translateY(0) rotate(0deg);
            }

            50% {
                transform: translateY(-22px) rotate(8deg);
            }
        }

        .dash-nav {
            position: sticky;
            top: 0;
            z-index: 100;
            min-height: var(--nav-height);
            padding: 16px clamp(16px, 5vw, 64px);
            display: flex;
            align-items: center;
            justify-content: center;
            background: rgba(255, 255, 255, 0.76);
            border-bottom: 1px solid rgba(148, 163, 184, 0.18);
            backdrop-filter: blur(22px);
            box-shadow: 0 12px 36px rgba(15, 23, 42, 0.06);
        }

        .nav-inner {
            width: min(var(--container), 100%);
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 22px;
        }

        .logo {
            display: inline-flex;
            align-items: center;
            gap: 12px;
            color: var(--slate-950);
            text-decoration: none;
            letter-spacing: 0.08em;
            text-transform: uppercase;
            font-family: var(--font-display);
            font-size: 1.25rem;
            font-weight: 400;
            white-space: nowrap;
        }

        .logo-icon {
            width: 46px;
            height: 46px;
            border-radius: 17px;
            color: white;
            display: grid;
            place-items: center;
            background:
                radial-gradient(circle at 30% 25%, rgba(255, 255, 255, 0.46), transparent 24%),
                linear-gradient(135deg, var(--ocean-500), var(--sea-500));
            box-shadow: var(--shadow-ocean);
            position: relative;
            overflow: hidden;
        }

        .logo-icon::after {
            content: "";
            position: absolute;
            inset: -50%;
            background: linear-gradient(120deg, transparent, rgba(255, 255, 255, 0.35), transparent);
            transform: translateX(-120%) rotate(20deg);
            animation: shineSweep 4.8s ease-in-out infinite;
        }

        .logo span {
            color: var(--ocean-600);
        }

        .nav-links {
            display: flex;
            align-items: center;
            gap: 10px;
        }

        .nav-link {
            min-height: 44px;
            padding: 0 16px;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 9px;
            border-radius: var(--radius-full);
            color: var(--text-soft);
            text-decoration: none;
            font-size: 0.78rem;
            font-weight: 850;
            letter-spacing: 0.06em;
            text-transform: uppercase;
            transition:
                transform 0.25s var(--ease),
                color 0.25s var(--ease),
                background 0.25s var(--ease),
                box-shadow 0.25s var(--ease);
        }

        .nav-link:hover {
            transform: translateY(-2px);
            color: var(--ocean-700);
            background: rgba(6, 182, 212, 0.10);
        }

        .nav-link.primary {
            color: white;
            background: linear-gradient(135deg, var(--ocean-600), var(--sea-500));
            box-shadow: 0 14px 34px rgba(8, 145, 178, 0.22);
        }

        .nav-link.primary:hover {
            color: white;
            box-shadow: 0 18px 42px rgba(8, 145, 178, 0.30);
        }

        .menu-toggle {
            width: 46px;
            height: 46px;
            border: 0;
            border-radius: 16px;
            display: none;
            place-items: center;
            cursor: pointer;
            color: white;
            background: linear-gradient(135deg, var(--ocean-600), var(--sea-500));
            box-shadow: 0 12px 30px rgba(8, 145, 178, 0.24);
        }

        .mobile-menu {
            position: fixed;
            inset: 0 0 auto 0;
            z-index: 120;
            transform: translateY(-110%);
            transition: transform 0.38s var(--ease);
            padding: 16px;
            pointer-events: none;
        }

        .mobile-menu.show {
            transform: translateY(0);
            pointer-events: auto;
        }

        .mobile-menu-panel {
            border-radius: 28px;
            padding: 18px;
            background: rgba(255, 255, 255, 0.92);
            border: 1px solid rgba(148, 163, 184, 0.18);
            box-shadow: var(--shadow-lg);
            backdrop-filter: blur(24px);
        }

        .mobile-menu-head {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 12px;
            margin-bottom: 16px;
        }

        .mobile-close {
            width: 42px;
            height: 42px;
            border: 0;
            border-radius: 15px;
            display: grid;
            place-items: center;
            cursor: pointer;
            color: var(--slate-700);
            background: var(--slate-100);
        }

        .mobile-menu-links {
            display: grid;
            gap: 10px;
        }

        .mobile-menu-links a {
            min-height: 54px;
            padding: 0 16px;
            border-radius: 18px;
            display: flex;
            align-items: center;
            gap: 12px;
            color: var(--text-main);
            text-decoration: none;
            font-weight: 850;
            background: var(--slate-50);
            border: 1px solid rgba(148, 163, 184, 0.18);
        }

        .screen-overlay {
            position: fixed;
            inset: 0;
            z-index: 110;
            display: none;
            background: rgba(15, 23, 42, 0.48);
            backdrop-filter: blur(8px);
        }

        .screen-overlay.show {
            display: block;
            animation: fadeIn 0.25s ease both;
        }

        .booking-container {
            width: min(var(--container), calc(100% - 32px));
            margin: 0 auto;
            padding: 34px 0 80px;
        }

        .booking-hero {
            position: relative;
            min-height: 350px;
            padding: clamp(28px, 5vw, 58px);
            border-radius: var(--radius-2xl);
            overflow: hidden;
            color: white;
            background:
                linear-gradient(135deg, rgba(8, 145, 178, 0.96), rgba(20, 184, 166, 0.88)),
                url('https://images.unsplash.com/photo-1507525428034-b723cf961d3e?auto=format&fit=crop&w=1600&q=80');
            background-size: cover;
            background-position: center;
            box-shadow: var(--shadow-lg);
            isolation: isolate;
            animation: heroRise 0.8s var(--ease) both;
        }

        .booking-hero::before {
            content: "";
            position: absolute;
            inset: 0;
            z-index: -1;
            background:
                radial-gradient(circle at 18% 18%, rgba(255, 255, 255, 0.24), transparent 22%),
                linear-gradient(120deg, rgba(2, 6, 23, 0.20), transparent 58%);
        }

        .booking-hero::after {
            content: "";
            position: absolute;
            right: -120px;
            bottom: -150px;
            width: 430px;
            height: 430px;
            border-radius: var(--radius-full);
            background: rgba(255, 255, 255, 0.14);
            border: 1px solid rgba(255, 255, 255, 0.20);
            animation: heroOrb 8s ease-in-out infinite;
        }

        .hero-content {
            position: relative;
            z-index: 2;
            max-width: 760px;
        }

        .eyebrow {
            display: inline-flex;
            align-items: center;
            gap: 10px;
            min-height: 38px;
            padding: 0 15px;
            border-radius: var(--radius-full);
            color: rgba(255, 255, 255, 0.92);
            font-size: 0.72rem;
            font-weight: 900;
            letter-spacing: 0.16em;
            text-transform: uppercase;
            background: rgba(255, 255, 255, 0.14);
            border: 1px solid rgba(255, 255, 255, 0.20);
            backdrop-filter: blur(14px);
        }

        .booking-hero h1 {
            margin: 22px 0 14px;
            font-family: var(--font-display);
            font-size: clamp(2.2rem, 5.4vw, 4.6rem);
            line-height: 0.98;
            font-weight: 400;
            letter-spacing: -0.05em;
        }

        .booking-hero h1 span {
            color: var(--sand-200);
        }

        .hero-copy {
            max-width: 660px;
            margin: 0;
            color: rgba(255, 255, 255, 0.82);
            font-size: clamp(0.98rem, 1.8vw, 1.15rem);
            line-height: 1.8;
        }

        .hero-actions {
            display: flex;
            align-items: center;
            flex-wrap: wrap;
            gap: 14px;
            margin-top: 30px;
        }

        .hero-btn {
            min-height: 54px;
            padding: 0 22px;
            border: 0;
            border-radius: var(--radius-full);
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 10px;
            color: var(--slate-950);
            text-decoration: none;
            font-size: 0.82rem;
            font-weight: 950;
            letter-spacing: 0.08em;
            text-transform: uppercase;
            background: white;
            box-shadow: 0 18px 38px rgba(2, 6, 23, 0.20);
            transition:
                transform 0.25s var(--ease),
                box-shadow 0.25s var(--ease),
                background 0.25s var(--ease);
        }

        .hero-btn:hover {
            transform: translateY(-3px);
            box-shadow: 0 24px 52px rgba(2, 6, 23, 0.26);
        }

        .hero-btn.ghost {
            color: white;
            background: rgba(255, 255, 255, 0.14);
            border: 1px solid rgba(255, 255, 255, 0.25);
            backdrop-filter: blur(14px);
        }

        .booking-progress {
            position: relative;
            z-index: 4;
            display: grid;
            grid-template-columns: repeat(4, minmax(0, 1fr));
            gap: 16px;
            margin: -38px auto 44px;
            padding: 0 clamp(18px, 4vw, 42px);
        }

        .progress-card {
            min-height: 112px;
            padding: 20px;
            border-radius: 28px;
            background: rgba(255, 255, 255, 0.88);
            border: 1px solid rgba(255, 255, 255, 0.82);
            box-shadow: var(--shadow-md);
            backdrop-filter: blur(18px);
            display: flex;
            align-items: center;
            gap: 15px;
            overflow: hidden;
            position: relative;
            transition:
                transform 0.28s var(--ease),
                box-shadow 0.28s var(--ease);
            animation: statPop 0.7s var(--ease-bounce) both;
        }

        .progress-card:nth-child(1) {
            animation-delay: 0.15s;
        }

        .progress-card:nth-child(2) {
            animation-delay: 0.23s;
        }

        .progress-card:nth-child(3) {
            animation-delay: 0.31s;
        }

        .progress-card:nth-child(4) {
            animation-delay: 0.39s;
        }

        .progress-card:hover {
            transform: translateY(-6px);
            box-shadow: var(--shadow-lg);
        }

        .progress-card::after {
            content: "";
            position: absolute;
            right: -40px;
            top: -40px;
            width: 110px;
            height: 110px;
            border-radius: var(--radius-full);
            background: rgba(6, 182, 212, 0.10);
        }

        .progress-icon {
            width: 52px;
            height: 52px;
            min-width: 52px;
            border-radius: 19px;
            display: grid;
            place-items: center;
            color: white;
            background: linear-gradient(135deg, var(--ocean-500), var(--sea-500));
            box-shadow: 0 16px 34px rgba(8, 145, 178, 0.22);
        }

        .progress-copy {
            min-width: 0;
        }

        .progress-copy strong {
            display: block;
            color: var(--text-main);
            font-size: 0.95rem;
            font-weight: 950;
            line-height: 1.25;
        }

        .progress-copy span {
            display: block;
            margin-top: 7px;
            color: var(--text-muted);
            font-size: 0.70rem;
            font-weight: 850;
            letter-spacing: 0.08em;
            text-transform: uppercase;
        }

        .booking-card {
            position: relative;
            display: grid;
            grid-template-columns: minmax(0, 1.08fr) minmax(360px, 0.92fr);
            gap: 0;
            border-radius: var(--radius-2xl);
            overflow: hidden;
            background: rgba(255, 255, 255, 0.88);
            border: 1px solid rgba(255, 255, 255, 0.86);
            box-shadow: var(--shadow-xl);
            backdrop-filter: blur(20px);
            animation: cardRise 0.85s var(--ease) both;
        }

        .booking-card::before {
            content: "";
            position: absolute;
            inset: 0;
            z-index: 0;
            pointer-events: none;
            background:
                radial-gradient(circle at 0% 0%, rgba(6, 182, 212, 0.10), transparent 28%),
                radial-gradient(circle at 100% 100%, rgba(20, 184, 166, 0.12), transparent 28%);
        }

        .booking-main {
            position: relative;
            z-index: 1;
            min-width: 0;
            padding: clamp(24px, 4vw, 42px);
            background: rgba(255, 255, 255, 0.58);
        }

        .payment-section {
            position: relative;
            z-index: 1;
            padding: clamp(24px, 4vw, 42px);
            color: white;
            background:
                linear-gradient(160deg, rgba(15, 23, 42, 0.96), rgba(14, 116, 144, 0.96) 52%, rgba(15, 118, 110, 0.96));
            overflow: hidden;
        }

        .payment-section::before {
            content: "";
            position: absolute;
            top: -120px;
            right: -120px;
            width: 320px;
            height: 320px;
            border-radius: var(--radius-full);
            background: rgba(255, 255, 255, 0.12);
            animation: paymentOrb 8s ease-in-out infinite;
        }

        .payment-section::after {
            content: "";
            position: absolute;
            left: -120px;
            bottom: -140px;
            width: 310px;
            height: 310px;
            border-radius: var(--radius-full);
            background: rgba(34, 211, 238, 0.14);
        }

        .form-title-row {
            display: flex;
            align-items: flex-start;
            justify-content: space-between;
            gap: 18px;
            margin-bottom: 30px;
        }

        .form-kicker {
            display: inline-flex;
            align-items: center;
            gap: 9px;
            color: var(--ocean-700);
            font-size: 0.72rem;
            font-weight: 950;
            letter-spacing: 0.15em;
            text-transform: uppercase;
            margin-bottom: 10px;
        }

        .form-title-row h2 {
            margin: 0;
            color: var(--text-main);
            font-family: var(--font-display);
            font-size: clamp(1.8rem, 3.5vw, 3rem);
            font-weight: 400;
            letter-spacing: -0.04em;
        }

        .form-title-row p {
            max-width: 520px;
            margin: 12px 0 0;
            color: var(--text-soft);
            line-height: 1.7;
            font-size: 0.94rem;
        }

        .security-chip {
            min-height: 44px;
            padding: 0 14px;
            border-radius: var(--radius-full);
            display: inline-flex;
            align-items: center;
            gap: 9px;
            color: var(--emerald-700);
            background: var(--emerald-50);
            border: 1px solid rgba(16, 185, 129, 0.18);
            font-size: 0.75rem;
            font-weight: 950;
            letter-spacing: 0.06em;
            text-transform: uppercase;
            white-space: nowrap;
        }

        .room-summary-card {
            display: grid;
            grid-template-columns: 126px minmax(0, 1fr);
            gap: 18px;
            padding: 18px;
            border-radius: 28px;
            margin-bottom: 30px;
            background: rgba(248, 250, 252, 0.84);
            border: 1px solid rgba(148, 163, 184, 0.18);
            box-shadow: var(--shadow-xs);
        }

        .room-preview {
            min-height: 118px;
            border-radius: 22px;
            overflow: hidden;
            position: relative;
            background: linear-gradient(135deg, var(--ocean-100), var(--sea-100));
        }

        .room-preview img {
            width: 100%;
            height: 100%;
            min-height: 118px;
            object-fit: cover;
            transition: transform 0.5s var(--ease);
        }

        .room-summary-card:hover .room-preview img {
            transform: scale(1.08);
        }

        .room-preview::after {
            content: "";
            position: absolute;
            inset: 0;
            background: linear-gradient(to bottom, transparent, rgba(2, 6, 23, 0.24));
        }

        .room-summary-copy {
            min-width: 0;
            display: flex;
            flex-direction: column;
            justify-content: center;
        }

        .room-type {
            display: inline-flex;
            align-items: center;
            gap: 7px;
            color: var(--ocean-700);
            font-size: 0.70rem;
            font-weight: 950;
            letter-spacing: 0.12em;
            text-transform: uppercase;
            margin-bottom: 8px;
        }

        .room-summary-copy h3 {
            margin: 0;
            color: var(--text-main);
            font-family: var(--font-display);
            font-size: 1.65rem;
            font-weight: 400;
            letter-spacing: -0.03em;
            line-height: 1.15;
        }

        .room-meta-row {
            display: flex;
            flex-wrap: wrap;
            gap: 9px;
            margin-top: 14px;
        }

        .meta-pill {
            min-height: 34px;
            padding: 0 11px;
            border-radius: var(--radius-full);
            display: inline-flex;
            align-items: center;
            gap: 7px;
            color: var(--text-soft);
            background: white;
            border: 1px solid rgba(148, 163, 184, 0.16);
            font-size: 0.74rem;
            font-weight: 800;
        }

        .form-grid {
            display: grid;
            grid-template-columns: repeat(2, minmax(0, 1fr));
            gap: 18px;
        }

        .field-group {
            position: relative;
            min-width: 0;
        }

        .field-group.full {
            grid-column: 1 / -1;
        }

        .field-label {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 10px;
            margin-bottom: 8px;
            color: var(--ocean-700);
            font-size: 0.72rem;
            font-weight: 950;
            letter-spacing: 0.10em;
            text-transform: uppercase;
        }

        .field-label span {
            display: inline-flex;
            align-items: center;
            gap: 7px;
        }

        .field-label small {
            color: var(--text-muted);
            font-size: 0.66rem;
            font-weight: 800;
            letter-spacing: 0.06em;
        }

        .input-wrap {
            position: relative;
        }

        .input-icon {
            position: absolute;
            top: 50%;
            left: 16px;
            transform: translateY(-50%);
            width: 20px;
            display: grid;
            place-items: center;
            color: var(--ocean-600);
            pointer-events: none;
            transition:
                color 0.25s var(--ease),
                transform 0.25s var(--ease);
        }

        .textarea-wrap .input-icon {
            top: 20px;
            transform: none;
        }

        .input-control {
            width: 100%;
            min-height: 54px;
            padding: 14px 16px 14px 48px;
            border: 1px solid rgba(148, 163, 184, 0.24);
            border-radius: 18px;
            outline: none;
            color: var(--text-main);
            background: rgba(255, 255, 255, 0.86);
            box-shadow: 0 6px 16px rgba(15, 23, 42, 0.035);
            transition:
                border-color 0.25s var(--ease),
                box-shadow 0.25s var(--ease),
                background 0.25s var(--ease),
                transform 0.25s var(--ease);
        }

        .input-control::placeholder {
            color: var(--text-muted);
        }

        .input-control:focus {
            border-color: rgba(6, 182, 212, 0.55);
            background: white;
            box-shadow:
                0 0 0 4px rgba(6, 182, 212, 0.11),
                0 14px 30px rgba(15, 23, 42, 0.07);
            transform: translateY(-1px);
        }

        .input-control:focus + .focus-ring {
            opacity: 1;
        }

        .input-wrap:focus-within .input-icon {
            color: var(--sea-600);
            transform: translateY(-50%) scale(1.08);
        }

        .textarea-wrap:focus-within .input-icon {
            transform: scale(1.08);
        }

        textarea.input-control {
            min-height: 124px;
            resize: vertical;
            line-height: 1.6;
        }

        input[readonly].input-control {
            color: var(--slate-700);
            background:
                linear-gradient(135deg, rgba(236, 253, 245, 0.96), rgba(236, 254, 255, 0.96));
            border-color: rgba(20, 184, 166, 0.24);
            font-weight: 950;
        }

        .helper-text {
            display: flex;
            align-items: flex-start;
            gap: 8px;
            margin-top: 8px;
            color: var(--text-muted);
            font-size: 0.76rem;
            line-height: 1.5;
        }

        .helper-text i {
            color: var(--ocean-600);
            margin-top: 2px;
        }

        .date-warning {
            display: none;
            margin-top: 8px;
            color: var(--rose-700);
            font-size: 0.76rem;
            font-weight: 800;
            line-height: 1.45;
        }

        .date-warning.show {
            display: flex;
            align-items: center;
            gap: 8px;
            animation: fadeIn 0.25s ease both;
        }

        .price-breakdown {
            margin-top: 26px;
            padding: 20px;
            border-radius: 26px;
            background:
                linear-gradient(135deg, rgba(236, 254, 255, 0.78), rgba(240, 253, 250, 0.78));
            border: 1px solid rgba(6, 182, 212, 0.16);
        }

        .breakdown-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            gap: 14px;
            margin-bottom: 14px;
        }

        .breakdown-header h3 {
            margin: 0;
            color: var(--text-main);
            font-size: 0.95rem;
            font-weight: 950;
        }

        .breakdown-tag {
            min-height: 34px;
            padding: 0 11px;
            border-radius: var(--radius-full);
            display: inline-flex;
            align-items: center;
            gap: 7px;
            color: var(--ocean-700);
            background: white;
            font-size: 0.68rem;
            font-weight: 950;
            letter-spacing: 0.08em;
            text-transform: uppercase;
        }

        .price-row {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 12px;
            padding: 11px 0;
            border-bottom: 1px solid rgba(148, 163, 184, 0.18);
            color: var(--text-soft);
            font-size: 0.9rem;
        }

        .price-row:last-child {
            border-bottom: 0;
        }

        .price-row strong {
            color: var(--text-main);
            font-weight: 950;
        }

        .price-row.total {
            margin-top: 4px;
            padding-top: 15px;
            color: var(--text-main);
            font-size: 1.08rem;
            font-weight: 950;
        }

        .price-row.total strong {
            color: var(--ocean-700);
            font-size: 1.35rem;
        }

        .payment-inner {
            position: relative;
            z-index: 2;
            height: 100%;
            display: flex;
            flex-direction: column;
        }

        .payment-kicker {
            display: inline-flex;
            width: fit-content;
            align-items: center;
            gap: 9px;
            min-height: 38px;
            padding: 0 14px;
            border-radius: var(--radius-full);
            color: rgba(255, 255, 255, 0.92);
            font-size: 0.70rem;
            font-weight: 950;
            letter-spacing: 0.14em;
            text-transform: uppercase;
            background: rgba(255, 255, 255, 0.12);
            border: 1px solid rgba(255, 255, 255, 0.18);
            backdrop-filter: blur(12px);
        }

        .payment-title {
            margin: 22px 0 10px;
            color: white;
            font-family: var(--font-display);
            font-size: clamp(1.8rem, 3vw, 2.6rem);
            font-weight: 400;
            letter-spacing: -0.04em;
        }

        .payment-copy {
            margin: 0;
            color: rgba(226, 232, 240, 0.78);
            line-height: 1.75;
            font-size: 0.92rem;
        }

        .qr-stage {
            position: relative;
            margin: 28px auto 22px;
            width: min(280px, 100%);
            padding: 18px;
            border-radius: 32px;
            background: rgba(255, 255, 255, 0.13);
            border: 1px solid rgba(255, 255, 255, 0.20);
            box-shadow:
                inset 0 1px 0 rgba(255, 255, 255, 0.12),
                0 24px 60px rgba(2, 6, 23, 0.24);
            backdrop-filter: blur(18px);
            animation: qrFloat 4s ease-in-out infinite;
        }

        .qr-stage::before {
            content: "";
            position: absolute;
            inset: -8px;
            z-index: -1;
            border-radius: 38px;
            border: 1px solid rgba(103, 232, 249, 0.24);
        }

        .qr-code {
            position: relative;
            width: 100%;
            aspect-ratio: 1 / 1;
            padding: 12px;
            border-radius: 24px;
            background: white;
            box-shadow: 0 18px 40px rgba(2, 6, 23, 0.24);
            overflow: hidden;
        }

        .qr-code img {
            width: 100%;
            height: 100%;
            object-fit: contain;
            border-radius: 16px;
        }

        .qr-corners span {
            position: absolute;
            width: 28px;
            height: 28px;
            border-color: var(--ocean-500);
            border-style: solid;
        }

        .qr-corners span:nth-child(1) {
            top: 10px;
            left: 10px;
            border-width: 3px 0 0 3px;
            border-radius: 10px 0 0 0;
        }

        .qr-corners span:nth-child(2) {
            top: 10px;
            right: 10px;
            border-width: 3px 3px 0 0;
            border-radius: 0 10px 0 0;
        }

        .qr-corners span:nth-child(3) {
            bottom: 10px;
            left: 10px;
            border-width: 0 0 3px 3px;
            border-radius: 0 0 0 10px;
        }

        .qr-corners span:nth-child(4) {
            bottom: 10px;
            right: 10px;
            border-width: 0 3px 3px 0;
            border-radius: 0 0 10px 0;
        }

        .payment-note {
            display: flex;
            align-items: flex-start;
            gap: 12px;
            padding: 16px;
            border-radius: 22px;
            color: rgba(255, 255, 255, 0.84);
            background: rgba(255, 255, 255, 0.10);
            border: 1px solid rgba(255, 255, 255, 0.16);
            font-size: 0.82rem;
            line-height: 1.6;
        }

        .payment-note i {
            color: var(--sand-300);
            margin-top: 2px;
        }

        .payment-details {
            display: grid;
            gap: 10px;
            margin: 18px 0;
        }

        .payment-detail-row {
            min-height: 48px;
            padding: 0 14px;
            border-radius: 18px;
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 14px;
            color: rgba(226, 232, 240, 0.86);
            background: rgba(255, 255, 255, 0.10);
            border: 1px solid rgba(255, 255, 255, 0.14);
        }

        .payment-detail-row span {
            display: inline-flex;
            align-items: center;
            gap: 9px;
            font-size: 0.78rem;
            font-weight: 850;
            letter-spacing: 0.04em;
            text-transform: uppercase;
        }

        .payment-detail-row strong {
            color: white;
            font-size: 0.88rem;
            text-align: right;
        }

        .submit-zone {
            margin-top: auto;
            padding-top: 24px;
        }

        .btn-submit {
            width: 100%;
            min-height: 58px;
            border: 0;
            border-radius: 20px;
            padding: 0 20px;
            cursor: pointer;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 11px;
            color: var(--slate-950);
            background: linear-gradient(135deg, #ffffff, #ecfeff);
            box-shadow:
                0 18px 42px rgba(2, 6, 23, 0.24),
                inset 0 1px 0 rgba(255, 255, 255, 0.84);
            font-size: 0.84rem;
            font-weight: 950;
            letter-spacing: 0.12em;
            text-transform: uppercase;
            transition:
                transform 0.25s var(--ease),
                box-shadow 0.25s var(--ease),
                filter 0.25s var(--ease);
        }

        .btn-submit:hover {
            transform: translateY(-3px);
            box-shadow:
                0 26px 56px rgba(2, 6, 23, 0.30),
                inset 0 1px 0 rgba(255, 255, 255, 0.84);
            filter: brightness(1.03);
        }

        .btn-submit:active {
            transform: translateY(-1px);
        }

        .btn-submit:disabled {
            opacity: 0.64;
            cursor: not-allowed;
            transform: none;
        }

        .submit-helper {
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
            margin-top: 13px;
            color: rgba(226, 232, 240, 0.72);
            font-size: 0.76rem;
            text-align: center;
        }

        .trust-grid {
            display: grid;
            grid-template-columns: repeat(3, minmax(0, 1fr));
            gap: 12px;
            margin-top: 28px;
        }

        .trust-item {
            padding: 14px;
            border-radius: 20px;
            text-align: center;
            color: rgba(255, 255, 255, 0.86);
            background: rgba(255, 255, 255, 0.10);
            border: 1px solid rgba(255, 255, 255, 0.14);
        }

        .trust-item i {
            display: block;
            margin-bottom: 8px;
            color: var(--sand-300);
            font-size: 1rem;
        }

        .trust-item span {
            display: block;
            font-size: 0.66rem;
            font-weight: 900;
            letter-spacing: 0.08em;
            line-height: 1.35;
            text-transform: uppercase;
        }

        .info-strip {
            display: grid;
            grid-template-columns: repeat(3, minmax(0, 1fr));
            gap: 16px;
            margin-top: 42px;
        }

        .info-card {
            padding: 22px;
            border-radius: 28px;
            background: rgba(255, 255, 255, 0.84);
            border: 1px solid rgba(255, 255, 255, 0.82);
            box-shadow: var(--shadow-sm);
            backdrop-filter: blur(18px);
            transition:
                transform 0.28s var(--ease),
                box-shadow 0.28s var(--ease);
        }

        .info-card:hover {
            transform: translateY(-6px);
            box-shadow: var(--shadow-md);
        }

        .info-icon {
            width: 48px;
            height: 48px;
            border-radius: 18px;
            display: grid;
            place-items: center;
            color: white;
            background: linear-gradient(135deg, var(--ocean-500), var(--sea-500));
            box-shadow: 0 14px 32px rgba(8, 145, 178, 0.20);
            margin-bottom: 15px;
        }

        .info-card h3 {
            margin: 0 0 8px;
            color: var(--text-main);
            font-size: 1rem;
            font-weight: 950;
        }

        .info-card p {
            margin: 0;
            color: var(--text-soft);
            font-size: 0.86rem;
            line-height: 1.7;
        }

        .footer-wave {
            position: relative;
            margin-top: 42px;
            padding: 28px;
            border-radius: 34px;
            color: white;
            overflow: hidden;
            background:
                linear-gradient(135deg, var(--slate-950), var(--ocean-900) 52%, var(--sea-800));
            box-shadow: var(--shadow-lg);
        }

        .footer-wave::before {
            content: "";
            position: absolute;
            width: 280px;
            height: 280px;
            right: -120px;
            top: -150px;
            border-radius: var(--radius-full);
            background: rgba(255, 255, 255, 0.12);
        }

        .footer-wave-content {
            position: relative;
            display: flex;
            justify-content: space-between;
            align-items: center;
            gap: 24px;
        }

        .footer-wave h3 {
            margin: 0 0 8px;
            font-family: var(--font-display);
            font-size: 1.8rem;
            font-weight: 400;
        }

        .footer-wave p {
            margin: 0;
            color: rgba(226, 232, 240, 0.76);
            line-height: 1.7;
        }

        .floating-top {
            position: fixed;
            right: 24px;
            bottom: 24px;
            z-index: 80;
            width: 56px;
            height: 56px;
            border: 0;
            border-radius: 20px;
            display: grid;
            place-items: center;
            cursor: pointer;
            color: white;
            background: linear-gradient(135deg, var(--ocean-600), var(--sea-500));
            box-shadow:
                0 22px 48px rgba(8, 145, 178, 0.28),
                0 0 0 8px rgba(6, 182, 212, 0.10);
            transform: translateY(90px);
            opacity: 0;
            transition:
                transform 0.3s var(--ease),
                opacity 0.3s var(--ease);
        }

        .floating-top.show {
            transform: translateY(0);
            opacity: 1;
        }

        .floating-top:hover {
            transform: translateY(-5px);
        }

        .toast {
            position: fixed;
            left: 50%;
            bottom: 28px;
            z-index: 200;
            min-width: min(380px, calc(100% - 32px));
            padding: 15px 16px;
            border-radius: 20px;
            display: flex;
            align-items: center;
            gap: 12px;
            color: white;
            background: rgba(15, 23, 42, 0.92);
            border: 1px solid rgba(255, 255, 255, 0.12);
            box-shadow: var(--shadow-lg);
            backdrop-filter: blur(18px);
            transform: translate(-50%, 30px);
            opacity: 0;
            pointer-events: none;
            transition:
                transform 0.28s var(--ease),
                opacity 0.28s var(--ease);
        }

        .toast.show {
            transform: translate(-50%, 0);
            opacity: 1;
        }

        .toast i {
            color: var(--sand-300);
        }

        @keyframes shineSweep {
            0% {
                transform: translateX(-120%) rotate(20deg);
            }

            45%,
            100% {
                transform: translateX(130%) rotate(20deg);
            }
        }

        @keyframes heroRise {
            from {
                opacity: 0;
                transform: translateY(26px) scale(0.985);
            }

            to {
                opacity: 1;
                transform: translateY(0) scale(1);
            }
        }

        @keyframes heroOrb {
            0%,
            100% {
                transform: translate(0, 0) scale(1);
            }

            50% {
                transform: translate(-28px, -16px) scale(1.05);
            }
        }

        @keyframes statPop {
            from {
                opacity: 0;
                transform: translateY(18px) scale(0.96);
            }

            to {
                opacity: 1;
                transform: translateY(0) scale(1);
            }
        }

        @keyframes cardRise {
            from {
                opacity: 0;
                transform: translateY(30px) scale(0.985);
            }

            to {
                opacity: 1;
                transform: translateY(0) scale(1);
            }
        }

        @keyframes paymentOrb {
            0%,
            100% {
                transform: translate(0, 0) scale(1);
            }

            50% {
                transform: translate(-20px, 20px) scale(1.06);
            }
        }

        @keyframes qrFloat {
            0%,
            100% {
                transform: translateY(0);
            }

            50% {
                transform: translateY(-8px);
            }
        }

        @keyframes fadeIn {
            from {
                opacity: 0;
            }

            to {
                opacity: 1;
            }
        }

        @media (max-width: 1120px) {
            .booking-card {
                grid-template-columns: 1fr;
            }

            .payment-section {
                min-height: auto;
            }

            .payment-inner {
                min-height: auto;
            }

            .booking-progress {
                grid-template-columns: repeat(2, minmax(0, 1fr));
                margin-top: 20px;
                padding: 0;
            }

            .info-strip {
                grid-template-columns: repeat(2, minmax(0, 1fr));
            }
        }

        @media (max-width: 860px) {
            :root {
                --nav-height: 74px;
            }

            .dash-nav {
                padding: 14px 16px;
            }

            .nav-links {
                display: none;
            }

            .menu-toggle {
                display: grid;
            }

            .booking-container {
                width: min(100% - 24px, var(--container));
                padding-top: 22px;
            }

            .booking-hero {
                min-height: auto;
                padding: 28px;
                border-radius: 32px;
            }

            .booking-progress {
                grid-template-columns: 1fr;
            }

            .form-title-row {
                align-items: flex-start;
                flex-direction: column;
            }

            .room-summary-card {
                grid-template-columns: 1fr;
            }

            .room-preview {
                min-height: 210px;
            }

            .form-grid {
                grid-template-columns: 1fr;
            }

            .info-strip {
                grid-template-columns: 1fr;
            }

            .footer-wave-content {
                align-items: flex-start;
                flex-direction: column;
            }
        }

        @media (max-width: 680px) {
            .hero-actions {
                align-items: stretch;
                flex-direction: column;
            }

            .hero-btn {
                width: 100%;
            }

            .booking-hero h1 {
                font-size: clamp(2.15rem, 12vw, 3.6rem);
            }

            .booking-main,
            .payment-section {
                padding: 22px;
            }

            .booking-card {
                border-radius: 30px;
            }

            .trust-grid {
                grid-template-columns: 1fr;
            }

            .qr-stage {
                width: min(260px, 100%);
            }
        }

        @media (max-width: 480px) {
            .logo-text {
                display: none;
            }

            .booking-hero {
                padding: 22px;
                border-radius: 26px;
            }

            .eyebrow {
                font-size: 0.62rem;
                letter-spacing: 0.10em;
            }

            .hero-copy {
                font-size: 0.92rem;
            }

            .progress-card {
                min-height: 96px;
                border-radius: 24px;
            }

            .form-title-row h2 {
                font-size: 1.8rem;
            }

            .room-summary-copy h3 {
                font-size: 1.45rem;
            }

            .footer-wave {
                padding: 22px;
            }

            .floating-top {
                right: 16px;
                bottom: 16px;
            }

            .toast {
                bottom: 16px;
            }
        }

        @media print {
            body {
                background: white;
            }

            .dash-nav,
            .mobile-menu,
            .screen-overlay,
            .floating-top,
            .ambient-bg,
            .floating-shape,
            .page-noise,
            .footer-wave,
            .info-strip {
                display: none !important;
            }

            .booking-container {
                width: 100%;
                padding: 0;
            }

            .booking-hero {
                box-shadow: none;
                color: var(--text-main);
                background: white;
                min-height: auto;
                padding: 0 0 18px;
                border-radius: 0;
            }

            .booking-hero::before,
            .booking-hero::after,
            .booking-progress {
                display: none;
            }

            .booking-card {
                box-shadow: none;
                border: 1px solid #ddd;
            }

            .payment-section {
                color: var(--text-main);
                background: white;
            }

            .payment-copy,
            .payment-note,
            .submit-helper {
                color: var(--text-soft);
            }

            .btn-submit {
                display: none;
            }
        }

        @media (prefers-reduced-motion: reduce) {
            *,
            *::before,
            *::after {
                animation-duration: 0.01ms !important;
                animation-iteration-count: 1 !important;
                scroll-behavior: auto !important;
                transition-duration: 0.01ms !important;
            }
        }
    </style>
</head>

<body>
