<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">

    <meta 
        name="viewport" 
        content="width=device-width, initial-scale=1.0"
    >

    <meta 
        name="theme-color" 
        content="#0891b2"
    >

    <title>My Sanctuary | Dang's Beach Resort</title>

    <!-- Google Fonts -->
    <link 
        href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&family=Tenor+Sans&display=swap" 
        rel="stylesheet"
    >

    <!-- Font Awesome Icons -->
    <link 
        rel="stylesheet" 
        href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css"
    >

    <style>
        :root {
            --font-main: 'Inter', sans-serif;
            --font-display: 'Tenor Sans', serif;

            --ocean-50: #ecfeff;
            --ocean-100: #cffafe;
            --ocean-200: #a5f3fc;
            --ocean-300: #67e8f9;
            --ocean-400: #22d3ee;
            --ocean-500: #06b6d4;
            --ocean-600: #0891b2;
            --ocean-700: #0e7490;
            --ocean-800: #155e75;
            --ocean-900: #164e63;

            --sea-50: #f0fdfa;
            --sea-100: #ccfbf1;
            --sea-200: #99f6e4;
            --sea-300: #5eead4;
            --sea-400: #2dd4bf;
            --sea-500: #14b8a6;
            --sea-600: #0d9488;
            --sea-700: #0f766e;
            --sea-800: #115e59;
            --sea-900: #134e4a;

            --sand-50: #fffaf0;
            --sand-100: #fef3c7;
            --sand-200: #fde68a;
            --sand-300: #fcd34d;
            --sand-400: #fbbf24;
            --sand-500: #f59e0b;
            --sand-600: #d97706;
            --sand-700: #b45309;
            --sand-800: #92400e;
            --sand-900: #78350f;

            --rose-50: #fff1f2;
            --rose-100: #ffe4e6;
            --rose-500: #f43f5e;
            --rose-600: #e11d48;
            --rose-700: #be123c;

            --emerald-50: #ecfdf5;
            --emerald-100: #d1fae5;
            --emerald-500: #10b981;
            --emerald-600: #059669;
            --emerald-700: #047857;

            --slate-50: #f8fafc;
            --slate-100: #f1f5f9;
            --slate-200: #e2e8f0;
            --slate-300: #cbd5e1;
            --slate-400: #94a3b8;
            --slate-500: #64748b;
            --slate-600: #475569;
            --slate-700: #334155;
            --slate-800: #1e293b;
            --slate-900: #0f172a;
            --slate-950: #020617;

            --white: #ffffff;
            --black: #000000;

            --page-bg: #f8fcff;
            --surface: rgba(255, 255, 255, 0.84);
            --surface-solid: #ffffff;
            --surface-muted: rgba(248, 250, 252, 0.74);
            --border: rgba(148, 163, 184, 0.22);
            --border-strong: rgba(148, 163, 184, 0.40);

            --text-main: #0f172a;
            --text-soft: #475569;
            --text-muted: #94a3b8;
            --text-white: #f8fafc;

            --shadow-xs: 0 4px 12px rgba(15, 23, 42, 0.06);
            --shadow-sm: 0 10px 28px rgba(15, 23, 42, 0.08);
            --shadow-md: 0 18px 42px rgba(15, 23, 42, 0.10);
            --shadow-lg: 0 30px 80px rgba(15, 23, 42, 0.16);
            --shadow-ocean: 0 24px 56px rgba(8, 145, 178, 0.24);
            --shadow-teal: 0 24px 56px rgba(20, 184, 166, 0.22);

            --radius-xs: 8px;
            --radius-sm: 12px;
            --radius-md: 18px;
            --radius-lg: 24px;
            --radius-xl: 32px;
            --radius-2xl: 42px;
            --radius-full: 999px;

            --ease: cubic-bezier(0.22, 1, 0.36, 1);
            --ease-bounce: cubic-bezier(0.34, 1.56, 0.64, 1);

            --nav-height: 84px;
            --container: 1220px;
        }

        * {
            box-sizing: border-box;
        }

        *::before,
        *::after {
            box-sizing: border-box;
        }

        html {
            width: 100%;
            min-height: 100%;
            scroll-behavior: smooth;
        }

        body {
            width: 100%;
            min-height: 100vh;
            margin: 0;
            color: var(--text-main);
            font-family: var(--font-main);
            background:
                radial-gradient(circle at 6% 8%, rgba(103, 232, 249, 0.34), transparent 28%),
                radial-gradient(circle at 94% 12%, rgba(45, 212, 191, 0.28), transparent 30%),
                radial-gradient(circle at 52% 100%, rgba(251, 191, 36, 0.16), transparent 36%),
                linear-gradient(135deg, #f8fcff 0%, #ecfeff 38%, #f0fdfa 100%);
            overflow-x: hidden;
        }

        body.mobile-open {
            overflow: hidden;
        }

        a {
            color: inherit;
        }

        button,
        input,
        select,
        textarea {
            font: inherit;
        }

        button {
            -webkit-tap-highlight-color: transparent;
        }

        img {
            max-width: 100%;
            display: block;
        }

        ::selection {
            background: rgba(6, 182, 212, 0.22);
            color: var(--slate-950);
        }

        ::-webkit-scrollbar {
            width: 10px;
            height: 10px;
        }

        ::-webkit-scrollbar-track {
            background: rgba(226, 232, 240, 0.5);
        }

        ::-webkit-scrollbar-thumb {
            background: linear-gradient(180deg, var(--ocean-500), var(--sea-500));
            border-radius: var(--radius-full);
        }

        ::-webkit-scrollbar-thumb:hover {
            background: linear-gradient(180deg, var(--ocean-600), var(--sea-600));
        }

        .page-shell {
            position: relative;
            min-height: 100vh;
            isolation: isolate;
            overflow: hidden;
        }

        .ambient-bg {
            position: fixed;
            inset: 0;
            z-index: -5;
            pointer-events: none;
            overflow: hidden;
        }

        .ambient-bg::before {
            content: "";
            position: absolute;
            inset: 0;
            background-image:
                linear-gradient(rgba(8, 145, 178, 0.045) 1px, transparent 1px),
                linear-gradient(90deg, rgba(8, 145, 178, 0.045) 1px, transparent 1px);
            background-size: 44px 44px;
            mask-image: linear-gradient(to bottom, black 0%, transparent 84%);
        }

        .glow-orb {
            position: absolute;
            width: 420px;
            height: 420px;
            border-radius: var(--radius-full);
            filter: blur(26px);
            opacity: 0.42;
            animation: orbDrift 16s var(--ease) infinite alternate;
        }

        .glow-orb.orb-one {
            top: -140px;
            left: -110px;
            background: rgba(34, 211, 238, 0.48);
        }

        .glow-orb.orb-two {
            top: 120px;
            right: -160px;
            background: rgba(20, 184, 166, 0.42);
            animation-delay: -5s;
        }

        .glow-orb.orb-three {
            width: 500px;
            height: 500px;
            left: 35%;
            bottom: -260px;
            background: rgba(251, 191, 36, 0.20);
            animation-delay: -9s;
        }

        .floating-shape {
            position: fixed;
            z-index: -3;
            pointer-events: none;
            border-radius: var(--radius-full);
            border: 1px solid rgba(14, 116, 144, 0.12);
            background: rgba(255, 255, 255, 0.28);
            backdrop-filter: blur(10px);
            animation: shapeFloat 10s ease-in-out infinite;
        }

        .floating-shape.shape-one {
            width: 74px;
            height: 74px;
            left: 8%;
            top: 34%;
        }

        .floating-shape.shape-two {
            width: 46px;
            height: 46px;
            right: 12%;
            top: 46%;
            animation-delay: -3s;
        }

        .floating-shape.shape-three {
            width: 96px;
            height: 96px;
            right: 20%;
            bottom: 12%;
            animation-delay: -6s;
        }

        .page-noise {
            position: fixed;
            inset: 0;
            z-index: -2;
            opacity: 0.05;
            pointer-events: none;
            background-image:
                radial-gradient(circle at 25% 25%, #000 1px, transparent 1px),
                radial-gradient(circle at 75% 75%, #000 1px, transparent 1px);
            background-size: 24px 24px;
        }

        @keyframes orbDrift {
            0% {
                transform: translate3d(0, 0, 0) scale(1);
            }

            50% {
                transform: translate3d(44px, 30px, 0) scale(1.08);
            }

            100% {
                transform: translate3d(-28px, 60px, 0) scale(0.95);
            }
        }

        @keyframes shapeFloat {
            0%,
            100% {
                transform: translateY(0) rotate(0deg);
            }

            50% {
                transform: translateY(-22px) rotate(8deg);
            }
        }

        .dash-nav {
            position: sticky;
            top: 0;
            z-index: 100;
            min-height: var(--nav-height);
            padding: 16px clamp(16px, 5vw, 64px);
            display: flex;
            align-items: center;
            justify-content: center;
            background: rgba(255, 255, 255, 0.74);
            border-bottom: 1px solid rgba(148, 163, 184, 0.18);
            backdrop-filter: blur(22px);
            box-shadow: 0 12px 36px rgba(15, 23, 42, 0.06);
        }

        .nav-inner {
            width: min(var(--container), 100%);
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 22px;
        }

        .logo {
            display: inline-flex;
            align-items: center;
            gap: 12px;
            color: var(--slate-950);
            text-decoration: none;
            letter-spacing: 0.08em;
            text-transform: uppercase;
            font-family: var(--font-display);
            font-size: 1.25rem;
            font-weight: 400;
            white-space: nowrap;
        }

        .logo-icon {
            width: 46px;
            height: 46px;
            border-radius: 17px;
            color: white;
            display: grid;
            place-items: center;
            background:
                radial-gradient(circle at 30% 25%, rgba(255, 255, 255, 0.46), transparent 24%),
                linear-gradient(135deg, var(--ocean-500), var(--sea-500));
            box-shadow: var(--shadow-ocean);
            position: relative;
            overflow: hidden;
        }

        .logo-icon::after {
            content: "";
            position: absolute;
            inset: -50%;
            background: linear-gradient(120deg, transparent, rgba(255, 255, 255, 0.35), transparent);
            transform: translateX(-120%) rotate(20deg);
            animation: shineSweep 4.8s ease-in-out infinite;
        }

        .logo span {
            color: var(--ocean-600);
        }

        .nav-links {
            display: flex;
            align-items: center;
            gap: 10px;
        }

        .nav-link {
            min-height: 44px;
            padding: 0 16px;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 9px;
            border-radius: var(--radius-full);
            color: var(--text-soft);
            text-decoration: none;
            font-size: 0.78rem;
            font-weight: 850;
            letter-spacing: 0.06em;
            text-transform: uppercase;
            transition:
                transform 0.25s var(--ease),
                color 0.25s var(--ease),
                background 0.25s var(--ease),
                box-shadow 0.25s var(--ease);
        }

        .nav-link:hover {
            transform: translateY(-2px);
            color: var(--ocean-700);
            background: rgba(6, 182, 212, 0.10);
        }

        .nav-link.primary {
            color: white;
            background: linear-gradient(135deg, var(--ocean-600), var(--sea-500));
            box-shadow: 0 14px 34px rgba(8, 145, 178, 0.22);
        }

        .nav-link.primary:hover {
            color: white;
            box-shadow: 0 18px 42px rgba(8, 145, 178, 0.30);
        }

        .menu-toggle {
            width: 46px;
            height: 46px;
            border: 0;
            border-radius: 16px;
            display: none;
            place-items: center;
            cursor: pointer;
            color: white;
            background: linear-gradient(135deg, var(--ocean-600), var(--sea-500));
            box-shadow: 0 12px 30px rgba(8, 145, 178, 0.24);
        }

        .mobile-menu {
            position: fixed;
            inset: 0 0 auto 0;
            z-index: 120;
            transform: translateY(-110%);
            transition: transform 0.38s var(--ease);
            padding: 16px;
            pointer-events: none;
        }

        .mobile-menu.show {
            transform: translateY(0);
            pointer-events: auto;
        }

        .mobile-menu-panel {
            border-radius: 28px;
            padding: 18px;
            background: rgba(255, 255, 255, 0.92);
            border: 1px solid rgba(148, 163, 184, 0.18);
            box-shadow: var(--shadow-lg);
            backdrop-filter: blur(24px);
        }

        .mobile-menu-head {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 12px;
            margin-bottom: 16px;
        }

        .mobile-close {
            width: 42px;
            height: 42px;
            border: 0;
            border-radius: 15px;
            display: grid;
            place-items: center;
            cursor: pointer;
            color: var(--slate-700);
            background: var(--slate-100);
        }

        .mobile-menu-links {
            display: grid;
            gap: 10px;
        }

        .mobile-menu-links a {
            min-height: 54px;
            padding: 0 16px;
            border-radius: 18px;
            display: flex;
            align-items: center;
            gap: 12px;
            color: var(--text-main);
            text-decoration: none;
            font-weight: 850;
            background: var(--slate-50);
            border: 1px solid rgba(148, 163, 184, 0.18);
        }

        .screen-overlay {
            position: fixed;
            inset: 0;
            z-index: 110;
            display: none;
            background: rgba(15, 23, 42, 0.48);
            backdrop-filter: blur(8px);
        }

        .screen-overlay.show {
            display: block;
            animation: fadeIn 0.25s ease both;
        }

        .container {
            width: min(var(--container), calc(100% - 32px));
            margin: 0 auto;
            padding: 34px 0 80px;
        }

        .welcome-hero {
            position: relative;
            min-height: 440px;
            padding: clamp(28px, 5vw, 58px);
            border-radius: var(--radius-2xl);
            overflow: hidden;
            color: white;
            background:
                linear-gradient(135deg, rgba(8, 145, 178, 0.96), rgba(20, 184, 166, 0.88)),
                url('https://images.unsplash.com/photo-1507525428034-b723cf961d3e?auto=format&fit=crop&w=1600&q=80');
            background-size: cover;
            background-position: center;
            box-shadow: var(--shadow-lg);
            isolation: isolate;
            animation: heroRise 0.8s var(--ease) both;
        }

        .welcome-hero::before {
            content: "";
            position: absolute;
            inset: 0;
            z-index: -1;
            background:
                radial-gradient(circle at 18% 18%, rgba(255, 255, 255, 0.24), transparent 22%),
                linear-gradient(120deg, rgba(2, 6, 23, 0.20), transparent 58%);
        }

        .welcome-hero::after {
            content: "";
            position: absolute;
            right: -120px;
            bottom: -150px;
            width: 430px;
            height: 430px;
            border-radius: var(--radius-full);
            background: rgba(255, 255, 255, 0.14);
            border: 1px solid rgba(255, 255, 255, 0.20);
            animation: heroOrb 8s ease-in-out infinite;
        }

        .hero-content {
            position: relative;
            z-index: 2;
            max-width: 740px;
        }

        .eyebrow {
            display: inline-flex;
            align-items: center;
            gap: 10px;
            min-height: 38px;
            padding: 0 15px;
            border-radius: var(--radius-full);
            color: rgba(255, 255, 255, 0.92);
            font-size: 0.72rem;
            font-weight: 900;
            letter-spacing: 0.16em;
            text-transform: uppercase;
            background: rgba(255, 255, 255, 0.14);
            border: 1px solid rgba(255, 255, 255, 0.20);
            backdrop-filter: blur(14px);
        }

        .welcome-hero h1 {
            margin: 22px 0 14px;
            font-family: var(--font-display);
            font-size: clamp(2.4rem, 6vw, 5rem);
            line-height: 0.98;
            font-weight: 400;
            letter-spacing: -0.05em;
        }

        .welcome-hero h1 span {
            color: var(--sand-200);
        }

        .hero-copy {
            max-width: 660px;
            margin: 0;
            color: rgba(255, 255, 255, 0.82);
            font-size: clamp(0.98rem, 1.8vw, 1.15rem);
            line-height: 1.8;
        }

        .hero-actions {
            display: flex;
            align-items: center;
            flex-wrap: wrap;
            gap: 14px;
            margin-top: 30px;
        }

        .hero-btn {
            min-height: 54px;
            padding: 0 22px;
            border: 0;
            border-radius: var(--radius-full);
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 10px;
            color: var(--slate-950);
            text-decoration: none;
            font-size: 0.82rem;
            font-weight: 950;
            letter-spacing: 0.08em;
            text-transform: uppercase;
            background: white;
            box-shadow: 0 18px 38px rgba(2, 6, 23, 0.20);
            transition:
                transform 0.25s var(--ease),
                box-shadow 0.25s var(--ease),
                background 0.25s var(--ease);
        }

        .hero-btn:hover {
            transform: translateY(-3px);
            box-shadow: 0 24px 52px rgba(2, 6, 23, 0.26);
        }

        .hero-btn.ghost {
            color: white;
            background: rgba(255, 255, 255, 0.14);
            border: 1px solid rgba(255, 255, 255, 0.25);
            backdrop-filter: blur(14px);
        }

        .hero-stats {
            position: relative;
            z-index: 2;
            display: grid;
            grid-template-columns: repeat(3, minmax(0, 1fr));
            gap: 14px;
            max-width: 720px;
            margin-top: 34px;
        }

        .mini-stat {
            padding: 17px;
            border-radius: 24px;
            background: rgba(255, 255, 255, 0.14);
            border: 1px solid rgba(255, 255, 255, 0.20);
            backdrop-filter: blur(16px);
            transform: translateY(10px);
            opacity: 0;
            animation: statPop 0.7s var(--ease-bounce) both;
        }

        .mini-stat:nth-child(1) {
            animation-delay: 0.20s;
        }

        .mini-stat:nth-child(2) {
            animation-delay: 0.30s;
        }

        .mini-stat:nth-child(3) {
            animation-delay: 0.40s;
        }

        .mini-stat i {
            color: var(--sand-200);
            margin-bottom: 10px;
        }

        .mini-stat strong {
            display: block;
            font-size: 1.7rem;
            font-weight: 950;
            line-height: 1;
        }

        .mini-stat span {
            display: block;
            margin-top: 6px;
            color: rgba(255, 255, 255, 0.74);
            font-size: 0.72rem;
            font-weight: 850;
            letter-spacing: 0.08em;
            text-transform: uppercase;
        }

        .quick-strip {
            position: relative;
            z-index: 3;
            display: grid;
            grid-template-columns: repeat(4, minmax(0, 1fr));
            gap: 16px;
            margin: -38px auto 44px;
            padding: 0 clamp(18px, 4vw, 42px);
        }

        .quick-card {
            min-height: 112px;
            padding: 20px;
            border-radius: 28px;
            background: rgba(255, 255, 255, 0.86);
            border: 1px solid rgba(255, 255, 255, 0.82);
            box-shadow: var(--shadow-md);
            backdrop-filter: blur(18px);
            display: flex;
            align-items: center;
            gap: 15px;
            overflow: hidden;
            position: relative;
            transition:
                transform 0.28s var(--ease),
                box-shadow 0.28s var(--ease);
        }

        .quick-card:hover {
            transform: translateY(-6px);
            box-shadow: var(--shadow-lg);
        }

        .quick-card::after {
            content: "";
            position: absolute;
            right: -40px;
            top: -40px;
            width: 110px;
            height: 110px;
            border-radius: var(--radius-full);
            background: rgba(6, 182, 212, 0.10);
        }

        .quick-icon {
            width: 52px;
            height: 52px;
            min-width: 52px;
            border-radius: 19px;
            display: grid;
            place-items: center;
            color: white;
            background: linear-gradient(135deg, var(--ocean-500), var(--sea-500));
            box-shadow: 0 16px 34px rgba(8, 145, 178, 0.22);
        }

        .quick-copy {
            min-width: 0;
        }

        .quick-copy strong {
            display: block;
            color: var(--text-main);
            font-size: 1.35rem;
            font-weight: 950;
            line-height: 1;
        }

        .quick-copy span {
            display: block;
            margin-top: 7px;
            color: var(--text-muted);
            font-size: 0.72rem;
            font-weight: 850;
            letter-spacing: 0.08em;
            text-transform: uppercase;
        }

        .section-block {
            margin-top: 64px;
            scroll-margin-top: 110px;
        }

        .section-header {
            display: flex;
            justify-content: space-between;
            align-items: flex-end;
            gap: 24px;
            margin-bottom: 24px;
        }

        .section-kicker {
            display: inline-flex;
            align-items: center;
            gap: 9px;
            color: var(--ocean-700);
            font-size: 0.72rem;
            font-weight: 950;
            letter-spacing: 0.15em;
            text-transform: uppercase;
            margin-bottom: 10px;
        }

        .section-header h2 {
            margin: 0;
            color: var(--text-main);
            font-family: var(--font-display);
            font-size: clamp(1.8rem, 3.5vw, 3rem);
            font-weight: 400;
            letter-spacing: -0.04em;
        }

        .section-header p {
            max-width: 420px;
            margin: 0;
            color: var(--text-soft);
            font-size: 0.94rem;
            line-height: 1.7;
            text-align: right;
        }

        .residence-grid {
            display: grid;
            grid-template-columns: repeat(3, minmax(0, 1fr));
            gap: 24px;
        }

        .residence-card {
            position: relative;
            min-width: 0;
            border-radius: 32px;
            overflow: hidden;
            background: var(--surface);
            border: 1px solid rgba(255, 255, 255, 0.86);
            box-shadow: var(--shadow-sm);
            backdrop-filter: blur(16px);
            transition:
                transform 0.35s var(--ease),
                box-shadow 0.35s var(--ease),
                border-color 0.35s var(--ease);
        }

        .residence-card:hover {
            transform: translateY(-10px);
            box-shadow: var(--shadow-lg);
            border-color: rgba(6, 182, 212, 0.28);
        }

        .residence-card.reveal {
            opacity: 0;
            transform: translateY(24px);
        }

        .residence-card.reveal.visible {
            animation: cardReveal 0.7s var(--ease) both;
        }

        .res-img-wrap {
            position: relative;
            height: 238px;
            overflow: hidden;
            background: linear-gradient(135deg, var(--ocean-100), var(--sea-100));
        }

        .res-img {
            width: 100%;
            height: 100%;
            object-fit: cover;
            transition:
                transform 0.55s var(--ease),
                filter 0.55s var(--ease);
        }

        .residence-card:hover .res-img {
            transform: scale(1.08);
            filter: saturate(1.12);
        }

        .res-img-overlay {
            position: absolute;
            inset: 0;
            background:
                linear-gradient(to bottom, rgba(2, 6, 23, 0.06), rgba(2, 6, 23, 0.48));
        }

        .res-floating-badge {
            position: absolute;
            top: 16px;
            left: 16px;
            min-height: 36px;
            padding: 0 13px;
            border-radius: var(--radius-full);
            display: inline-flex;
            align-items: center;
            gap: 8px;
            color: white;
            font-size: 0.70rem;
            font-weight: 950;
            letter-spacing: 0.08em;
            text-transform: uppercase;
            background: rgba(15, 23, 42, 0.54);
            border: 1px solid rgba(255, 255, 255, 0.22);
            backdrop-filter: blur(14px);
        }

        .res-price-chip {
            position: absolute;
            right: 16px;
            bottom: 16px;
            padding: 10px 14px;
            border-radius: 16px;
            color: var(--slate-950);
            background: rgba(255, 255, 255, 0.90);
            box-shadow: 0 14px 30px rgba(15, 23, 42, 0.18);
            backdrop-filter: blur(14px);
        }

        .res-price-chip strong {
            display: block;
            font-size: 1.05rem;
            font-weight: 950;
            line-height: 1;
        }

        .res-price-chip span {
            display: block;
            margin-top: 4px;
            color: var(--text-muted);
            font-size: 0.64rem;
            font-weight: 850;
            letter-spacing: 0.08em;
            text-transform: uppercase;
        }

        .res-content {
            padding: 24px;
        }

        .res-topline {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 12px;
            margin-bottom: 12px;
        }

        .res-type {
            display: inline-flex;
            align-items: center;
            gap: 7px;
            color: var(--ocean-700);
            font-size: 0.70rem;
            font-weight: 950;
            letter-spacing: 0.12em;
            text-transform: uppercase;
        }

        .heart-btn {
            width: 38px;
            height: 38px;
            border: 0;
            border-radius: 14px;
            display: grid;
            place-items: center;
            cursor: pointer;
            color: var(--rose-500);
            background: var(--rose-50);
            transition:
                transform 0.25s var(--ease),
                background 0.25s var(--ease);
        }

        .heart-btn:hover,
        .heart-btn.active {
            transform: scale(1.08);
            color: white;
            background: linear-gradient(135deg, var(--rose-500), var(--rose-600));
        }

        .res-title {
            margin: 0;
            color: var(--text-main);
            font-family: var(--font-display);
            font-size: 1.55rem;
            font-weight: 400;
            letter-spacing: -0.03em;
            line-height: 1.15;
        }

        .res-meta {
            display: flex;
            flex-wrap: wrap;
            gap: 8px;
            margin: 17px 0 20px;
        }

        .meta-pill {
            min-height: 34px;
            padding: 0 11px;
            border-radius: var(--radius-full);
            display: inline-flex;
            align-items: center;
            gap: 7px;
            color: var(--text-soft);
            background: var(--slate-50);
            border: 1px solid rgba(148, 163, 184, 0.16);
            font-size: 0.74rem;
            font-weight: 800;
        }

        .btn-book {
            width: 100%;
            min-height: 52px;
            border: 0;
            border-radius: 18px;
            padding: 0 18px;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 10px;
            cursor: pointer;
            color: white;
            text-decoration: none;
            background: linear-gradient(135deg, var(--ocean-600), var(--sea-500));
            box-shadow: 0 16px 36px rgba(8, 145, 178, 0.22);
            font-size: 0.76rem;
            font-weight: 950;
            letter-spacing: 0.10em;
            text-transform: uppercase;
            transition:
                transform 0.25s var(--ease),
                box-shadow 0.25s var(--ease),
                filter 0.25s var(--ease);
        }

        .btn-book:hover {
            transform: translateY(-3px);
            box-shadow: 0 22px 46px rgba(8, 145, 178, 0.30);
            filter: brightness(1.04);
        }

        .btn-book.warning {
            background: linear-gradient(135deg, var(--sand-600), var(--sand-500));
            box-shadow: 0 16px 36px rgba(245, 158, 11, 0.22);
        }

        .btn-book.danger {
            background: linear-gradient(135deg, var(--rose-600), #fb7185);
            box-shadow: 0 16px 36px rgba(225, 29, 72, 0.20);
        }

        .btn-disabled {
            cursor: not-allowed;
            color: var(--slate-500) !important;
            background: var(--slate-200) !important;
            box-shadow: none !important;
            transform: none !important;
        }

        .empty-state {
            position: relative;
            padding: 54px;
            border-radius: 34px;
            text-align: center;
            background: rgba(255, 255, 255, 0.82);
            border: 1px dashed rgba(8, 145, 178, 0.28);
            box-shadow: var(--shadow-sm);
            overflow: hidden;
        }

        .empty-state::before {
            content: "";
            position: absolute;
            width: 220px;
            height: 220px;
            top: -120px;
            right: -90px;
            border-radius: var(--radius-full);
            background: rgba(6, 182, 212, 0.10);
        }

        .empty-icon {
            width: 78px;
            height: 78px;
            margin: 0 auto 18px;
            border-radius: 28px;
            display: grid;
            place-items: center;
            color: white;
            font-size: 1.8rem;
            background: linear-gradient(135deg, var(--ocean-500), var(--sea-500));
            box-shadow: var(--shadow-ocean);
        }

        .empty-state h3 {
            margin: 0 0 8px;
            color: var(--text-main);
            font-family: var(--font-display);
            font-size: 1.8rem;
            font-weight: 400;
        }

        .empty-state p {
            max-width: 440px;
            margin: 0 auto 22px;
            color: var(--text-soft);
            line-height: 1.7;
        }

        .reservation-shell {
            border-radius: 34px;
            background: rgba(255, 255, 255, 0.84);
            border: 1px solid rgba(255, 255, 255, 0.82);
            box-shadow: var(--shadow-md);
            backdrop-filter: blur(18px);
            overflow: hidden;
        }

        .table-scroll {
            width: 100%;
            overflow-x: auto;
        }

        .status-table {
            width: 100%;
            min-width: 820px;
            border-collapse: collapse;
            background: transparent;
        }

        .status-table th {
            padding: 20px 22px;
            text-align: left;
            color: var(--text-muted);
            background: rgba(248, 250, 252, 0.78);
            border-bottom: 1px solid rgba(148, 163, 184, 0.18);
            font-size: 0.70rem;
            font-weight: 950;
            letter-spacing: 0.12em;
            text-transform: uppercase;
        }

        .status-table td {
            padding: 20px 22px;
            border-bottom: 1px solid rgba(148, 163, 184, 0.14);
            color: var(--text-soft);
            font-size: 0.90rem;
            vertical-align: middle;
        }

        .status-table tr:last-child td {
            border-bottom: 0;
        }

        .status-table tbody tr {
            transition:
                background 0.25s var(--ease),
                transform 0.25s var(--ease);
        }

        .status-table tbody tr:hover {
            background: rgba(6, 182, 212, 0.045);
        }

        .reservation-name {
            display: flex;
            align-items: center;
            gap: 12px;
            min-width: 230px;
        }

        .reservation-icon {
            width: 44px;
            height: 44px;
            min-width: 44px;
            border-radius: 16px;
            display: grid;
            place-items: center;
            color: white;
            background: linear-gradient(135deg, var(--ocean-500), var(--sea-500));
            box-shadow: 0 12px 28px rgba(8, 145, 178, 0.18);
        }

        .reservation-name strong {
            display: block;
            color: var(--text-main);
            font-size: 0.96rem;
            font-weight: 900;
            line-height: 1.15;
        }

        .reservation-name small {
            display: block;
            margin-top: 4px;
            color: var(--text-muted);
            font-size: 0.75rem;
            font-weight: 700;
        }

        .date-pill {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            min-height: 38px;
            padding: 0 12px;
            border-radius: var(--radius-full);
            color: var(--text-soft);
            background: var(--slate-50);
            border: 1px solid rgba(148, 163, 184, 0.16);
            font-size: 0.78rem;
            font-weight: 800;
        }

        .badge {
            min-height: 38px;
            padding: 0 13px;
            border-radius: var(--radius-full);
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
            font-size: 0.70rem;
            font-weight: 950;
            letter-spacing: 0.08em;
            text-transform: uppercase;
            white-space: nowrap;
        }

        .badge.pending,
        .badge.processing,
        .badge.waiting {
            color: var(--sand-800);
            background: var(--sand-100);
            border: 1px solid rgba(245, 158, 11, 0.18);
        }

        .badge.approved,
        .badge.confirmed,
        .badge.confirm {
            color: var(--emerald-700);
            background: var(--emerald-100);
            border: 1px solid rgba(16, 185, 129, 0.18);
        }

        .badge.cancelled,
        .badge.canceled,
        .badge.rejected,
        .badge.declined {
            color: var(--rose-700);
            background: var(--rose-100);
            border: 1px solid rgba(244, 63, 94, 0.18);
        }

        .mobile-reservations {
            display: none;
            gap: 14px;
        }

        .booking-card {
            padding: 18px;
            border-radius: 26px;
            background: rgba(255, 255, 255, 0.86);
            border: 1px solid rgba(255, 255, 255, 0.82);
            box-shadow: var(--shadow-sm);
        }

        .booking-card-top {
            display: flex;
            align-items: flex-start;
            justify-content: space-between;
            gap: 12px;
            margin-bottom: 16px;
        }

        .booking-card-title strong {
            display: block;
            color: var(--text-main);
            font-weight: 950;
            line-height: 1.25;
        }

        .booking-card-title small {
            display: block;
            margin-top: 4px;
            color: var(--text-muted);
            font-weight: 750;
        }

        .booking-card-meta {
            display: grid;
            gap: 10px;
            margin-bottom: 16px;
        }

        .booking-meta-row {
            min-height: 42px;
            padding: 0 12px;
            border-radius: 15px;
            display: flex;
            align-items: center;
            gap: 10px;
            color: var(--text-soft);
            background: rgba(248, 250, 252, 0.86);
            border: 1px solid rgba(148, 163, 184, 0.14);
            font-size: 0.84rem;
            font-weight: 750;
        }

        .booking-meta-row i {
            color: var(--ocean-600);
        }

        .footer-wave {
            position: relative;
            margin-top: 72px;
            padding: 28px;
            border-radius: 34px;
            color: white;
            overflow: hidden;
            background:
                linear-gradient(135deg, var(--slate-950), var(--ocean-900) 52%, var(--sea-800));
            box-shadow: var(--shadow-lg);
        }

        .footer-wave::before {
            content: "";
            position: absolute;
            width: 280px;
            height: 280px;
            right: -120px;
            top: -150px;
            border-radius: var(--radius-full);
            background: rgba(255, 255, 255, 0.12);
        }

        .footer-wave-content {
            position: relative;
            display: flex;
            justify-content: space-between;
            align-items: center;
            gap: 24px;
        }

        .footer-wave h3 {
            margin: 0 0 8px;
            font-family: var(--font-display);
            font-size: 1.8rem;
            font-weight: 400;
        }

        .footer-wave p {
            margin: 0;
            color: rgba(226, 232, 240, 0.76);
            line-height: 1.7;
        }

        .floating-top {
            position: fixed;
            right: 24px;
            bottom: 24px;
            z-index: 80;
            width: 56px;
            height: 56px;
            border: 0;
            border-radius: 20px;
            display: grid;
            place-items: center;
            cursor: pointer;
            color: white;
            background: linear-gradient(135deg, var(--ocean-600), var(--sea-500));
            box-shadow:
                0 22px 48px rgba(8, 145, 178, 0.28),
                0 0 0 8px rgba(6, 182, 212, 0.10);
            transform: translateY(90px);
            opacity: 0;
            transition:
                transform 0.3s var(--ease),
                opacity 0.3s var(--ease);
        }

        .floating-top.show {
            transform: translateY(0);
            opacity: 1;
        }

        .floating-top:hover {
            transform: translateY(-5px);
        }

        @keyframes shineSweep {
            0% {
                transform: translateX(-120%) rotate(20deg);
            }

            45%,
            100% {
                transform: translateX(130%) rotate(20deg);
            }
        }

        @keyframes heroRise {
            from {
                opacity: 0;
                transform: translateY(26px) scale(0.985);
            }

            to {
                opacity: 1;
                transform: translateY(0) scale(1);
            }
        }

        @keyframes heroOrb {
            0%,
            100% {
                transform: translate(0, 0) scale(1);
            }

            50% {
                transform: translate(-28px, -16px) scale(1.05);
            }
        }

        @keyframes statPop {
            from {
                opacity: 0;
                transform: translateY(18px) scale(0.96);
            }

            to {
                opacity: 1;
                transform: translateY(0) scale(1);
            }
        }

        @keyframes cardReveal {
            from {
                opacity: 0;
                transform: translateY(24px) scale(0.985);
            }

            to {
                opacity: 1;
                transform: translateY(0) scale(1);
            }
        }

        @keyframes fadeIn {
            from {
                opacity: 0;
            }

            to {
                opacity: 1;
            }
        }

        @media (max-width: 1100px) {
            .residence-grid {
                grid-template-columns: repeat(2, minmax(0, 1fr));
            }

            .quick-strip {
                grid-template-columns: repeat(2, minmax(0, 1fr));
                margin-top: 20px;
                padding: 0;
            }

            .welcome-hero {
                min-height: auto;
            }
        }

        @media (max-width: 860px) {
            :root {
                --nav-height: 74px;
            }

            .dash-nav {
                padding: 14px 16px;
            }

            .nav-links {
                display: none;
            }

            .menu-toggle {
                display: grid;
            }

            .container {
                width: min(100% - 24px, var(--container));
                padding-top: 22px;
            }

            .welcome-hero {
                padding: 28px;
                border-radius: 32px;
            }

            .hero-stats {
                grid-template-columns: 1fr;
            }

            .section-header {
                align-items: flex-start;
                flex-direction: column;
                gap: 10px;
            }

            .section-header p {
                text-align: left;
                max-width: 100%;
            }

            .reservation-shell {
                display: none;
            }

            .mobile-reservations {
                display: grid;
            }

            .footer-wave-content {
                align-items: flex-start;
                flex-direction: column;
            }
        }

        @media (max-width: 680px) {
            .residence-grid {
                grid-template-columns: 1fr;
            }

            .quick-strip {
                grid-template-columns: 1fr;
            }

            .hero-actions {
                align-items: stretch;
                flex-direction: column;
            }

            .hero-btn {
                width: 100%;
            }

            .welcome-hero h1 {
                font-size: clamp(2.2rem, 13vw, 3.8rem);
            }

            .res-img-wrap {
                height: 220px;
            }
        }

        @media (max-width: 480px) {
            .logo-text {
                display: none;
            }

            .welcome-hero {
                padding: 22px;
                border-radius: 26px;
            }

            .eyebrow {
                font-size: 0.62rem;
                letter-spacing: 0.10em;
            }

            .hero-copy {
                font-size: 0.92rem;
            }

            .quick-card {
                min-height: 96px;
                border-radius: 24px;
            }

            .res-content {
                padding: 20px;
            }

            .res-title {
                font-size: 1.35rem;
            }

            .empty-state {
                padding: 34px 20px;
            }

            .footer-wave {
                padding: 22px;
            }

            .floating-top {
                right: 16px;
                bottom: 16px;
            }
        }

        @media (prefers-reduced-motion: reduce) {
            *,
            *::before,
            *::after {
                animation-duration: 0.01ms !important;
                animation-iteration-count: 1 !important;
                scroll-behavior: auto !important;
                transition-duration: 0.01ms !important;
            }
        }
    </style>
</head>

<body>
    <%
        const safeUser = typeof user !== 'undefined' && user ? user : {};
        const safeRooms = typeof rooms !== 'undefined' && Array.isArray(rooms) ? rooms : [];
        const safeBookings = typeof bookings !== 'undefined' && Array.isArray(bookings) ? bookings : [];

        const username = safeUser.username || safeUser.name || 'Guest';
        const totalRooms = safeRooms.length;
        const totalReservations = safeBookings.length;

        const pendingReservations = safeBookings.filter(function (booking) {
            return String(booking.status || '').toLowerCase() === 'pending';
        }).length;

        const approvedReservations = safeBookings.filter(function (booking) {
            const status = String(booking.status || '').toLowerCase();
            return status === 'approved' || status === 'confirmed';
        }).length;

        const pesoFormat = function (value) {
            return Number(value || 0).toLocaleString('en-PH');
        };

        const readableDate = function (dateValue) {
            if (!dateValue) return 'N/A';

            const parsedDate = new Date(dateValue);

            if (isNaN(parsedDate.getTime())) return 'N/A';

            return parsedDate.toLocaleDateString('en-US', {
                month: 'short',
                day: 'numeric',
                year: 'numeric'
            });
        };

        const statusIcon = function (statusValue) {
            const status = String(statusValue || '').toLowerCase();

            if (status === 'pending') return 'fa-solid fa-hourglass-half';
            if (status === 'approved' || status === 'confirmed') return 'fa-solid fa-circle-check';
            if (status === 'cancelled' || status === 'canceled' || status === 'rejected' || status === 'declined') return 'fa-solid fa-circle-xmark';

            return 'fa-solid fa-circle-info';
        };
    %>

    <div class="page-shell">
        <div class="ambient-bg">
            <span class="glow-orb orb-one"></span>
            <span class="glow-orb orb-two"></span>
            <span class="glow-orb orb-three"></span>
        </div>

        <span class="floating-shape shape-one"></span>
        <span class="floating-shape shape-two"></span>
        <span class="floating-shape shape-three"></span>

        <div class="page-noise"></div>

        <div class="screen-overlay" id="screenOverlay"></div>

        <div class="mobile-menu" id="mobileMenu">
            <div class="mobile-menu-panel">
                <div class="mobile-menu-head">
                    <a href="/dashboard" class="logo">
                        <span class="logo-icon">
                            <i class="fa-solid fa-water"></i>
                        </span>

                        <span class="logo-text">
                            Dang's<span>.</span>
                        </span>
                    </a>

                    <button 
                        type="button" 
                        class="mobile-close" 
                        id="mobileClose"
                        aria-label="Close menu"
                    >
                        <i class="fa-solid fa-xmark"></i>
                    </button>
                </div>

                <div class="mobile-menu-links">
                    <a href="/dashboard">
                        <i class="fa-solid fa-house"></i>
                        Home
                    </a>

                    <a href="#available">
                        <i class="fa-solid fa-umbrella-beach"></i>
                        Available Residences
                    </a>

                    <a href="#reservations">
                        <i class="fa-solid fa-calendar-check"></i>
                        My Reservations
                    </a>

                    <a href="/logout">
                        <i class="fa-solid fa-right-from-bracket"></i>
                        Sign Out
                    </a>
                </div>
            </div>
        </div>

        <nav class="dash-nav">
            <div class="nav-inner">
                <a href="/dashboard" class="logo">
                    <span class="logo-icon">
                        <i class="fa-solid fa-water"></i>
                    </span>

                    <span class="logo-text">
                        Dang's<span>.</span>
                    </span>
                </a>

                <div class="nav-links">
                    <a href="/dashboard" class="nav-link">
                        <i class="fa-solid fa-house"></i>
                        Home
                    </a>

                    <a href="#available" class="nav-link">
                        <i class="fa-solid fa-umbrella-beach"></i>
                        Residences
                    </a>

                    <a href="#reservations" class="nav-link">
                        <i class="fa-solid fa-calendar-check"></i>
                        Reservations
                    </a>

                    <a href="/logout" class="nav-link primary">
                        <i class="fa-solid fa-right-from-bracket"></i>
                        Sign Out
                    </a>
                </div>

                <button 
                    type="button" 
                    class="menu-toggle" 
                    id="menuToggle"
                    aria-label="Open menu"
                >
                    <i class="fa-solid fa-bars"></i>
                </button>
            </div>
        </nav>

        <main class="container">
            <header class="welcome-hero">
                <div class="hero-content">
                    <span class="eyebrow">
                        <i class="fa-solid fa-sun"></i>
                        Welcome to your sanctuary
                    </span>

                    <h1>
                        Hello, <%= username %><span>.</span>
                    </h1>

                    <p class="hero-copy">
                        Plan your next seaside escape, browse available rooms, and track your reservation status from your personal guest dashboard.
                    </p>

                    <div class="hero-actions">
                        <a href="#available" class="hero-btn">
                            <i class="fa-solid fa-magnifying-glass-location"></i>
                            Explore Residences
                        </a>

                        <a href="#reservations" class="hero-btn ghost">
                            <i class="fa-solid fa-calendar-days"></i>
                            View Reservations
                        </a>
                    </div>

                    <div class="hero-stats">
                        <div class="mini-stat">
                            <i class="fa-solid fa-hotel"></i>
                            <strong><%= totalRooms %></strong>
                            <span>Available stays</span>
                        </div>

                        <div class="mini-stat">
                            <i class="fa-solid fa-calendar-check"></i>
                            <strong><%= totalReservations %></strong>
                            <span>Your bookings</span>
                        </div>

                        <div class="mini-stat">
                            <i class="fa-solid fa-hourglass-half"></i>
                            <strong><%= pendingReservations %></strong>
                            <span>Pending requests</span>
                        </div>
                    </div>
                </div>
            </header>

            <section class="quick-strip" aria-label="Dashboard summary">
                <article class="quick-card">
                    <div class="quick-icon">
                        <i class="fa-solid fa-umbrella-beach"></i>
                    </div>

                    <div class="quick-copy">
                        <strong><%= totalRooms %></strong>
                        <span>Residences</span>
                    </div>
                </article>

                <article class="quick-card">
                    <div class="quick-icon">
                        <i class="fa-solid fa-bookmark"></i>
                    </div>

                    <div class="quick-copy">
                        <strong><%= totalReservations %></strong>
                        <span>Reservations</span>
                    </div>
                </article>

                <article class="quick-card">
                    <div class="quick-icon">
                        <i class="fa-solid fa-circle-check"></i>
                    </div>

                    <div class="quick-copy">
                        <strong><%= approvedReservations %></strong>
                        <span>Approved</span>
                    </div>
                </article>

                <article class="quick-card">
                    <div class="quick-icon">
                        <i class="fa-solid fa-clock"></i>
                    </div>

                    <div class="quick-copy">
                        <strong><%= pendingReservations %></strong>
                        <span>Pending</span>
                    </div>
                </article>
            </section>

            <section class="section-block" id="available">
                <div class="section-header">
                    <div>
                        <span class="section-kicker">
                            <i class="fa-solid fa-water-ladder"></i>
                            Available Residences
                        </span>

                        <h2>
                            Choose your next escape
                        </h2>
                    </div>

                    <p>
                        Browse cozy rooms and resort spaces designed for relaxation, comfort, and unforgettable beach moments.
                    </p>
                </div>

                <% if (safeRooms.length > 0) { %>
                    <div class="residence-grid">
                        <% safeRooms.forEach(function (room, index) { %>
                            <article class="residence-card reveal" style="animation-delay:<%= index * 0.08 %>s;">
                                <div class="res-img-wrap">
                                    <img 
                                        src="<%= room.image_url || '/images/default-room.jpg' %>" 
                                        alt="<%= room.name || 'Resort residence' %>" 
                                        class="res-img"
                                        onerror="this.onerror=null; this.src='/images/default-room.jpg';"
                                    >

                                    <div class="res-img-overlay"></div>

                                    <span class="res-floating-badge">
                                        <i class="fa-solid fa-star"></i>
                                        Guest Pick
                                    </span>

                                    <div class="res-price-chip">
                                        <strong>₱<%= pesoFormat(room.price) %></strong>
                                        <span>Per stay</span>
                                    </div>
                                </div>

                                <div class="res-content">
                                    <div class="res-topline">
                                        <span class="res-type">
                                            <i class="fa-solid fa-bed"></i>
                                            <%= room.type || 'Residence' %>
                                        </span>

                                        <button 
                                            type="button" 
                                            class="heart-btn favorite-btn"
                                            aria-label="Save residence"
                                        >
                                            <i class="fa-solid fa-heart"></i>
                                        </button>
                                    </div>

                                    <h3 class="res-title">
                                        <%= room.name || 'Unknown Residence' %>
                                    </h3>

                                    <div class="res-meta">
                                        <span class="meta-pill">
                                            <i class="fa-solid fa-wifi"></i>
                                            Free Wi-Fi
                                        </span>

                                        <span class="meta-pill">
                                            <i class="fa-solid fa-water"></i>
                                            Beach Access
                                        </span>

                                        <span class="meta-pill">
                                            <i class="fa-solid fa-shield-heart"></i>
                                            Cozy Stay
                                        </span>
                                    </div>

                                    <a href="/book/<%= room.id %>" class="btn-book">
                                        <i class="fa-solid fa-calendar-plus"></i>
                                        Reserve Selection
                                    </a>
                                </div>
                            </article>
                        <% }) %>
                    </div>
                <% } else { %>
                    <div class="empty-state">
                        <div class="empty-icon">
                            <i class="fa-solid fa-hotel"></i>
                        </div>

                        <h3>No residences available</h3>

                        <p>
                            There are currently no rooms available for booking. Please check again later for new resort listings.
                        </p>
                    </div>
                <% } %>
            </section>

            <section class="section-block" id="reservations">
                <div class="section-header">
                    <div>
                        <span class="section-kicker">
                            <i class="fa-solid fa-calendar-check"></i>
                            Your Reservations
                        </span>

                        <h2>
                            Track your retreats
                        </h2>
                    </div>

                    <p>
                        Check the current status of your bookings. Pending reservations can still be cancelled before approval.
                    </p>
                </div>

                <% if (safeBookings.length > 0) { %>
                    <div class="reservation-shell">
                        <div class="table-scroll">
                            <table class="status-table">
                                <thead>
                                    <tr>
                                        <th>Residence</th>
                                        <th>Date</th>
                                        <th>Status</th>
                                        <th>Reference</th>
                                        <th>Action</th>
                                    </tr>
                                </thead>

                                <tbody>
                                    <% safeBookings.forEach(function (b) { 
                                        const status = String(b.status || 'pending').toLowerCase();
                                        const bookingId = b.booking_id || b.id;
                                        const referenceCode = b.ref_code || b.reference_code || '---';
                                    %>
                                        <tr>
                                            <td>
                                                <div class="reservation-name">
                                                    <div class="reservation-icon">
                                                        <i class="fa-solid fa-bed"></i>
                                                    </div>

                                                    <div>
                                                        <strong><%= b.room_name || 'Unknown Residence' %></strong>
                                                        <small><%= b.room_type || 'Unknown Type' %></small>
                                                    </div>
                                                </div>
                                            </td>

                                            <td>
                                                <span class="date-pill">
                                                    <i class="fa-regular fa-calendar"></i>
                                                    <%= readableDate(b.booking_date) %>
                                                </span>
                                            </td>

                                            <td>
                                                <span class="badge <%= status %>">
                                                    <i class="<%= statusIcon(status) %>"></i>
                                                    <%= b.status || 'Pending' %>
                                                </span>
                                            </td>

                                            <td>
                                                <span class="date-pill">
                                                    <i class="fa-solid fa-hashtag"></i>
                                                    <%= referenceCode %>
                                                </span>
                                            </td>

                                            <td>
                                                <% if (status === 'pending' && bookingId) { %>
                                                    <form action="/client/booking/<%= bookingId %>/cancel" method="POST">
                                                        <button type="submit" class="btn-book warning">
                                                            <i class="fa-solid fa-ban"></i>
                                                            Cancel
                                                        </button>
                                                    </form>
                                                <% } else { %>
                                                    <button class="btn-book btn-disabled" disabled>
                                                        <i class="fa-solid fa-lock"></i>
                                                        Locked
                                                    </button>
                                                <% } %>
                                            </td>
                                        </tr>
                                    <% }) %>
                                </tbody>
                            </table>
                        </div>
                    </div>

                    <div class="mobile-reservations">
                        <% safeBookings.forEach(function (b) { 
                            const status = String(b.status || 'pending').toLowerCase();
                            const bookingId = b.booking_id || b.id;
                            const referenceCode = b.ref_code || b.reference_code || '---';
                        %>
                            <article class="booking-card reveal">
                                <div class="booking-card-top">
                                    <div class="booking-card-title">
                                        <strong><%= b.room_name || 'Unknown Residence' %></strong>
                                        <small><%= b.room_type || 'Unknown Type' %></small>
                                    </div>

                                    <span class="badge <%= status %>">
                                        <i class="<%= statusIcon(status) %>"></i>
                                        <%= b.status || 'Pending' %>
                                    </span>
                                </div>

                                <div class="booking-card-meta">
                                    <div class="booking-meta-row">
                                        <i class="fa-regular fa-calendar"></i>
                                        <span><%= readableDate(b.booking_date) %></span>
                                    </div>

                                    <div class="booking-meta-row">
                                        <i class="fa-solid fa-hashtag"></i>
                                        <span><%= referenceCode %></span>
                                    </div>
                                </div>

                                <% if (status === 'pending' && bookingId) { %>
                                    <form action="/client/booking/<%= bookingId %>/cancel" method="POST">
                                        <button type="submit" class="btn-book warning">
                                            <i class="fa-solid fa-ban"></i>
                                            Cancel Reservation
                                        </button>
                                    </form>
                                <% } else { %>
                                    <button class="btn-book btn-disabled" disabled>
                                        <i class="fa-solid fa-lock"></i>
                                        Reservation Locked
                                    </button>
                                <% } %>
                            </article>
                        <% }) %>
                    </div>
                <% } else { %>
                    <div class="empty-state">
                        <div class="empty-icon">
                            <i class="fa-solid fa-calendar-plus"></i>
                        </div>

                        <h3>No active reservations</h3>

                        <p>
                            You do not have any reservations yet. Explore the available residences and reserve your next beach retreat.
                        </p>

                        <a href="#available" class="btn-book" style="max-width:260px; margin:0 auto;">
                            <i class="fa-solid fa-compass"></i>
                            Explore Residences
                        </a>
                    </div>
                <% } %>
            </section>

            <section class="footer-wave">
                <div class="footer-wave-content">
                    <div>
                        <h3>
                            Ready for your next seaside moment?
                        </h3>

                        <p>
                            Dang's Beach Resort keeps your booking experience simple, calm, and easy to manage.
                        </p>
                    </div>

                    <a href="#available" class="hero-btn">
                        <i class="fa-solid fa-paper-plane"></i>
                        Book Again
                    </a>
                </div>
            </section>
        </main>

        <button 
            type="button" 
            class="floating-top" 
            id="floatingTop"
            aria-label="Back to top"
        >
            <i class="fa-solid fa-arrow-up"></i>
        </button>
    </div>

    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const body = document.body;
            const menuToggle = document.getElementById('menuToggle');
            const mobileMenu = document.getElementById('mobileMenu');
            const mobileClose = document.getElementById('mobileClose');
            const screenOverlay = document.getElementById('screenOverlay');
            const floatingTop = document.getElementById('floatingTop');
            const favoriteButtons = document.querySelectorAll('.favorite-btn');
            const revealElements = document.querySelectorAll('.reveal');

            function openMobileMenu() {
                if (!mobileMenu || !screenOverlay) return;

                mobileMenu.classList.add('show');
                screenOverlay.classList.add('show');
                body.classList.add('mobile-open');
            }

            function closeMobileMenu() {
                if (!mobileMenu || !screenOverlay) return;

                mobileMenu.classList.remove('show');
                screenOverlay.classList.remove('show');
                body.classList.remove('mobile-open');
            }

            if (menuToggle) {
                menuToggle.addEventListener('click', openMobileMenu);
            }

            if (mobileClose) {
                mobileClose.addEventListener('click', closeMobileMenu);
            }

            if (screenOverlay) {
                screenOverlay.addEventListener('click', closeMobileMenu);
            }

            document.querySelectorAll('.mobile-menu a').forEach(function (link) {
                link.addEventListener('click', closeMobileMenu);
            });

            document.addEventListener('keydown', function (event) {
                if (event.key === 'Escape') {
                    closeMobileMenu();
                }
            });

            favoriteButtons.forEach(function (button) {
                button.addEventListener('click', function () {
                    button.classList.toggle('active');
                });
            });

            window.addEventListener('scroll', function () {
                if (!floatingTop) return;

                if (window.scrollY > 450) {
                    floatingTop.classList.add('show');
                } else {
                    floatingTop.classList.remove('show');
                }
            });

            if (floatingTop) {
                floatingTop.addEventListener('click', function () {
                    window.scrollTo({
                        top: 0,
                        behavior: 'smooth'
                    });
                });
            }

            if ('IntersectionObserver' in window) {
                const observer = new IntersectionObserver(function (entries) {
                    entries.forEach(function (entry) {
                        if (entry.isIntersecting) {
                            entry.target.classList.add('visible');
                            observer.unobserve(entry.target);
                        }
                    });
                }, {
                    threshold: 0.12
                });

                revealElements.forEach(function (element) {
                    observer.observe(element);
                });
            } else {
                revealElements.forEach(function (element) {
                    element.classList.add('visible');
                });
            }
        });
    </script>
</body>
</html>