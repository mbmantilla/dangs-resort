<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Client Booking History | Dang's Admin</title>
<link href="https://fonts.googleapis.com/css2?family=Outfit:wght@200;400;600;700&display=swap" rel="stylesheet">
<style>
body {
    font-family: 'Outfit', sans-serif;
    margin: 0;
    padding: 0;
    background: #f1f5f9;
    color: #1e293b;
}

.container {
    max-width: 1100px;
    margin: 40px auto;
    padding: 0 20px;
}

h2 {
    font-size: 1.8rem;
    color: #0ea5e9;
    margin-bottom: 20px;
}

.table-card {
    background: white;
    padding: 30px;
    border-radius: 20px;
    box-shadow: 0 10px 25px -5px rgba(0,0,0,0.05);
    border: 1px solid #e2e8f0;
}

.history-table {
    width: 100%;
    border-collapse: separate;
    border-spacing: 0 12px;
    margin-top: 20px;
}

.history-table th {
    text-align: left;
    padding: 12px 16px;
    color: #94a3b8;
    font-size: 0.75rem;
    text-transform: uppercase;
    font-weight: 700;
}

.history-table td {
    padding: 14px 16px;
    background: #ffffff;
    border-top: 1px solid #f1f5f9;
    border-bottom: 1px solid #f1f5f9;
    border-radius: 12px;
}

.history-table tbody tr:hover {
    background: #f8fafc;
    transform: translateY(-2px);
    box-shadow: 0 10px 15px rgba(0,0,0,0.05);
}

.room-thumb {
    width: 40px;
    height: 40px;
    border-radius: 8px;
    object-fit: cover;
    margin-right: 10px;
    flex-shrink: 0;
    border: 1px solid #e2e8f0;
}

.room-name-cell {
    display: flex;
    align-items: center;
}

.status-pill {
    padding: 6px 14px;
    border-radius: 99px;
    font-size: 0.7rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.02em;
}

.status-approved { background: #dcfce7; color: #166534; border: 1px solid #bbf7d0; }
.status-pending  { background: #fef3c7; color: #a16207; border: 1px solid #fde68a; }
.status-rejected { background: #fee2e2; color: #991b1b; border: 1px solid #fecaca; }

.back-btn {
    display: inline-block;
    margin-top: 20px;
    padding: 10px 20px;
    background: #0ea5e9;
    color: white;
    border-radius: 12px;
    text-decoration: none;
    font-weight: 600;
    transition: 0.3s ease;
}
.back-btn:hover { background: #0369a1; }

@media (max-width: 768px) {
    .table-card { padding: 20px; }
    h2 { font-size: 1.5rem; }
    .room-thumb { width: 36px; height: 36px; }
}
</style>
</head>
<body>

<div class="container">
    <h2>Booking History for Client #<%= clientId %></h2>

    <div class="table-card">
        <table class="history-table">
            <thead>
                <tr>
                    <th>Booking ID</th>
                    <th>Room</th>
                    <th>Check-in</th>
                    <th>Ref Code</th>
                    <th>Status</th>
                </tr>
            </thead>
            <tbody>
                <% bookings.forEach(b => { %>
                <tr>
                    <td>#<%= b.booking_id %></td>
                    <td class="room-name-cell">
                        <% if(b.room_image && b.room_image.trim() !== '') { %>
                            <img src="<%= b.room_image %>" alt="<%= b.room_name %>" class="room-thumb">
                        <% } else { %>
                            <div class="room-thumb" style="display:flex;align-items:center;justify-content:center;font-weight:700;color:#1e293b;background:#e2e8f0;">
                                <%= b.room_name ? b.room_name.charAt(0).toUpperCase() : '?' %>
                            </div>
                        <% } %>
                        <span><%= b.room_name %> (<%= b.room_type %>)</span>
                    </td>
                    <td><%= b.booking_date ? new Date(b.booking_date).toLocaleDateString() : 'TBD' %></td>
                    <td><%= b.ref_code %></td>
                    <td>
                        <span class="status-pill 
                            <% if(b.status.toLowerCase() === 'approved'){ %>status-approved<% } %>
                            <% if(b.status.toLowerCase() === 'pending'){ %>status-pending<% } %>
                            <% if(b.status.toLowerCase() === 'rejected'){ %>status-rejected<% } %>">
                            <%= b.status.toUpperCase() %>
                        </span>
                    </td>
                </tr>
                <% }) %>
            </tbody>
        </table>

        <a href="/admin/clients" class="back-btn">← Back to Clients</a>
    </div>
</div>

</body>
</html>