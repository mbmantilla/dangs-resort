<%
    const safeBookings = typeof bookings !== 'undefined' && Array.isArray(bookings) ? bookings : [];

    const totalBookings = safeBookings.length;

    const pendingBookings = safeBookings.filter(function (booking) {
        return String(booking.status || 'pending').toLowerCase() === 'pending';
    }).length;

    const approvedBookings = safeBookings.filter(function (booking) {
        const status = String(booking.status || '').toLowerCase();
        return status === 'approved' || status === 'confirmed';
    }).length;

    const rejectedBookings = safeBookings.filter(function (booking) {
        const status = String(booking.status || '').toLowerCase();
        return status === 'rejected' || status === 'cancelled' || status === 'canceled' || status === 'declined';
    }).length;

    const todayArrivals = safeBookings.filter(function (booking) {
        if (!booking.check_in) return false;

        const today = new Date();
        const checkIn = new Date(booking.check_in);

        return today.toDateString() === checkIn.toDateString();
    }).length;

    const totalExpectedRevenue = safeBookings.reduce(function (sum, booking) {
        return sum + Number(booking.total_price || 0);
    }, 0);

    const pesoFormat = function (value) {
        return Number(value || 0).toLocaleString('en-PH', {
            minimumFractionDigits: 0,
            maximumFractionDigits: 2
        });
    };

    const readableDate = function (dateValue) {
        if (!dateValue) return 'Not Set';

        const parsedDate = new Date(dateValue);

        if (isNaN(parsedDate.getTime())) return 'Not Set';

        return parsedDate.toLocaleDateString('en-US', {
            month: 'short',
            day: 'numeric',
            year: 'numeric'
        });
    };

    const statusClass = function (statusValue) {
        const status = String(statusValue || 'pending').toLowerCase();

        if (status === 'approved' || status === 'confirmed') return 'approved';
        if (status === 'rejected' || status === 'cancelled' || status === 'canceled' || status === 'declined') return 'rejected';
        if (status === 'pending') return 'pending';

        return 'neutral';
    };

    const statusIcon = function (statusValue) {
        const status = statusClass(statusValue);

        if (status === 'approved') return 'fa-solid fa-circle-check';
        if (status === 'rejected') return 'fa-solid fa-circle-xmark';
        if (status === 'pending') return 'fa-solid fa-hourglass-half';

        return 'fa-solid fa-circle-info';
    };
