        box-shadow: 0 18px 42px rgba(15, 23, 42, 0.12);
    }

    .admin-table td {
        padding: 18px;
        vertical-align: middle;
        border: none;
        color: var(--book-text-soft);
        font-size: 0.86rem;
    }

    .admin-table td:first-child {
        border-radius: 22px 0 0 22px;
    }

    .admin-table td:last-child {
        border-radius: 0 22px 22px 0;
    }

    .guest-cell {
        display: flex;
        align-items: center;
        gap: 13px;
        min-width: 210px;
    }

    .guest-avatar {
        width: 48px;
        height: 48px;
        min-width: 48px;
        border-radius: 18px;
        display: grid;
        place-items: center;
        color: white;
        font-weight: 950;
        background: linear-gradient(135deg, var(--book-ocean-500), var(--book-sea-500));
        box-shadow: 0 14px 30px rgba(8, 145, 178, 0.22);
    }

    .guest-name {
        display: block;
        color: var(--book-text-main);
        font-size: 0.96rem;
        font-weight: 950;
        line-height: 1.2;
    }

    .guest-phone {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        margin-top: 5px;
        color: var(--book-text-muted);
        font-size: 0.74rem;
        font-weight: 800;
    }

    .room-cell {
        display: flex;
        flex-direction: column;
        gap: 5px;
        min-width: 190px;
    }

    .room-name {
        color: var(--book-text-main);
        font-weight: 950;
    }

    .room-type {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        color: var(--book-ocean-700);
        font-size: 0.72rem;
        font-weight: 900;
        letter-spacing: 0.07em;
        text-transform: uppercase;
    }

    .date-chip,
    .ref-chip,
    .price-chip {
        min-height: 38px;
        padding: 0 12px;
        border-radius: var(--book-radius-full);
        display: inline-flex;
        align-items: center;
        gap: 8px;
        color: var(--book-text-soft);
        background: var(--book-slate-50);
        border: 1px solid rgba(148, 163, 184, 0.16);
        font-size: 0.76rem;
        font-weight: 850;
        white-space: nowrap;
    }

    .price-chip {
        color: var(--book-ocean-700);
        background: var(--book-ocean-50);
    }

    .status-badge {
        min-height: 38px;
        padding: 0 13px;
        border-radius: var(--book-radius-full);
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        font-size: 0.70rem;
        font-weight: 950;
        letter-spacing: 0.08em;
        text-transform: uppercase;
        white-space: nowrap;
        border: 1px solid transparent;
    }

    .status-pending {
        color: var(--book-sand-800);
        background: var(--book-sand-100);
        border-color: rgba(245, 158, 11, 0.20);
    }

    .status-approved {
        color: var(--book-emerald-700);
        background: var(--book-emerald-100);
        border-color: rgba(16, 185, 129, 0.18);
    }

    .status-rejected {
        color: var(--book-rose-700);
        background: var(--book-rose-100);
        border-color: rgba(244, 63, 94, 0.18);
    }

    .status-neutral {
        color: var(--book-slate-700);
        background: var(--book-slate-100);
        border-color: rgba(148, 163, 184, 0.22);
    }

    .action-buttons {
        display: flex;
        align-items: center;
        justify-content: flex-start;
        gap: 9px;
        flex-wrap: wrap;
        min-width: 230px;
    }

    .btn-approve,
    .btn-reject,
    .btn-details,
    .btn-soft {
        min-height: 42px;
        padding: 0 14px;
        border: 0;
        border-radius: 15px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        cursor: pointer;
        font-size: 0.72rem;
        font-weight: 950;
        letter-spacing: 0.06em;
        text-transform: uppercase;
        transition:
            transform 0.22s var(--book-ease),
            box-shadow 0.22s var(--book-ease),
            background 0.22s var(--book-ease);
    }

    .btn-approve {
        color: white;
        background: linear-gradient(135deg, var(--book-emerald-500), var(--book-emerald-700));
        box-shadow: 0 12px 28px rgba(16, 185, 129, 0.18);
    }

    .btn-approve:hover {
        transform: translateY(-2px);
        box-shadow: 0 16px 34px rgba(16, 185, 129, 0.26);
    }

    .btn-reject {
        color: white;
        background: linear-gradient(135deg, var(--book-rose-500), var(--book-rose-700));
        box-shadow: 0 12px 28px rgba(244, 63, 94, 0.18);
    }

    .btn-reject:hover {
        transform: translateY(-2px);
        box-shadow: 0 16px 34px rgba(244, 63, 94, 0.26);
    }

    .btn-details,
    .btn-soft {
        color: var(--book-ocean-700);
        background: var(--book-ocean-50);
        border: 1px solid rgba(6, 182, 212, 0.16);
    }

    .btn-details:hover,
    .btn-soft:hover {
        transform: translateY(-2px);
        background: var(--book-ocean-100);
        box-shadow: 0 12px 28px rgba(8, 145, 178, 0.15);
    }

    .mobile-booking-grid {
        display: none;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 16px;
    }

    .booking-card {
        position: relative;
        border-radius: 30px;
        overflow: hidden;
        background: rgba(255, 255, 255, 0.88);
        border: 1px solid rgba(255, 255, 255, 0.82);
        box-shadow: var(--book-shadow-sm);
        backdrop-filter: blur(18px);
        transition:
            transform 0.28s var(--book-ease),
            box-shadow 0.28s var(--book-ease);
    }

    .booking-card:hover {
        transform: translateY(-6px);
        box-shadow: var(--book-shadow-md);
    }

    .booking-card-top {
        position: relative;
        min-height: 150px;
        padding: 20px;
        color: white;
        background:
            radial-gradient(circle at 16% 16%, rgba(255, 255, 255, 0.20), transparent 30%),
            linear-gradient(135deg, var(--book-ocean-700), var(--book-sea-700));
        overflow: hidden;
    }

    .booking-card-top::after {
        content: "";
        position: absolute;
        right: -65px;
        bottom: -85px;
        width: 180px;
        height: 180px;
        border-radius: var(--book-radius-full);
        background: rgba(255, 255, 255, 0.12);
    }

    .booking-card-head {
        position: relative;
        z-index: 2;
        display: flex;
        align-items: flex-start;
        justify-content: space-between;
        gap: 14px;
    }

    .booking-card-guest {
        min-width: 0;
    }

    .booking-card-guest strong {
        display: block;
        font-size: 1.1rem;
        font-weight: 950;
        line-height: 1.2;
    }

    .booking-card-guest span {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        margin-top: 6px;
        color: rgba(255, 255, 255, 0.76);
        font-size: 0.78rem;
        font-weight: 800;
    }

    .booking-card-body {
        padding: 20px;
    }

    .booking-meta-list {
        display: grid;
        gap: 10px;
        margin-bottom: 16px;
    }

    .booking-meta-row {
        min-height: 42px;
        padding: 0 12px;
        border-radius: 16px;
        display: flex;
        align-items: center;
        gap: 10px;
        color: var(--book-text-soft);
        background: var(--book-slate-50);
        border: 1px solid rgba(148, 163, 184, 0.14);
        font-size: 0.82rem;
        font-weight: 800;
    }

    .booking-meta-row i {
        color: var(--book-ocean-600);
    }

    .booking-card-actions {
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: 9px;
    }

    .booking-card-actions.only-details {
        grid-template-columns: 1fr;
    }

    .empty-state {
        position: relative;
        padding: 56px 24px;
        text-align: center;
        border-radius: 34px;
        background: rgba(255, 255, 255, 0.88);
        border: 1px dashed rgba(8, 145, 178, 0.30);
        box-shadow: var(--book-shadow-sm);
        overflow: hidden;
    }

    .empty-state::before {
        content: "";
        position: absolute;
        top: -120px;
        right: -90px;
        width: 240px;
        height: 240px;
        border-radius: var(--book-radius-full);
        background: rgba(6, 182, 212, 0.10);
    }

    .empty-icon {
        width: 78px;
        height: 78px;
        margin: 0 auto 18px;
        border-radius: 28px;
        display: grid;
        place-items: center;
        color: white;
        font-size: 1.8rem;
        background: linear-gradient(135deg, var(--book-ocean-500), var(--book-sea-500));
        box-shadow: var(--book-shadow-ocean);
    }

    .empty-state h3 {
        margin: 0 0 8px;
        color: var(--book-text-main);
        font-family: var(--book-font-display);
        font-size: 1.8rem;
        font-weight: 400;
    }

    .empty-state p {
        max-width: 460px;
        margin: 0 auto 22px;
        color: var(--book-text-soft);
        line-height: 1.7;
    }

    #detailsModal {
        position: fixed;
        inset: 0;
        z-index: 1000;
        display: none;
        align-items: center;
        justify-content: center;
        padding: 22px;
        background: rgba(15, 23, 42, 0.56);
        backdrop-filter: blur(10px);
    }

    #detailsModal.show {
        display: flex;
        animation: bookFadeIn 0.24s ease both;
    }

    .details-card {
        position: relative;
        width: min(680px, 100%);
        max-height: calc(100vh - 44px);
        overflow-y: auto;
        border-radius: 34px;
        background: rgba(255, 255, 255, 0.96);
        border: 1px solid rgba(255, 255, 255, 0.82);
        box-shadow: var(--book-shadow-xl);
        animation: bookModalPop 0.36s var(--book-ease-bounce) both;
    }

    .details-header {
        position: relative;
        padding: 28px 28px 0;
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        gap: 18px;
    }

    .details-title-wrap {
        display: flex;
        align-items: flex-start;
        gap: 14px;
    }

    .details-icon {
        width: 52px;
        height: 52px;
        min-width: 52px;
        border-radius: 20px;
        display: grid;
        place-items: center;
        color: white;
        background: linear-gradient(135deg, var(--book-ocean-500), var(--book-sea-500));
        box-shadow: 0 16px 34px rgba(8, 145, 178, 0.22);
    }

    .details-title {
        margin: 0;
        color: var(--book-text-main);
        font-size: 1.35rem;
        font-weight: 950;
        letter-spacing: -0.02em;
    }

    .details-subtitle {
        margin: 6px 0 0;
        color: var(--book-text-muted);
        font-size: 0.86rem;
        line-height: 1.55;
    }

    .modal-close {
        width: 42px;
        height: 42px;
        border: 0;
        border-radius: 16px;
        display: grid;
        place-items: center;
        cursor: pointer;
        color: var(--book-text-soft);
        background: var(--book-slate-100);
        transition:
            transform 0.22s var(--book-ease),
            background 0.22s var(--book-ease);
    }

    .modal-close:hover {
        transform: rotate(90deg);
        color: white;
        background: var(--book-rose-500);
    }

    #modalContent {
        padding: 26px 28px 28px;
    }

    .details-grid {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 14px;
    }

    .details-item {
        min-height: 74px;
        padding: 16px;
        border-radius: 22px;
        background: var(--book-card-muted);
        border: 1px solid rgba(148, 163, 184, 0.16);
    }

    .details-item.full {
        grid-column: 1 / -1;
    }

    .details-label {
        display: flex;
        align-items: center;
        gap: 8px;
        color: var(--book-ocean-700);
        font-size: 0.68rem;
        font-weight: 950;
        letter-spacing: 0.10em;
        text-transform: uppercase;
        margin-bottom: 7px;
    }

    .details-value {
        color: var(--book-text-main);
        font-size: 0.94rem;
        font-weight: 850;
        line-height: 1.5;
        overflow-wrap: anywhere;
    }

    .details-loading {
        padding: 36px;
        text-align: center;
        color: var(--book-text-muted);
        font-weight: 850;
    }

    .loading-spinner {
        width: 44px;
        height: 44px;
        margin: 0 auto 14px;
        border-radius: var(--book-radius-full);
        border: 4px solid var(--book-ocean-100);
        border-top-color: var(--book-ocean-600);
        animation: bookSpin 0.9s linear infinite;
    }

    @keyframes bookSpin {
        to {
            transform: rotate(360deg);
        }
    }

    .toast {
        position: fixed;
        left: 50%;
        bottom: 28px;
        z-index: 1100;
        min-width: min(440px, calc(100% - 32px));
        padding: 15px 16px;
        border-radius: 20px;
        display: flex;
        align-items: center;
        gap: 12px;
        color: white;
        background: rgba(15, 23, 42, 0.92);
        border: 1px solid rgba(255, 255, 255, 0.12);
        box-shadow: var(--book-shadow-lg);
        backdrop-filter: blur(18px);
        transform: translate(-50%, 30px);
        opacity: 0;
        pointer-events: none;
        transition:
            transform 0.28s var(--book-ease),
            opacity 0.28s var(--book-ease);
    }

    .toast.show {
        transform: translate(-50%, 0);
        opacity: 1;
    }

    .toast i {
        color: var(--book-sand-300);
    }

    .footer-bookings {
        position: relative;
        margin-top: 28px;
        padding: 28px;
        border-radius: 34px;
        color: white;
        overflow: hidden;
        background:
            linear-gradient(135deg, var(--book-slate-950), var(--book-ocean-900) 52%, var(--book-sea-800));
        box-shadow: var(--book-shadow-lg);
    }

    .footer-bookings::before {
        content: "";
        position: absolute;
        width: 280px;
        height: 280px;
        right: -120px;
        top: -150px;
        border-radius: var(--book-radius-full);
        background: rgba(255, 255, 255, 0.12);
    }

    .footer-bookings-content {
        position: relative;
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 24px;
    }

    .footer-bookings h3 {
        margin: 0 0 8px;
        font-family: var(--book-font-display);
        font-size: 1.8rem;
        font-weight: 400;
    }

    .footer-bookings p {
        margin: 0;
        color: rgba(226, 232, 240, 0.76);
        line-height: 1.7;
    }

    @keyframes bookFadeIn {
        from {
            opacity: 0;
        }

        to {
            opacity: 1;
        }
    }

    @keyframes bookModalPop {
        from {
            opacity: 0;
            transform: translateY(22px) scale(0.96);
        }

        to {
            opacity: 1;
            transform: translateY(0) scale(1);
        }
    }

    @media (max-width: 1280px) {
        .booking-hero-inner {
            grid-template-columns: 1fr;
        }

        .booking-overview-strip {
            grid-template-columns: repeat(2, minmax(0, 1fr));
            margin-top: 20px;
            margin-left: 0;
            margin-right: 0;
        }
    }

    @media (max-width: 980px) {
        .section-heading {
            align-items: flex-start;
            flex-direction: column;
            gap: 10px;
        }

        .section-heading p {
            max-width: 100%;
            text-align: left;
        }

        .toolbar-card {
            grid-template-columns: 1fr;
        }

        .admin-table {
            display: none;
        }

        .mobile-booking-grid {
            display: grid;
        }
    }

    @media (max-width: 720px) {
        .booking-hero {
            padding: 26px;
            border-radius: 30px;
        }

        .hero-title {
            font-size: clamp(2.1rem, 12vw, 3.5rem);
        }

        .hero-actions {
            align-items: stretch;
            flex-direction: column;
        }

        .hero-btn,
        .btn-add {
            width: 100%;
        }

        .booking-overview-strip,
        .mobile-booking-grid,
        .details-grid {
            grid-template-columns: 1fr;
        }

        .admin-card-inner {
            padding: 20px;
        }

        .booking-card-actions {
            grid-template-columns: 1fr;
        }

        .footer-bookings-content {
            align-items: flex-start;
            flex-direction: column;
        }
    }

    @media (max-width: 520px) {
        .booking-hero {
            padding: 22px;
            border-radius: 26px;
        }

        .hero-eyebrow,
        .section-kicker {
            font-size: 0.62rem;
            letter-spacing: 0.10em;
        }

        .hero-copy {
            font-size: 0.92rem;
        }

        .overview-pill {
            min-height: 94px;
            border-radius: 24px;
        }

        .admin-card,
        .booking-card,
        .details-card {
            border-radius: 26px;
        }

        #detailsModal {
            padding: 14px;
        }
    }

    @media print {
        .book-orb,
        .book-noise,
        .hero-actions,
        .toolbar-card,
        #detailsModal,
        .toast {
            display: none !important;
        }

        .bookings-page::before,
        .bookings-page::after {
            display: none !important;
        }

        .booking-hero,
        .admin-card,
        .booking-card,
        .overview-pill,
        .footer-bookings {
            box-shadow: none !important;
        }
    }

    @media (prefers-reduced-motion: reduce) {
        .bookings-page *,
        .bookings-page *::before,
        .bookings-page *::after {
            animation-duration: 0.01ms !important;
            animation-iteration-count: 1 !important;
            scroll-behavior: auto !important;
            transition-duration: 0.01ms !important;
        }
    }
</style>

<div class="bookings-page">
    <span class="book-orb one"></span>
    <span class="book-orb two"></span>
    <span class="book-orb three"></span>
    <div class="book-noise"></div>

    <section class="booking-hero">
        <div class="booking-hero-inner">
            <div>
                <span class="hero-eyebrow">
                    <i class="fa-solid fa-calendar-check"></i>
                    Reservation Management
                </span>

                <h1 class="hero-title">
                    Manage guest bookings<span>.</span>
                </h1>

                <p class="hero-copy">
                    Review reservation details, verify payment references, approve valid bookings, and reject incomplete or invalid requests.
                </p>

                <div class="hero-actions">
                    <a href="/admin/reports" class="hero-btn">
                        <i class="fa-solid fa-chart-line"></i>
                        View Reports
                    </a>

                    <a href="/admin/facilities" class="hero-btn ghost">
                        <i class="fa-solid fa-umbrella-beach"></i>
                        Manage Facilities
                    </a>
                </div>
            </div>

            <article class="hero-live-card">
                <div class="live-card-icon">
                    <i class="fa-solid fa-bookmark"></i>
                </div>

                <span class="live-card-label">
                    Total Reservations
                </span>

                <strong class="live-card-value">
                    <%= totalBookings %>
                </strong>

                <p class="live-card-copy">
                    Reservations currently stored in the resort management system.
                </p>
            </article>
        </div>
    </section>

    <section class="booking-overview-strip" aria-label="Booking summary">
        <article class="overview-pill">
            <div class="overview-icon">
                <i class="fa-solid fa-calendar-days"></i>
            </div>

            <div class="overview-copy">
                <strong><%= totalBookings %></strong>
                <span>Total Bookings</span>
            </div>
        </article>

        <article class="overview-pill">
            <div class="overview-icon pending">
                <i class="fa-solid fa-hourglass-half"></i>
            </div>

            <div class="overview-copy">
                <strong><%= pendingBookings %></strong>
                <span>Pending Review</span>
            </div>
        </article>

        <article class="overview-pill">
            <div class="overview-icon approved">
                <i class="fa-solid fa-circle-check"></i>
            </div>

            <div class="overview-copy">
                <strong><%= approvedBookings %></strong>
                <span>Approved</span>
            </div>
        </article>

        <article class="overview-pill">
            <div class="overview-icon rejected">
                <i class="fa-solid fa-peso-sign"></i>
            </div>

            <div class="overview-copy">
                <strong>₱<%= pesoFormat(totalExpectedRevenue) %></strong>
                <span>Total Value</span>
            </div>
        </article>
    </section>

    <div class="section-heading">
        <div>
            <span class="section-kicker">
                <i class="fa-solid fa-table-list"></i>
                Booking Queue
            </span>

            <h2>
                Guest reservations
            </h2>
        </div>

        <p>
            Search by guest, room, phone, reference code, or filter by booking status. Pending bookings can be approved or rejected.
        </p>
    </div>

    <section class="toolbar-card">
        <div class="search-wrap">
            <i class="fa-solid fa-magnifying-glass"></i>

            <input 
                type="search" 
                id="bookingSearch" 
                class="search-input" 
                placeholder="Search guest, room, phone, or reference code..."
            >
        </div>

        <div class="filter-wrap">
            <i class="fa-solid fa-filter"></i>

            <select id="statusFilter" class="filter-select" onchange="filterBookings()">
                <option value="all">All Bookings</option>
                <option value="pending">Pending</option>
                <option value="approved">Approved</option>
                <option value="rejected">Rejected</option>
            </select>
        </div>

        <button type="button" class="btn-add" onclick="window.location.reload()">
            <i class="fa-solid fa-rotate-right"></i>
            Refresh
        </button>
    </section>

    <% if (safeBookings.length > 0) { %>
        <section class="admin-card">
            <div class="admin-card-inner">
                <div class="table-shell">
                    <table class="admin-table">
                        <thead>
                            <tr>
                                <th>Guest</th>
                                <th>Room</th>
                                <th>Check-in</th>
                                <th>Check-out</th>
                                <th>Ref Code</th>
                                <th>Amount</th>
                                <th>Status</th>
                                <th>Actions</th>
                            </tr>
                        </thead>

                        <tbody id="bookingTableBody">
                            <% safeBookings.forEach(function (b) { 
                                const statusValue = String(b.status || 'pending').toLowerCase();
                                const normalizedStatus = statusClass(statusValue);
                                const bookingId = b.booking_id || b.id;
                                const guestName = b.guest_name || 'Walk-in Guest';
                                const avatarLetter = guestName.charAt(0).toUpperCase();
                                const searchable = [
                                    guestName,
                                    b.phone || '',
                                    b.room_name || '',
                                    b.room_type || '',
                                    b.ref_code || '',
                                    b.status || ''
                                ].join(' ').toLowerCase();
                            %>
                                <tr 
                                    class="booking-row"
                                    data-status="<%= normalizedStatus %>"
                                    data-search="<%= searchable %>"
                                >
                                    <td>
                                        <div class="guest-cell">
                                            <span class="guest-avatar">
                                                <%= avatarLetter %>
                                            </span>

                                            <span>
                                                <strong class="guest-name"><%= guestName %></strong>
                                                <span class="guest-phone">
                                                    <i class="fa-solid fa-phone"></i>
                                                    <%= b.phone || 'No Phone' %>
                                                </span>
                                            </span>
                                        </div>
                                    </td>

                                    <td>
                                        <div class="room-cell">
                                            <span class="room-name"><%= b.room_name || 'Unknown Room' %></span>
                                            <span class="room-type">
                                                <i class="fa-solid fa-bed"></i>
                                                <%= b.room_type || 'Unknown Type' %>
                                            </span>
                                        </div>
                                    </td>

                                    <td>
                                        <span class="date-chip">
                                            <i class="fa-regular fa-calendar"></i>
                                            <%= readableDate(b.check_in) %>
                                        </span>
                                    </td>

                                    <td>
                                        <span class="date-chip">
                                            <i class="fa-regular fa-calendar-check"></i>
                                            <%= readableDate(b.check_out) %>
                                        </span>
                                    </td>

                                    <td>
                                        <span class="ref-chip">
                                            <i class="fa-solid fa-hashtag"></i>
                                            <%= b.ref_code || '---' %>
                                        </span>
                                    </td>

                                    <td>
                                        <span class="price-chip">
                                            <i class="fa-solid fa-peso-sign"></i>
                                            ₱<%= pesoFormat(b.total_price) %>
                                        </span>
                                    </td>

                                    <td>
                                        <span class="status-badge status-<%= normalizedStatus %>">
                                            <i class="<%= statusIcon(statusValue) %>"></i>
                                            <%= String(b.status || 'PENDING').toUpperCase() %>
                                        </span>
                                    </td>

                                    <td>
                                        <div class="action-buttons">
                                            <% if (normalizedStatus === 'pending') { %>
                                                <button 
                                                    type="button" 
                                                    class="btn-approve" 
                                                    onclick="updateStatus('<%= bookingId %>', 'Approved')"
                                                >
                                                    <i class="fa-solid fa-check"></i>
                                                    Approve
                                                </button>

                                                <button 
                                                    type="button" 
                                                    class="btn-reject" 
                                                    onclick="updateStatus('<%= bookingId %>', 'Rejected')"
                                                >
                                                    <i class="fa-solid fa-xmark"></i>
                                                    Reject
                                                </button>
                                            <% } %>

                                            <button 
                                                type="button" 
                                                class="btn-details" 
                                                onclick="viewDetails('<%= bookingId %>')"
                                            >
                                                <i class="fa-solid fa-eye"></i>
                                                Details
                                            </button>
                                        </div>
                                    </td>
                                </tr>
                            <% }) %>
                        </tbody>
                    </table>
                </div>

                <div class="mobile-booking-grid" id="mobileBookingGrid">
                    <% safeBookings.forEach(function (b) { 
                        const statusValue = String(b.status || 'pending').toLowerCase();
                        const normalizedStatus = statusClass(statusValue);
                        const bookingId = b.booking_id || b.id;
                        const guestName = b.guest_name || 'Walk-in Guest';
                        const searchable = [
                            guestName,
                            b.phone || '',
                            b.room_name || '',
                            b.room_type || '',
                            b.ref_code || '',
                            b.status || ''
                        ].join(' ').toLowerCase();
                    %>
                        <article 
                            class="booking-card booking-row"
                            data-status="<%= normalizedStatus %>"
                            data-search="<%= searchable %>"
                        >
                            <div class="booking-card-top">
                                <div class="booking-card-head">
                                    <div class="booking-card-guest">
                                        <strong><%= guestName %></strong>
                                        <span>
                                            <i class="fa-solid fa-phone"></i>
                                            <%= b.phone || 'No Phone' %>
                                        </span>
                                    </div>

                                    <span class="status-badge status-<%= normalizedStatus %>">
                                        <i class="<%= statusIcon(statusValue) %>"></i>
                                        <%= String(b.status || 'PENDING').toUpperCase() %>
                                    </span>
                                </div>
                            </div>

                            <div class="booking-card-body">
                                <div class="booking-meta-list">
                                    <div class="booking-meta-row">
                                        <i class="fa-solid fa-bed"></i>
                                        <span><%= b.room_name || 'Unknown Room' %> (<%= b.room_type || 'Unknown Type' %>)</span>
                                    </div>

                                    <div class="booking-meta-row">
                                        <i class="fa-regular fa-calendar"></i>
                                        <span>Check-in: <%= readableDate(b.check_in) %></span>
                                    </div>

                                    <div class="booking-meta-row">
                                        <i class="fa-regular fa-calendar-check"></i>
                                        <span>Check-out: <%= readableDate(b.check_out) %></span>
                                    </div>

                                    <div class="booking-meta-row">
                                        <i class="fa-solid fa-hashtag"></i>
                                        <span>Ref: <%= b.ref_code || '---' %></span>
                                    </div>

                                    <div class="booking-meta-row">
                                        <i class="fa-solid fa-peso-sign"></i>
                                        <span>Amount: ₱<%= pesoFormat(b.total_price) %></span>
                                    </div>
                                </div>

                                <div class="booking-card-actions <%= normalizedStatus !== 'pending' ? 'only-details' : '' %>">
                                    <% if (normalizedStatus === 'pending') { %>
                                        <button 
                                            type="button" 
                                            class="btn-approve" 
                                            onclick="updateStatus('<%= bookingId %>', 'Approved')"
                                        >
                                            <i class="fa-solid fa-check"></i>
                                            Approve
                                        </button>

                                        <button 
                                            type="button" 
                                            class="btn-reject" 
                                            onclick="updateStatus('<%= bookingId %>', 'Rejected')"
                                        >
                                            <i class="fa-solid fa-xmark"></i>
                                            Reject
                                        </button>
                                    <% } %>

                                    <button 
                                        type="button" 
                                        class="btn-details" 
                                        onclick="viewDetails('<%= bookingId %>')"
                                    >
                                        <i class="fa-solid fa-eye"></i>
                                        Details
                                    </button>
                                </div>
                            </div>
                        </article>
                    <% }) %>
                </div>
            </div>
        </section>
    <% } else { %>
        <section class="empty-state">
            <div class="empty-icon">
                <i class="fa-solid fa-calendar-xmark"></i>
            </div>

            <h3>No bookings found</h3>

            <p>
                There are no reservations yet. Once guests submit bookings, they will appear here for admin review.
            </p>

            <a href="/admin/facilities" class="hero-btn" style="margin:0 auto;">
                <i class="fa-solid fa-umbrella-beach"></i>
                Manage Facilities
            </a>
        </section>
    <% } %>

    <section class="footer-bookings">
        <div class="footer-bookings-content">
            <div>
                <h3>
                    Keep reservations moving.
                </h3>

                <p>
                    Review pending payments regularly so guests receive timely booking confirmation.
                </p>
            </div>

            <a href="/admin/reports" class="hero-btn">
                <i class="fa-solid fa-chart-line"></i>
                Open Reports
            </a>
        </div>
    </section>
</div>

<div id="detailsModal">
    <div class="details-card">
        <div class="details-header">
            <div class="details-title-wrap">
                <div class="details-icon">
                    <i class="fa-solid fa-receipt"></i>
                </div>

                <div>
                    <h3 class="details-title">
                        Reservation Details
                    </h3>

                    <p class="details-subtitle">
                        Full booking, guest, payment, and request information.
                    </p>
                </div>
            </div>

            <button type="button" class="modal-close" onclick="closeModal()" aria-label="Close modal">
                <i class="fa-solid fa-xmark"></i>
            </button>
        </div>

        <div id="modalContent">
            <div class="details-loading">
                <div class="loading-spinner"></div>
                Loading reservation details...
            </div>
        </div>
    </div>
</div>

<div class="toast" id="bookingToast">
    <i class="fa-solid fa-circle-info"></i>
    <span id="bookingToastMessage">Booking action completed.</span>
</div>

<script>
    const detailsModal = document.getElementById('detailsModal');
    const modalContent = document.getElementById('modalContent');
    const bookingSearch = document.getElementById('bookingSearch');
    const statusFilter = document.getElementById('statusFilter');
    const bookingToast = document.getElementById('bookingToast');
    const bookingToastMessage = document.getElementById('bookingToastMessage');

    function showToast(message) {
        if (!bookingToast || !bookingToastMessage) return;

        bookingToastMessage.textContent = message;
        bookingToast.classList.add('show');

        setTimeout(function () {
            bookingToast.classList.remove('show');
        }, 3000);
    }

    function escapeHtml(value) {
        return String(value ?? '')
            .replaceAll('&', '&amp;')
            .replaceAll('<', '&lt;')
            .replaceAll('>', '&gt;')
            .replaceAll('"', '&quot;')
            .replaceAll("'", '&#039;');
    }

    function formatDate(value) {
        if (!value) return 'Not Set';

        const date = new Date(value);

        if (Number.isNaN(date.getTime())) {
            return 'Not Set';
        }

        return date.toLocaleDateString('en-US', {
            month: 'short',
            day: 'numeric',
            year: 'numeric'
        });
    }

    function formatPeso(value) {
        return '₱' + Number(value || 0).toLocaleString('en-PH', {
            minimumFractionDigits: 0,
            maximumFractionDigits: 2
        });
    }

    function normalizeStatus(status) {
        const value = String(status || 'pending').toLowerCase();

        if (value === 'approved' || value === 'confirmed') return 'approved';
        if (value === 'rejected' || value === 'cancelled' || value === 'canceled' || value === 'declined') return 'rejected';
        if (value === 'pending') return 'pending';

        return 'neutral';
    }

    function updateStatus(id, status) {
        const actionText = status === 'Approved' ? 'approve' : 'reject';

        if (!confirm('Are you sure you want to ' + actionText + ' this booking?')) {
            return;
        }

        showToast('Updating booking status...');

        fetch('/admin/booking/status/' + encodeURIComponent(id), {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json'
            },
            body: JSON.stringify({ status: status })
        })
        .then(function (res) {
            if (res.ok) {
                showToast('Booking has been ' + status.toLowerCase() + '.');

                setTimeout(function () {
                    window.location.reload();
                }, 650);
            } else {
                showToast('Error updating booking status.');
            }
        })
        .catch(function () {
            showToast('Network error while updating status.');
        });
    }

    function viewDetails(id) {
        if (!detailsModal || !modalContent) return;

        detailsModal.classList.add('show');
        document.body.style.overflow = 'hidden';

        modalContent.innerHTML = `
            <div class="details-loading">
                <div class="loading-spinner"></div>
                Loading reservation details...
            </div>
        `;

        fetch('/admin/booking/details/' + encodeURIComponent(id))
            .then(function (res) {
                if (!res.ok) {
                    throw new Error('Unable to load booking details');
                }

                return res.json();
            })
            .then(function (data) {
                const status = normalizeStatus(data.status || 'Pending');

                modalContent.innerHTML = `
                    <div class="details-grid">
                        <div class="details-item">
                            <div class="details-label">
                                <i class="fa-solid fa-user"></i>
                                Guest
                            </div>
                            <div class="details-value">${escapeHtml(data.guest_name || 'Walk-in Guest')}</div>
                        </div>

                        <div class="details-item">
                            <div class="details-label">
                                <i class="fa-solid fa-phone"></i>
                                Phone
                            </div>
                            <div class="details-value">${escapeHtml(data.phone || 'No Phone')}</div>
                        </div>

                        <div class="details-item">
                            <div class="details-label">
                                <i class="fa-solid fa-bed"></i>
                                Room
                            </div>
                            <div class="details-value">
                                ${escapeHtml(data.room_name || 'Unknown')} (${escapeHtml(data.room_type || 'Unknown')})
                            </div>
                        </div>

                        <div class="details-item">
                            <div class="details-label">
                                <i class="fa-solid fa-hashtag"></i>
                                Reference Code
                            </div>
                            <div class="details-value">${escapeHtml(data.ref_code || '---')}</div>
                        </div>

                        <div class="details-item">
                            <div class="details-label">
                                <i class="fa-regular fa-calendar"></i>
                                Check-in
                            </div>
                            <div class="details-value">${formatDate(data.check_in)}</div>
                        </div>

                        <div class="details-item">
                            <div class="details-label">
                                <i class="fa-regular fa-calendar-check"></i>
                                Check-out
                            </div>
                            <div class="details-value">${formatDate(data.check_out)}</div>
                        </div>

                        <div class="details-item">
                            <div class="details-label">
                                <i class="fa-solid fa-signal"></i>
                                Status
                            </div>
                            <div class="details-value">
                                <span class="status-badge status-${status}">
                                    ${escapeHtml(data.status || 'PENDING')}
                                </span>
                            </div>
                        </div>

                        <div class="details-item">
                            <div class="details-label">
                                <i class="fa-solid fa-peso-sign"></i>
                                Total Price
                            </div>
                            <div class="details-value">${formatPeso(data.total_price)}</div>
                        </div>

                        <div class="details-item">
                            <div class="details-label">
                                <i class="fa-solid fa-calendar-day"></i>
                                Booking Date
                            </div>
                            <div class="details-value">${formatDate(data.booking_date)}</div>
                        </div>

                        <div class="details-item full">
                            <div class="details-label">
                                <i class="fa-solid fa-message"></i>
                                Special Requests
                            </div>
                            <div class="details-value">${escapeHtml(data.requests || 'None')}</div>
                        </div>
                    </div>
                `;
            })
            .catch(function () {
                modalContent.innerHTML = `
                    <div class="details-loading">
                        <i class="fa-solid fa-triangle-exclamation" style="font-size:2rem; color:#e11d48; margin-bottom:12px;"></i>
                        <br>
                        Failed to load reservation details.
                    </div>
                `;
            });
    }

    function closeModal() {
        if (!detailsModal) return;

        detailsModal.classList.remove('show');
        document.body.style.overflow = '';
    }

    function filterBookings() {
        const filter = statusFilter ? statusFilter.value.toLowerCase() : 'all';
        const keyword = bookingSearch ? bookingSearch.value.trim().toLowerCase() : '';
        const bookingRows = document.querySelectorAll('.booking-row');

        bookingRows.forEach(function (row) {
            const status = row.getAttribute('data-status') || '';
            const searchable = row.getAttribute('data-search') || '';

            const matchesStatus = filter === 'all' || status === filter;
            const matchesKeyword = !keyword || searchable.includes(keyword);

            row.style.display = matchesStatus && matchesKeyword ? '' : 'none';
        });
    }

    if (bookingSearch) {
        bookingSearch.addEventListener('input', filterBookings);
    }

    if (statusFilter) {
        statusFilter.addEventListener('change', filterBookings);
    }

    if (detailsModal) {
        detailsModal.addEventListener('click', function (event) {
            if (event.target === detailsModal) {
                closeModal();
            }
        });
    }

    document.addEventListener('keydown', function (event) {
        if (event.key === 'Escape') {
            closeModal();
        }
    });
</script>
