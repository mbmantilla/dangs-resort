<%
    const safeClients = typeof clients !== 'undefined' && Array.isArray(clients) ? clients : [];

    const totalClients = safeClients.length;

    const customerCount = safeClients.filter(function (client) {
        return String(client.role || '').toLowerCase() === 'customer';
    }).length;

    const adminCount = safeClients.filter(function (client) {
        return String(client.role || '').toLowerCase() === 'admin';
    }).length;

    const activeCount = totalClients;

    const uniqueDomains = Array.from(new Set(
        safeClients
            .map(function (client) {
                const email = String(client.email || '');
                return email.includes('@') ? email.split('@').pop().toLowerCase() : '';
            })
            .filter(Boolean)
    )).length;

    const getAvatarLetter = function (name) {
        const safeName = String(name || 'Guest').trim();
        return safeName ? safeName.charAt(0).toUpperCase() : 'G';
    };

    const getRoleClass = function (role) {
        const safeRole = String(role || '').toLowerCase();

        if (safeRole === 'admin') return 'admin';
        if (safeRole === 'customer') return 'customer';

        return 'neutral';
    };

    const readableRole = function (role) {
        const safeRole = String(role || 'customer').toLowerCase();

        if (safeRole === 'admin') return 'Administrator';
        if (safeRole === 'customer') return 'Customer';

        return role || 'Customer';
    };
