<style>
/* --- Admin Card Container --- */
.admin-card { 
    background: #ffffff;
    padding: 36px; 
    border-radius: 20px; 
    box-shadow: 0 20px 60px rgba(0,0,0,0.08);
    border: 1px solid #f1f5f9; 
    transition: transform 0.3s;
}
.admin-card:hover { transform: translateY(-3px); }

/* --- Search Input --- */
#searchInput { 
    width: 250px; 
    padding: 10px 12px; 
    margin-bottom: 20px; 
    border-radius: 12px; 
    border: 1px solid #e2e8f0; 
    outline: none; 
    font-size: 0.9rem;
    transition: 0.3s;
}
#searchInput:focus { border-color: #0ea5e9; }

/* --- Table --- */
.admin-table { 
    width: 100%; 
    border-collapse: separate; 
    border-spacing: 0 14px; 
}
.admin-table th { 
    text-align: left; 
    padding: 14px 24px; 
    color: #475569; 
    font-size: 0.75rem; 
    text-transform: uppercase; 
    font-weight: 700;
    letter-spacing: 0.02em;
}
.admin-table td { 
    padding: 16px 24px; 
    vertical-align: middle;
    font-size: 0.85rem;
    border-top: none;
    border-bottom: none;
}

/* --- Table Rows --- */
.admin-table tbody tr { 
    background: #f8fafc; 
    border-radius: 12px;
    box-shadow: 0 5px 15px rgba(0,0,0,0.04); 
    transition: transform 0.3s, box-shadow 0.3s;
}
.admin-table tbody tr:hover { 
    transform: translateY(-2px);
    box-shadow: 0 15px 35px rgba(0,0,0,0.08);
    background: #f1f5f9;
}

/* --- Avatar Circle --- */
.client-avatar {
    width: 36px; height: 36px; 
    border-radius: 50%; 
    background: #e2e8f0; 
    display: flex; 
    align-items: center; 
    justify-content: center; 
    font-weight: 700; 
    color: #1e293b; 
    font-size: 0.85rem;
}

/* --- Status Badges --- */
.status-badge { 
    padding: 6px 14px; 
    border-radius: 99px; 
    font-size: 0.7rem; 
    font-weight: 700; 
    text-transform: uppercase;
    letter-spacing: 0.02em; 
    transition: all 0.2s;
}
.status-active { background: #dcfce7; color: #166534; border: 1px solid #bbf7d0; }
.status-inactive { background: #fee2e2; color: #991b1b; border: 1px solid #fecaca; }

/* --- Action Buttons --- */
.btn-action { 
    background: #f1f5f9; 
    color: #475569; 
    border: none; 
    padding: 8px 16px; 
    border-radius: 10px; 
    cursor: pointer; 
    font-weight: 600; 
    margin-right: 6px;
    transition: transform 0.2s, background 0.2s;
}
.btn-action:hover { 
    background: #e2e8f0; 
    transform: translateY(-2px);
}

/* --- Responsive --- */
@media (max-width: 768px) {
    #searchInput { width: 100%; margin-bottom: 12px; }
    .admin-table th, .admin-table td { padding: 12px 16px; font-size: 0.8rem; }
}
</style>

<div class="admin-card">
    <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:16px;">
        <div>
            <h2 style="margin:0;">Registered Guests</h2>
            <p style="margin:5px 0 0;">Managing your sanctuary's community</p>
        </div>
        <div>
            <input type="text" id="searchInput" placeholder="Search by name or email..." onkeyup="filterClients()">
        </div>
    </div>

    <table class="admin-table">
        <thead>
            <tr>
                <th>User ID</th>
                <th>Full Name</th>
                <th>Email Address</th>
                <th>Account Type</th>
                <th>Status</th>
                <th>Action</th>
            </tr>
        </thead>
        <tbody>
            <% clients.forEach(client => { %>
            <tr class="client-row" data-name="<%= client.username %>" data-email="<%= client.email %>">
                <td>#<%= client.id %></td>
                <td>
                    <div style="display:flex; align-items:center; gap:8px;">
                        <div style="width:32px; height:32px; border-radius:50%; background:#e2e8f0; display:flex; align-items:center; justify-content:center; font-weight:700; color:#1e293b;">
                            <%= client.username.charAt(0).toUpperCase() %>
                        </div>
                        <span><%= client.username %></span>
                    </div>
                </td>
                <td><%= client.email %></td>
                <td><span class="status-badge status-active"><%= client.role.toUpperCase() %></span></td>
                <td><span class="status-badge status-active">ACTIVE</span></td>
                <td>
                    <button class="btn-action" onclick="contactClient('<%= client.email %>')">Contact</button>
                    <button class="btn-action" onclick="viewHistory('<%= client.id %>')">History</button>
                </td>
            </tr>
            <% }) %>
        </tbody>
    </table>
</div>

<script>
function filterClients() {
    const filter = document.getElementById('searchInput').value.toLowerCase();
    document.querySelectorAll('.client-row').forEach(row => {
        const name = row.dataset.name.toLowerCase();
        const email = row.dataset.email.toLowerCase();
        row.style.display = (name.includes(filter) || email.includes(filter)) ? '' : 'none';
    });
}

function contactClient(email) {
    alert(`Open email client to contact: ${email}`);
}

function viewHistory(clientId) {
    // Implement modal or redirect to booking history page for this client
    window.location.href = `/admin/clients/${clientId}/history`;
}
</script>