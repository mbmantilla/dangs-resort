    }

    .email-chip {
        color: var(--client-ocean-700);
        background: var(--client-ocean-50);
        max-width: 280px;
        overflow: hidden;
        text-overflow: ellipsis;
    }

    .client-name-cell {
        display: flex;
        align-items: center;
        gap: 13px;
        min-width: 210px;
    }

    .client-avatar {
        width: 50px;
        height: 50px;
        min-width: 50px;
        border-radius: 19px;
        display: grid;
        place-items: center;
        color: white;
        font-weight: 950;
        background:
            radial-gradient(circle at 30% 25%, rgba(255, 255, 255, 0.36), transparent 26%),
            linear-gradient(135deg, var(--client-ocean-500), var(--client-sea-500));
        box-shadow: 0 14px 30px rgba(8, 145, 178, 0.22);
    }

    .client-name {
        display: block;
        color: var(--client-text-main);
        font-size: 0.98rem;
        font-weight: 950;
        line-height: 1.2;
    }

    .client-sub {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        margin-top: 5px;
        color: var(--client-text-muted);
        font-size: 0.74rem;
        font-weight: 800;
    }

    .status-badge {
        min-height: 38px;
        padding: 0 13px;
        border-radius: var(--client-radius-full);
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        font-size: 0.70rem;
        font-weight: 950;
        letter-spacing: 0.08em;
        text-transform: uppercase;
        white-space: nowrap;
        border: 1px solid transparent;
    }

    .status-active,
    .role-customer {
        color: var(--client-emerald-700);
        background: var(--client-emerald-100);
        border-color: rgba(16, 185, 129, 0.18);
    }

    .status-inactive {
        color: var(--client-rose-700);
        background: var(--client-rose-100);
        border-color: rgba(244, 63, 94, 0.18);
    }

    .role-admin {
        color: var(--client-indigo-700);
        background: var(--client-indigo-100);
        border-color: rgba(99, 102, 241, 0.18);
    }

    .role-neutral {
        color: var(--client-slate-700);
        background: var(--client-slate-100);
        border-color: rgba(148, 163, 184, 0.22);
    }

    .action-buttons {
        display: flex;
        align-items: center;
        justify-content: flex-start;
        gap: 9px;
        flex-wrap: wrap;
        min-width: 230px;
    }

    .btn-action,
    .btn-soft {
        min-height: 42px;
        padding: 0 14px;
        border: 0;
        border-radius: 15px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        cursor: pointer;
        text-decoration: none;
        font-size: 0.72rem;
        font-weight: 950;
        letter-spacing: 0.06em;
        text-transform: uppercase;
        transition:
            transform 0.22s var(--client-ease),
            box-shadow 0.22s var(--client-ease),
            background 0.22s var(--client-ease);
    }

    .btn-action {
        color: var(--client-ocean-700);
        background: var(--client-ocean-50);
        border: 1px solid rgba(6, 182, 212, 0.16);
    }

    .btn-action:hover {
        transform: translateY(-2px);
        background: var(--client-ocean-100);
        box-shadow: 0 12px 28px rgba(8, 145, 178, 0.15);
    }

    .btn-soft {
        color: var(--client-text-soft);
        background: var(--client-slate-100);
        border: 1px solid rgba(148, 163, 184, 0.18);
    }

    .btn-soft:hover {
        transform: translateY(-2px);
        background: white;
        box-shadow: var(--client-shadow-xs);
    }

    .mobile-client-grid {
        display: none;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 16px;
    }

    .client-card {
        position: relative;
        border-radius: 30px;
        overflow: hidden;
        background: rgba(255, 255, 255, 0.88);
        border: 1px solid rgba(255, 255, 255, 0.82);
        box-shadow: var(--client-shadow-sm);
        backdrop-filter: blur(18px);
        transition:
            transform 0.28s var(--client-ease),
            box-shadow 0.28s var(--client-ease);
    }

    .client-card:hover {
        transform: translateY(-6px);
        box-shadow: var(--client-shadow-md);
    }

    .client-card-top {
        position: relative;
        min-height: 150px;
        padding: 20px;
        color: white;
        background:
            radial-gradient(circle at 16% 16%, rgba(255, 255, 255, 0.20), transparent 30%),
            linear-gradient(135deg, var(--client-ocean-700), var(--client-sea-700));
        overflow: hidden;
    }

    .client-card-top::after {
        content: "";
        position: absolute;
        right: -65px;
        bottom: -85px;
        width: 180px;
        height: 180px;
        border-radius: var(--client-radius-full);
        background: rgba(255, 255, 255, 0.12);
    }

    .client-card-head {
        position: relative;
        z-index: 2;
        display: flex;
        align-items: flex-start;
        justify-content: space-between;
        gap: 14px;
    }

    .client-card-avatar {
        width: 62px;
        height: 62px;
        min-width: 62px;
        border-radius: 24px;
        display: grid;
        place-items: center;
        color: var(--client-slate-950);
        background: white;
        box-shadow: 0 18px 40px rgba(2, 6, 23, 0.18);
        font-size: 1.3rem;
        font-weight: 950;
    }

    .client-card-title {
        position: relative;
        z-index: 2;
        margin-top: 18px;
    }

    .client-card-title strong {
        display: block;
        color: white;
        font-size: 1.25rem;
        font-weight: 950;
        line-height: 1.2;
    }

    .client-card-title span {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        margin-top: 6px;
        color: rgba(255, 255, 255, 0.76);
        font-size: 0.78rem;
        font-weight: 800;
        word-break: break-word;
    }

    .client-card-body {
        padding: 20px;
    }

    .client-meta-list {
        display: grid;
        gap: 10px;
        margin-bottom: 16px;
    }

    .client-meta-row {
        min-height: 42px;
        padding: 0 12px;
        border-radius: 16px;
        display: flex;
        align-items: center;
        gap: 10px;
        color: var(--client-text-soft);
        background: var(--client-slate-50);
        border: 1px solid rgba(148, 163, 184, 0.14);
        font-size: 0.82rem;
        font-weight: 800;
    }

    .client-meta-row i {
        color: var(--client-ocean-600);
    }

    .client-card-actions {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 9px;
    }

    .empty-state {
        position: relative;
        padding: 56px 24px;
        text-align: center;
        border-radius: 34px;
        background: rgba(255, 255, 255, 0.88);
        border: 1px dashed rgba(8, 145, 178, 0.30);
        box-shadow: var(--client-shadow-sm);
        overflow: hidden;
    }

    .empty-state::before {
        content: "";
        position: absolute;
        top: -120px;
        right: -90px;
        width: 240px;
        height: 240px;
        border-radius: var(--client-radius-full);
        background: rgba(6, 182, 212, 0.10);
    }

    .empty-icon {
        width: 78px;
        height: 78px;
        margin: 0 auto 18px;
        border-radius: 28px;
        display: grid;
        place-items: center;
        color: white;
        font-size: 1.8rem;
        background: linear-gradient(135deg, var(--client-ocean-500), var(--client-sea-500));
        box-shadow: var(--client-shadow-ocean);
    }

    .empty-state h3 {
        margin: 0 0 8px;
        color: var(--client-text-main);
        font-family: var(--client-font-display);
        font-size: 1.8rem;
        font-weight: 400;
    }

    .empty-state p {
        max-width: 460px;
        margin: 0 auto 22px;
        color: var(--client-text-soft);
        line-height: 1.7;
    }

    .client-modal {
        position: fixed;
        inset: 0;
        z-index: 1000;
        display: none;
        align-items: center;
        justify-content: center;
        padding: 22px;
        background: rgba(15, 23, 42, 0.56);
        backdrop-filter: blur(10px);
    }

    .client-modal.show {
        display: flex;
        animation: clientFadeIn 0.24s ease both;
    }

    .client-modal-card {
        position: relative;
        width: min(640px, 100%);
        max-height: calc(100vh - 44px);
        overflow-y: auto;
        border-radius: 34px;
        background: rgba(255, 255, 255, 0.96);
        border: 1px solid rgba(255, 255, 255, 0.82);
        box-shadow: var(--client-shadow-xl);
        animation: clientModalPop 0.36s var(--client-ease-bounce) both;
    }

    .client-modal-header {
        position: relative;
        padding: 28px 28px 0;
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        gap: 18px;
    }

    .client-modal-title-wrap {
        display: flex;
        align-items: flex-start;
        gap: 14px;
    }

    .client-modal-icon {
        width: 52px;
        height: 52px;
        min-width: 52px;
        border-radius: 20px;
        display: grid;
        place-items: center;
        color: white;
        background: linear-gradient(135deg, var(--client-ocean-500), var(--client-sea-500));
        box-shadow: 0 16px 34px rgba(8, 145, 178, 0.22);
    }

    .client-modal-title {
        margin: 0;
        color: var(--client-text-main);
        font-size: 1.35rem;
        font-weight: 950;
        letter-spacing: -0.02em;
    }

    .client-modal-subtitle {
        margin: 6px 0 0;
        color: var(--client-text-muted);
        font-size: 0.86rem;
        line-height: 1.55;
    }

    .modal-close {
        width: 42px;
        height: 42px;
        border: 0;
        border-radius: 16px;
        display: grid;
        place-items: center;
        cursor: pointer;
        color: var(--client-text-soft);
        background: var(--client-slate-100);
        transition:
            transform 0.22s var(--client-ease),
            background 0.22s var(--client-ease);
    }

    .modal-close:hover {
        transform: rotate(90deg);
        color: white;
        background: var(--client-rose-500);
    }

    .client-modal-content {
        padding: 26px 28px 28px;
    }

    .client-detail-grid {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 14px;
    }

    .client-detail-item {
        min-height: 74px;
        padding: 16px;
        border-radius: 22px;
        background: var(--client-card-muted);
        border: 1px solid rgba(148, 163, 184, 0.16);
    }

    .client-detail-item.full {
        grid-column: 1 / -1;
    }

    .client-detail-label {
        display: flex;
        align-items: center;
        gap: 8px;
        color: var(--client-ocean-700);
        font-size: 0.68rem;
        font-weight: 950;
        letter-spacing: 0.10em;
        text-transform: uppercase;
        margin-bottom: 7px;
    }

    .client-detail-value {
        color: var(--client-text-main);
        font-size: 0.94rem;
        font-weight: 850;
        line-height: 1.5;
        overflow-wrap: anywhere;
    }

    .toast {
        position: fixed;
        left: 50%;
        bottom: 28px;
        z-index: 1100;
        min-width: min(440px, calc(100% - 32px));
        padding: 15px 16px;
        border-radius: 20px;
        display: flex;
        align-items: center;
        gap: 12px;
        color: white;
        background: rgba(15, 23, 42, 0.92);
        border: 1px solid rgba(255, 255, 255, 0.12);
        box-shadow: var(--client-shadow-lg);
        backdrop-filter: blur(18px);
        transform: translate(-50%, 30px);
        opacity: 0;
        pointer-events: none;
        transition:
            transform 0.28s var(--client-ease),
            opacity 0.28s var(--client-ease);
    }

    .toast.show {
        transform: translate(-50%, 0);
        opacity: 1;
    }

    .toast i {
        color: var(--client-sand-300);
    }

    .footer-clients {
        position: relative;
        margin-top: 28px;
        padding: 28px;
        border-radius: 34px;
        color: white;
        overflow: hidden;
        background:
            linear-gradient(135deg, var(--client-slate-950), var(--client-ocean-900) 52%, var(--client-sea-800));
        box-shadow: var(--client-shadow-lg);
    }

    .footer-clients::before {
        content: "";
        position: absolute;
        width: 280px;
        height: 280px;
        right: -120px;
        top: -150px;
        border-radius: var(--client-radius-full);
        background: rgba(255, 255, 255, 0.12);
    }

    .footer-clients-content {
        position: relative;
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 24px;
    }

    .footer-clients h3 {
        margin: 0 0 8px;
        font-family: var(--client-font-display);
        font-size: 1.8rem;
        font-weight: 400;
    }

    .footer-clients p {
        margin: 0;
        color: rgba(226, 232, 240, 0.76);
        line-height: 1.7;
    }

    @keyframes clientFadeIn {
        from {
            opacity: 0;
        }

        to {
            opacity: 1;
        }
    }

    @keyframes clientModalPop {
        from {
            opacity: 0;
            transform: translateY(22px) scale(0.96);
        }

        to {
            opacity: 1;
            transform: translateY(0) scale(1);
        }
    }

    @media (max-width: 1280px) {
        .client-hero-inner {
            grid-template-columns: 1fr;
        }

        .client-overview-strip {
            grid-template-columns: repeat(2, minmax(0, 1fr));
            margin-top: 20px;
            margin-left: 0;
            margin-right: 0;
        }
    }

    @media (max-width: 980px) {
        .section-heading {
            align-items: flex-start;
            flex-direction: column;
            gap: 10px;
        }

        .section-heading p {
            max-width: 100%;
            text-align: left;
        }

        .toolbar-card {
            grid-template-columns: 1fr;
        }

        .admin-table {
            display: none;
        }

        .mobile-client-grid {
            display: grid;
        }
    }

    @media (max-width: 720px) {
        .client-hero {
            padding: 26px;
            border-radius: 30px;
        }

        .hero-title {
            font-size: clamp(2.1rem, 12vw, 3.5rem);
        }

        .hero-actions {
            align-items: stretch;
            flex-direction: column;
        }

        .hero-btn,
        .btn-add {
            width: 100%;
        }

        .client-overview-strip,
        .mobile-client-grid,
        .client-detail-grid {
            grid-template-columns: 1fr;
        }

        .admin-card-inner {
            padding: 20px;
        }

        .client-card-actions {
            grid-template-columns: 1fr;
        }

        .footer-clients-content {
            align-items: flex-start;
            flex-direction: column;
        }
    }

    @media (max-width: 520px) {
        .client-hero {
            padding: 22px;
            border-radius: 26px;
        }

        .hero-eyebrow,
        .section-kicker {
            font-size: 0.62rem;
            letter-spacing: 0.10em;
        }

        .hero-copy {
            font-size: 0.92rem;
        }

        .overview-pill {
            min-height: 94px;
            border-radius: 24px;
        }

        .admin-card,
        .client-card,
        .client-modal-card {
            border-radius: 26px;
        }

        .client-modal {
            padding: 14px;
        }
    }

    @media print {
        .client-orb,
        .client-noise,
        .hero-actions,
        .toolbar-card,
        .client-modal,
        .toast {
            display: none !important;
        }

        .clients-page::before,
        .clients-page::after {
            display: none !important;
        }

        .client-hero,
        .admin-card,
        .client-card,
        .overview-pill,
        .footer-clients {
            box-shadow: none !important;
        }
    }

    @media (prefers-reduced-motion: reduce) {
        .clients-page *,
        .clients-page *::before,
        .clients-page *::after {
            animation-duration: 0.01ms !important;
            animation-iteration-count: 1 !important;
            scroll-behavior: auto !important;
            transition-duration: 0.01ms !important;
        }
    }
</style>

<div class="clients-page">
    <span class="client-orb one"></span>
    <span class="client-orb two"></span>
    <span class="client-orb three"></span>
    <div class="client-noise"></div>

    <section class="client-hero">
        <div class="client-hero-inner">
            <div>
                <span class="hero-eyebrow">
                    <i class="fa-solid fa-users"></i>
                    Guest Community
                </span>

                <h1 class="hero-title">
                    Registered guests<span>.</span>
                </h1>

                <p class="hero-copy">
                    Manage the resort community, contact guests, and open each customer's booking history from a modern animated admin interface.
                </p>

                <div class="hero-actions">
                    <a href="/admin/bookings" class="hero-btn">
                        <i class="fa-solid fa-calendar-check"></i>
                        View Bookings
                    </a>

                    <a href="/admin/reports" class="hero-btn ghost">
                        <i class="fa-solid fa-chart-line"></i>
                        Open Reports
                    </a>
                </div>
            </div>

            <article class="hero-live-card">
                <div class="live-card-icon">
                    <i class="fa-solid fa-user-group"></i>
                </div>

                <span class="live-card-label">
                    Total Guests
                </span>

                <strong class="live-card-value">
                    <%= totalClients %>
                </strong>

                <p class="live-card-copy">
                    Registered customer accounts currently stored in the resort management system.
                </p>
            </article>
        </div>
    </section>

    <section class="client-overview-strip" aria-label="Client summary">
        <article class="overview-pill">
            <div class="overview-icon">
                <i class="fa-solid fa-users"></i>
            </div>

            <div class="overview-copy">
                <strong><%= totalClients %></strong>
                <span>Total Accounts</span>
            </div>
        </article>

        <article class="overview-pill">
            <div class="overview-icon customer">
                <i class="fa-solid fa-user-check"></i>
            </div>

            <div class="overview-copy">
                <strong><%= customerCount %></strong>
                <span>Customers</span>
            </div>
        </article>

        <article class="overview-pill">
            <div class="overview-icon admin">
                <i class="fa-solid fa-shield-halved"></i>
            </div>

            <div class="overview-copy">
                <strong><%= activeCount %></strong>
                <span>Active</span>
            </div>
        </article>

        <article class="overview-pill">
            <div class="overview-icon domain">
                <i class="fa-solid fa-envelope"></i>
            </div>

            <div class="overview-copy">
                <strong><%= uniqueDomains %></strong>
                <span>Email Domains</span>
            </div>
        </article>
    </section>

    <div class="section-heading">
        <div>
            <span class="section-kicker">
                <i class="fa-solid fa-address-book"></i>
                Client Directory
            </span>

            <h2>
                Guest accounts
            </h2>
        </div>

        <p>
            Search by name, email, role, or ID. Use contact for email communication and history to review a client's reservations.
        </p>
    </div>

    <section class="toolbar-card">
        <div class="search-wrap">
            <i class="fa-solid fa-magnifying-glass"></i>

            <input 
                type="search" 
                id="searchInput" 
                class="search-input" 
                placeholder="Search by name, email, role, or ID..."
                onkeyup="filterClients()"
            >
        </div>

        <div class="filter-wrap">
            <i class="fa-solid fa-filter"></i>

            <select id="roleFilter" class="filter-select" onchange="filterClients()">
                <option value="all">All Roles</option>
                <option value="customer">Customers</option>
                <option value="admin">Administrators</option>
            </select>
        </div>

        <button type="button" class="btn-add" onclick="window.location.reload()">
            <i class="fa-solid fa-rotate-right"></i>
            Refresh
        </button>
    </section>

    <% if (safeClients.length > 0) { %>
        <section class="admin-card">
            <div class="admin-card-inner">
                <div class="table-shell">
                    <table class="admin-table">
                        <thead>
                            <tr>
                                <th>User ID</th>
                                <th>Full Name</th>
                                <th>Email Address</th>
                                <th>Account Type</th>
                                <th>Status</th>
                                <th>Action</th>
                            </tr>
                        </thead>

                        <tbody id="clientTableBody">
                            <% safeClients.forEach(function (client) { 
                                const username = client.username || 'Guest User';
                                const email = client.email || 'No Email';
                                const role = client.role || 'customer';
                                const roleClass = getRoleClass(role);
                                const clientPayload = {
                                    id: String(client.id || ''),
                                    username: String(username),
                                    email: String(email),
                                    role: String(role)
                                };
                                const searchable = [
                                    client.id || '',
                                    username,
                                    email,
                                    role
                                ].join(' ').toLowerCase();
                            %>
                                <tr 
                                    class="client-row" 
                                    data-name="<%= String(username).toLowerCase() %>" 
                                    data-email="<%= String(email).toLowerCase() %>"
                                    data-role="<%= String(role).toLowerCase() %>"
                                    data-search="<%= searchable %>"
                                >
                                    <td>
                                        <span class="client-id-chip">
                                            <i class="fa-solid fa-hashtag"></i>
                                            <%= client.id %>
                                        </span>
                                    </td>

                                    <td>
                                        <div class="client-name-cell">
                                            <div class="client-avatar">
                                                <%= getAvatarLetter(username) %>
                                            </div>

                                            <div>
                                                <strong class="client-name">
                                                    <%= username %>
                                                </strong>

                                                <span class="client-sub">
                                                    <i class="fa-solid fa-user"></i>
                                                    Guest Profile
                                                </span>
                                            </div>
                                        </div>
                                    </td>

                                    <td>
                                        <span class="email-chip" title="<%= email %>">
                                            <i class="fa-solid fa-envelope"></i>
                                            <%= email %>
                                        </span>
                                    </td>

                                    <td>
                                        <span class="status-badge role-<%= roleClass %>">
                                            <i class="fa-solid <%= roleClass === 'admin' ? 'fa-shield-halved' : roleClass === 'customer' ? 'fa-user-check' : 'fa-circle-info' %>"></i>
                                            <%= readableRole(role) %>
                                        </span>
                                    </td>

                                    <td>
                                        <span class="status-badge status-active">
                                            <i class="fa-solid fa-circle-check"></i>
                                            Active
                                        </span>
                                    </td>

                                    <td>
                                        <div class="action-buttons">
                                            <button 
                                                type="button" 
                                                class="btn-action"
                                                onclick="contactClient('<%= encodeURIComponent(email) %>')"
                                            >
                                                <i class="fa-solid fa-envelope-open-text"></i>
                                                Contact
                                            </button>

                                            <button 
                                                type="button" 
                                                class="btn-action"
                                                onclick="viewHistory('<%= client.id %>')"
                                            >
                                                <i class="fa-solid fa-clock-rotate-left"></i>
                                                History
                                            </button>

                                            <button 
                                                type="button" 
                                                class="btn-soft client-details-btn"
                                                data-client="<%- encodeURIComponent(JSON.stringify(clientPayload)) %>"
                                            >
                                                <i class="fa-solid fa-eye"></i>
                                                Details
                                            </button>
                                        </div>
                                    </td>
                                </tr>
                            <% }) %>
                        </tbody>
                    </table>
                </div>

                <div class="mobile-client-grid" id="mobileClientGrid">
                    <% safeClients.forEach(function (client) { 
                        const username = client.username || 'Guest User';
                        const email = client.email || 'No Email';
                        const role = client.role || 'customer';
                        const roleClass = getRoleClass(role);
                        const clientPayload = {
                            id: String(client.id || ''),
                            username: String(username),
                            email: String(email),
                            role: String(role)
                        };
                        const searchable = [
                            client.id || '',
                            username,
                            email,
                            role
                        ].join(' ').toLowerCase();
                    %>
                        <article 
                            class="client-card client-row"
                            data-name="<%= String(username).toLowerCase() %>" 
                            data-email="<%= String(email).toLowerCase() %>"
                            data-role="<%= String(role).toLowerCase() %>"
                            data-search="<%= searchable %>"
                        >
                            <div class="client-card-top">
                                <div class="client-card-head">
                                    <div class="client-card-avatar">
                                        <%= getAvatarLetter(username) %>
                                    </div>

                                    <span class="status-badge status-active">
                                        <i class="fa-solid fa-circle-check"></i>
                                        Active
                                    </span>
                                </div>

                                <div class="client-card-title">
                                    <strong><%= username %></strong>
                                    <span>
                                        <i class="fa-solid fa-envelope"></i>
                                        <%= email %>
                                    </span>
                                </div>
                            </div>

                            <div class="client-card-body">
                                <div class="client-meta-list">
                                    <div class="client-meta-row">
                                        <i class="fa-solid fa-hashtag"></i>
                                        <span>User ID: <%= client.id %></span>
                                    </div>

                                    <div class="client-meta-row">
                                        <i class="fa-solid <%= roleClass === 'admin' ? 'fa-shield-halved' : 'fa-user-check' %>"></i>
                                        <span><%= readableRole(role) %></span>
                                    </div>
                                </div>

                                <div class="client-card-actions">
                                    <button 
                                        type="button" 
                                        class="btn-action"
                                        onclick="contactClient('<%= encodeURIComponent(email) %>')"
                                    >
                                        <i class="fa-solid fa-envelope"></i>
                                        Contact
                                    </button>

                                    <button 
                                        type="button" 
                                        class="btn-action"
                                        onclick="viewHistory('<%= client.id %>')"
                                    >
                                        <i class="fa-solid fa-clock-rotate-left"></i>
                                        History
                                    </button>

                                    <button 
                                        type="button" 
                                        class="btn-soft client-details-btn"
                                        data-client="<%- encodeURIComponent(JSON.stringify(clientPayload)) %>"
                                    >
                                        <i class="fa-solid fa-eye"></i>
                                        Details
                                    </button>
                                </div>
                            </div>
                        </article>
                    <% }) %>
                </div>
            </div>
        </section>
    <% } else { %>
        <section class="empty-state">
            <div class="empty-icon">
                <i class="fa-solid fa-user-slash"></i>
            </div>

            <h3>No registered guests yet</h3>

            <p>
                Customer accounts will appear here once guests register or make reservations through the system.
            </p>

            <a href="/admin/bookings" class="hero-btn" style="margin:0 auto;">
                <i class="fa-solid fa-calendar-check"></i>
                View Bookings
            </a>
        </section>
    <% } %>

    <section class="footer-clients">
        <div class="footer-clients-content">
            <div>
                <h3>
                    Keep guest relationships organized.
                </h3>

                <p>
                    Use guest history and contact actions to support better reservation service and follow-ups.
                </p>
            </div>

            <a href="/admin/reports" class="hero-btn">
                <i class="fa-solid fa-chart-line"></i>
                Open Reports
            </a>
        </div>
    </section>
</div>

<div class="client-modal" id="clientModal">
    <div class="client-modal-card">
        <div class="client-modal-header">
            <div class="client-modal-title-wrap">
                <div class="client-modal-icon">
                    <i class="fa-solid fa-id-card"></i>
                </div>

                <div>
                    <h3 class="client-modal-title">
                        Client Details
                    </h3>

                    <p class="client-modal-subtitle">
                        Quick overview of the selected guest account.
                    </p>
                </div>
            </div>

            <button type="button" class="modal-close" onclick="closeClientModal()" aria-label="Close modal">
                <i class="fa-solid fa-xmark"></i>
            </button>
        </div>

        <div class="client-modal-content" id="clientModalContent">
            <!-- Filled by JavaScript -->
        </div>
    </div>
</div>

<div class="toast" id="clientToast">
    <i class="fa-solid fa-circle-info"></i>
    <span id="clientToastMessage">Client action completed.</span>
</div>

<script>
    const searchInput = document.getElementById('searchInput');
    const roleFilter = document.getElementById('roleFilter');
    const clientModal = document.getElementById('clientModal');
    const clientModalContent = document.getElementById('clientModalContent');
    const clientToast = document.getElementById('clientToast');
    const clientToastMessage = document.getElementById('clientToastMessage');

    function showToast(message) {
        if (!clientToast || !clientToastMessage) return;

        clientToastMessage.textContent = message;
        clientToast.classList.add('show');

        setTimeout(function () {
            clientToast.classList.remove('show');
        }, 3000);
    }

    function escapeHtml(value) {
        return String(value ?? '')
            .replaceAll('&', '&amp;')
            .replaceAll('<', '&lt;')
            .replaceAll('>', '&gt;')
            .replaceAll('"', '&quot;')
            .replaceAll("'", '&#039;');
    }

    function filterClients() {
        const keyword = searchInput ? searchInput.value.trim().toLowerCase() : '';
        const roleValue = roleFilter ? roleFilter.value.toLowerCase() : 'all';
        const clientRows = document.querySelectorAll('.client-row');

        clientRows.forEach(function (row) {
            const searchable = row.dataset.search || '';
            const role = row.dataset.role || '';

            const matchesKeyword = !keyword || searchable.includes(keyword);
            const matchesRole = roleValue === 'all' || role === roleValue;

            row.style.display = matchesKeyword && matchesRole ? '' : 'none';
        });
    }

    function contactClient(encodedEmail) {
        const email = decodeURIComponent(encodedEmail || '');

        if (!email || email === 'No Email') {
            showToast('This client has no email address.');
            return;
        }

        window.location.href = 'mailto:' + email;
    }

    function viewHistory(clientId) {
        window.location.href = '/admin/clients/' + encodeURIComponent(clientId) + '/history';
    }

    function openClientModal(client) {
        if (!clientModal || !clientModalContent || !client) return;

        clientModalContent.innerHTML = `
            <div class="client-detail-grid">
                <div class="client-detail-item">
                    <div class="client-detail-label">
                        <i class="fa-solid fa-hashtag"></i>
                        User ID
                    </div>
                    <div class="client-detail-value">#${escapeHtml(client.id || '---')}</div>
                </div>

                <div class="client-detail-item">
                    <div class="client-detail-label">
                        <i class="fa-solid fa-user"></i>
                        Full Name
                    </div>
                    <div class="client-detail-value">${escapeHtml(client.username || 'Guest User')}</div>
                </div>

                <div class="client-detail-item full">
                    <div class="client-detail-label">
                        <i class="fa-solid fa-envelope"></i>
                        Email Address
                    </div>
                    <div class="client-detail-value">${escapeHtml(client.email || 'No Email')}</div>
                </div>

                <div class="client-detail-item">
                    <div class="client-detail-label">
                        <i class="fa-solid fa-user-tag"></i>
                        Account Type
                    </div>
                    <div class="client-detail-value">${escapeHtml(client.role || 'customer')}</div>
                </div>

                <div class="client-detail-item">
                    <div class="client-detail-label">
                        <i class="fa-solid fa-circle-check"></i>
                        Status
                    </div>
                    <div class="client-detail-value">
                        <span class="status-badge status-active">
                            <i class="fa-solid fa-circle-check"></i>
                            Active
                        </span>
                    </div>
                </div>
            </div>
        `;

        clientModal.classList.add('show');
        document.body.style.overflow = 'hidden';
    }

    function closeClientModal() {
        if (!clientModal) return;

        clientModal.classList.remove('show');
        document.body.style.overflow = '';
    }

    document.querySelectorAll('.client-details-btn').forEach(function (button) {
        button.addEventListener('click', function () {
            try {
                const payload = JSON.parse(decodeURIComponent(button.dataset.client || '{}'));
                openClientModal(payload);
            } catch (error) {
                console.error('Failed to read client payload:', error);
                showToast('Unable to open client details.');
            }
        });
    });

    if (searchInput) {
        searchInput.addEventListener('input', filterClients);
    }

    if (roleFilter) {
        roleFilter.addEventListener('change', filterClients);
    }

    if (clientModal) {
        clientModal.addEventListener('click', function (event) {
            if (event.target === clientModal) {
                closeClientModal();
            }
        });
    }

    document.addEventListener('keydown', function (event) {
        if (event.key === 'Escape') {
            closeClientModal();
        }
    });
</script>
