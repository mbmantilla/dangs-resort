<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">

    <meta 
        name="viewport" 
        content="width=device-width, initial-scale=1.0"
    >

    <meta 
        name="theme-color" 
        content="#0f766e"
    >

    <title>Dang's Beach Resort | Admin Control Panel</title>

    <!-- Google Fonts -->
    <link 
        href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&family=Tenor+Sans&display=swap" 
        rel="stylesheet"
    >

    <!-- Font Awesome Icons -->
    <link 
        rel="stylesheet" 
        href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css"
    >

    <!-- Chart JS -->
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

    <style>
        :root {
            --sidebar-width: 292px;
            --sidebar-width-collapsed: 92px;

            --primary: #0ea5e9;
            --primary-dark: #0369a1;
            --primary-soft: rgba(14, 165, 233, 0.14);

            --teal: #14b8a6;
            --teal-dark: #0f766e;
            --teal-soft: rgba(20, 184, 166, 0.16);

            --cyan: #22d3ee;
            --blue: #2563eb;
            --indigo: #4f46e5;
            --purple: #7c3aed;

            --success: #22c55e;
            --success-soft: #dcfce7;

            --warning: #f59e0b;
            --warning-soft: #fef3c7;

            --danger: #ef4444;
            --danger-soft: #fee2e2;

            --dark: #0f172a;
            --dark-2: #111827;
            --dark-3: #1e293b;

            --text-main: #0f172a;
            --text-soft: #475569;
            --text-muted: #94a3b8;
            --text-white: #f8fafc;

            --border: rgba(148, 163, 184, 0.22);
            --border-strong: rgba(148, 163, 184, 0.38);

            --page-bg: #eef8fb;
            --card-bg: rgba(255, 255, 255, 0.84);
            --card-bg-solid: #ffffff;

            --glass: rgba(255, 255, 255, 0.70);
            --glass-dark: rgba(15, 23, 42, 0.72);

            --radius-xs: 8px;
            --radius-sm: 12px;
            --radius-md: 18px;
            --radius-lg: 24px;
            --radius-xl: 32px;
            --radius-full: 999px;

            --shadow-sm: 0 8px 22px rgba(15, 23, 42, 0.08);
            --shadow-md: 0 18px 42px rgba(15, 23, 42, 0.11);
            --shadow-lg: 0 28px 80px rgba(15, 23, 42, 0.16);
            --shadow-glow: 0 0 34px rgba(14, 165, 233, 0.28);

            --ease: cubic-bezier(0.22, 1, 0.36, 1);
            --ease-bounce: cubic-bezier(0.34, 1.56, 0.64, 1);
        }

        * {
            box-sizing: border-box;
        }

        *::before,
        *::after {
            box-sizing: border-box;
        }

        html {
            width: 100%;
            height: 100%;
            scroll-behavior: smooth;
        }

        body {
            width: 100%;
            min-height: 100vh;
            margin: 0;
            font-family: 'Inter', sans-serif;
            color: var(--text-main);
            background:
                radial-gradient(circle at top left, rgba(34, 211, 238, 0.20), transparent 34%),
                radial-gradient(circle at top right, rgba(14, 165, 233, 0.18), transparent 30%),
                linear-gradient(135deg, #ecfeff 0%, #f8fafc 42%, #e0f2fe 100%);
            overflow: hidden;
        }

        a {
            color: inherit;
        }

        button,
        input,
        select,
        textarea {
            font-family: inherit;
        }

        ::selection {
            background: rgba(14, 165, 233, 0.22);
            color: var(--dark);
        }

        ::-webkit-scrollbar {
            width: 10px;
            height: 10px;
        }

        ::-webkit-scrollbar-track {
            background: transparent;
        }

        ::-webkit-scrollbar-thumb {
            background: linear-gradient(180deg, var(--primary), var(--teal));
            border-radius: var(--radius-full);
        }

        ::-webkit-scrollbar-thumb:hover {
            background: linear-gradient(180deg, var(--primary-dark), var(--teal-dark));
        }

        .admin-shell {
            position: relative;
            width: 100%;
            height: 100vh;
            display: flex;
            overflow: hidden;
            isolation: isolate;
        }

        .animated-bg {
            position: fixed;
            inset: 0;
            pointer-events: none;
            overflow: hidden;
            z-index: -3;
        }

        .animated-bg .blob {
            position: absolute;
            width: 420px;
            height: 420px;
            border-radius: 999px;
            filter: blur(26px);
            opacity: 0.34;
            animation: blobFloat 14s var(--ease) infinite alternate;
        }

        .animated-bg .blob.one {
            top: -160px;
            left: 240px;
            background: rgba(34, 211, 238, 0.52);
        }

        .animated-bg .blob.two {
            right: -130px;
            bottom: 80px;
            background: rgba(20, 184, 166, 0.44);
            animation-delay: -4s;
        }

        .animated-bg .blob.three {
            left: 48%;
            bottom: -180px;
            background: rgba(37, 99, 235, 0.22);
            animation-delay: -8s;
        }

        .wave-grid {
            position: fixed;
            inset: 0;
            z-index: -2;
            pointer-events: none;
            background-image:
                linear-gradient(rgba(14, 165, 233, 0.045) 1px, transparent 1px),
                linear-gradient(90deg, rgba(14, 165, 233, 0.045) 1px, transparent 1px);
            background-size: 42px 42px;
            mask-image: linear-gradient(to bottom, black 0%, transparent 82%);
        }

        .page-noise {
            position: fixed;
            inset: 0;
            pointer-events: none;
            z-index: -1;
            opacity: 0.045;
            background-image:
                radial-gradient(circle at 25% 25%, #000 1px, transparent 1px),
                radial-gradient(circle at 75% 75%, #000 1px, transparent 1px);
            background-size: 22px 22px;
        }

        @keyframes blobFloat {
            0% {
                transform: translate3d(0, 0, 0) scale(1);
            }

            50% {
                transform: translate3d(44px, 34px, 0) scale(1.08);
            }

            100% {
                transform: translate3d(-28px, 64px, 0) scale(0.96);
            }
        }

        .preloader {
            position: fixed;
            inset: 0;
            z-index: 9999;
            display: grid;
            place-items: center;
            background:
                radial-gradient(circle at top, rgba(34, 211, 238, 0.22), transparent 38%),
                linear-gradient(135deg, #020617, #0f172a 48%, #134e4a);
            transition:
                opacity 0.65s var(--ease),
                visibility 0.65s var(--ease);
        }

        .preloader.hide {
            opacity: 0;
            visibility: hidden;
        }

        .loader-card {
            width: min(420px, calc(100% - 48px));
            padding: 36px;
            border-radius: 34px;
            text-align: center;
            color: white;
            background: rgba(255, 255, 255, 0.10);
            border: 1px solid rgba(255, 255, 255, 0.18);
            box-shadow: 0 30px 90px rgba(0, 0, 0, 0.36);
            backdrop-filter: blur(20px);
            animation: loaderPop 0.7s var(--ease-bounce) both;
        }

        .loader-logo {
            width: 84px;
            height: 84px;
            margin: 0 auto 20px;
            border-radius: 30px;
            display: grid;
            place-items: center;
            background:
                linear-gradient(135deg, rgba(34, 211, 238, 0.95), rgba(20, 184, 166, 0.95));
            box-shadow: 0 0 45px rgba(34, 211, 238, 0.42);
            animation: pulseLogo 1.6s ease-in-out infinite;
        }

        .loader-logo i {
            font-size: 34px;
        }

        .loader-title {
            margin: 0;
            font-family: 'Tenor Sans', serif;
            font-size: 1.45rem;
            letter-spacing: 0.04em;
        }

        .loader-subtitle {
            margin: 10px 0 24px;
            color: rgba(255, 255, 255, 0.72);
            font-size: 0.88rem;
        }

        .loader-bar {
            width: 100%;
            height: 9px;
            border-radius: var(--radius-full);
            overflow: hidden;
            background: rgba(255, 255, 255, 0.15);
        }

        .loader-bar span {
            display: block;
            height: 100%;
            border-radius: inherit;
            background: linear-gradient(90deg, var(--cyan), var(--teal), var(--primary));
            animation: loadingMove 1.2s ease-in-out infinite;
        }

        @keyframes loaderPop {
            from {
                opacity: 0;
                transform: translateY(22px) scale(0.96);
            }

            to {
                opacity: 1;
                transform: translateY(0) scale(1);
            }
        }

        @keyframes pulseLogo {
            0%,
            100% {
                transform: scale(1);
            }

            50% {
                transform: scale(1.07);
            }
        }

        @keyframes loadingMove {
            0% {
                width: 0%;
                transform: translateX(0);
            }

            50% {
                width: 72%;
            }

            100% {
                width: 100%;
            }
        }

        .sidebar {
            position: relative;
            z-index: 10;
            width: var(--sidebar-width);
            height: 100vh;
            padding: 26px 18px;
            color: var(--text-white);
            background:
                linear-gradient(180deg, rgba(2, 6, 23, 0.96) 0%, rgba(15, 23, 42, 0.94) 48%, rgba(19, 78, 74, 0.96) 100%);
            border-right: 1px solid rgba(255, 255, 255, 0.10);
            box-shadow: 18px 0 60px rgba(15, 23, 42, 0.20);
            overflow: hidden;
            display: flex;
            flex-direction: column;
            transition:
                width 0.42s var(--ease),
                transform 0.42s var(--ease);
        }

        .sidebar::before {
            content: "";
            position: absolute;
            inset: -120px -90px auto auto;
            width: 250px;
            height: 250px;
            border-radius: 999px;
            background: rgba(34, 211, 238, 0.18);
            filter: blur(2px);
            animation: orbSpin 12s linear infinite;
        }

        .sidebar::after {
            content: "";
            position: absolute;
            left: -80px;
            bottom: -80px;
            width: 230px;
            height: 230px;
            border-radius: 999px;
            background: rgba(20, 184, 166, 0.20);
            filter: blur(3px);
            animation: orbSpin 16s linear infinite reverse;
        }

        @keyframes orbSpin {
            from {
                transform: rotate(0deg) translateX(16px) rotate(0deg);
            }

            to {
                transform: rotate(360deg) translateX(16px) rotate(-360deg);
            }
        }

        .sidebar-inner {
            position: relative;
            z-index: 2;
            height: 100%;
            display: flex;
            flex-direction: column;
        }

        .brand-card {
            position: relative;
            display: flex;
            align-items: center;
            gap: 14px;
            padding: 16px;
            margin-bottom: 22px;
            border-radius: 26px;
            background: rgba(255, 255, 255, 0.08);
            border: 1px solid rgba(255, 255, 255, 0.12);
            box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.10);
            backdrop-filter: blur(16px);
            overflow: hidden;
            animation: slideInLeft 0.75s var(--ease) both;
        }

        .brand-card::before {
            content: "";
            position: absolute;
            inset: 0;
            background:
                linear-gradient(120deg, transparent, rgba(255, 255, 255, 0.16), transparent);
            transform: translateX(-120%);
            animation: shineMove 4.8s ease-in-out infinite;
        }

        .brand-icon {
            width: 54px;
            height: 54px;
            min-width: 54px;
            border-radius: 20px;
            display: grid;
            place-items: center;
            color: white;
            font-size: 1.35rem;
            background: linear-gradient(135deg, var(--primary), var(--teal));
            box-shadow: 0 18px 40px rgba(14, 165, 233, 0.34);
        }

        .brand-text {
            min-width: 0;
            transition:
                opacity 0.25s var(--ease),
                transform 0.25s var(--ease);
        }

        .brand-title {
            margin: 0;
            font-family: 'Tenor Sans', serif;
            font-size: 1.15rem;
            line-height: 1.05;
            letter-spacing: 0.02em;
            text-transform: uppercase;
        }

        .brand-subtitle {
            display: block;
            margin-top: 7px;
            color: var(--cyan);
            font-size: 0.66rem;
            font-weight: 800;
            letter-spacing: 0.22em;
            text-transform: uppercase;
        }

        .collapse-btn {
            position: absolute;
            top: 26px;
            right: -15px;
            z-index: 30;
            width: 34px;
            height: 34px;
            border: 0;
            border-radius: 999px;
            cursor: pointer;
            color: white;
            background: linear-gradient(135deg, var(--primary), var(--teal));
            box-shadow: 0 10px 26px rgba(14, 165, 233, 0.34);
            display: grid;
            place-items: center;
            transition:
                transform 0.25s var(--ease),
                box-shadow 0.25s var(--ease);
        }

        .collapse-btn:hover {
            transform: scale(1.08);
            box-shadow: 0 16px 34px rgba(14, 165, 233, 0.44);
        }

        .sidebar-section-label {
            margin: 10px 12px 10px;
            color: rgba(255, 255, 255, 0.42);
            font-size: 0.68rem;
            font-weight: 900;
            letter-spacing: 0.18em;
            text-transform: uppercase;
            transition:
                opacity 0.25s var(--ease),
                transform 0.25s var(--ease);
        }

        .sidebar-nav {
            display: grid;
            gap: 8px;
            margin-top: 4px;
        }

        .nav-item {
            position: relative;
            min-height: 52px;
            padding: 0 14px;
            border-radius: 18px;
            display: flex;
            align-items: center;
            gap: 13px;
            color: rgba(226, 232, 240, 0.72);
            text-decoration: none;
            font-size: 0.94rem;
            font-weight: 750;
            overflow: hidden;
            isolation: isolate;
            transition:
                color 0.25s var(--ease),
                background 0.25s var(--ease),
                transform 0.25s var(--ease);
            animation: navRise 0.55s var(--ease) both;
            animation-delay: calc(var(--i) * 0.065s);
        }

        .nav-item::before {
            content: "";
            position: absolute;
            inset: 0;
            z-index: -2;
            border-radius: inherit;
            background: rgba(255, 255, 255, 0.06);
            opacity: 0;
            transition: opacity 0.25s var(--ease);
        }

        .nav-item::after {
            content: "";
            position: absolute;
            left: 8px;
            top: 50%;
            width: 5px;
            height: 0;
            border-radius: 999px;
            background: linear-gradient(180deg, var(--cyan), var(--teal));
            transform: translateY(-50%);
            transition: height 0.25s var(--ease);
        }

        .nav-item:hover {
            color: white;
            transform: translateX(4px);
        }

        .nav-item:hover::before {
            opacity: 1;
        }

        .nav-item.active {
            color: white;
            background:
                linear-gradient(135deg, rgba(14, 165, 233, 0.26), rgba(20, 184, 166, 0.16));
            box-shadow:
                inset 0 1px 0 rgba(255, 255, 255, 0.10),
                0 14px 30px rgba(14, 165, 233, 0.16);
        }

        .nav-item.active::after {
            height: 26px;
        }

        .nav-icon {
            width: 36px;
            height: 36px;
            min-width: 36px;
            border-radius: 14px;
            display: grid;
            place-items: center;
            background: rgba(255, 255, 255, 0.07);
            color: var(--cyan);
            box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.06);
            transition:
                transform 0.25s var(--ease),
                background 0.25s var(--ease),
                color 0.25s var(--ease);
        }

        .nav-item:hover .nav-icon,
        .nav-item.active .nav-icon {
            background: linear-gradient(135deg, var(--primary), var(--teal));
            color: white;
            transform: rotate(-6deg) scale(1.04);
        }

        .nav-label {
            white-space: nowrap;
            transition:
                opacity 0.25s var(--ease),
                transform 0.25s var(--ease);
        }

        .nav-badge {
            margin-left: auto;
            padding: 4px 8px;
            border-radius: 999px;
            color: white;
            font-size: 0.64rem;
            font-weight: 900;
            letter-spacing: 0.02em;
            background: rgba(255, 255, 255, 0.12);
            transition:
                opacity 0.25s var(--ease),
                transform 0.25s var(--ease);
        }

        .sidebar-widget {
            position: relative;
            margin-top: 22px;
            padding: 18px;
            border-radius: 24px;
            overflow: hidden;
            background:
                linear-gradient(145deg, rgba(255, 255, 255, 0.12), rgba(255, 255, 255, 0.06));
            border: 1px solid rgba(255, 255, 255, 0.12);
            box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.08);
            animation: slideInLeft 0.85s var(--ease) both;
            animation-delay: 0.22s;
            transition:
                opacity 0.25s var(--ease),
                transform 0.25s var(--ease);
        }

        .sidebar-widget::before {
            content: "";
            position: absolute;
            width: 150px;
            height: 150px;
            right: -74px;
            top: -80px;
            border-radius: 999px;
            background: rgba(34, 211, 238, 0.22);
        }

        .widget-icon {
            width: 42px;
            height: 42px;
            border-radius: 16px;
            display: grid;
            place-items: center;
            color: white;
            background: linear-gradient(135deg, var(--teal), var(--primary));
            box-shadow: 0 14px 28px rgba(14, 165, 233, 0.26);
            margin-bottom: 14px;
        }

        .widget-title {
            margin: 0 0 6px;
            color: white;
            font-size: 0.92rem;
            font-weight: 850;
        }

        .widget-text {
            margin: 0;
            color: rgba(226, 232, 240, 0.66);
            font-size: 0.76rem;
            line-height: 1.5;
        }

        .sidebar-footer {
            margin-top: auto;
            padding-top: 18px;
            display: grid;
            gap: 10px;
        }

        .footer-line {
            height: 1px;
            background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.18), transparent);
            margin-bottom: 8px;
        }

        .signout-link {
            min-height: 52px;
            padding: 0 14px;
            border-radius: 18px;
            color: #fecaca;
            text-decoration: none;
            display: flex;
            align-items: center;
            gap: 13px;
            font-weight: 850;
            background: rgba(239, 68, 68, 0.08);
            border: 1px solid rgba(239, 68, 68, 0.16);
            transition:
                transform 0.25s var(--ease),
                background 0.25s var(--ease),
                color 0.25s var(--ease);
        }

        .signout-link:hover {
            transform: translateY(-2px);
            background: rgba(239, 68, 68, 0.16);
            color: white;
        }

        .signout-link .nav-icon {
            color: #fecaca;
            background: rgba(239, 68, 68, 0.14);
        }

        .signout-link:hover .nav-icon {
            color: white;
            background: linear-gradient(135deg, #ef4444, #f97316);
        }

        .main-content {
            position: relative;
            flex: 1;
            height: 100vh;
            padding: 28px 38px 38px;
            overflow-y: auto;
            overflow-x: hidden;
            transition:
                margin 0.42s var(--ease),
                padding 0.3s var(--ease);
        }

        .topbar {
            position: sticky;
            top: 0;
            z-index: 20;
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 24px;
            padding: 18px 20px;
            margin-bottom: 28px;
            border-radius: 28px;
            background: rgba(255, 255, 255, 0.76);
            border: 1px solid rgba(255, 255, 255, 0.78);
            box-shadow: 0 18px 50px rgba(15, 23, 42, 0.08);
            backdrop-filter: blur(22px);
            animation: dropIn 0.7s var(--ease) both;
        }

        .topbar-left {
            display: flex;
            align-items: center;
            gap: 16px;
            min-width: 0;
        }

        .mobile-menu-btn {
            width: 46px;
            height: 46px;
            border: 0;
            border-radius: 16px;
            display: none;
            place-items: center;
            cursor: pointer;
            color: white;
            background: linear-gradient(135deg, var(--primary), var(--teal));
            box-shadow: 0 14px 32px rgba(14, 165, 233, 0.28);
        }

        .page-icon {
            width: 58px;
            height: 58px;
            min-width: 58px;
            border-radius: 21px;
            display: grid;
            place-items: center;
            color: white;
            font-size: 1.25rem;
            background:
                linear-gradient(135deg, var(--primary), var(--teal));
            box-shadow: 0 18px 38px rgba(14, 165, 233, 0.28);
            position: relative;
            overflow: hidden;
        }

        .page-icon::after {
            content: "";
            position: absolute;
            inset: -60%;
            background: linear-gradient(120deg, transparent, rgba(255, 255, 255, 0.28), transparent);
            transform: rotate(20deg) translateX(-120%);
            animation: shineMove 5s ease-in-out infinite;
        }

        .page-title-wrap {
            min-width: 0;
        }

        .page-title {
            margin: 0;
            color: var(--text-main);
            font-size: clamp(1.35rem, 2vw, 2.25rem);
            font-weight: 950;
            letter-spacing: -0.04em;
            text-transform: capitalize;
        }

        .page-date {
            margin: 6px 0 0;
            display: flex;
            align-items: center;
            gap: 8px;
            color: var(--text-muted);
            font-size: 0.88rem;
            font-weight: 650;
        }

        .topbar-actions {
            display: flex;
            align-items: center;
            gap: 12px;
            margin-left: auto;
        }

        .quick-action {
            width: 46px;
            height: 46px;
            border: 0;
            border-radius: 17px;
            display: grid;
            place-items: center;
            cursor: pointer;
            color: var(--text-soft);
            background: rgba(255, 255, 255, 0.74);
            border: 1px solid rgba(148, 163, 184, 0.18);
            box-shadow: 0 10px 24px rgba(15, 23, 42, 0.06);
            transition:
                transform 0.25s var(--ease),
                color 0.25s var(--ease),
                background 0.25s var(--ease),
                box-shadow 0.25s var(--ease);
        }

        .quick-action:hover {
            transform: translateY(-3px);
            color: white;
            background: linear-gradient(135deg, var(--primary), var(--teal));
            box-shadow: 0 18px 36px rgba(14, 165, 233, 0.24);
        }

        .admin-user-profile {
            position: relative;
            display: flex;
            align-items: center;
            gap: 12px;
            padding: 8px 10px 8px 16px;
            border-radius: 22px;
            background: rgba(255, 255, 255, 0.74);
            border: 1px solid rgba(148, 163, 184, 0.18);
            box-shadow: 0 12px 28px rgba(15, 23, 42, 0.07);
        }

        .user-copy {
            text-align: right;
            line-height: 1.15;
        }

        .user-name {
            display: block;
            color: var(--text-main);
            font-size: 0.92rem;
            font-weight: 900;
            max-width: 140px;
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
        }

        .user-role {
            display: inline-flex;
            align-items: center;
            gap: 5px;
            margin-top: 5px;
            color: var(--teal-dark);
            font-size: 0.66rem;
            font-weight: 950;
            letter-spacing: 0.06em;
            text-transform: uppercase;
        }

        .avatar-circle {
            width: 52px;
            height: 52px;
            min-width: 52px;
            border-radius: 19px;
            display: grid;
            place-items: center;
            position: relative;
            overflow: hidden;
            color: white;
            font-weight: 950;
            font-size: 1.05rem;
            background:
                radial-gradient(circle at 30% 25%, rgba(255, 255, 255, 0.44), transparent 24%),
                linear-gradient(135deg, var(--primary), var(--teal));
            box-shadow: 0 16px 34px rgba(14, 165, 233, 0.28);
        }

        .avatar-circle::after {
            content: "";
            position: absolute;
            right: 6px;
            bottom: 6px;
            width: 11px;
            height: 11px;
            border-radius: 50%;
            background: var(--success);
            border: 2px solid white;
        }

        .content-panel {
            position: relative;
            z-index: 1;
            animation: contentRise 0.72s var(--ease) both;
        }

        .admin-card,
        .card,
        .dashboard-card,
        .stats-card {
            backdrop-filter: blur(16px);
        }

        .admin-card:hover {
            transform: translateY(-2px);
            transition: transform 0.25s var(--ease);
        }

        .floating-help {
            position: fixed;
            right: 30px;
            bottom: 30px;
            z-index: 50;
            width: 58px;
            height: 58px;
            border: 0;
            border-radius: 22px;
            color: white;
            cursor: pointer;
            display: grid;
            place-items: center;
            background:
                linear-gradient(135deg, var(--primary), var(--teal));
            box-shadow:
                0 20px 48px rgba(14, 165, 233, 0.32),
                0 0 0 8px rgba(14, 165, 233, 0.10);
            transition:
                transform 0.25s var(--ease),
                box-shadow 0.25s var(--ease);
            animation: helpFloat 3s ease-in-out infinite;
        }

        .floating-help:hover {
            transform: translateY(-5px) scale(1.04);
            box-shadow:
                0 28px 60px rgba(14, 165, 233, 0.42),
                0 0 0 10px rgba(14, 165, 233, 0.12);
        }

        .tooltip-card {
            position: fixed;
            right: 30px;
            bottom: 100px;
            z-index: 49;
            width: 280px;
            padding: 18px;
            border-radius: 22px;
            background: rgba(15, 23, 42, 0.90);
            color: white;
            box-shadow: 0 26px 70px rgba(15, 23, 42, 0.32);
            backdrop-filter: blur(18px);
            transform: translateY(12px) scale(0.96);
            opacity: 0;
            pointer-events: none;
            transition:
                transform 0.25s var(--ease),
                opacity 0.25s var(--ease);
        }

        .tooltip-card.show {
            opacity: 1;
            transform: translateY(0) scale(1);
            pointer-events: auto;
        }

        .tooltip-card h4 {
            margin: 0 0 8px;
            font-size: 0.95rem;
        }

        .tooltip-card p {
            margin: 0;
            color: rgba(226, 232, 240, 0.76);
            font-size: 0.8rem;
            line-height: 1.55;
        }

        .screen-overlay {
            position: fixed;
            inset: 0;
            z-index: 8;
            display: none;
            background: rgba(2, 6, 23, 0.52);
            backdrop-filter: blur(6px);
        }

        .screen-overlay.show {
            display: block;
            animation: fadeIn 0.22s ease both;
        }

        body.sidebar-collapsed .sidebar {
            width: var(--sidebar-width-collapsed);
        }

        body.sidebar-collapsed .brand-text,
        body.sidebar-collapsed .sidebar-section-label,
        body.sidebar-collapsed .nav-label,
        body.sidebar-collapsed .nav-badge,
        body.sidebar-collapsed .sidebar-widget,
        body.sidebar-collapsed .signout-link span:not(.nav-icon) {
            opacity: 0;
            transform: translateX(-8px);
            pointer-events: none;
        }

        body.sidebar-collapsed .brand-card {
            padding: 14px;
            justify-content: center;
        }

        body.sidebar-collapsed .brand-icon {
            margin: 0;
        }

        body.sidebar-collapsed .nav-item {
            justify-content: center;
            padding: 0;
        }

        body.sidebar-collapsed .nav-item::after {
            left: 5px;
        }

        body.sidebar-collapsed .nav-icon {
            margin: 0;
        }

        body.sidebar-collapsed .signout-link {
            justify-content: center;
            padding: 0;
        }

        body.sidebar-collapsed .collapse-btn i {
            transform: rotate(180deg);
        }

        @keyframes slideInLeft {
            from {
                opacity: 0;
                transform: translateX(-22px);
            }

            to {
                opacity: 1;
                transform: translateX(0);
            }
        }

        @keyframes navRise {
            from {
                opacity: 0;
                transform: translateX(-18px);
            }

            to {
                opacity: 1;
                transform: translateX(0);
            }
        }

        @keyframes dropIn {
            from {
                opacity: 0;
                transform: translateY(-18px);
            }

            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        @keyframes contentRise {
            from {
                opacity: 0;
                transform: translateY(18px);
            }

            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        @keyframes shineMove {
            0% {
                transform: translateX(-120%);
            }

            42%,
            100% {
                transform: translateX(130%);
            }
        }

        @keyframes helpFloat {
            0%,
            100% {
                transform: translateY(0);
            }

            50% {
                transform: translateY(-8px);
            }
        }

        @keyframes fadeIn {
            from {
                opacity: 0;
            }

            to {
                opacity: 1;
            }
        }

        @media print {
            body {
                overflow: auto;
                background: white;
            }

            .sidebar,
            .topbar-actions,
            .floating-help,
            .tooltip-card,
            .screen-overlay,
            .preloader,
            .animated-bg,
            .wave-grid,
            .page-noise,
            .collapse-btn,
            .mobile-menu-btn {
                display: none !important;
            }

            .admin-shell {
                display: block;
                height: auto;
                overflow: visible;
            }

            .main-content {
                height: auto;
                overflow: visible;
                padding: 0;
            }

            .topbar {
                position: static;
                box-shadow: none;
                border: none;
                padding: 0 0 18px;
                margin-bottom: 22px;
                background: white;
            }

            .content-panel {
                animation: none;
            }
        }

        @media (max-width: 1180px) {
            .topbar {
                align-items: flex-start;
                flex-direction: column;
            }

            .topbar-actions {
                width: 100%;
                justify-content: flex-end;
            }
        }

        @media (max-width: 980px) {
            body {
                overflow: hidden;
            }

            .sidebar {
                position: fixed;
                left: 0;
                top: 0;
                transform: translateX(-110%);
            }

            .sidebar.show {
                transform: translateX(0);
            }

            .collapse-btn {
                display: none;
            }

            .main-content {
                width: 100%;
                padding: 18px;
            }

            .mobile-menu-btn {
                display: grid;
            }

            .topbar {
                border-radius: 24px;
            }

            .screen-overlay {
                display: none;
            }

            body.sidebar-collapsed .sidebar {
                width: var(--sidebar-width);
            }

            body.sidebar-collapsed .brand-text,
            body.sidebar-collapsed .sidebar-section-label,
            body.sidebar-collapsed .nav-label,
            body.sidebar-collapsed .nav-badge,
            body.sidebar-collapsed .sidebar-widget,
            body.sidebar-collapsed .signout-link span:not(.nav-icon) {
                opacity: 1;
                transform: none;
                pointer-events: auto;
            }

            body.sidebar-collapsed .nav-item,
            body.sidebar-collapsed .signout-link {
                justify-content: flex-start;
                padding: 0 14px;
            }

            body.sidebar-collapsed .brand-card {
                justify-content: flex-start;
            }
        }

        @media (max-width: 720px) {
            .main-content {
                padding: 14px;
            }

            .topbar {
                padding: 16px;
            }

            .topbar-left {
                width: 100%;
            }

            .page-icon {
                width: 50px;
                height: 50px;
                min-width: 50px;
                border-radius: 18px;
            }

            .topbar-actions {
                justify-content: space-between;
                flex-wrap: wrap;
            }

            .admin-user-profile {
                width: 100%;
                justify-content: space-between;
            }

            .user-copy {
                text-align: left;
            }

            .floating-help {
                right: 18px;
                bottom: 18px;
            }

            .tooltip-card {
                right: 18px;
                bottom: 88px;
                width: calc(100% - 36px);
            }
        }

        @media (max-width: 520px) {
            .sidebar {
                width: min(292px, calc(100% - 34px));
            }

            .topbar-left {
                align-items: flex-start;
            }

            .page-title {
                font-size: 1.35rem;
            }

            .page-date {
                font-size: 0.76rem;
                flex-wrap: wrap;
            }

            .quick-action {
                width: 42px;
                height: 42px;
                border-radius: 15px;
            }
        }
    </style>
</head>

<body>
    <%
        const currentPath = typeof path !== 'undefined' && path ? path : '';
        const adminUser = typeof user !== 'undefined' && user ? user : { username: 'Resort Admin' };

        const safeUsername = adminUser.username || 'Resort Admin';
        const avatarLetter = safeUsername.charAt(0).toUpperCase();

        let pageName = 'dashboard';

        if (currentPath && currentPath.includes('/')) {
            pageName = currentPath.split('/').pop() || 'dashboard';
        }

        pageName = pageName.replace(/-/g, ' ');

        const navItems = [
            {
                href: '/admin/dashboard',
                label: 'Dashboard',
                icon: 'fa-solid fa-chart-pie',
                badge: 'Live',
                isActive: currentPath === '/admin/dashboard'
            },
            {
                href: '/admin/facilities',
                label: 'Facilities',
                icon: 'fa-solid fa-umbrella-beach',
                badge: '',
                isActive: currentPath === '/admin/facilities'
            },
            {
                href: '/admin/bookings',
                label: 'Bookings',
                icon: 'fa-solid fa-calendar-check',
                badge: '',
                isActive: currentPath === '/admin/bookings'
            },
            {
                href: '/admin/clients',
                label: 'Clients',
                icon: 'fa-solid fa-users',
                badge: '',
                isActive: currentPath === '/admin/clients'
            },
            {
                href: '/admin/reports',
                label: 'Reports',
                icon: 'fa-solid fa-chart-line',
                badge: '',
                isActive: currentPath === '/admin/reports'
            },
            {
                href: '/admin/settings',
                label: 'Settings',
                icon: 'fa-solid fa-gear',
                badge: '',
                isActive: currentPath.startsWith('/admin/settings')
            }
        ];

        const pageIconMap = {
            dashboard: 'fa-solid fa-chart-pie',
            facilities: 'fa-solid fa-umbrella-beach',
            bookings: 'fa-solid fa-calendar-check',
            clients: 'fa-solid fa-users',
            reports: 'fa-solid fa-chart-line',
            settings: 'fa-solid fa-gear'
        };

        const pageIcon = pageIconMap[pageName.toLowerCase()] || 'fa-solid fa-water';
    %>

    <div class="preloader" id="preloader">
        <div class="loader-card">
            <div class="loader-logo">
                <i class="fa-solid fa-water"></i>
            </div>

            <h2 class="loader-title">DANG'S BEACH RESORT</h2>

            <p class="loader-subtitle">
                Loading admin control panel...
            </p>

            <div class="loader-bar">
                <span></span>
            </div>
        </div>
    </div>

    <div class="animated-bg">
        <span class="blob one"></span>
        <span class="blob two"></span>
        <span class="blob three"></span>
    </div>

    <div class="wave-grid"></div>
    <div class="page-noise"></div>

    <div class="screen-overlay" id="screenOverlay"></div>

    <div class="admin-shell">
        <aside class="sidebar" id="sidebar">
            <button 
                class="collapse-btn" 
                type="button" 
                id="collapseBtn" 
                title="Collapse sidebar"
            >
                <i class="fa-solid fa-chevron-left"></i>
            </button>

            <div class="sidebar-inner">
                <div class="brand-card">
                    <div class="brand-icon">
                        <i class="fa-solid fa-water"></i>
                    </div>

                    <div class="brand-text">
                        <h1 class="brand-title">
                            Dang's Beach Resort
                        </h1>

                        <span class="brand-subtitle">
                            Admin Panel
                        </span>
                    </div>
                </div>

                <div class="sidebar-section-label">
                    Navigation
                </div>

                <nav class="sidebar-nav">
                    <% navItems.forEach((item, index) => { %>
                        <a 
                            href="<%= item.href %>" 
                            class="nav-item <%= item.isActive ? 'active' : '' %>"
                            style="--i:<%= index + 1 %>;"
                        >
                            <span class="nav-icon">
                                <i class="<%= item.icon %>"></i>
                            </span>

                            <span class="nav-label">
                                <%= item.label %>
                            </span>

                            <% if (item.badge) { %>
                                <span class="nav-badge">
                                    <%= item.badge %>
                                </span>
                            <% } %>
                        </a>
                    <% }) %>
                </nav>

                <div class="sidebar-widget">
                    <div class="widget-icon">
                        <i class="fa-solid fa-sparkles"></i>
                    </div>

                    <h3 class="widget-title">
                        Resort Operations
                    </h3>

                    <p class="widget-text">
                        Manage bookings, facilities, clients, and business reports from one powerful dashboard.
                    </p>
                </div>

                <div class="sidebar-footer">
                    <div class="footer-line"></div>

                    <a href="/logout" class="signout-link">
                        <span class="nav-icon">
                            <i class="fa-solid fa-right-from-bracket"></i>
                        </span>

                        <span>
                            Sign Out
                        </span>
                    </a>
                </div>
            </div>
        </aside>

        <main class="main-content" id="mainContent">
            <header class="topbar">
                <div class="topbar-left">
                    <button 
                        type="button" 
                        class="mobile-menu-btn" 
                        id="mobileMenuBtn"
                    >
                        <i class="fa-solid fa-bars"></i>
                    </button>

                    <div class="page-icon">
                        <i class="<%= pageIcon %>"></i>
                    </div>

                    <div class="page-title-wrap">
                        <h1 class="page-title">
                            <%= pageName %>
                        </h1>

                        <p class="page-date">
                            <i class="fa-regular fa-calendar-days"></i>

                            <span>
                                <%= new Date().toLocaleDateString('en-US', { 
                                    weekday: 'long', 
                                    year: 'numeric', 
                                    month: 'long', 
                                    day: 'numeric' 
                                }) %>
                            </span>
                        </p>
                    </div>
                </div>

                <div class="topbar-actions">
                    <button 
                        type="button" 
                        class="quick-action" 
                        title="Print page"
                        onclick="window.print()"
                    >
                        <i class="fa-solid fa-print"></i>
                    </button>

                    <button 
                        type="button" 
                        class="quick-action" 
                        title="Refresh page"
                        onclick="window.location.reload()"
                    >
                        <i class="fa-solid fa-rotate-right"></i>
                    </button>

                    <a 
                        href="/admin/settings" 
                        class="quick-action" 
                        title="Settings"
                        style="text-decoration:none;"
                    >
                        <i class="fa-solid fa-sliders"></i>
                    </a>

                    <div class="admin-user-profile">
                        <div class="user-copy">
                            <span class="user-name">
                                <%= safeUsername %>
                            </span>

                            <small class="user-role">
                                <i class="fa-solid fa-shield-halved"></i>
                                Administrator
                            </small>
                        </div>

                        <div class="avatar-circle">
                            <%= avatarLetter %>
                        </div>
                    </div>
                </div>
            </header>

            <section class="content-panel">
                <%- body %>
            </section>
        </main>
    </div>

    <button 
        class="floating-help" 
        type="button" 
        id="helpBtn"
        title="Admin help"
    >
        <i class="fa-solid fa-headset"></i>
    </button>

    <div class="tooltip-card" id="helpCard">
        <h4>
            <i class="fa-solid fa-circle-info"></i>
            Admin Assistant
        </h4>

        <p>
            Use the sidebar to manage facilities, bookings, clients, reports, and resort settings. 
            You can also print or refresh pages using the quick actions above.
        </p>
    </div>

    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const body = document.body;
            const preloader = document.getElementById('preloader');
            const sidebar = document.getElementById('sidebar');
            const collapseBtn = document.getElementById('collapseBtn');
            const mobileMenuBtn = document.getElementById('mobileMenuBtn');
            const screenOverlay = document.getElementById('screenOverlay');
            const helpBtn = document.getElementById('helpBtn');
            const helpCard = document.getElementById('helpCard');

            const savedSidebarState = localStorage.getItem('adminSidebarCollapsed');

            if (savedSidebarState === 'true' && window.innerWidth > 980) {
                body.classList.add('sidebar-collapsed');
            }

            window.addEventListener('load', function () {
                setTimeout(function () {
                    if (preloader) {
                        preloader.classList.add('hide');
                    }
                }, 450);
            });

            if (collapseBtn) {
                collapseBtn.addEventListener('click', function () {
                    body.classList.toggle('sidebar-collapsed');

                    const isCollapsed = body.classList.contains('sidebar-collapsed');

                    localStorage.setItem('adminSidebarCollapsed', isCollapsed ? 'true' : 'false');
                });
            }

            function openMobileSidebar() {
                if (!sidebar || !screenOverlay) return;

                sidebar.classList.add('show');
                screenOverlay.classList.add('show');
                body.style.overflow = 'hidden';
            }

            function closeMobileSidebar() {
                if (!sidebar || !screenOverlay) return;

                sidebar.classList.remove('show');
                screenOverlay.classList.remove('show');
                body.style.overflow = '';
            }

            if (mobileMenuBtn) {
                mobileMenuBtn.addEventListener('click', openMobileSidebar);
            }

            if (screenOverlay) {
                screenOverlay.addEventListener('click', closeMobileSidebar);
            }

            window.addEventListener('resize', function () {
                if (window.innerWidth > 980) {
                    closeMobileSidebar();
                }
            });

            if (helpBtn && helpCard) {
                helpBtn.addEventListener('click', function () {
                    helpCard.classList.toggle('show');
                });

                document.addEventListener('click', function (event) {
                    const clickedHelp = helpBtn.contains(event.target);
                    const clickedCard = helpCard.contains(event.target);

                    if (!clickedHelp && !clickedCard) {
                        helpCard.classList.remove('show');
                    }
                });
            }

            document.addEventListener('keydown', function (event) {
                if (event.key === 'Escape') {
                    closeMobileSidebar();

                    if (helpCard) {
                        helpCard.classList.remove('show');
                    }
                }
            });

            const navItems = document.querySelectorAll('.nav-item');

            navItems.forEach(function (item) {
                item.addEventListener('mouseenter', function () {
                    item.style.setProperty('--hover-x', '1');
                });

                item.addEventListener('mouseleave', function () {
                    item.style.setProperty('--hover-x', '0');
                });
            });
        });
    </script>
</body>

</html>