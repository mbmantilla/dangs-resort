<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Dang's Admin | Control Panel</title>
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=Tenor+Sans&display=swap" rel="stylesheet">
<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

<style>
:root {
    --sidebar-gradient: linear-gradient(180deg, #0f172a 0%, #1e293b 100%);
    --sidebar-width: 260px;
    --active-bg: rgba(14, 165, 233, 0.15);
    --active-color: #0ea5e9;
    --text-main: #f8fafc;
    --text-muted: #94a3b8;
    --accent: #0ea5e9;
    --danger: #ef4444;
    --card-bg: #f8fafc;
    --card-radius: 18px;
    --shadow-lg: 0 25px 60px rgba(0,0,0,0.2);
}

/* Reset & Base */
body {
    font-family: 'Inter', sans-serif;
    margin: 0;
    display: flex;
    height: 100vh;
    overflow: hidden;
    background: #f1f5f9;
    color: #1e293b;
}

/* Sidebar */
.sidebar {
    width: var(--sidebar-width);
    background: var(--sidebar-gradient);
    display: flex;
    flex-direction: column;
    padding: 30px 20px;
    color: var(--text-main);
    transition: width 0.3s ease;
}
.sidebar-brand {
    font-family: 'Tenor Sans', serif;
    font-weight: 800;
    font-size: 1.7rem;
    letter-spacing: -0.5px;
    margin-bottom: 50px;
}
.sidebar-brand span {
    display: block;
    font-size: 0.65rem;
    color: var(--accent);
    text-transform: uppercase;
    letter-spacing: 2px;
    margin-top: 4px;
}
.nav-item {
    padding: 12px 20px;
    display: flex;
    align-items: center;
    text-decoration: none;
    color: var(--text-muted);
    transition: all 0.25s ease;
    font-size: 0.95rem;
    border-radius: 8px;
    font-weight: 500;
    margin: 6px 0;
}
.nav-item:hover {
    background: rgba(14, 165, 233, 0.1);
    color: var(--text-main);
}
.nav-item.active {
    background: var(--active-bg);
    color: var(--active-color);
    font-weight: 600;
}

/* Sidebar footer */
.sidebar-footer {
    margin-top: auto;
    border-top: 1px solid rgba(255,255,255,0.1);
    padding-top: 20px;
}
.sidebar-footer a {
    color: var(--danger);
    font-weight: 600;
    text-decoration: none;
    font-size: 0.9rem;
    display: flex;
    align-items: center;
    gap: 8px;
}
.sidebar-footer a:hover { opacity: 0.85; }

/* Main Content */
.main-content {
    flex: 1;
    overflow-y: auto;
    padding: 30px 40px;
    background: #f8fafc;
    border-radius: 0 20px 20px 0;
    position: relative;
    transition: padding 0.3s ease;
}

/* Admin Header */
.admin-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 40px;
    padding-bottom: 10px;
    border-bottom: 1px solid #e2e8f0;
}
.admin-header h1 {
    font-size: 2rem;
    font-weight: 700;
    background: linear-gradient(90deg, #0ea5e9, #2563eb);
    background-clip: text;
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
}
.admin-header p {
    color: #94a3b8;
    font-size: 0.85rem;
}
.admin-user-profile {
    display: flex;
    align-items: center;
    gap: 12px;
    text-align: right;
}
.avatar-circle {
    width: 44px;
    height: 44px;
    background: var(--accent);
    color: white;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-weight: 700;
    font-size: 1rem;
}

/* Responsive */
@media (max-width: 900px) {
    .sidebar { width: 220px; }
    .main-content { padding: 20px; }
}
@media (max-width: 640px) {
    .admin-header h1 { font-size: 1.6rem; }
    .admin-header p { font-size: 0.75rem; }
}
</style>
</head>
<body>

<aside class="sidebar">
    <div class="sidebar-brand">
        DANG'S BEACH RESORT
        <span>ADMIN PANEL</span>
    </div>

    <nav>
        <a href="/admin/dashboard" class="nav-item <%= path === '/admin/dashboard' ? 'active' : '' %>">Dashboard</a>
        <a href="/admin/facilities" class="nav-item <%= path === '/admin/facilities' ? 'active' : '' %>">Facilities</a>
        <a href="/admin/bookings" class="nav-item <%= path === '/admin/bookings' ? 'active' : '' %>">Bookings</a>
        <a href="/admin/clients" class="nav-item <%= path === '/admin/clients' ? 'active' : '' %>">Clients</a>
        <a href="/admin/reports" class="nav-item <%= path === '/admin/reports' ? 'active' : '' %>">Reports</a>
        <a href="/admin/settings" class="nav-item <%= path.startsWith('/admin/settings') ? 'active' : '' %>">Settings</a>
    </nav>

    <div class="sidebar-footer">
        <a href="/logout">Sign Out</a>
    </div>
</aside>

<main class="main-content">
    <header class="admin-header">
        <div>
            <h1><%= path.split('/').pop().replace('-', ' ') %></h1>
            <p><%= new Date().toLocaleDateString('en-US', { weekday:'long', year:'numeric', month:'long', day:'numeric' }) %></p>
        </div>
        <div class="admin-user-profile">
            <div style="line-height:1.2;">
                <span style="font-weight:600; display:block;"><%= user.username %></span>
                <small style="color: var(--accent); font-weight:600; text-transform: uppercase; font-size:0.7rem;">Administrator</small>
            </div>
            <div class="avatar-circle"><%= user.username.charAt(0).toUpperCase() %></div>
        </div>
    </header>

    <%- body %>
</main>

</body>
</html>