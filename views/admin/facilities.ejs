        border: 3px solid white;
    }

    .preview-frame img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        transition: transform 0.45s var(--fac-ease);
    }

    .admin-table tbody tr:hover .preview-frame img,
    .facility-card:hover .facility-card-image img {
        transform: scale(1.08);
    }

    .facility-name-cell {
        display: flex;
        flex-direction: column;
        gap: 5px;
    }

    .facility-title {
        color: var(--fac-text-main);
        font-size: 0.98rem;
        font-weight: 950;
        line-height: 1.2;
    }

    .facility-id {
        color: var(--fac-text-muted);
        font-size: 0.72rem;
        font-weight: 800;
        letter-spacing: 0.06em;
        text-transform: uppercase;
    }

    .badge {
        min-height: 38px;
        padding: 0 13px;
        border-radius: var(--fac-radius-full);
        display: inline-flex;
        align-items: center;
        gap: 8px;
        color: var(--fac-ocean-700);
        background: var(--fac-ocean-50);
        border: 1px solid rgba(6, 182, 212, 0.16);
        font-size: 0.70rem;
        font-weight: 950;
        letter-spacing: 0.08em;
        text-transform: uppercase;
        white-space: nowrap;
    }

    .price-text {
        display: inline-flex;
        flex-direction: column;
        gap: 3px;
    }

    .price-text strong {
        color: var(--fac-text-main);
        font-size: 1.02rem;
        font-weight: 950;
    }

    .price-text span {
        color: var(--fac-text-muted);
        font-size: 0.70rem;
        font-weight: 800;
        text-transform: uppercase;
        letter-spacing: 0.06em;
    }

    .status-pill {
        min-height: 38px;
        padding: 0 13px;
        border-radius: var(--fac-radius-full);
        display: inline-flex;
        align-items: center;
        gap: 8px;
        font-size: 0.70rem;
        font-weight: 950;
        letter-spacing: 0.08em;
        text-transform: uppercase;
        white-space: nowrap;
        border: 1px solid transparent;
    }

    .status-pill.active {
        color: var(--fac-emerald-700);
        background: var(--fac-emerald-100);
        border-color: rgba(16, 185, 129, 0.18);
    }

    .status-pill.maintenance {
        color: var(--fac-sand-800);
        background: var(--fac-sand-100);
        border-color: rgba(245, 158, 11, 0.20);
    }

    .status-pill.inactive {
        color: var(--fac-rose-700);
        background: var(--fac-rose-100);
        border-color: rgba(244, 63, 94, 0.18);
    }

    .status-pill.neutral {
        color: var(--fac-slate-700);
        background: var(--fac-slate-100);
        border-color: rgba(148, 163, 184, 0.22);
    }

    .action-buttons {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 9px;
    }

    .btn-edit,
    .btn-delete,
    .btn-soft {
        min-height: 42px;
        padding: 0 14px;
        border: 0;
        border-radius: 15px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        cursor: pointer;
        font-size: 0.72rem;
        font-weight: 950;
        letter-spacing: 0.06em;
        text-transform: uppercase;
        transition:
            transform 0.22s var(--fac-ease),
            box-shadow 0.22s var(--fac-ease),
            background 0.22s var(--fac-ease);
    }

    .btn-edit {
        color: var(--fac-ocean-700);
        background: var(--fac-ocean-50);
        border: 1px solid rgba(6, 182, 212, 0.16);
    }

    .btn-edit:hover {
        transform: translateY(-2px);
        background: var(--fac-ocean-100);
        box-shadow: 0 12px 28px rgba(8, 145, 178, 0.15);
    }

    .btn-delete {
        color: var(--fac-rose-700);
        background: var(--fac-rose-50);
        border: 1px solid rgba(244, 63, 94, 0.16);
    }

    .btn-delete:hover {
        transform: translateY(-2px);
        background: var(--fac-rose-100);
        box-shadow: 0 12px 28px rgba(225, 29, 72, 0.13);
    }

    .btn-soft {
        color: var(--fac-text-soft);
        background: var(--fac-slate-100);
        border: 1px solid rgba(148, 163, 184, 0.18);
    }

    .btn-soft:hover {
        transform: translateY(-2px);
        background: white;
        box-shadow: var(--fac-shadow-xs);
    }

    .mobile-facility-grid {
        display: none;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 16px;
    }

    .facility-card {
        position: relative;
        border-radius: 30px;
        overflow: hidden;
        background: rgba(255, 255, 255, 0.88);
        border: 1px solid rgba(255, 255, 255, 0.82);
        box-shadow: var(--fac-shadow-sm);
        backdrop-filter: blur(18px);
        transition:
            transform 0.28s var(--fac-ease),
            box-shadow 0.28s var(--fac-ease);
    }

    .facility-card:hover {
        transform: translateY(-6px);
        box-shadow: var(--fac-shadow-md);
    }

    .facility-card-image {
        position: relative;
        height: 190px;
        overflow: hidden;
        background: linear-gradient(135deg, var(--fac-ocean-100), var(--fac-sea-100));
    }

    .facility-card-image img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        transition: transform 0.45s var(--fac-ease);
    }

    .facility-card-image::after {
        content: "";
        position: absolute;
        inset: 0;
        background: linear-gradient(to bottom, transparent, rgba(2, 6, 23, 0.45));
    }

    .facility-card-status {
        position: absolute;
        top: 14px;
        left: 14px;
        z-index: 2;
    }

    .facility-card-price {
        position: absolute;
        right: 14px;
        bottom: 14px;
        z-index: 2;
        padding: 9px 12px;
        border-radius: 16px;
        color: var(--fac-text-main);
        background: rgba(255, 255, 255, 0.92);
        box-shadow: 0 12px 28px rgba(15, 23, 42, 0.18);
        font-weight: 950;
    }

    .facility-card-body {
        padding: 20px;
    }

    .facility-card-type {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        color: var(--fac-ocean-700);
        font-size: 0.70rem;
        font-weight: 950;
        letter-spacing: 0.12em;
        text-transform: uppercase;
        margin-bottom: 10px;
    }

    .facility-card-title {
        margin: 0;
        color: var(--fac-text-main);
        font-family: var(--fac-font-display);
        font-size: 1.5rem;
        font-weight: 400;
        line-height: 1.15;
        letter-spacing: -0.03em;
    }

    .facility-card-id {
        margin-top: 8px;
        color: var(--fac-text-muted);
        font-size: 0.75rem;
        font-weight: 800;
    }

    .facility-card-actions {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 9px;
        margin-top: 18px;
    }

    .empty-state {
        position: relative;
        padding: 56px 24px;
        text-align: center;
        border-radius: 34px;
        background: rgba(255, 255, 255, 0.88);
        border: 1px dashed rgba(8, 145, 178, 0.30);
        box-shadow: var(--fac-shadow-sm);
        overflow: hidden;
    }

    .empty-state::before {
        content: "";
        position: absolute;
        top: -120px;
        right: -90px;
        width: 240px;
        height: 240px;
        border-radius: var(--fac-radius-full);
        background: rgba(6, 182, 212, 0.10);
    }

    .empty-icon {
        width: 78px;
        height: 78px;
        margin: 0 auto 18px;
        border-radius: 28px;
        display: grid;
        place-items: center;
        color: white;
        font-size: 1.8rem;
        background: linear-gradient(135deg, var(--fac-ocean-500), var(--fac-sea-500));
        box-shadow: var(--fac-shadow-ocean);
    }

    .empty-state h3 {
        margin: 0 0 8px;
        color: var(--fac-text-main);
        font-family: var(--fac-font-display);
        font-size: 1.8rem;
        font-weight: 400;
    }

    .empty-state p {
        max-width: 460px;
        margin: 0 auto 22px;
        color: var(--fac-text-soft);
        line-height: 1.7;
    }

    .modal-overlay {
        position: fixed;
        inset: 0;
        z-index: 1000;
        display: none;
        align-items: center;
        justify-content: center;
        padding: 22px;
        background: rgba(15, 23, 42, 0.56);
        backdrop-filter: blur(10px);
    }

    .modal-overlay.show {
        display: flex;
        animation: facFadeIn 0.24s ease both;
    }

    .modal-content {
        position: relative;
        width: min(560px, 100%);
        max-height: calc(100vh - 44px);
        overflow-y: auto;
        border-radius: 34px;
        background: rgba(255, 255, 255, 0.96);
        border: 1px solid rgba(255, 255, 255, 0.82);
        box-shadow: var(--fac-shadow-xl);
        animation: facModalPop 0.36s var(--fac-ease-bounce) both;
    }

    .modal-header {
        position: relative;
        padding: 28px 28px 0;
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        gap: 18px;
    }

    .modal-title-wrap {
        display: flex;
        align-items: flex-start;
        gap: 14px;
    }

    .modal-icon {
        width: 52px;
        height: 52px;
        min-width: 52px;
        border-radius: 20px;
        display: grid;
        place-items: center;
        color: white;
        background: linear-gradient(135deg, var(--fac-ocean-500), var(--fac-sea-500));
        box-shadow: 0 16px 34px rgba(8, 145, 178, 0.22);
    }

    .modal-title {
        margin: 0;
        color: var(--fac-text-main);
        font-size: 1.35rem;
        font-weight: 950;
        letter-spacing: -0.02em;
    }

    .modal-subtitle {
        margin: 6px 0 0;
        color: var(--fac-text-muted);
        font-size: 0.86rem;
        line-height: 1.55;
    }

    .modal-close {
        width: 42px;
        height: 42px;
        border: 0;
        border-radius: 16px;
        display: grid;
        place-items: center;
        cursor: pointer;
        color: var(--fac-text-soft);
        background: var(--fac-slate-100);
        transition:
            transform 0.22s var(--fac-ease),
            background 0.22s var(--fac-ease);
    }

    .modal-close:hover {
        transform: rotate(90deg);
        color: white;
        background: var(--fac-rose-500);
    }

    .facility-form {
        padding: 26px 28px 28px;
    }

    .form-group {
        margin-bottom: 18px;
    }

    .form-group label {
        display: flex;
        align-items: center;
        gap: 8px;
        margin-bottom: 8px;
        color: var(--fac-ocean-700);
        font-size: 0.72rem;
        font-weight: 950;
        letter-spacing: 0.10em;
        text-transform: uppercase;
    }

    .field-shell {
        position: relative;
    }

    .field-icon {
        position: absolute;
        left: 16px;
        top: 50%;
        transform: translateY(-50%);
        color: var(--fac-ocean-600);
        pointer-events: none;
    }

    .form-group input,
    .form-group select {
        width: 100%;
        min-height: 54px;
        padding: 0 16px 0 46px;
        border: 1px solid rgba(148, 163, 184, 0.24);
        border-radius: 18px;
        outline: none;
        color: var(--fac-text-main);
        background: rgba(248, 250, 252, 0.86);
        font-weight: 750;
        transition:
            border-color 0.25s var(--fac-ease),
            box-shadow 0.25s var(--fac-ease),
            background 0.25s var(--fac-ease);
    }

    .form-group input[type="file"] {
        padding: 15px;
        cursor: pointer;
    }

    .form-group input:focus,
    .form-group select:focus {
        background: white;
        border-color: rgba(6, 182, 212, 0.48);
        box-shadow: 0 0 0 4px rgba(6, 182, 212, 0.11);
    }

    .image-upload-row {
        display: grid;
        grid-template-columns: 110px minmax(0, 1fr);
        gap: 16px;
        align-items: center;
    }

    .image-preview-wrap {
        width: 110px;
        height: 82px;
        border-radius: 22px;
        overflow: hidden;
        background: linear-gradient(135deg, var(--fac-ocean-100), var(--fac-sea-100));
        border: 3px solid white;
        box-shadow: var(--fac-shadow-sm);
    }

    .image-preview-wrap img {
        width: 100%;
        height: 100%;
        object-fit: cover;
    }

    .form-actions {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 12px;
        margin-top: 24px;
    }

    .toast {
        position: fixed;
        left: 50%;
        bottom: 28px;
        z-index: 1100;
        min-width: min(420px, calc(100% - 32px));
        padding: 15px 16px;
        border-radius: 20px;
        display: flex;
        align-items: center;
        gap: 12px;
        color: white;
        background: rgba(15, 23, 42, 0.92);
        border: 1px solid rgba(255, 255, 255, 0.12);
        box-shadow: var(--fac-shadow-lg);
        backdrop-filter: blur(18px);
        transform: translate(-50%, 30px);
        opacity: 0;
        pointer-events: none;
        transition:
            transform 0.28s var(--fac-ease),
            opacity 0.28s var(--fac-ease);
    }

    .toast.show {
        transform: translate(-50%, 0);
        opacity: 1;
    }

    .toast i {
        color: var(--fac-sand-300);
    }

    .footer-facilities {
        position: relative;
        margin-top: 28px;
        padding: 28px;
        border-radius: 34px;
        color: white;
        overflow: hidden;
        background:
            linear-gradient(135deg, var(--fac-slate-950), var(--fac-ocean-900) 52%, var(--fac-sea-800));
        box-shadow: var(--fac-shadow-lg);
    }

    .footer-facilities::before {
        content: "";
        position: absolute;
        width: 280px;
        height: 280px;
        right: -120px;
        top: -150px;
        border-radius: var(--fac-radius-full);
        background: rgba(255, 255, 255, 0.12);
    }

    .footer-facilities-content {
        position: relative;
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 24px;
    }

    .footer-facilities h3 {
        margin: 0 0 8px;
        font-family: var(--fac-font-display);
        font-size: 1.8rem;
        font-weight: 400;
    }

    .footer-facilities p {
        margin: 0;
        color: rgba(226, 232, 240, 0.76);
        line-height: 1.7;
    }

    @keyframes facFadeIn {
        from {
            opacity: 0;
        }

        to {
            opacity: 1;
        }
    }

    @keyframes facModalPop {
        from {
            opacity: 0;
            transform: translateY(22px) scale(0.96);
        }

        to {
            opacity: 1;
            transform: translateY(0) scale(1);
        }
    }

    @media (max-width: 1280px) {
        .facility-hero-inner {
            grid-template-columns: 1fr;
        }

        .facility-overview-strip {
            grid-template-columns: repeat(2, minmax(0, 1fr));
            margin-top: 20px;
            margin-left: 0;
            margin-right: 0;
        }
    }

    @media (max-width: 980px) {
        .section-heading {
            align-items: flex-start;
            flex-direction: column;
            gap: 10px;
        }

        .section-heading p {
            max-width: 100%;
            text-align: left;
        }

        .toolbar-card {
            grid-template-columns: 1fr;
        }

        .admin-table {
            display: none;
        }

        .mobile-facility-grid {
            display: grid;
        }
    }

    @media (max-width: 720px) {
        .facility-hero {
            padding: 26px;
            border-radius: 30px;
        }

        .hero-title {
            font-size: clamp(2.1rem, 12vw, 3.5rem);
        }

        .hero-actions {
            align-items: stretch;
            flex-direction: column;
        }

        .hero-btn,
        .btn-add {
            width: 100%;
        }

        .facility-overview-strip,
        .mobile-facility-grid {
            grid-template-columns: 1fr;
        }

        .admin-card-inner {
            padding: 20px;
        }

        .form-actions {
            grid-template-columns: 1fr;
        }

        .image-upload-row {
            grid-template-columns: 1fr;
        }

        .image-preview-wrap {
            width: 100%;
            height: 180px;
        }

        .footer-facilities-content {
            align-items: flex-start;
            flex-direction: column;
        }
    }

    @media (max-width: 520px) {
        .facility-hero {
            padding: 22px;
            border-radius: 26px;
        }

        .hero-eyebrow,
        .section-kicker {
            font-size: 0.62rem;
            letter-spacing: 0.10em;
        }

        .hero-copy {
            font-size: 0.92rem;
        }

        .overview-pill {
            min-height: 94px;
            border-radius: 24px;
        }

        .admin-card,
        .facility-card,
        .modal-content {
            border-radius: 26px;
        }

        .modal-overlay {
            padding: 14px;
        }
    }

    @media print {
        .fac-orb,
        .fac-noise,
        .hero-actions,
        .toolbar-card,
        .modal-overlay,
        .toast {
            display: none !important;
        }

        .facilities-page::before,
        .facilities-page::after {
            display: none !important;
        }

        .facility-hero,
        .admin-card,
        .facility-card,
        .overview-pill,
        .footer-facilities {
            box-shadow: none !important;
        }
    }

    @media (prefers-reduced-motion: reduce) {
        .facilities-page *,
        .facilities-page *::before,
        .facilities-page *::after {
            animation-duration: 0.01ms !important;
            animation-iteration-count: 1 !important;
            scroll-behavior: auto !important;
            transition-duration: 0.01ms !important;
        }
    }
</style>

<div class="facilities-page">
    <span class="fac-orb one"></span>
    <span class="fac-orb two"></span>
    <span class="fac-orb three"></span>
    <div class="fac-noise"></div>

    <section class="facility-hero">
        <div class="facility-hero-inner">
            <div>
                <span class="hero-eyebrow">
                    <i class="fa-solid fa-umbrella-beach"></i>
                    Facility Management
                </span>

                <h1 class="hero-title">
                    Manage resort spaces<span>.</span>
                </h1>

                <p class="hero-copy">
                    View, add, update, and organize resort rooms, cottages, and halls with a cleaner animated admin interface.
                </p>

                <div class="hero-actions">
                    <button type="button" class="hero-btn" onclick="openAddModal()">
                        <i class="fa-solid fa-plus"></i>
                        Add New Facility
                    </button>

                    <a href="/admin/bookings" class="hero-btn ghost">
                        <i class="fa-solid fa-calendar-check"></i>
                        View Bookings
                    </a>
                </div>
            </div>

            <article class="hero-live-card">
                <div class="live-card-icon">
                    <i class="fa-solid fa-house-chimney"></i>
                </div>

                <span class="live-card-label">
                    Total Facilities
                </span>

                <strong class="live-card-value">
                    <%= totalFacilities %>
                </strong>

                <p class="live-card-copy">
                    Current rooms, cottages, and halls listed in Dang's Beach Resort system.
                </p>
            </article>
        </div>
    </section>

    <section class="facility-overview-strip" aria-label="Facilities summary">
        <article class="overview-pill">
            <div class="overview-icon">
                <i class="fa-solid fa-circle-check"></i>
            </div>

            <div class="overview-copy">
                <strong><%= availableFacilities %></strong>
                <span>Available</span>
            </div>
        </article>

        <article class="overview-pill">
            <div class="overview-icon">
                <i class="fa-solid fa-screwdriver-wrench"></i>
            </div>

            <div class="overview-copy">
                <strong><%= maintenanceFacilities %></strong>
                <span>Maintenance</span>
            </div>
        </article>

        <article class="overview-pill">
            <div class="overview-icon">
                <i class="fa-solid fa-bed"></i>
            </div>

            <div class="overview-copy">
                <strong><%= roomCount %></strong>
                <span>Rooms</span>
            </div>
        </article>

        <article class="overview-pill">
            <div class="overview-icon">
                <i class="fa-solid fa-peso-sign"></i>
            </div>

            <div class="overview-copy">
                <strong>₱<%= pesoFormat(averagePrice) %></strong>
                <span>Average Price</span>
            </div>
        </article>
    </section>

    <div class="section-heading">
        <div>
            <span class="section-kicker">
                <i class="fa-solid fa-layer-group"></i>
                Facility Inventory
            </span>

            <h2>
                Rooms, cottages, and halls
            </h2>
        </div>

        <p>
            Search, filter, and manage every listed facility. The table view is used on desktop, while mobile shows card-style facility previews.
        </p>
    </div>

    <section class="toolbar-card">
        <div class="search-wrap">
            <i class="fa-solid fa-magnifying-glass"></i>

            <input 
                type="search" 
                id="facilitySearch" 
                class="search-input" 
                placeholder="Search facility name, type, or status..."
            >
        </div>

        <div class="filter-wrap">
            <i class="fa-solid fa-filter"></i>

            <select id="facilityFilter" class="filter-select">
                <option value="all">All Facilities</option>
                <option value="available">Available</option>
                <option value="maintenance">Maintenance</option>
                <option value="room">Rooms</option>
                <option value="cottage">Cottages</option>
                <option value="hall">Halls</option>
            </select>
        </div>

        <button type="button" class="btn-add primary" onclick="openAddModal()">
            <i class="fa-solid fa-plus"></i>
            Add Facility
        </button>
    </section>

    <% if (safeRooms.length > 0) { %>
        <section class="admin-card">
            <div class="admin-card-inner">
                <div class="table-shell">
                    <table class="admin-table">
                        <thead>
                            <tr>
                                <th>Preview</th>
                                <th>Facility Name</th>
                                <th>Category</th>
                                <th>Pricing</th>
                                <th>Status</th>
                                <th style="text-align:center;">Actions</th>
                            </tr>
                        </thead>

                        <tbody id="facilityTableBody">
                            <% safeRooms.forEach(function (room) { 
                                const roomStatusClass = statusClass(room.status);
                                const facilityPayload = {
                                    id: String(room.id || ''),
                                    name: String(room.name || ''),
                                    type: String(room.type || ''),
                                    price: String(room.price || ''),
                                    status: String(room.status || ''),
                                    image_url: String(room.image_url || '')
                                };
                            %>
                                <tr 
                                    class="facility-row"
                                    data-name="<%= String(room.name || '').toLowerCase() %>"
                                    data-type="<%= String(room.type || '').toLowerCase() %>"
                                    data-status="<%= String(room.status || '').toLowerCase() %>"
                                >
                                    <td>
                                        <div class="preview-frame">
                                            <img 
                                                src="<%= room.image_url || '/images/default-room.jpg' %>" 
                                                alt="<%= room.name || 'Facility image' %>"
                                                onerror="this.onerror=null; this.src='/images/default-room.jpg';"
                                            >
                                        </div>
                                    </td>

                                    <td>
                                        <div class="facility-name-cell">
                                            <span class="facility-title">
                                                <%= room.name || 'Unnamed Facility' %>
                                            </span>

                                            <span class="facility-id">
                                                ID: #REF-0<%= room.id %>
                                            </span>
                                        </div>
                                    </td>

                                    <td>
                                        <span class="badge">
                                            <i class="<%= typeIcon(room.type) %>"></i>
                                            <%= room.type || 'Facility' %>
                                        </span>
                                    </td>

                                    <td>
                                        <span class="price-text">
                                            <strong>₱<%= pesoFormat(room.price) %></strong>
                                            <span>Per night</span>
                                        </span>
                                    </td>

                                    <td>
                                        <span class="status-pill <%= roomStatusClass %>">
                                            <i class="fa-solid <%= roomStatusClass === 'active' ? 'fa-circle-check' : roomStatusClass === 'maintenance' ? 'fa-screwdriver-wrench' : 'fa-circle-info' %>"></i>
                                            <%= room.status || 'Unknown' %>
                                        </span>
                                    </td>

                                    <td style="text-align:center;">
                                        <div class="action-buttons">
                                            <button 
                                                type="button" 
                                                class="btn-edit edit-facility-btn"
                                                data-facility="<%- encodeURIComponent(JSON.stringify(facilityPayload)) %>"
                                            >
                                                <i class="fa-solid fa-pen"></i>
                                                Edit
                                            </button>

                                            <button 
                                                type="button" 
                                                class="btn-delete" 
                                                onclick="confirmDelete('<%= room.id %>')"
                                            >
                                                <i class="fa-solid fa-trash"></i>
                                                Delete
                                            </button>
                                        </div>
                                    </td>
                                </tr>
                            <% }) %>
                        </tbody>
                    </table>
                </div>

                <div class="mobile-facility-grid" id="mobileFacilityGrid">
                    <% safeRooms.forEach(function (room) { 
                        const roomStatusClass = statusClass(room.status);
                        const facilityPayload = {
                            id: String(room.id || ''),
                            name: String(room.name || ''),
                            type: String(room.type || ''),
                            price: String(room.price || ''),
                            status: String(room.status || ''),
                            image_url: String(room.image_url || '')
                        };
                    %>
                        <article 
                            class="facility-card facility-row"
                            data-name="<%= String(room.name || '').toLowerCase() %>"
                            data-type="<%= String(room.type || '').toLowerCase() %>"
                            data-status="<%= String(room.status || '').toLowerCase() %>"
                        >
                            <div class="facility-card-image">
                                <img 
                                    src="<%= room.image_url || '/images/default-room.jpg' %>" 
                                    alt="<%= room.name || 'Facility image' %>"
                                    onerror="this.onerror=null; this.src='/images/default-room.jpg';"
                                >

                                <div class="facility-card-status">
                                    <span class="status-pill <%= roomStatusClass %>">
                                        <i class="fa-solid <%= roomStatusClass === 'active' ? 'fa-circle-check' : roomStatusClass === 'maintenance' ? 'fa-screwdriver-wrench' : 'fa-circle-info' %>"></i>
                                        <%= room.status || 'Unknown' %>
                                    </span>
                                </div>

                                <div class="facility-card-price">
                                    ₱<%= pesoFormat(room.price) %>
                                </div>
                            </div>

                            <div class="facility-card-body">
                                <span class="facility-card-type">
                                    <i class="<%= typeIcon(room.type) %>"></i>
                                    <%= room.type || 'Facility' %>
                                </span>

                                <h3 class="facility-card-title">
                                    <%= room.name || 'Unnamed Facility' %>
                                </h3>

                                <div class="facility-card-id">
                                    ID: #REF-0<%= room.id %>
                                </div>

                                <div class="facility-card-actions">
                                    <button 
                                        type="button" 
                                        class="btn-edit edit-facility-btn"
                                        data-facility="<%- encodeURIComponent(JSON.stringify(facilityPayload)) %>"
                                    >
                                        <i class="fa-solid fa-pen"></i>
                                        Edit
                                    </button>

                                    <button 
                                        type="button" 
                                        class="btn-delete" 
                                        onclick="confirmDelete('<%= room.id %>')"
                                    >
                                        <i class="fa-solid fa-trash"></i>
                                        Delete
                                    </button>
                                </div>
                            </div>
                        </article>
                    <% }) %>
                </div>
            </div>
        </section>
    <% } else { %>
        <section class="empty-state">
            <div class="empty-icon">
                <i class="fa-solid fa-hotel"></i>
            </div>

            <h3>No facilities yet</h3>

            <p>
                Add your first room, cottage, or hall so guests can start browsing and booking resort spaces.
            </p>

            <button type="button" class="btn-add primary" onclick="openAddModal()" style="margin:0 auto;">
                <i class="fa-solid fa-plus"></i>
                Add First Facility
            </button>
        </section>
    <% } %>

    <section class="footer-facilities">
        <div class="footer-facilities-content">
            <div>
                <h3>
                    Keep your listings updated.
                </h3>

                <p>
                    Accurate facility details help guests choose the right space and reduce booking confusion.
                </p>
            </div>

            <a href="/admin/reports" class="hero-btn">
                <i class="fa-solid fa-chart-line"></i>
                Open Reports
            </a>
        </div>
    </section>
</div>

<div id="facilityModal" class="modal-overlay">
    <div class="modal-content">
        <div class="modal-header">
            <div class="modal-title-wrap">
                <div class="modal-icon">
                    <i class="fa-solid fa-umbrella-beach"></i>
                </div>

                <div>
                    <h3 id="modalTitle" class="modal-title">
                        Edit Facility
                    </h3>

                    <p id="modalSubtitle" class="modal-subtitle">
                        Update the selected facility details below.
                    </p>
                </div>
            </div>

            <button type="button" class="modal-close" onclick="closeModal()" aria-label="Close modal">
                <i class="fa-solid fa-xmark"></i>
            </button>
        </div>

        <form id="facilityForm" class="facility-form" method="POST" enctype="multipart/form-data">
            <div class="form-group">
                <label for="field_image">
                    <i class="fa-solid fa-image"></i>
                    Facility Image
                </label>

                <div class="image-upload-row">
                    <div class="image-preview-wrap">
                        <img id="imagePreview" src="/images/default-room.jpg" alt="Image preview">
                    </div>

                    <input 
                        type="file" 
                        name="image" 
                        id="field_image" 
                        accept="image/*" 
                        onchange="previewFile()"
                    >
                </div>
            </div>

            <div class="form-group">
                <label for="field_name">
                    <i class="fa-solid fa-signature"></i>
                    Facility Name
                </label>

                <div class="field-shell">
                    <i class="fa-solid fa-house field-icon"></i>

                    <input 
                        type="text" 
                        name="name" 
                        id="field_name" 
                        placeholder="Enter facility name"
                        required
                    >
                </div>
            </div>

            <div class="form-group">
                <label for="field_type">
                    <i class="fa-solid fa-layer-group"></i>
                    Type
                </label>

                <div class="field-shell">
                    <i class="fa-solid fa-tag field-icon"></i>

                    <select name="type" id="field_type">
                        <option value="Room">Room</option>
                        <option value="Cottage">Cottage</option>
                        <option value="Hall">Hall</option>
                    </select>
                </div>
            </div>

            <div class="form-group">
                <label for="field_price">
                    <i class="fa-solid fa-peso-sign"></i>
                    Price per Night
                </label>

                <div class="field-shell">
                    <i class="fa-solid fa-peso-sign field-icon"></i>

                    <input 
                        type="number" 
                        name="price" 
                        id="field_price" 
                        min="0"
                        step="0.01"
                        placeholder="Enter price"
                        required
                    >
                </div>
            </div>

            <div class="form-group">
                <label for="field_status">
                    <i class="fa-solid fa-toggle-on"></i>
                    Status
                </label>

                <div class="field-shell">
                    <i class="fa-solid fa-circle-check field-icon"></i>

                    <select name="status" id="field_status">
                        <option value="Available">Available</option>
                        <option value="Maintenance">Maintenance</option>
                    </select>
                </div>
            </div>

            <div class="form-actions">
                <button type="submit" class="btn-add primary" id="submitBtn">
                    <i class="fa-solid fa-floppy-disk"></i>
                    Save Changes
                </button>

                <button type="button" class="btn-soft" onclick="closeModal()">
                    <i class="fa-solid fa-xmark"></i>
                    Cancel
                </button>
            </div>
        </form>
    </div>
</div>

<div class="toast" id="facilityToast">
    <i class="fa-solid fa-circle-info"></i>
    <span id="facilityToastMessage">Facility action completed.</span>
</div>

<script>
    const modal = document.getElementById('facilityModal');
    const form = document.getElementById('facilityForm');
    const submitBtn = document.getElementById('submitBtn');
    const imagePreview = document.getElementById('imagePreview');
    const facilitySearch = document.getElementById('facilitySearch');
    const facilityFilter = document.getElementById('facilityFilter');
    const facilityToast = document.getElementById('facilityToast');
    const facilityToastMessage = document.getElementById('facilityToastMessage');

    function showToast(message) {
        if (!facilityToast || !facilityToastMessage) return;

        facilityToastMessage.textContent = message;
        facilityToast.classList.add('show');

        setTimeout(function () {
            facilityToast.classList.remove('show');
        }, 2800);
    }

    function previewFile() {
        const fileInput = document.getElementById('field_image');
        const file = fileInput && fileInput.files ? fileInput.files[0] : null;

        if (!file || !imagePreview) return;

        const reader = new FileReader();

        reader.onloadend = function () {
            imagePreview.src = reader.result;
        };

        reader.readAsDataURL(file);
    }

    function openAddModal() {
        if (!modal || !form || !submitBtn) return;

        document.getElementById('modalTitle').innerText = 'Add New Facility';
        document.getElementById('modalSubtitle').innerText = 'Create a new room, cottage, or hall listing for your guests.';

        submitBtn.innerHTML = '<i class="fa-solid fa-plus"></i> Create Facility';
        form.action = '/admin/facilities/add';
        form.reset();

        if (imagePreview) {
            imagePreview.src = '/images/default-room.jpg';
        }

        modal.classList.add('show');
        document.body.style.overflow = 'hidden';

        setTimeout(function () {
            const nameField = document.getElementById('field_name');

            if (nameField) {
                nameField.focus();
            }
        }, 120);
    }

    function openEditModalFromData(button) {
        try {
            const payload = JSON.parse(decodeURIComponent(button.dataset.facility || '{}'));
            openEditModal(payload);
        } catch (error) {
            console.error('Failed to read facility data:', error);
            showToast('Unable to open facility details.');
        }
    }

    function openEditModal(facility) {
        if (!modal || !form || !submitBtn || !facility) return;

        document.getElementById('modalTitle').innerText = 'Edit Facility';
        document.getElementById('modalSubtitle').innerText = 'Update the selected facility details below.';

        submitBtn.innerHTML = '<i class="fa-solid fa-floppy-disk"></i> Save Changes';
        form.action = '/admin/facilities/update/' + facility.id;

        document.getElementById('field_name').value = facility.name || '';
        document.getElementById('field_type').value = facility.type || 'Room';
        document.getElementById('field_price').value = facility.price || '';
        document.getElementById('field_status').value = facility.status || 'Available';

        if (imagePreview) {
            imagePreview.src = facility.image_url || '/images/default-room.jpg';
        }

        modal.classList.add('show');
        document.body.style.overflow = 'hidden';
    }

    function closeModal() {
        if (!modal) return;

        modal.classList.remove('show');
        document.body.style.overflow = '';
    }

    function confirmDelete(id) {
        if (confirm('Are you sure you want to delete this facility?')) {
            window.location.href = '/admin/facilities/delete/' + id;
        }
    }

    function applyFacilityFilters() {
        const keyword = facilitySearch ? facilitySearch.value.trim().toLowerCase() : '';
        const filterValue = facilityFilter ? facilityFilter.value.toLowerCase() : 'all';
        const facilityRows = document.querySelectorAll('.facility-row');

        facilityRows.forEach(function (row) {
            const name = row.dataset.name || '';
            const type = row.dataset.type || '';
            const status = row.dataset.status || '';

            const matchesKeyword = !keyword || 
                name.includes(keyword) || 
                type.includes(keyword) || 
                status.includes(keyword);

            const matchesFilter = filterValue === 'all' || 
                type === filterValue || 
                status === filterValue;

            row.style.display = matchesKeyword && matchesFilter ? '' : 'none';
        });
    }

    document.querySelectorAll('.edit-facility-btn').forEach(function (button) {
        button.addEventListener('click', function () {
            openEditModalFromData(button);
        });
    });

    if (facilitySearch) {
        facilitySearch.addEventListener('input', applyFacilityFilters);
    }

    if (facilityFilter) {
        facilityFilter.addEventListener('change', applyFacilityFilters);
    }

    if (modal) {
        modal.addEventListener('click', function (event) {
            if (event.target === modal) {
                closeModal();
            }
        });
    }

    document.addEventListener('keydown', function (event) {
        if (event.key === 'Escape') {
            closeModal();
        }
    });
</script>