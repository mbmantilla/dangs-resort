<style>
/* --- Main Container Card --- */
.admin-card { 
    background: linear-gradient(135deg, #f8fafc, #e2e8f0);
    padding: 32px; 
    border-radius: 20px; 
    box-shadow: 0 20px 60px rgba(0,0,0,0.08);
    border: none; 
    transition: transform 0.3s ease;
}
.admin-card:hover { transform: translateY(-3px); }

/* --- Modern Table UI --- */
.admin-table { 
    width: 100%; 
    border-collapse: separate; 
    border-spacing: 0 12px; 
    margin-top: -12px; 
}
.admin-table th { 
    text-align: left; 
    padding: 14px 24px; 
    color: #475569; 
    font-size: 0.75rem; 
    text-transform: uppercase; 
    letter-spacing: 0.05em;
    font-weight: 700;
    border: none;
}

.admin-table tbody tr { 
    background: #fff; 
    transition: all 0.3s ease;
    box-shadow: 0 5px 15px rgba(0,0,0,0.05);
    border-radius: 12px;
}
.admin-table tbody tr:hover { 
    transform: translateY(-2px);
    box-shadow: 0 15px 30px rgba(0,0,0,0.1);
    background: #f1f5f9;
}

.admin-table td { 
    padding: 16px 24px; 
    vertical-align: middle;
    border-top: none;
    border-bottom: none;
}
.admin-table td:first-child { border-radius: 12px 0 0 12px; }
.admin-table td:last-child { border-radius: 0 12px 12px 0; }

/* --- Action Buttons --- */
.btn-add { 
    background: linear-gradient(135deg, #0ea5e9, #2563eb); 
    color: white; 
    border: none; 
    padding: 12px 24px; 
    border-radius: 12px; 
    font-weight: 600; 
    cursor: pointer; 
    display: flex; 
    align-items: center; 
    gap: 8px; 
    transition: transform 0.2s ease, background 0.3s;
}
.btn-add:hover { 
    background: linear-gradient(135deg, #0369a1, #0c4a6e); 
    transform: scale(1.05); 
}

.btn-edit { 
    background: #e0f2fe; 
    color: #0369a1; 
    border: none; 
    padding: 8px 16px; 
    border-radius: 8px; 
    cursor: pointer; 
    font-weight: 600; 
    transition: background 0.3s;
}
.btn-edit:hover { background: #bae6fd; }

.btn-delete { 
    background: #fee2e2; 
    color: #dc2626; 
    border: none; 
    padding: 8px 16px; 
    border-radius: 8px; 
    cursor: pointer; 
    font-weight: 600; 
    transition: background 0.3s;
}
.btn-delete:hover { background: #fecaca; }

/* --- Status Pills --- */
.status-pill { 
    padding: 6px 14px; 
    border-radius: 99px; 
    font-size: 0.75rem; 
    font-weight: 700; 
    text-transform: uppercase; 
    letter-spacing: 0.02em; 
    transition: background 0.3s, color 0.3s;
}
.status-pill.active { background: #dcfce7; color: #166534; border: 1px solid #bbf7d0; }
.status-pill.inactive { background: #fef2f2; color: #991b1b; border: 1px solid #fecaca; }

/* --- Badges --- */
.badge { 
    background: #f1f5f9; 
    padding: 4px 10px; 
    border-radius: 8px; 
    font-size: 0.75rem; 
    color: #475569; 
    font-weight: 600; 
}

/* --- Modal --- */
.modal-overlay { 
    position: fixed; top:0; left:0; width:100%; height:100%; 
    background: rgba(15, 23, 42, 0.5); 
    display: none; align-items: center; justify-content: center; 
    z-index: 1000; backdrop-filter: blur(6px); 
}
.modal-content { 
    background: #ffffff; 
    padding: 40px; 
    border-radius: 24px; 
    width: 450px; 
    box-shadow: 0 25px 50px -12px rgba(0,0,0,0.25); 
    border: 1px solid #e2e8f0; 
    transition: transform 0.3s ease;
}
.modal-content:hover { transform: translateY(-2px); }

/* --- Form Fields --- */
.form-group { margin-bottom: 18px; }
.form-group label { display: block; font-size: 0.85rem; color: #64748b; margin-bottom: 8px; font-weight: 600; }
.form-group input, .form-group select { 
    width: 100%; padding: 12px; border: 1px solid #e2e8f0; border-radius: 12px; font-size: 0.9rem; 
    font-family: inherit; background: #f8fafc; transition: border 0.2s ease;
}
.form-group input:focus, .form-group select:focus { border-color: #0ea5e9; outline: none; }
</style>

<div class="admin-card">
    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 30px;">
        <div>
            <h2 style="margin: 0; color: #0f172a; font-size: 1.75rem;">Manage Facilities</h2>
            <p style="margin: 5px 0 0; color: #64748b; font-size: 0.9rem;">View and manage your resort rooms and cottages</p>
        </div>
        <button class="btn-add" onclick="openAddModal()">
            <svg width="20" height="20" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"></path></svg>
            Add New Facility
        </button>
    </div>

    <table class="admin-table">
        <thead>
            <tr>
                <th>Preview</th>
                <th>Facility Name</th>
                <th>Category</th>
                <th>Pricing</th>
                <th>Status</th>
                <th style="text-align: center;">Actions</th>
            </tr>
        </thead>
        <tbody>
            <% rooms.forEach(room => { %>
            <tr>
                <td>
                    <img src="<%= room.image_url || '/images/default-room.jpg' %>" 
                         style="width: 70px; height: 50px; border-radius: 12px; object-fit: cover; border: 2px solid #fff; box-shadow: 0 4px 6px -1px rgba(0,0,0,0.1);">
                </td>
                <td>
                    <div style="font-weight: 700; color: #1e293b; font-size: 1rem;"><%= room.name %></div>
                    <div style="font-size: 0.75rem; color: #94a3b8;">ID: #REF-0<%= room.id %></div>
                </td>
                <td><span class="badge"><%= room.type %></span></td>
                <td>
                    <span style="font-weight: 700; color: #0f172a;">₱<%= room.price.toLocaleString() %></span>
                    <span style="font-size: 0.7rem; color: #94a3b8;">/ night</span>
                </td>
                <td>
                    <span class="status-pill <%= room.status === 'Available' ? 'active' : 'inactive' %>">
                        <%= room.status %>
                    </span>
                </td>
                <td style="text-align: center;">
                    <div style="display: flex; gap: 8px; justify-content: center;">
                        <button class="btn-edit" 
                            onclick="openEditModal('<%= room.id %>', '<%= room.name %>', '<%= room.type %>', '<%= room.price %>', '<%= room.status %>', '<%= room.image_url %>')">
                            Edit
                        </button>
                        <button class="btn-delete" onclick="confirmDelete('<%= room.id %>')">Delete</button>
                    </div>
                </td>
            </tr>
            <% }) %>
        </tbody>
    </table>
</div>

<div id="facilityModal" class="modal-overlay">
    <div class="modal-content">
        <h3 id="modalTitle" style="margin-top: 0; color: #0f172a;">Edit Facility</h3>
        <form id="facilityForm" method="POST" enctype="multipart/form-data">
            <div class="form-group">
                <label>Facility Image</label>
                <div style="display: flex; align-items: center; gap: 15px;">
                    <img id="imagePreview" src="/images/default-room.jpg" style="width: 80px; height: 60px; border-radius: 8px; object-fit: cover; border: 1px solid #e2e8f0;">
                    <input type="file" name="image" id="field_image" accept="image/*" onchange="previewFile()">
                </div>
            </div>
            <div class="form-group">
                <label>Facility Name</label>
                <input type="text" name="name" id="field_name" required>
            </div>
            <div class="form-group">
                <label>Type</label>
                <select name="type" id="field_type">
                    <option value="Room">Room</option>
                    <option value="Cottage">Cottage</option>
                    <option value="Hall">Hall</option>
                </select>
            </div>
            <div class="form-group">
                <label>Price per Night (₱)</label>
                <input type="number" name="price" id="field_price" required>
            </div>
            <div class="form-group">
                <label>Status</label>
                <select name="status" id="field_status">
                    <option value="Available">Available</option>
                    <option value="Maintenance">Maintenance</option>
                </select>
            </div>
            <div style="display: flex; gap: 10px; margin-top: 25px;">
                <button type="submit" class="btn-add" id="submitBtn" style="flex: 1; justify-content: center;">Save Changes</button>
                <button type="button" class="btn-delete" onclick="closeModal()" style="background: #94a3b8; flex: 1; color: white;">Cancel</button>
            </div>
        </form>
    </div>
</div>

<script>
    const modal = document.getElementById('facilityModal');
    const form = document.getElementById('facilityForm');
    const submitBtn = document.getElementById('submitBtn');
    const imagePreview = document.getElementById('imagePreview');

    function previewFile() {
        const file = document.querySelector('input[type=file]').files[0];
        const reader = new FileReader();
        reader.onloadend = () => imagePreview.src = reader.result;
        if (file) reader.readAsDataURL(file);
    }

    function openAddModal() {
        document.getElementById('modalTitle').innerText = "Add New Facility";
        submitBtn.innerText = "Create Facility";
        form.action = "/admin/facilities/add";
        form.reset();
        imagePreview.src = '/images/default-room.jpg';
        modal.style.display = 'flex';
    }

    function openEditModal(id, name, type, price, status, imageUrl) {
        document.getElementById('modalTitle').innerText = "Edit Facility";
        submitBtn.innerText = "Save Changes";
        form.action = `/admin/facilities/update/${id}`;
        
        document.getElementById('field_name').value = name;
        document.getElementById('field_type').value = type;
        document.getElementById('field_price').value = price;
        document.getElementById('field_status').value = status;
        imagePreview.src = imageUrl || '/images/default-room.jpg';
        
        modal.style.display = 'flex';
    }

    function closeModal() {
        modal.style.display = 'none';
    }

    function confirmDelete(id) {
        if (confirm("Are you sure you want to delete this facility?")) {
            window.location.href = `/admin/facilities/delete/${id}`;
        }
    }

    window.onclick = (event) => { if (event.target == modal) closeModal(); }
</script>