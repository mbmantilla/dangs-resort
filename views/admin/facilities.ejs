<%
    const safeRooms = typeof rooms !== 'undefined' && Array.isArray(rooms) ? rooms : [];

    const totalFacilities = safeRooms.length;

    const availableFacilities = safeRooms.filter(function (room) {
        return String(room.status || '').toLowerCase() === 'available';
    }).length;

    const maintenanceFacilities = safeRooms.filter(function (room) {
        const status = String(room.status || '').toLowerCase();
        return status === 'maintenance' || status === 'inactive' || status === 'unavailable';
    }).length;

    const roomCount = safeRooms.filter(function (room) {
        return String(room.type || '').toLowerCase() === 'room';
    }).length;

    const cottageCount = safeRooms.filter(function (room) {
        return String(room.type || '').toLowerCase() === 'cottage';
    }).length;

    const hallCount = safeRooms.filter(function (room) {
        return String(room.type || '').toLowerCase() === 'hall';
    }).length;

    const averagePrice = totalFacilities > 0 
        ? safeRooms.reduce(function (sum, room) {
            return sum + Number(room.price || 0);
        }, 0) / totalFacilities 
        : 0;

    const pesoFormat = function (value) {
        return Number(value || 0).toLocaleString('en-PH', {
            minimumFractionDigits: 0,
            maximumFractionDigits: 2
        });
    };

    const statusClass = function (status) {
        const value = String(status || '').toLowerCase();

        if (value === 'available') return 'active';
        if (value === 'maintenance') return 'maintenance';
        if (value === 'inactive' || value === 'unavailable') return 'inactive';

        return 'neutral';
    };

    const typeIcon = function (type) {
        const value = String(type || '').toLowerCase();

        if (value === 'room') return 'fa-solid fa-bed';
        if (value === 'cottage') return 'fa-solid fa-umbrella-beach';
        if (value === 'hall') return 'fa-solid fa-building-columns';

        return 'fa-solid fa-house';
    };
%>

