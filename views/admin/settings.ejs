    }

    .label-hint {
        color: var(--settings-text-muted);
        font-size: 0.66rem;
        font-weight: 800;
        letter-spacing: 0.06em;
    }

    .field-shell {
        position: relative;
    }

    .field-icon {
        position: absolute;
        left: 16px;
        top: 50%;
        transform: translateY(-50%);
        color: var(--settings-ocean-600);
        pointer-events: none;
        transition:
            color 0.25s var(--settings-ease),
            transform 0.25s var(--settings-ease);
    }

    .form-control {
        width: 100%;
        min-height: 56px;
        padding: 0 16px 0 48px;
        border: 1px solid rgba(148, 163, 184, 0.24);
        border-radius: 18px;
        outline: none;
        color: var(--settings-text-main);
        background: rgba(255, 255, 255, 0.86);
        box-shadow: 0 6px 16px rgba(15, 23, 42, 0.035);
        font-weight: 750;
        transition:
            border-color 0.25s var(--settings-ease),
            box-shadow 0.25s var(--settings-ease),
            background 0.25s var(--settings-ease),
            transform 0.25s var(--settings-ease);
    }

    .form-control::placeholder {
        color: var(--settings-text-muted);
        font-weight: 650;
    }

    .form-control:focus {
        border-color: rgba(6, 182, 212, 0.55);
        background: white;
        box-shadow:
            0 0 0 4px rgba(6, 182, 212, 0.11),
            0 14px 30px rgba(15, 23, 42, 0.07);
        transform: translateY(-1px);
    }

    .field-shell:focus-within .field-icon {
        color: var(--settings-sea-600);
        transform: translateY(-50%) scale(1.08);
    }

    .helper-text {
        display: flex;
        align-items: flex-start;
        gap: 8px;
        margin-top: 8px;
        color: var(--settings-text-muted);
        font-size: 0.76rem;
        line-height: 1.5;
    }

    .helper-text i {
        color: var(--settings-ocean-600);
        margin-top: 2px;
    }

    .maintenance-row {
        display: grid;
        grid-template-columns: minmax(0, 1fr) minmax(190px, 240px);
        gap: 18px;
        align-items: center;
    }

    .maintenance-copy {
        display: flex;
        align-items: center;
        gap: 14px;
    }

    .maintenance-icon {
        width: 50px;
        height: 50px;
        min-width: 50px;
        border-radius: 19px;
        display: grid;
        place-items: center;
        color: white;
        background: linear-gradient(135deg, var(--settings-sand-500), var(--settings-sand-700));
        box-shadow: 0 14px 30px rgba(245, 158, 11, 0.16);
    }

    .maintenance-copy span {
        display: block;
        color: var(--settings-text-main);
        font-size: 0.98rem;
        font-weight: 950;
    }

    .maintenance-copy small {
        display: block;
        margin-top: 4px;
        color: var(--settings-text-muted);
        line-height: 1.5;
        font-size: 0.78rem;
        font-weight: 750;
    }

    .select-shell {
        position: relative;
    }

    .select-shell::after {
        content: "\f078";
        position: absolute;
        top: 50%;
        right: 16px;
        transform: translateY(-50%);
        pointer-events: none;
        color: var(--settings-ocean-600);
        font-family: "Font Awesome 6 Free";
        font-weight: 900;
        font-size: 0.72rem;
    }

    .select-shell select {
        appearance: none;
        padding-right: 44px;
        cursor: pointer;
    }

    .form-actions {
        display: grid;
        gap: 12px;
        margin-top: 22px;
    }

    .btn-primary i {
        font-size: 0.95rem;
    }

    .preview-card {
        position: relative;
        min-width: 0;
        padding: 0;
        border-radius: 34px;
        background: rgba(255, 255, 255, 0.88);
        border: 1px solid rgba(255, 255, 255, 0.82);
        box-shadow: var(--settings-shadow-md);
        backdrop-filter: blur(18px);
        overflow: hidden;
        animation: settingsCardRise 0.9s var(--settings-ease) both;
    }

    .preview-card::before {
        content: "";
        position: absolute;
        inset: 0;
        pointer-events: none;
        background:
            radial-gradient(circle at 0% 0%, rgba(6, 182, 212, 0.08), transparent 30%),
            radial-gradient(circle at 100% 100%, rgba(20, 184, 166, 0.09), transparent 30%);
    }

    .preview-inner {
        position: relative;
        z-index: 2;
        padding: 26px;
    }

    .payment-preview {
        position: relative;
        padding: 24px;
        border-radius: 30px;
        overflow: hidden;
        color: white;
        background:
            radial-gradient(circle at 16% 14%, rgba(255, 255, 255, 0.24), transparent 28%),
            linear-gradient(135deg, var(--settings-slate-950), var(--settings-ocean-900) 55%, var(--settings-sea-800));
        box-shadow: var(--settings-shadow-lg);
    }

    .payment-preview::before {
        content: "";
        position: absolute;
        right: -80px;
        top: -80px;
        width: 190px;
        height: 190px;
        border-radius: var(--settings-radius-full);
        background: rgba(255, 255, 255, 0.12);
    }

    .preview-top {
        position: relative;
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        gap: 16px;
        margin-bottom: 34px;
    }

    .preview-brand {
        display: inline-flex;
        align-items: center;
        gap: 10px;
        color: rgba(255, 255, 255, 0.88);
        font-size: 0.76rem;
        font-weight: 950;
        letter-spacing: 0.12em;
        text-transform: uppercase;
    }

    .preview-brand i {
        width: 38px;
        height: 38px;
        border-radius: 15px;
        display: grid;
        place-items: center;
        color: var(--settings-slate-950);
        background: white;
    }

    .preview-chip {
        min-height: 34px;
        padding: 0 11px;
        border-radius: var(--settings-radius-full);
        display: inline-flex;
        align-items: center;
        gap: 7px;
        color: white;
        background: rgba(255, 255, 255, 0.14);
        border: 1px solid rgba(255, 255, 255, 0.22);
        font-size: 0.66rem;
        font-weight: 950;
        letter-spacing: 0.08em;
        text-transform: uppercase;
    }

    .preview-name-label {
        position: relative;
        display: block;
        color: rgba(255, 255, 255, 0.66);
        font-size: 0.72rem;
        font-weight: 950;
        letter-spacing: 0.14em;
        text-transform: uppercase;
        margin-bottom: 8px;
    }

    .preview-name {
        position: relative;
        display: block;
        color: white;
        font-size: 1.5rem;
        font-weight: 950;
        line-height: 1.15;
        overflow-wrap: anywhere;
    }

    .preview-number {
        position: relative;
        margin-top: 14px;
        min-height: 46px;
        padding: 0 14px;
        border-radius: 17px;
        display: inline-flex;
        align-items: center;
        gap: 9px;
        color: rgba(255, 255, 255, 0.88);
        background: rgba(255, 255, 255, 0.12);
        border: 1px solid rgba(255, 255, 255, 0.16);
        font-size: 0.94rem;
        font-weight: 850;
        overflow-wrap: anywhere;
    }

    .status-preview {
        margin-top: 18px;
        padding: 20px;
        border-radius: 26px;
        background: var(--settings-card-muted);
        border: 1px solid rgba(148, 163, 184, 0.16);
    }

    .status-preview-head {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 14px;
        margin-bottom: 14px;
    }

    .status-preview-title {
        display: flex;
        align-items: center;
        gap: 10px;
        color: var(--settings-text-main);
        font-size: 0.95rem;
        font-weight: 950;
    }

    .status-preview-title i {
        color: var(--settings-ocean-600);
    }

    .mode-badge {
        min-height: 36px;
        padding: 0 12px;
        border-radius: var(--settings-radius-full);
        display: inline-flex;
        align-items: center;
        gap: 8px;
        font-size: 0.68rem;
        font-weight: 950;
        letter-spacing: 0.08em;
        text-transform: uppercase;
        white-space: nowrap;
        border: 1px solid transparent;
    }

    .mode-badge.active {
        color: var(--settings-emerald-700);
        background: var(--settings-emerald-100);
        border-color: rgba(16, 185, 129, 0.18);
    }

    .mode-badge.maintenance {
        color: var(--settings-sand-800);
        background: var(--settings-sand-100);
        border-color: rgba(245, 158, 11, 0.20);
    }

    .status-preview p {
        margin: 0;
        color: var(--settings-text-soft);
        line-height: 1.7;
        font-size: 0.86rem;
    }

    .tips-list {
        display: grid;
        gap: 12px;
        margin-top: 18px;
    }

    .tip-item {
        display: flex;
        align-items: flex-start;
        gap: 12px;
        padding: 14px;
        border-radius: 20px;
        background: rgba(255, 255, 255, 0.82);
        border: 1px solid rgba(148, 163, 184, 0.14);
    }

    .tip-icon {
        width: 38px;
        height: 38px;
        min-width: 38px;
        border-radius: 15px;
        display: grid;
        place-items: center;
        color: white;
        background: linear-gradient(135deg, var(--settings-ocean-500), var(--settings-sea-500));
        box-shadow: 0 10px 24px rgba(8, 145, 178, 0.14);
    }

    .tip-item strong {
        display: block;
        color: var(--settings-text-main);
        font-size: 0.88rem;
        font-weight: 950;
        margin-bottom: 4px;
    }

    .tip-item span {
        display: block;
        color: var(--settings-text-soft);
        font-size: 0.78rem;
        line-height: 1.55;
    }

    .footer-settings {
        position: relative;
        margin-top: 28px;
        padding: 28px;
        border-radius: 34px;
        color: white;
        overflow: hidden;
        background:
            linear-gradient(135deg, var(--settings-slate-950), var(--settings-ocean-900) 52%, var(--settings-sea-800));
        box-shadow: var(--settings-shadow-lg);
    }

    .footer-settings::before {
        content: "";
        position: absolute;
        width: 280px;
        height: 280px;
        right: -120px;
        top: -150px;
        border-radius: var(--settings-radius-full);
        background: rgba(255, 255, 255, 0.12);
    }

    .footer-settings-content {
        position: relative;
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 24px;
    }

    .footer-settings h3 {
        margin: 0 0 8px;
        font-family: var(--settings-font-display);
        font-size: 1.8rem;
        font-weight: 400;
    }

    .footer-settings p {
        margin: 0;
        color: rgba(226, 232, 240, 0.76);
        line-height: 1.7;
    }

    .toast {
        position: fixed;
        left: 50%;
        bottom: 28px;
        z-index: 1100;
        min-width: min(440px, calc(100% - 32px));
        padding: 15px 16px;
        border-radius: 20px;
        display: flex;
        align-items: center;
        gap: 12px;
        color: white;
        background: rgba(15, 23, 42, 0.92);
        border: 1px solid rgba(255, 255, 255, 0.12);
        box-shadow: var(--settings-shadow-lg);
        backdrop-filter: blur(18px);
        transform: translate(-50%, 30px);
        opacity: 0;
        pointer-events: none;
        transition:
            transform 0.28s var(--settings-ease),
            opacity 0.28s var(--settings-ease);
    }

    .toast.show {
        transform: translate(-50%, 0);
        opacity: 1;
    }

    .toast i {
        color: var(--settings-sand-300);
    }

    @media (max-width: 1280px) {
        .settings-hero-inner {
            grid-template-columns: 1fr;
        }

        .settings-grid {
            grid-template-columns: 1fr;
        }

        .settings-overview-strip {
            grid-template-columns: repeat(2, minmax(0, 1fr));
            margin-top: 20px;
            margin-left: 0;
            margin-right: 0;
        }
    }

    @media (max-width: 980px) {
        .card-header,
        .section-heading {
            align-items: flex-start;
            flex-direction: column;
        }

        .maintenance-row {
            grid-template-columns: 1fr;
        }
    }

    @media (max-width: 720px) {
        .settings-hero {
            padding: 26px;
            border-radius: 30px;
        }

        .hero-title {
            font-size: clamp(2.1rem, 12vw, 3.5rem);
        }

        .hero-actions {
            align-items: stretch;
            flex-direction: column;
        }

        .hero-btn,
        .btn-primary,
        .btn-soft {
            width: 100%;
        }

        .settings-overview-strip {
            grid-template-columns: 1fr;
        }

        .admin-card-inner,
        .preview-inner {
            padding: 20px;
        }

        .footer-settings-content {
            align-items: flex-start;
            flex-direction: column;
        }
    }

    @media (max-width: 520px) {
        .settings-hero {
            padding: 22px;
            border-radius: 26px;
        }

        .hero-eyebrow,
        .card-kicker {
            font-size: 0.62rem;
            letter-spacing: 0.10em;
        }

        .hero-copy {
            font-size: 0.92rem;
        }

        .overview-pill {
            min-height: 94px;
            border-radius: 24px;
        }

        .admin-card,
        .preview-card,
        .footer-settings {
            border-radius: 26px;
        }

        .settings-section {
            padding: 16px;
            border-radius: 24px;
        }

        .maintenance-copy {
            align-items: flex-start;
        }
    }

    @media print {
        .settings-orb,
        .settings-noise,
        .hero-actions,
        .footer-settings,
        .toast {
            display: none !important;
        }

        .settings-page::before,
        .settings-page::after {
            display: none !important;
        }

        .settings-hero,
        .admin-card,
        .preview-card,
        .overview-pill,
        .footer-settings {
            box-shadow: none !important;
        }

        .settings-grid {
            grid-template-columns: 1fr !important;
        }
    }

    @media (prefers-reduced-motion: reduce) {
        .settings-page *,
        .settings-page *::before,
        .settings-page *::after {
            animation-duration: 0.01ms !important;
            animation-iteration-count: 1 !important;
            scroll-behavior: auto !important;
            transition-duration: 0.01ms !important;
        }
    }

