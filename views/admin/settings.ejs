    /* Settings UI Note 0151: Glassmorphism cards match the other upgraded admin pages. */
    /* Settings UI Note 0152: Responsive grid stacks settings and preview cards on tablets. */
</style>

<div class="settings-page">
    <span class="settings-orb one"></span>
    <span class="settings-orb two"></span>
    <span class="settings-orb three"></span>
    <div class="settings-noise"></div>

    <section class="settings-hero">
        <div class="settings-hero-inner">
            <div>
                <span class="hero-eyebrow">
                    <i class="fa-solid fa-gear"></i>
                    System Settings
                </span>

                <h1 class="hero-title">
                    Resort controls<span>.</span>
                </h1>

                <p class="hero-copy">
                    Manage payment details, booking availability, and key operational settings for Dang's Beach Resort.
                </p>

                <div class="hero-actions">
                    <a href="/admin/dashboard" class="hero-btn">
                        <i class="fa-solid fa-gauge-high"></i>
                        Dashboard
                    </a>

                    <a href="/admin/reports" class="hero-btn ghost">
                        <i class="fa-solid fa-chart-line"></i>
                        Reports
                    </a>
                </div>
            </div>

            <article class="hero-live-card">
                <div class="live-card-icon">
                    <i class="fa-solid <%= isMaintenance ? 'fa-screwdriver-wrench' : 'fa-circle-check' %>"></i>
                </div>

                <span class="live-card-label">
                    Resort Mode
                </span>

                <strong class="live-card-value">
                    <%= isMaintenance ? 'Maintenance' : 'Active' %>
                </strong>

                <p class="live-card-copy">
                    <%= isMaintenance ? 'Bookings are temporarily disabled while maintenance mode is active.' : 'Bookings are currently available for guests.' %>
                </p>
            </article>
        </div>
    </section>

    <section class="settings-overview-strip" aria-label="Settings overview">
        <article class="overview-pill">
            <div class="overview-icon payment">
                <i class="fa-solid fa-wallet"></i>
            </div>

            <div class="overview-copy">
                <strong><%= gcashName || 'Not Set' %></strong>
                <span>Name</span>
            </div>
        </article>

        <article class="overview-pill">
            <div class="overview-icon">
                <i class="fa-solid fa-mobile-screen"></i>
            </div>

            <div class="overview-copy">
                <strong><%= gcashNumber || 'Not Set' %></strong>
                <span>Mobile Number</span>
            </div>
        </article>

        <article class="overview-pill">
            <div class="overview-icon <%= isMaintenance ? 'status-on' : 'status-off' %>">
                <i class="fa-solid <%= isMaintenance ? 'fa-screwdriver-wrench' : 'fa-circle-check' %>"></i>
            </div>

            <div class="overview-copy">
                <strong><%= isMaintenance ? 'Maintenance' : 'Active' %></strong>
                <span>Resort Status</span>
            </div>
        </article>
    </section>

    <section class="settings-grid">
        <article class="admin-card">
            <div class="admin-card-inner">
                <div class="card-header">
                    <div>
                        <span class="card-kicker">
                            <i class="fa-solid fa-sliders"></i>
                            Configuration
                        </span>

                        <h2 class="card-title">
                            System Settings
                        </h2>

                        <p class="card-copy">
                            Update the resort's payment information and guest booking availability.
                        </p>
                    </div>

                    <span class="card-chip">
                        <i class="fa-solid fa-shield-halved"></i>
                        Admin Only
                    </span>
                </div>

                <% if (isSuccess) { %>
                    <div class="success-msg">
                        <i class="fa-solid fa-circle-check"></i>
                        <span>Settings updated successfully!</span>
                    </div>
                <% } %>

                <form action="/admin/settings/update" method="POST" id="settingsForm">
                    <div class="settings-section">
                        <div class="section-heading">
                            <div class="section-title-wrap">
                                <div class="section-icon">
                                    <i class="fa-solid fa-credit-card"></i>
                                </div>

                                <div>
                                    <span class="section-title">
                                        Payment Configuration
                                    </span>

                                    <span class="section-subtitle">
                                        Displayed to guests during payment.
                                    </span>
                                </div>
                            </div>

                            <span class="section-badge">
                                <i class="fa-solid fa-qrcode"></i>
                                Payment
                            </span>
                        </div>

                        <div class="form-group">
                            <label for="gcashName">
                                <span class="label-main">
                                    <i class="fa-solid fa-user"></i>
                                    GCash Name
                                </span>

                                <span class="label-hint">Required</span>
                            </label>

                            <div class="field-shell">
                                <i class="fa-solid fa-user-check field-icon"></i>

                                <input 
                                    type="text" 
                                    name="gcash_name" 
                                    id="gcashName"
                                    class="form-control"
                                    value="<%= gcashName %>" 
                                    placeholder="Enter GCash Name"
                                    autocomplete="off"
                                >
                            </div>

                            <div class="helper-text">
                                <i class="fa-solid fa-circle-info"></i>
                                <span>Use the same account name visible on the resort payment QR or receipt.</span>
                            </div>
                        </div>

                        <div class="form-group">
                            <label for="gcashNumber">
                                <span class="label-main">
                                    <i class="fa-solid fa-mobile-screen"></i>
                                    GCash Number
                                </span>

                                <span class="label-hint">Required</span>
                            </label>

                            <div class="field-shell">
                                <i class="fa-solid fa-phone field-icon"></i>

                                <input 
                                    type="text" 
                                    name="gcash_number" 
                                    id="gcashNumber"
                                    class="form-control"
                                    value="<%= gcashNumber %>" 
                                    placeholder="Enter GCash Number"
                                    autocomplete="off"
                                >
                            </div>

                            <div class="helper-text">
                                <i class="fa-solid fa-shield-heart"></i>
                                <span>Double-check this number before saving because guests may use it for payment confirmation.</span>
                            </div>
                        </div>
                    </div>

                    <div class="settings-section">
                        <div class="section-heading">
                            <div class="section-title-wrap">
                                <div class="section-icon">
                                    <i class="fa-solid fa-tower-broadcast"></i>
                                </div>

                                <div>
                                    <span class="section-title">
                                        Resort Status
                                    </span>

                                    <span class="section-subtitle">
                                        Control whether guests can book rooms.
                                    </span>
                                </div>
                            </div>

                            <span class="section-badge">
                                <i class="fa-solid fa-power-off"></i>
                                System
                            </span>
                        </div>

                        <div class="maintenance-row">
                            <div class="maintenance-copy">
                                <div class="maintenance-icon">
                                    <i class="fa-solid <%= isMaintenance ? 'fa-screwdriver-wrench' : 'fa-circle-check' %>"></i>
                                </div>

                                <div>
                                    <span>Maintenance Mode</span>
                                    <small>Disable bookings temporarily when the resort is not accepting reservations.</small>
                                </div>
                            </div>

                            <div class="select-shell">
                                <select 
                                    name="maintenance_mode" 
                                    id="maintenanceMode"
                                    class="form-control"
                                >
                                    <option value="off" <%= maintenanceMode === 'off' ? 'selected' : '' %>>
                                        Active
                                    </option>

                                    <option value="on" <%= maintenanceMode === 'on' ? 'selected' : '' %>>
                                        Maintenance
                                    </option>
                                </select>
                            </div>
                        </div>
                    </div>

                    <div class="form-actions">
                        <button type="submit" class="btn-primary" id="saveButton">
                            <i class="fa-solid fa-floppy-disk"></i>
                            Save Changes
                        </button>
                    </div>
                </form>
            </div>
        </article>

        <aside class="preview-card">
            <div class="preview-inner">
                <div class="card-header">
                    <div>
                        <span class="card-kicker">
                            <i class="fa-solid fa-eye"></i>
                            Live Preview
                        </span>

                        <h2 class="card-title">
                            Payment Display
                        </h2>

                        <p class="card-copy">
                            Preview what the current payment account details look like.
                        </p>
                    </div>
                </div>

                <div class="payment-preview">
                    <div class="preview-top">
                        <span class="preview-brand">
                            <i class="fa-solid fa-wallet"></i>
                            GCash Payment
                        </span>

                        <span class="preview-chip">
                            <i class="fa-solid fa-lock"></i>
                            Secure
                        </span>
                    </div>

                    <span class="preview-name-label">
                        Account Name
                    </span>

                    <strong class="preview-name" id="previewName">
                        <%= gcashName || 'GCash Name' %>
                    </strong>

                    <div class="preview-number">
                        <i class="fa-solid fa-mobile-screen"></i>
                        <span id="previewNumber">
                            <%= gcashNumber || 'GCash Number' %>
                        </span>
                    </div>
                </div>

                <div class="status-preview">
                    <div class="status-preview-head">
                        <div class="status-preview-title">
                            <i class="fa-solid fa-signal"></i>
                            Booking Availability
                        </div>

                        <span class="mode-badge <%= isMaintenance ? 'maintenance' : 'active' %>" id="modeBadge">
                            <i class="fa-solid <%= isMaintenance ? 'fa-screwdriver-wrench' : 'fa-circle-check' %>"></i>
                            <span><%= isMaintenance ? 'Maintenance' : 'Active' %></span>
                        </span>
                    </div>

                    <p id="modeDescription">
                        <%= isMaintenance ? 'Guests will not be able to create new bookings while maintenance mode is enabled.' : 'Guests can continue creating new bookings while the resort is active.' %>
                    </p>
                </div>

                <div class="tips-list">
                    <div class="tip-item">
                        <div class="tip-icon">
                            <i class="fa-solid fa-receipt"></i>
                        </div>

                        <div>
                            <strong>Payment clarity</strong>
                            <span>Keep the GCash account name and number consistent with the QR code shown to clients.</span>
                        </div>
                    </div>

                    <div class="tip-item">
                        <div class="tip-icon">
                            <i class="fa-solid fa-bell"></i>
                        </div>

                        <div>
                            <strong>Maintenance reminder</strong>
                            <span>Turn maintenance mode on only when bookings should be temporarily paused.</span>
                        </div>
                    </div>

                    <div class="tip-item">
                        <div class="tip-icon">
                            <i class="fa-solid fa-shield-halved"></i>
                        </div>

                        <div>
                            <strong>Admin review</strong>
                            <span>After saving changes, review the client booking page to confirm payment instructions look correct.</span>
                        </div>
                    </div>
                </div>
            </div>
        </aside>
    </section>

    <section class="footer-settings">
        <div class="footer-settings-content">
            <div>
                <h3>
                    Keep system details accurate.
                </h3>

                <p>
                    Payment details and maintenance mode directly affect guest booking experience and admin verification.
                </p>
            </div>

            <a href="/admin/dashboard" class="hero-btn">
                <i class="fa-solid fa-gauge-high"></i>
                Go to Dashboard
            </a>
        </div>
    </section>
</div>

<div class="toast" id="settingsToast">
    <i class="fa-solid fa-circle-info"></i>
    <span id="settingsToastMessage">Settings ready.</span>
</div>

<script>
    const settingsForm = document.getElementById('settingsForm');
    const gcashNameInput = document.getElementById('gcashName');
    const gcashNumberInput = document.getElementById('gcashNumber');
    const maintenanceModeSelect = document.getElementById('maintenanceMode');
    const previewName = document.getElementById('previewName');
    const previewNumber = document.getElementById('previewNumber');
    const modeBadge = document.getElementById('modeBadge');
    const modeDescription = document.getElementById('modeDescription');
    const settingsToast = document.getElementById('settingsToast');
    const settingsToastMessage = document.getElementById('settingsToastMessage');

    function showToast(message) {
        if (!settingsToast || !settingsToastMessage) return;

        settingsToastMessage.textContent = message;
        settingsToast.classList.add('show');

        setTimeout(function () {
            settingsToast.classList.remove('show');
        }, 3000);
    }

    function updatePreview() {
        const nameValue = gcashNameInput ? gcashNameInput.value.trim() : '';
        const numberValue = gcashNumberInput ? gcashNumberInput.value.trim() : '';
        const modeValue = maintenanceModeSelect ? maintenanceModeSelect.value : 'off';

        if (previewName) {
            previewName.textContent = nameValue || 'GCash Name';
        }

        if (previewNumber) {
            previewNumber.textContent = numberValue || 'GCash Number';
        }

        if (modeBadge) {
            const icon = modeValue === 'on' ? 'fa-screwdriver-wrench' : 'fa-circle-check';
            const label = modeValue === 'on' ? 'Maintenance' : 'Active';

            modeBadge.className = 'mode-badge ' + (modeValue === 'on' ? 'maintenance' : 'active');
            modeBadge.innerHTML = '<i class="fa-solid ' + icon + '"></i><span>' + label + '</span>';
        }

        if (modeDescription) {
            modeDescription.textContent = modeValue === 'on'
                ? 'Guests will not be able to create new bookings while maintenance mode is enabled.'
                : 'Guests can continue creating new bookings while the resort is active.';
        }
    }

    if (gcashNameInput) {
        gcashNameInput.addEventListener('input', updatePreview);
    }

    if (gcashNumberInput) {
        gcashNumberInput.addEventListener('input', updatePreview);
    }

    if (maintenanceModeSelect) {
        maintenanceModeSelect.addEventListener('change', updatePreview);
    }

    if (settingsForm) {
        settingsForm.addEventListener('submit', function () {
            showToast('Saving system settings...');
        });
    }

    updatePreview();
</script>
