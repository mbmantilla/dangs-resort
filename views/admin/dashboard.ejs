<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<title>Admin Dashboard | Dang's Beach Resort</title>
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600;700&display=swap" rel="stylesheet">
<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
<style>
body {
    font-family: 'Inter', sans-serif;
    background: #f8fafc;
    margin: 0; padding: 0;
}
.dashboard-container {
    padding: 32px;
}
.stats-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: 24px;
    margin-bottom: 40px;
}
.stat-card {
    background: linear-gradient(135deg,#0ea5e9,#2563eb);
    color: #fff;
    border-radius: 20px;
    padding: 24px;
    display: flex;
    flex-direction: column;
    gap: 12px;
    box-shadow: 0 15px 40px rgba(0,0,0,0.25);
    transition: transform 0.3s;
}
.stat-card:hover { transform: translateY(-5px); }
.stat-card h3 { margin:0; font-size:0.85rem; font-weight:600; }
.stat-card .value { font-size:2rem; font-weight:700; }
.charts-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: 32px;
    margin-bottom: 40px;
}
.admin-card {
    background:#fff;
    border-radius:20px;
    padding:28px;
    box-shadow:0 20px 50px rgba(0,0,0,0.1);
    transition: transform 0.3s;
}
.admin-card:hover { transform: translateY(-5px); }
h3.chart-title { margin-top:0; color:#64748b; font-size:0.85rem; text-transform:uppercase; letter-spacing:1px; }
</style>
</head>
<body>
<div class="dashboard-container">

    <!-- Stats -->
    <section class="stats-grid">
        <div class="stat-card" style="background: linear-gradient(135deg, #0ea5e9, #2563eb);">
            <h3>Total Bookings</h3>
            <div class="value"><%= stats.totalBookings %></div>
        </div>
        <div class="stat-card" style="background: linear-gradient(135deg, #22c55e, #16a34a);">
            <h3>Today's Arrivals</h3>
            <div class="value"><%= stats.todayArrivals %></div>
        </div>
        <div class="stat-card" style="background: linear-gradient(135deg, #eab308, #facc15);">
            <h3>Pending Payments</h3>
            <div class="value"><%= stats.pendingPayments %></div>
        </div>
        <div class="stat-card" style="background: linear-gradient(135deg, #64748b, #1e293b);">
            <h3>Total Revenue</h3>
            <div class="value">₱<%= stats.revenue.toLocaleString() %></div>
        </div>
    </section>

    <!-- Charts -->
    <section class="charts-grid">
        <!-- Revenue Trend -->
        <div class="admin-card">
            <h3 class="chart-title">Revenue Trend (Last 7 Days)</h3>
            <canvas id="revenueChart" height="250"></canvas>
        </div>

        <!-- Booking Status -->
        <div class="admin-card">
            <h3 class="chart-title">Bookings by Status</h3>
            <canvas id="statusChart" height="250"></canvas>
        </div>

        <!-- Payment Status -->
        <div class="admin-card">
            <h3 class="chart-title">Payment Status</h3>
            <canvas id="paymentChart" height="250"></canvas>
        </div>

        <!-- Facility Usage -->
        <div class="admin-card">
            <h3 class="chart-title">Facility Usage</h3>
            <canvas id="facilityChart" height="250"></canvas>
        </div>
    </section>

</div>

<script>
    // Revenue Chart
    const revCtx = document.getElementById('revenueChart').getContext('2d');
    new Chart(revCtx, {
        type:'line',
        data:{
            labels: ['May 9','May 10','May 11','May 12','May 13','May 14','May 15'],
            datasets:[{
                label:'Revenue',
                data:[12000,19000,15000,8000,12000,25000,<%= stats.revenue %>],
                borderColor:'#0ea5e9',
                backgroundColor:'rgba(14,165,233,0.15)',
                fill:true,
                tension:0.4,
                pointRadius:4,
                pointBackgroundColor:'#0ea5e9'
            }]
        },
        options:{
            responsive:true,
            maintainAspectRatio:false,
            plugins:{ legend:{ display:false } },
            scales:{
                y:{ beginAtZero:true, grid:{ color:'#f1f5f9' } },
                x:{ grid:{ display:false } }
            }
        }
    });

    // Status Chart
    const statusCtx = document.getElementById('statusChart').getContext('2d');
    const chartData = <%- JSON.stringify(stats.chartData || []) %>;
    const getCount = status => {
        const found = chartData.find(item=>item.status.toLowerCase()===status.toLowerCase());
        return found ? found.count : 0;
    };
    new Chart(statusCtx,{
        type:'doughnut',
        data:{
            labels:['Approved','Pending','Rejected'],
            datasets:[{
                data:[getCount('approved'), getCount('pending'), getCount('rejected')],
                backgroundColor:['#22c55e','#eab308','#ef4444'],
                borderWidth:0,
                cutout:'70%'
            }]
        },
        options:{
            responsive:true,
            plugins:{
                legend:{
                    position:'bottom',
                    labels:{ usePointStyle:true, padding:20, color:'#64748b' }
                }
            }
        }
    });

    // Payment Status Chart
    const paymentCtx = document.getElementById('paymentChart').getContext('2d');
    new Chart(paymentCtx, {
        type:'pie',
        data:{
            labels:['Pending','Paid'],
            datasets:[{
                data:[<%= stats.pendingPayments %>, <%= stats.totalBookings - stats.pendingPayments %>],
                backgroundColor:['#eab308','#22c55e']
            }]
        },
        options:{ responsive:true, plugins:{ legend:{ position:'bottom' } } }
    });

    // Facility Usage Chart
    const facilityCtx = document.getElementById('facilityChart').getContext('2d');
    new Chart(facilityCtx,{
        type:'bar',
        data:{
            labels:['Cottage','Cabana','Suite','Others'],
            datasets:[{
                label:'Bookings',
                data:[3,2,4,2],
                backgroundColor:'#0ea5e9'
            }]
        },
        options:{ responsive:true, plugins:{ legend:{ display:false } }, scales:{ y:{ beginAtZero:true } } }
    });
</script>