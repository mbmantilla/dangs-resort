<div 
    id="dashboard-data"
    style="display:none;"
    data-chart="<%- encodeURIComponent(JSON.stringify(safeChartData)) %>"
    data-revenue="<%- encodeURIComponent(JSON.stringify(safeRevenueTrend)) %>"
    data-total-revenue="<%= totalRevenue %>">
</div>

<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

<script>
document.addEventListener('DOMContentLoaded', function () {
    const dataEl = document.getElementById('dashboard-data');

    function parseSafeData(value) {
        try {
            return JSON.parse(decodeURIComponent(value || '[]'));
        } catch (error) {
            console.error('Dashboard data parse error:', error);
            return [];
        }
    }

    const chartData = parseSafeData(dataEl ? dataEl.dataset.chart : '[]');
    const revenueTrend = parseSafeData(dataEl ? dataEl.dataset.revenue : '[]');
    const totalRevenue = Number(dataEl ? dataEl.dataset.totalRevenue || 0 : 0);

    function getStatusValue(item) {
        return String(
            item.status ||
            item.booking_status ||
            item.bookingStatus ||
            item.reservation_status ||
            ''
        ).trim().toLowerCase();
    }

    function getCountValue(item) {
        return Number(
            item.count ||
            item.total ||
            item.total_count ||
            item.total_bookings ||
            item.booking_count ||
            0
        );
    }

    function getCount(statusName) {
        return chartData.reduce(function (total, item) {
            const status = getStatusValue(item);
            const count = getCountValue(item);

            if (status === statusName) {
                return total + count;
            }

            if (statusName === 'approved' && (status.includes('approve') || status.includes('confirm'))) {
                return total + count;
            }

            if (statusName === 'pending' && (status.includes('pending') || status.includes('waiting') || status.includes('processing'))) {
                return total + count;
            }

            if (
                statusName === 'rejected' &&
                (
                    status.includes('reject') ||
                    status.includes('cancel') ||
                    status.includes('decline') ||
                    status.includes('denied')
                )
            ) {
                return total + count;
            }

            return total;
        }, 0);
    }

    function formatPeso(value) {
        return '₱' + Number(value || 0).toLocaleString('en-PH');
    }

    const revenueCanvas = document.getElementById('revenueChart');

    if (revenueCanvas && window.Chart) {
        const labels = revenueTrend.length > 0
            ? revenueTrend.map(function (item) {
                return item.month || item.label || 'N/A';
            })
            : ['Current Revenue'];

        const revenueValues = revenueTrend.length > 0
            ? revenueTrend.map(function (item) {
                return Number(item.monthly_total || item.revenue || item.total_revenue || 0);
            })
            : [totalRevenue];

        const bookingValues = revenueTrend.length > 0
            ? revenueTrend.map(function (item) {
                return Number(item.total_bookings || item.bookings || item.count || 0);
            })
            : [0];

        new Chart(revenueCanvas.getContext('2d'), {
            data: {
                labels: labels,
                datasets: [
                    {
                        type: 'bar',
                        label: 'Bookings',
                        data: bookingValues,
                        backgroundColor: 'rgba(20, 184, 166, 0.72)',
                        borderRadius: 12,
                        yAxisID: 'yBookings'
                    },
                    {
                        type: 'line',
                        label: 'Revenue',
                        data: revenueValues,
                        borderColor: '#0891b2',
                        backgroundColor: 'rgba(8, 145, 178, 0.14)',
                        fill: true,
                        tension: 0.42,
                        pointRadius: 5,
                        pointHoverRadius: 8,
                        pointBackgroundColor: '#ffffff',
                        pointBorderColor: '#0891b2',
                        pointBorderWidth: 3,
                        yAxisID: 'yRevenue'
                    }
                ]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                interaction: {
                    mode: 'index',
                    intersect: false
                },
                plugins: {
                    legend: {
                        position: 'bottom',
                        labels: {
                            usePointStyle: true,
                            padding: 20,
                            color: '#64748b',
                            font: {
                                weight: '700'
                            }
                        }
                    },
                    tooltip: {
                        callbacks: {
                            label: function (context) {
                                if (context.dataset.label === 'Revenue') {
                                    return 'Revenue: ' + formatPeso(context.raw);
                                }

                                return 'Bookings: ' + Number(context.raw || 0).toLocaleString('en-PH');
                            }
                        }
                    }
                },
                scales: {
                    yRevenue: {
                        type: 'linear',
                        position: 'left',
                        beginAtZero: true,
                        ticks: {
                            callback: function (value) {
                                return formatPeso(value);
                            },
                            color: '#64748b'
                        },
                        grid: {
                            color: 'rgba(226,232,240,0.82)'
                        }
                    },
                    yBookings: {
                        type: 'linear',
                        position: 'right',
                        beginAtZero: true,
                        ticks: {
                            precision: 0,
                            color: '#64748b'
                        },
                        grid: {
                            drawOnChartArea: false
                        }
                    },
                    x: {
                        ticks: {
                            color: '#64748b'
                        },
                        grid: {
                            display: false
                        }
                    }
                }
            }
        });
    }

    const statusCanvas = document.getElementById('statusChart');

    if (statusCanvas && window.Chart) {
        const approved = getCount('approved');
        const pending = getCount('pending');
        const rejected = getCount('rejected');
        const statusTotal = approved + pending + rejected;

        const centerTextPlugin = {
            id: 'dashboardCenterText',
            beforeDraw: function (chart) {
                const chartArea = chart.chartArea;
                const ctx = chart.ctx;

                if (!chartArea) return;

                const centerX = (chartArea.left + chartArea.right) / 2;
                const centerY = (chartArea.top + chartArea.bottom) / 2;

                ctx.save();
                ctx.textAlign = 'center';
                ctx.textBaseline = 'middle';

                ctx.font = '800 32px Inter, Arial, sans-serif';
                ctx.fillStyle = '#0f172a';
                ctx.fillText(statusTotal, centerX, centerY - 9);

                ctx.font = '700 12px Inter, Arial, sans-serif';
                ctx.fillStyle = '#64748b';
                ctx.fillText('Bookings', centerX, centerY + 18);

                ctx.restore();
            }
        };

        new Chart(statusCanvas.getContext('2d'), {
            type: 'doughnut',
            data: {
                labels: statusTotal > 0 ? ['Approved', 'Pending', 'Rejected'] : ['No Data'],
                datasets: [{
                    data: statusTotal > 0 ? [approved, pending, rejected] : [1],
                    backgroundColor: statusTotal > 0 ? ['#10b981', '#f59e0b', '#f43f5e'] : ['#e2e8f0'],
                    borderColor: '#ffffff',
                    borderWidth: 6,
                    hoverOffset: 12,
                    cutout: '72%'
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                plugins: {
                    legend: {
                        position: 'bottom',
                        labels: {
                            usePointStyle: true,
                            padding: 18,
                            color: '#64748b',
                            font: {
                                weight: '700'
                            }
                        }
                    },
                    tooltip: {
                        callbacks: {
                            label: function (context) {
                                if (statusTotal === 0) {
                                    return 'No booking data yet';
                                }

                                const value = Number(context.raw || 0);
                                const percent = Math.round((value / statusTotal) * 100);

                                return context.label + ': ' + value + ' booking' + (value === 1 ? '' : 's') + ' (' + percent + '%)';
                            }
                        }
                    }
                }
            },
            plugins: [centerTextPlugin]
        });
    }
});
</script>
