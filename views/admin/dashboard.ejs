            opacity: 1;
            transform: translateY(0) scale(1);
        }
    }

    .dashboard-grid {
        display: grid;
        grid-template-columns: minmax(0, 1.65fr) minmax(340px, 0.95fr);
        gap: 24px;
        margin-bottom: 26px;
    }

    .admin-card {
        position: relative;
        min-width: 0;
        border-radius: 34px;
        background: rgba(255, 255, 255, 0.88);
        border: 1px solid rgba(255, 255, 255, 0.82);
        box-shadow: var(--dash-shadow-md);
        backdrop-filter: blur(18px);
        overflow: hidden;
        animation: dashCardRise 0.8s var(--dash-ease) both;
    }

    .admin-card::before {
        content: "";
        position: absolute;
        inset: 0;
        pointer-events: none;
        background:
            radial-gradient(circle at 0% 0%, rgba(6, 182, 212, 0.08), transparent 30%),
            radial-gradient(circle at 100% 100%, rgba(20, 184, 166, 0.09), transparent 30%);
    }

    .admin-card:hover {
        transform: translateY(-3px);
        box-shadow: var(--dash-shadow-lg);
        transition:
            transform 0.28s var(--dash-ease),
            box-shadow 0.28s var(--dash-ease);
    }

    .card-inner {
        position: relative;
        z-index: 2;
        padding: 26px;
    }

    .card-header {
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        gap: 18px;
        margin-bottom: 22px;
    }

    .card-kicker {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        color: var(--dash-ocean-700);
        font-size: 0.70rem;
        font-weight: 950;
        letter-spacing: 0.14em;
        text-transform: uppercase;
        margin-bottom: 8px;
    }

    .card-title {
        margin: 0;
        color: var(--dash-text-main);
        font-size: 1.18rem;
        font-weight: 950;
        letter-spacing: -0.02em;
    }

    .card-copy {
        margin: 6px 0 0;
        color: var(--dash-text-muted);
        font-size: 0.86rem;
        line-height: 1.6;
    }

    .card-chip {
        min-height: 38px;
        padding: 0 13px;
        border-radius: var(--dash-radius-full);
        display: inline-flex;
        align-items: center;
        gap: 8px;
        color: var(--dash-ocean-700);
        background: var(--dash-ocean-50);
        border: 1px solid rgba(6, 182, 212, 0.16);
        font-size: 0.68rem;
        font-weight: 950;
        letter-spacing: 0.08em;
        text-transform: uppercase;
        white-space: nowrap;
    }

    .chart-wrap {
        position: relative;
        height: 330px;
    }

    .chart-wrap.small {
        height: 278px;
    }

    .status-summary {
        display: grid;
        gap: 14px;
        margin-top: 18px;
    }

    .status-row {
        padding: 16px;
        border-radius: 22px;
        display: grid;
        gap: 12px;
        background: var(--dash-card-muted);
        border: 1px solid rgba(148, 163, 184, 0.16);
        transition:
            transform 0.24s var(--dash-ease),
            background 0.24s var(--dash-ease);
    }

    .status-row:hover {
        transform: translateX(5px);
        background: white;
    }

    .status-main {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 14px;
    }

    .status-label {
        display: inline-flex;
        align-items: center;
        gap: 10px;
        color: var(--dash-text-main);
        font-size: 0.88rem;
        font-weight: 950;
    }

    .status-dot {
        width: 12px;
        height: 12px;
        border-radius: var(--dash-radius-full);
        background: var(--status-color);
        box-shadow: 0 0 0 6px var(--status-soft);
    }

    .status-value {
        color: var(--dash-text-main);
        font-size: 1.2rem;
        font-weight: 950;
    }

    .status-track {
        height: 9px;
        border-radius: var(--dash-radius-full);
        overflow: hidden;
        background: rgba(226, 232, 240, 0.82);
    }

    .status-fill {
        display: block;
        height: 100%;
        width: var(--status-width);
        border-radius: inherit;
        background: var(--status-color);
        animation: dashFill 1.2s var(--dash-ease) both;
    }

    @keyframes dashFill {
        from {
            width: 0%;
        }

        to {
            width: var(--status-width);
        }
    }

    .insight-grid {
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: 18px;
        margin-bottom: 26px;
    }

    .insight-card {
        position: relative;
        padding: 24px;
        border-radius: 30px;
        overflow: hidden;
        background: rgba(255, 255, 255, 0.88);
        border: 1px solid rgba(255, 255, 255, 0.82);
        box-shadow: var(--dash-shadow-sm);
        backdrop-filter: blur(18px);
        transition:
            transform 0.28s var(--dash-ease),
            box-shadow 0.28s var(--dash-ease);
        animation: dashCardRise 0.76s var(--dash-ease) both;
    }

    .insight-card:hover {
        transform: translateY(-7px);
        box-shadow: var(--dash-shadow-md);
    }

    .insight-icon {
        width: 50px;
        height: 50px;
        border-radius: 19px;
        display: grid;
        place-items: center;
        color: white;
        background: linear-gradient(135deg, var(--dash-ocean-500), var(--dash-sea-500));
        box-shadow: 0 16px 34px rgba(8, 145, 178, 0.22);
        margin-bottom: 18px;
    }

    .insight-card h3 {
        margin: 0 0 8px;
        color: var(--dash-text-main);
        font-size: 1rem;
        font-weight: 950;
    }

    .insight-card p {
        margin: 0;
        color: var(--dash-text-soft);
        line-height: 1.7;
        font-size: 0.86rem;
    }

    .activity-panel {
        display: grid;
        grid-template-columns: minmax(0, 1fr) minmax(320px, 0.72fr);
        gap: 24px;
    }

    .action-grid {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 14px;
    }

    .action-card {
        min-height: 126px;
        padding: 20px;
        border-radius: 26px;
        text-decoration: none;
        color: var(--dash-text-main);
        background: var(--dash-card-muted);
        border: 1px solid rgba(148, 163, 184, 0.16);
        display: flex;
        align-items: flex-start;
        gap: 14px;
        transition:
            transform 0.25s var(--dash-ease),
            background 0.25s var(--dash-ease),
            box-shadow 0.25s var(--dash-ease);
    }

    .action-card:hover {
        transform: translateY(-5px);
        background: white;
        box-shadow: var(--dash-shadow-sm);
    }

    .action-icon {
        width: 46px;
        height: 46px;
        min-width: 46px;
        border-radius: 17px;
        display: grid;
        place-items: center;
        color: white;
        background: linear-gradient(135deg, var(--dash-ocean-500), var(--dash-sea-500));
        box-shadow: 0 14px 30px rgba(8, 145, 178, 0.18);
    }

    .action-card strong {
        display: block;
        font-size: 0.96rem;
        font-weight: 950;
        margin-bottom: 6px;
    }

    .action-card span {
        display: block;
        color: var(--dash-text-muted);
        font-size: 0.80rem;
        line-height: 1.55;
    }

    .health-list {
        display: grid;
        gap: 14px;
    }

    .health-row {
        padding: 16px;
        border-radius: 22px;
        background: var(--dash-card-muted);
        border: 1px solid rgba(148, 163, 184, 0.16);
    }

    .health-row-top {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 12px;
        margin-bottom: 11px;
    }

    .health-label {
        display: inline-flex;
        align-items: center;
        gap: 9px;
        color: var(--dash-text-main);
        font-size: 0.84rem;
        font-weight: 950;
    }

    .health-value {
        color: var(--dash-ocean-700);
        font-size: 0.80rem;
        font-weight: 950;
    }

    .health-track {
        height: 9px;
        overflow: hidden;
        border-radius: var(--dash-radius-full);
        background: rgba(226, 232, 240, 0.86);
    }

    .health-fill {
        display: block;
        height: 100%;
        width: var(--health-width);
        border-radius: inherit;
        background: linear-gradient(90deg, var(--dash-ocean-500), var(--dash-sea-500));
        animation: dashFillHealth 1.2s var(--dash-ease) both;
    }

    @keyframes dashFillHealth {
        from {
            width: 0%;
        }

        to {
            width: var(--health-width);
        }
    }

    .mobile-status-cards {
        display: none;
        gap: 14px;
    }

    .mobile-status-card {
        padding: 18px;
        border-radius: 26px;
        background: rgba(255, 255, 255, 0.88);
        border: 1px solid rgba(255, 255, 255, 0.82);
        box-shadow: var(--dash-shadow-sm);
    }

    .footer-dashboard {
        position: relative;
        margin-top: 28px;
        padding: 28px;
        border-radius: 34px;
        color: white;
        overflow: hidden;
        background:
            linear-gradient(135deg, var(--dash-slate-950), var(--dash-ocean-900) 52%, var(--dash-sea-800));
        box-shadow: var(--dash-shadow-lg);
    }

    .footer-dashboard::before {
        content: "";
        position: absolute;
        width: 280px;
        height: 280px;
        right: -120px;
        top: -150px;
        border-radius: var(--dash-radius-full);
        background: rgba(255, 255, 255, 0.12);
    }

    .footer-dashboard-content {
        position: relative;
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 24px;
    }

    .footer-dashboard h3 {
        margin: 0 0 8px;
        font-family: var(--dash-font-display);
        font-size: 1.8rem;
        font-weight: 400;
    }

    .footer-dashboard p {
        margin: 0;
        color: rgba(226, 232, 240, 0.76);
        line-height: 1.7;
    }

    .floating-refresh {
        position: fixed;
        right: 26px;
        bottom: 26px;
        z-index: 60;
        width: 58px;
        height: 58px;
        border: 0;
        border-radius: 22px;
        color: white;
        cursor: pointer;
        display: grid;
        place-items: center;
        background: linear-gradient(135deg, var(--dash-ocean-600), var(--dash-sea-500));
        box-shadow:
            0 22px 48px rgba(8, 145, 178, 0.28),
            0 0 0 8px rgba(6, 182, 212, 0.10);
        transition:
            transform 0.25s var(--dash-ease),
            box-shadow 0.25s var(--dash-ease);
        animation: dashFloating 3s ease-in-out infinite;
    }

    .floating-refresh:hover {
        transform: translateY(-5px) scale(1.04);
        box-shadow:
            0 30px 60px rgba(8, 145, 178, 0.36),
            0 0 0 10px rgba(6, 182, 212, 0.12);
    }

    @keyframes dashFloating {
        0%,
        100% {
            transform: translateY(0);
        }

        50% {
            transform: translateY(-8px);
        }
    }

    @media (max-width: 1280px) {
        .stats-grid {
            grid-template-columns: repeat(2, minmax(0, 1fr));
        }

        .dashboard-grid,
        .activity-panel {
            grid-template-columns: 1fr;
        }

        .chart-wrap.small {
            height: 330px;
        }
    }

    @media (max-width: 980px) {
        .hero-inner {
            grid-template-columns: 1fr;
        }

        .dashboard-overview-strip {
            grid-template-columns: repeat(2, minmax(0, 1fr));
            margin-top: 20px;
            margin-left: 0;
            margin-right: 0;
        }

        .insight-grid {
            grid-template-columns: 1fr;
        }

        .section-heading {
            align-items: flex-start;
            flex-direction: column;
            gap: 10px;
        }

        .section-heading p {
            text-align: left;
            max-width: 100%;
        }
    }

    @media (max-width: 720px) {
        .dashboard-hero {
            border-radius: 30px;
            padding: 26px;
        }

        .hero-title {
            font-size: clamp(2.1rem, 12vw, 3.5rem);
        }

        .hero-actions {
            align-items: stretch;
            flex-direction: column;
        }

        .hero-btn {
            width: 100%;
        }

        .dashboard-overview-strip,
        .stats-grid,
        .action-grid {
            grid-template-columns: 1fr;
        }

        .card-inner {
            padding: 22px;
        }

        .card-header {
            align-items: flex-start;
            flex-direction: column;
        }

        .chart-wrap,
        .chart-wrap.small {
            height: 280px;
        }

        .floating-refresh {
            right: 18px;
            bottom: 18px;
        }

        .footer-dashboard-content {
            align-items: flex-start;
            flex-direction: column;
        }
    }

    @media (max-width: 520px) {
        .dashboard-hero {
            padding: 22px;
            border-radius: 26px;
        }

        .hero-eyebrow,
        .section-kicker,
        .card-kicker {
            font-size: 0.62rem;
            letter-spacing: 0.10em;
        }

        .hero-copy {
            font-size: 0.92rem;
        }

        .stat-card {
            min-height: 172px;
            border-radius: 26px;
            padding: 20px;
        }

        .admin-card,
        .insight-card {
            border-radius: 26px;
        }

        .overview-pill {
            min-height: 94px;
            border-radius: 24px;
        }
    }

    @media print {
        .dashboard-orb,
        .dashboard-noise,
        .floating-refresh,
        .hero-actions {
            display: none !important;
        }

        .dashboard-page::before,
        .dashboard-page::after {
            display: none !important;
        }

        .dashboard-hero,
        .admin-card,
        .stat-card,
        .insight-card,
        .footer-dashboard {
            box-shadow: none !important;
        }
    }

    @media (prefers-reduced-motion: reduce) {
        .dashboard-page *,
        .dashboard-page *::before,
        .dashboard-page *::after {
            animation-duration: 0.01ms !important;
            animation-iteration-count: 1 !important;
            scroll-behavior: auto !important;
            transition-duration: 0.01ms !important;
        }
    }
</style>

<div class="dashboard-page">
    <span class="dashboard-orb one"></span>
    <span class="dashboard-orb two"></span>
    <span class="dashboard-orb three"></span>
    <div class="dashboard-noise"></div>

    <section class="dashboard-hero">
        <div class="hero-inner">
            <div>
                <span class="hero-eyebrow">
                    <i class="fa-solid fa-water"></i>
                    Dang's Beach Resort Command Center
                </span>

                <h1 class="hero-title">
                    Resort overview<span>.</span>
                </h1>

                <p class="hero-copy">
                    Monitor bookings, arrivals, revenue, facilities, and reservation movement in one animated and mobile-friendly admin dashboard.
                </p>

                <div class="hero-actions">
                    <a href="/admin/bookings" class="hero-btn">
                        <i class="fa-solid fa-calendar-check"></i>
                        Manage Bookings
                    </a>

                    <a href="/admin/reports" class="hero-btn ghost">
                        <i class="fa-solid fa-chart-line"></i>
                        View Reports
                    </a>
                </div>
            </div>

            <article class="hero-live-card">
                <div class="live-card-icon">
                    <i class="fa-solid fa-signal"></i>
                </div>

                <span class="live-card-label">
                    Live Operations
                </span>

                <strong class="live-card-value">
                    <%= totalBookings %>
                </strong>

                <p class="live-card-copy">
                    Total bookings recorded in the resort system, including pending, approved, and rejected reservations.
                </p>
            </article>
        </div>
    </section>

    <section class="dashboard-overview-strip" aria-label="Dashboard quick overview">
        <article class="overview-pill">
            <div class="overview-icon">
                <i class="fa-solid fa-users"></i>
            </div>

            <div class="overview-copy">
                <strong><%= registeredGuests %></strong>
                <span>Registered Guests</span>
            </div>
        </article>

        <article class="overview-pill">
            <div class="overview-icon">
                <i class="fa-solid fa-umbrella-beach"></i>
            </div>

            <div class="overview-copy">
                <strong><%= activeFacilities %></strong>
                <span>Active Facilities</span>
            </div>
        </article>

        <article class="overview-pill">
            <div class="overview-icon">
                <i class="fa-solid fa-circle-check"></i>
            </div>

            <div class="overview-copy">
                <strong><%= approvedCount %></strong>
                <span>Approved</span>
            </div>
        </article>

        <article class="overview-pill">
            <div class="overview-icon">
                <i class="fa-solid fa-hourglass-half"></i>
            </div>

            <div class="overview-copy">
                <strong><%= pendingCount %></strong>
                <span>Pending</span>
            </div>
        </article>
    </section>

    <div class="section-heading">
        <div>
            <span class="section-kicker">
                <i class="fa-solid fa-gauge-high"></i>
                Key Metrics
            </span>

            <h2>
                Resort performance snapshot
            </h2>
        </div>

        <p>
            These cards summarize the current booking activity, arrivals, pending payments, and approved revenue.
        </p>
    </div>

    <section class="stats-grid">
        <article class="stat-card bookings">
            <div class="stat-top">
                <div class="stat-icon">
                    <i class="fa-solid fa-calendar-days"></i>
                </div>

                <span class="stat-trend">
                    <i class="fa-solid fa-arrow-trend-up"></i>
                    Total
                </span>
            </div>

            <p class="stat-label">Total Bookings</p>
            <strong class="stat-value"><%= totalBookings %></strong>
            <p class="stat-subtext">All reservations submitted by guests.</p>
        </article>

        <article class="stat-card arrivals">
            <div class="stat-top">
                <div class="stat-icon">
                    <i class="fa-solid fa-house-chimney-user"></i>
                </div>

                <span class="stat-trend">
                    <i class="fa-solid fa-sun"></i>
                    Today
                </span>
            </div>

            <p class="stat-label">Today's Arrivals</p>
            <strong class="stat-value"><%= todayArrivals %></strong>
            <p class="stat-subtext">Guests expected based on today's booking date.</p>
        </article>

        <article class="stat-card pending">
            <div class="stat-top">
                <div class="stat-icon">
                    <i class="fa-solid fa-hourglass-half"></i>
                </div>

                <span class="stat-trend">
                    <i class="fa-solid fa-clock"></i>
                    Review
                </span>
            </div>

            <p class="stat-label">Pending Payments</p>
            <strong class="stat-value"><%= pendingPayments %></strong>
            <p class="stat-subtext">Reservations waiting for payment verification.</p>
        </article>

        <article class="stat-card revenue">
            <div class="stat-top">
                <div class="stat-icon">
                    <i class="fa-solid fa-peso-sign"></i>
                </div>

                <span class="stat-trend">
                    <i class="fa-solid fa-chart-line"></i>
                    Approved
                </span>
            </div>

            <p class="stat-label">Total Revenue</p>
            <strong class="stat-value">₱<%= pesoFormat(totalRevenue) %></strong>
            <p class="stat-subtext">Revenue from approved bookings only.</p>
        </article>
    </section>

    <div class="dashboard-grid">
        <article class="admin-card">
            <div class="card-inner">
                <div class="card-header">
                    <div>
                        <span class="card-kicker">
                            <i class="fa-solid fa-chart-area"></i>
                            Revenue Analytics
                        </span>

                        <h3 class="card-title">
                            Revenue Trend
                        </h3>

                        <p class="card-copy">
                            Monthly revenue movement based on approved bookings.
                        </p>
                    </div>

                    <span class="card-chip">
                        <i class="fa-solid fa-calendar"></i>
                        Latest Data
                    </span>
                </div>

                <div class="chart-wrap">
                    <canvas id="revenueChart"></canvas>
                </div>
            </div>
        </article>

        <article class="admin-card">
            <div class="card-inner">
                <div class="card-header">
                    <div>
                        <span class="card-kicker">
                            <i class="fa-solid fa-chart-pie"></i>
                            Booking Status
                        </span>

                        <h3 class="card-title">
                            Bookings by Status
                        </h3>

                        <p class="card-copy">
                            Distribution of approved, pending, and rejected reservations.
                        </p>
                    </div>

                    <span class="card-chip">
                        <i class="fa-solid fa-circle-nodes"></i>
                        Live
                    </span>
                </div>

                <div class="chart-wrap small">
                    <canvas id="statusChart"></canvas>
                </div>

                <div class="status-summary">
                    <div class="status-row" style="--status-color:#10b981; --status-soft:rgba(16,185,129,0.14); --status-width:<%= approvedPercentage %>%;">
                        <div class="status-main">
                            <span class="status-label">
                                <span class="status-dot"></span>
                                Approved
                            </span>
                            <strong class="status-value"><%= approvedCount %></strong>
                        </div>
                        <div class="status-track"><span class="status-fill"></span></div>
                    </div>

                    <div class="status-row" style="--status-color:#f59e0b; --status-soft:rgba(245,158,11,0.16); --status-width:<%= pendingPercentage %>%;">
                        <div class="status-main">
                            <span class="status-label">
                                <span class="status-dot"></span>
                                Pending
                            </span>
                            <strong class="status-value"><%= pendingCount %></strong>
                        </div>
                        <div class="status-track"><span class="status-fill"></span></div>
                    </div>

                    <div class="status-row" style="--status-color:#f43f5e; --status-soft:rgba(244,63,94,0.14); --status-width:<%= rejectedPercentage %>%;">
                        <div class="status-main">
                            <span class="status-label">
                                <span class="status-dot"></span>
                                Rejected
                            </span>
                            <strong class="status-value"><%= rejectedCount %></strong>
                        </div>
                        <div class="status-track"><span class="status-fill"></span></div>
                    </div>
                </div>
            </div>
        </article>
    </div>

    <section class="insight-grid">
        <article class="insight-card">
            <div class="insight-icon">
                <i class="fa-solid fa-magnifying-glass-chart"></i>
            </div>

            <h3>Booking Visibility</h3>

            <p>
                Use the status chart to quickly check if reservations are moving from pending to approved.
            </p>
        </article>

        <article class="insight-card">
            <div class="insight-icon">
                <i class="fa-solid fa-wallet"></i>
            </div>

            <h3>Revenue Monitoring</h3>

            <p>
                Revenue only increases when reservations are approved, helping you track verified payments.
            </p>
        </article>

        <article class="insight-card">
            <div class="insight-icon">
                <i class="fa-solid fa-people-roof"></i>
            </div>

