    const safeStats = typeof stats !== 'undefined' && stats ? stats : {};

    const totalBookings = Number(safeStats.totalBookings || 0);
    const todayArrivals = Number(safeStats.todayArrivals || 0);
    const pendingPayments = Number(safeStats.pendingPayments || 0);
    const totalRevenue = Number(safeStats.revenue || 0);
    const registeredGuests = Number(safeStats.registeredGuests || 0);
    const activeFacilities = Number(safeStats.activeFacilities || 0);

    const safeChartData = Array.isArray(safeStats.chartData) ? safeStats.chartData : [];
    const safeRevenueTrend = Array.isArray(safeStats.revenueTrend) ? safeStats.revenueTrend : [];

    const pesoFormat = function (value) {
        return Number(value || 0).toLocaleString('en-PH', {
            minimumFractionDigits: 0,
            maximumFractionDigits: 2
        });
    };

    const getStatusCountServer = function (statusName) {
        const found = safeChartData.find(function (item) {
            const itemStatus = String(item.status || item.booking_status || '').toLowerCase();
            return itemStatus === statusName.toLowerCase();
        });

        return Number(found ? found.count || found.total || found.total_bookings || 0 : 0);
    };

    const approvedCount = getStatusCountServer('approved');
    const pendingCount = getStatusCountServer('pending');
    const rejectedCount = getStatusCountServer('rejected');
    const statusTotal = approvedCount + pendingCount + rejectedCount;

    const approvedPercentage = statusTotal > 0 ? Math.round((approvedCount / statusTotal) * 100) : 0;
    const pendingPercentage = statusTotal > 0 ? Math.round((pendingCount / statusTotal) * 100) : 0;
    const rejectedPercentage = statusTotal > 0 ? Math.round((rejectedCount / statusTotal) * 100) : 0;
