    }

    .chart-wrap.large {
        height: 380px;
    }

    .facility-list {
        display: grid;
        gap: 14px;
        margin-top: 18px;
    }

    .facility-row {
        padding: 16px;
        border-radius: 22px;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 14px;
        background: var(--report-card-muted);
        border: 1px solid rgba(148, 163, 184, 0.16);
        transition:
            transform 0.24s var(--report-ease),
            background 0.24s var(--report-ease),
            box-shadow 0.24s var(--report-ease);
    }

    .facility-row:hover {
        transform: translateX(5px);
        background: white;
        box-shadow: var(--report-shadow-xs);
    }

    .facility-left {
        display: flex;
        align-items: center;
        gap: 12px;
        min-width: 0;
    }

    .facility-rank {
        width: 42px;
        height: 42px;
        min-width: 42px;
        border-radius: 16px;
        display: grid;
        place-items: center;
        color: white;
        background: linear-gradient(135deg, var(--report-ocean-500), var(--report-sea-500));
        box-shadow: 0 12px 28px rgba(8, 145, 178, 0.18);
        font-size: 0.80rem;
        font-weight: 950;
    }

    .facility-name {
        display: block;
        color: var(--report-text-main);
        font-size: 0.92rem;
        font-weight: 950;
        line-height: 1.25;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
    }

    .facility-sub {
        display: block;
        margin-top: 4px;
        color: var(--report-text-muted);
        font-size: 0.74rem;
        font-weight: 750;
    }

    .status-pill {
        min-height: 38px;
        padding: 0 13px;
        border-radius: var(--report-radius-full);
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        font-size: 0.70rem;
        font-weight: 950;
        letter-spacing: 0.08em;
        text-transform: uppercase;
        white-space: nowrap;
        border: 1px solid transparent;
    }

    .status-approved {
        color: var(--report-emerald-700);
        background: var(--report-emerald-100);
        border-color: rgba(16, 185, 129, 0.18);
    }

    .status-pending {
        color: var(--report-sand-800);
        background: var(--report-sand-100);
        border-color: rgba(245, 158, 11, 0.20);
    }

    .status-rejected {
        color: var(--report-rose-700);
        background: var(--report-rose-100);
        border-color: rgba(244, 63, 94, 0.18);
    }

    .status-neutral {
        color: var(--report-slate-700);
        background: var(--report-slate-100);
        border-color: rgba(148, 163, 184, 0.22);
    }

    .status-section-grid {
        display: grid;
        grid-template-columns: minmax(0, 1.15fr) minmax(300px, 0.85fr);
        gap: 28px;
        align-items: center;
    }

    .status-summary {
        display: grid;
        gap: 14px;
    }

    .status-row {
        padding: 17px;
        border-radius: 22px;
        background: var(--status-bg);
        border: 1px solid rgba(15, 23, 42, 0.06);
        transition:
            transform 0.24s var(--report-ease),
            box-shadow 0.24s var(--report-ease);
    }

    .status-row:hover {
        transform: translateY(-4px);
        box-shadow: var(--report-shadow-xs);
    }

    .status-row-top {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 12px;
    }

    .status-row-label {
        display: flex;
        align-items: center;
        gap: 10px;
        color: var(--status-text);
        font-size: 0.90rem;
        font-weight: 950;
    }

    .status-dot {
        width: 12px;
        height: 12px;
        border-radius: var(--report-radius-full);
        background: var(--status-color);
        box-shadow: 0 0 0 6px rgba(255, 255, 255, 0.58);
    }

    .status-count {
        color: var(--status-text);
        font-size: 1.4rem;
        font-weight: 950;
    }

    .status-track {
        height: 9px;
        margin-top: 12px;
        border-radius: var(--report-radius-full);
        overflow: hidden;
        background: rgba(255, 255, 255, 0.72);
    }

    .status-fill {
        display: block;
        height: 100%;
        width: var(--status-width);
        border-radius: inherit;
        background: var(--status-color);
        animation: reportFill 1.2s var(--report-ease) both;
    }

    .status-percent {
        margin: 8px 0 0;
        color: var(--status-text);
        font-size: 0.80rem;
        font-weight: 800;
        line-height: 1.5;
    }

    @keyframes reportFill {
        from {
            width: 0%;
        }

        to {
            width: var(--status-width);
        }
    }

    .insight-grid {
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: 18px;
        margin-top: 24px;
    }

    .insight-card {
        position: relative;
        padding: 24px;
        border-radius: 30px;
        overflow: hidden;
        background: rgba(255, 255, 255, 0.88);
        border: 1px solid rgba(255, 255, 255, 0.82);
        box-shadow: var(--report-shadow-sm);
        backdrop-filter: blur(18px);
        transition:
            transform 0.28s var(--report-ease),
            box-shadow 0.28s var(--report-ease);
        animation: reportCardRise 0.76s var(--report-ease) both;
    }

    .insight-card:hover {
        transform: translateY(-7px);
        box-shadow: var(--report-shadow-md);
    }

    .insight-icon {
        width: 50px;
        height: 50px;
        border-radius: 19px;
        display: grid;
        place-items: center;
        color: white;
        background: linear-gradient(135deg, var(--report-ocean-500), var(--report-sea-500));
        box-shadow: 0 16px 34px rgba(8, 145, 178, 0.22);
        margin-bottom: 18px;
    }

    .insight-card h3 {
        margin: 0 0 8px;
        color: var(--report-text-main);
        font-size: 1rem;
        font-weight: 950;
    }

    .insight-card p {
        margin: 0;
        color: var(--report-text-soft);
        line-height: 1.7;
        font-size: 0.86rem;
    }

    .empty-state {
        position: relative;
        padding: 46px 22px;
        border-radius: 28px;
        text-align: center;
        background: var(--report-card-muted);
        border: 1px dashed rgba(8, 145, 178, 0.30);
    }

    .empty-icon {
        width: 72px;
        height: 72px;
        margin: 0 auto 16px;
        border-radius: 26px;
        display: grid;
        place-items: center;
        color: white;
        background: linear-gradient(135deg, var(--report-ocean-500), var(--report-sea-500));
        box-shadow: var(--report-shadow-ocean);
        font-size: 1.6rem;
    }

    .empty-state h3 {
        margin: 0 0 8px;
        color: var(--report-text-main);
        font-family: var(--report-font-display);
        font-size: 1.7rem;
        font-weight: 400;
    }

    .empty-state p {
        max-width: 420px;
        margin: 0 auto;
        color: var(--report-text-soft);
        line-height: 1.7;
        font-size: 0.9rem;
    }

    .footer-report {
        position: relative;
        margin-top: 28px;
        padding: 28px;
        border-radius: 34px;
        color: white;
        overflow: hidden;
        background:
            linear-gradient(135deg, var(--report-slate-950), var(--report-ocean-900) 52%, var(--report-sea-800));
        box-shadow: var(--report-shadow-lg);
    }

    .footer-report::before {
        content: "";
        position: absolute;
        width: 280px;
        height: 280px;
        right: -120px;
        top: -150px;
        border-radius: var(--report-radius-full);
        background: rgba(255, 255, 255, 0.12);
    }

    .footer-report-content {
        position: relative;
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 24px;
    }

    .footer-report h3 {
        margin: 0 0 8px;
        font-family: var(--report-font-display);
        font-size: 1.8rem;
        font-weight: 400;
    }

    .footer-report p {
        margin: 0;
        color: rgba(226, 232, 240, 0.76);
        line-height: 1.7;
    }

    @media (max-width: 1280px) {
        .report-hero-inner {
            grid-template-columns: 1fr;
        }

        .report-overview-strip {
            grid-template-columns: repeat(2, minmax(0, 1fr));
            margin-top: 20px;
            margin-left: 0;
            margin-right: 0;
        }

        .analytics-grid,
        .status-section-grid {
            grid-template-columns: 1fr;
        }
    }

    @media (max-width: 980px) {
        .section-heading {
            align-items: flex-start;
            flex-direction: column;
            gap: 10px;
        }

        .section-heading p {
            max-width: 100%;
            text-align: left;
        }

        .insight-grid {
            grid-template-columns: 1fr;
        }
    }

    @media (max-width: 720px) {
        .report-hero {
            padding: 26px;
            border-radius: 30px;
        }

        .hero-title {
            font-size: clamp(2.1rem, 12vw, 3.5rem);
        }

        .hero-actions {
            align-items: stretch;
            flex-direction: column;
        }

        .hero-btn,
        .btn-export,
        .btn-soft {
            width: 100%;
        }

        .report-overview-strip {
            grid-template-columns: 1fr;
        }

        .admin-card-inner {
            padding: 20px;
        }

        .card-header {
            align-items: flex-start;
            flex-direction: column;
        }

        .chart-wrap,
        .chart-wrap.large {
            height: 300px;
        }

        .facility-row {
            align-items: flex-start;
            flex-direction: column;
        }

        .footer-report-content {
            align-items: flex-start;
            flex-direction: column;
        }
    }

    @media (max-width: 520px) {
        .report-hero {
            padding: 22px;
            border-radius: 26px;
        }

        .hero-eyebrow,
        .section-kicker,
        .card-kicker {
            font-size: 0.62rem;
            letter-spacing: 0.10em;
        }

        .hero-copy {
            font-size: 0.92rem;
        }

        .overview-pill {
            min-height: 94px;
            border-radius: 24px;
        }

        .admin-card,
        .insight-card,
        .footer-report {
            border-radius: 26px;
        }

        .chart-wrap,
        .chart-wrap.large {
            height: 270px;
        }
    }

    @media print {
        .report-orb,
        .report-noise,
        .hero-actions,
        .footer-report {
            display: none !important;
        }

        .reports-page::before,
        .reports-page::after {
            display: none !important;
        }

        .report-hero,
        .admin-card,
        .overview-pill,
        .insight-card,
        .footer-report {
            box-shadow: none !important;
        }

        .analytics-grid,
        .status-section-grid,
        .insight-grid {
            grid-template-columns: 1fr !important;
        }
    }

    @media (prefers-reduced-motion: reduce) {
        .reports-page *,
        .reports-page *::before,
        .reports-page *::after {
            animation-duration: 0.01ms !important;
            animation-iteration-count: 1 !important;
            scroll-behavior: auto !important;
            transition-duration: 0.01ms !important;
        }
    }

