<div class="reports-page">
    <span class="report-orb one"></span>
    <span class="report-orb two"></span>
    <span class="report-orb three"></span>
    <div class="report-noise"></div>

    <section class="report-hero">
        <div class="report-hero-inner">
            <div>
                <span class="hero-eyebrow">
                    <i class="fa-solid fa-chart-pie"></i>
                    Business Analytics
                </span>

                <h1 class="hero-title">
                    Resort reports<span>.</span>
                </h1>

                <p class="hero-copy">
                    Track revenue, booking trends, status distribution, and top-performing facilities in one modern analytics dashboard.
                </p>

                <div class="hero-actions">
                    <button type="button" class="hero-btn" onclick="window.print()">
                        <i class="fa-solid fa-print"></i>
                        Print Summary
                    </button>

                    <button type="button" class="hero-btn ghost" onclick="window.location.href='/admin/reports/export'">
                        <i class="fa-solid fa-file-arrow-down"></i>
                        Export CSV
                    </button>
                </div>
            </div>

            <article class="hero-live-card">
                <div class="live-card-icon">
                    <i class="fa-solid fa-peso-sign"></i>
                </div>

                <span class="live-card-label">
                    Reported Revenue
                </span>

                <strong class="live-card-value">
                    ₱<%= pesoFormat(totalRevenue) %>
                </strong>

                <p class="live-card-copy">
                    Total revenue from the report data supplied to this page.
                </p>
            </article>
        </div>
    </section>

    <section class="report-overview-strip" aria-label="Report summary">
        <article class="overview-pill">
            <div class="overview-icon revenue">
                <i class="fa-solid fa-peso-sign"></i>
            </div>

            <div class="overview-copy">
                <strong>₱<%= pesoFormat(totalRevenue) %></strong>
                <span>Total Revenue</span>
            </div>
        </article>

        <article class="overview-pill">
            <div class="overview-icon booking">
                <i class="fa-solid fa-calendar-check"></i>
            </div>

            <div class="overview-copy">
                <strong><%= totalBookings %></strong>
                <span>Total Bookings</span>
            </div>
        </article>

        <article class="overview-pill">
            <div class="overview-icon">
                <i class="fa-solid fa-chart-line"></i>
            </div>

            <div class="overview-copy">
                <strong>₱<%= pesoFormat(averageRevenue) %></strong>
                <span>Avg Monthly Revenue</span>
            </div>
        </article>

        <article class="overview-pill">
            <div class="overview-icon top">
                <i class="fa-solid fa-ranking-star"></i>
            </div>

            <div class="overview-copy">
                <strong><%= topFacilityBookings %></strong>
                <span>Top Facility Bookings</span>
            </div>
        </article>
    </section>

    <div class="section-heading">
        <div>
            <span class="section-kicker">
                <i class="fa-solid fa-wave-square"></i>
                Performance Overview
            </span>

            <h2>
                Revenue and facility movement
            </h2>
        </div>

        <p>
            Analyze monthly revenue, booking volume, and the facilities that attract the most reservations.
        </p>
    </div>

    <section class="analytics-grid">
        <article class="admin-card">
            <div class="admin-card-inner">
                <div class="card-header">
                    <div>
                        <span class="card-kicker">
                            <i class="fa-solid fa-chart-area"></i>
                            Revenue Trend
                        </span>

                        <h3 class="card-title">
                            Revenue & Bookings Trend
                        </h3>

                        <p class="card-copy">
                            Combined monthly revenue and booking movement for the latest available report period.
                        </p>
                    </div>

                    <span class="card-chip">
                        <i class="fa-solid fa-calendar-days"></i>
                        Last 6 Months
                    </span>
                </div>

                <div class="chart-wrap large">
                    <canvas id="revenueBookingChart"></canvas>
                </div>
            </div>
        </article>

        <article class="admin-card">
            <div class="admin-card-inner">
                <div class="card-header">
                    <div>
                        <span class="card-kicker">
                            <i class="fa-solid fa-ranking-star"></i>
                            Facility Demand
                        </span>

                        <h3 class="card-title">
                            Top Performing Facilities
                        </h3>

                        <p class="card-copy">
                            Facilities ranked by the number of booking records.
                        </p>
                    </div>

                    <span class="card-chip">
                        <i class="fa-solid fa-trophy"></i>
                        Top 5
                    </span>
                </div>

                <% if (safePopularityData.length > 0) { %>
                    <div class="facility-list">
                        <% safePopularityData.slice(0, 5).forEach(function (item, index) { 
                            const facilityBookingCount = Number(item.total_bookings || item.count || item.total || 0);
                        %>
                            <div class="facility-row">
                                <div class="facility-left">
                                    <span class="facility-rank">
                                        <%= String(index + 1).padStart(2, '0') %>
                                    </span>

                                    <span>
                                        <strong class="facility-name">
                                            <%= item.name || item.room_name || 'Unnamed Facility' %>
                                        </strong>

                                        <span class="facility-sub">
                                            <i class="fa-solid fa-umbrella-beach"></i>
                                            Facility ranking
                                        </span>
                                    </span>
                                </div>

                                <span class="status-pill status-approved">
                                    <i class="fa-solid fa-bookmark"></i>
                                    <%= facilityBookingCount %>
                                    Booking<%= facilityBookingCount === 1 ? '' : 's' %>
                                </span>
                            </div>
                        <% }) %>
                    </div>
                <% } else { %>
                    <div class="empty-state">
                        <div class="empty-icon">
                            <i class="fa-solid fa-chart-simple"></i>
                        </div>

                        <h3>No facility data</h3>

                        <p>
                            Facility rankings will appear once bookings are connected to room or facility records.
                        </p>
                    </div>
                <% } %>
            </div>
        </article>
    </section>

    <section class="admin-card">
        <div class="admin-card-inner">
            <div class="card-header">
                <div>
                    <span class="card-kicker">
                        <i class="fa-solid fa-chart-pie"></i>
                        Booking Status
                    </span>

                    <h3 class="card-title">
                        Booking Status Distribution
                    </h3>

                    <p class="card-copy">
                        Overview of approved, pending, and rejected reservations with total booking count at the center.
                    </p>
                </div>

                <span class="card-chip">
                    <i class="fa-solid fa-signal"></i>
                    Live Report
                </span>
            </div>

            <div class="status-section-grid">
                <div class="chart-wrap">
                    <canvas id="statusChart"></canvas>
                </div>

                <div class="status-summary" id="statusSummary">
                    <div 
                        class="status-row" 
                        style="--status-bg:#dcfce7; --status-text:#166534; --status-color:#10b981; --status-width:<%= approvedPercentage %>%;">
                        <div class="status-row-top">
                            <div class="status-row-label">
                                <span class="status-dot"></span>
                                Approved
                            </div>

                            <strong class="status-count">
                                <%= statusTotals.approved %>
                            </strong>
                        </div>

                        <div class="status-track">
                            <span class="status-fill"></span>
                        </div>

                        <p class="status-percent">
                            <%= approvedPercentage %>% of total bookings
                        </p>
                    </div>

                    <div 
                        class="status-row" 
                        style="--status-bg:#fef3c7; --status-text:#92400e; --status-color:#f59e0b; --status-width:<%= pendingPercentage %>%;">
                        <div class="status-row-top">
                            <div class="status-row-label">
                                <span class="status-dot"></span>
                                Pending
                            </div>

                            <strong class="status-count">
                                <%= statusTotals.pending %>
                            </strong>
                        </div>

                        <div class="status-track">
                            <span class="status-fill"></span>
                        </div>

                        <p class="status-percent">
                            <%= pendingPercentage %>% of total bookings
                        </p>
                    </div>

                    <div 
                        class="status-row" 
                        style="--status-bg:#ffe4e6; --status-text:#9f1239; --status-color:#f43f5e; --status-width:<%= rejectedPercentage %>%;">
                        <div class="status-row-top">
                            <div class="status-row-label">
                                <span class="status-dot"></span>
                                Rejected
                            </div>

                            <strong class="status-count">
                                <%= statusTotals.rejected %>
                            </strong>
                        </div>

                        <div class="status-track">
                            <span class="status-fill"></span>
                        </div>

                        <p class="status-percent">
                            <%= rejectedPercentage %>% of total bookings
                        </p>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <section class="insight-grid">
        <article class="insight-card">
            <div class="insight-icon">
                <i class="fa-solid fa-magnifying-glass-chart"></i>
            </div>

            <h3>Demand Visibility</h3>

            <p>
                Use facility rankings to see which resort spaces are attracting the most reservations.
            </p>
        </article>

        <article class="insight-card">
            <div class="insight-icon">
                <i class="fa-solid fa-money-bill-trend-up"></i>
            </div>

            <h3>Revenue Monitoring</h3>

            <p>
                Compare booking volume and revenue movement to understand when sales are increasing or slowing down.
            </p>
        </article>

        <article class="insight-card">
            <div class="insight-icon">
                <i class="fa-solid fa-clipboard-check"></i>
            </div>

            <h3>Status Control</h3>

            <p>
                Track approved, pending, and rejected reservations so payment verification stays organized.
            </p>
        </article>
    </section>

    <section class="footer-report">
        <div class="footer-report-content">
            <div>
                <h3>
                    Turn data into better resort decisions.
                </h3>

                <p>
                    Use this report page to monitor verified revenue, identify high-demand facilities, and keep reservations moving.
                </p>
            </div>

            <button type="button" class="hero-btn" onclick="window.location.href='/admin/reports/export'">
                <i class="fa-solid fa-file-csv"></i>
                Export CSV
            </button>
        </div>
    </section>
</div>

<div 
    id="report-data" 
    style="display:none;"
    data-revenue="<%- encodeURIComponent(JSON.stringify(safeRevenueData)) %>"
    data-popularity="<%- encodeURIComponent(JSON.stringify(safePopularityData)) %>"
    data-chart="<%- encodeURIComponent(JSON.stringify(safeChartData)) %>">
</div>

<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

<script>
document.addEventListener('DOMContentLoaded', function () {
    const reportDataEl = document.getElementById('report-data');

    function parseSafeData(value) {
        try {
            return JSON.parse(decodeURIComponent(value || '[]'));
        } catch (error) {
            console.error('Chart data parsing error:', error);
            return [];
        }
    }

    const revenueData = parseSafeData(reportDataEl ? reportDataEl.dataset.revenue : '[]');
    const popularityData = parseSafeData(reportDataEl ? reportDataEl.dataset.popularity : '[]');
    const chartData = parseSafeData(reportDataEl ? reportDataEl.dataset.chart : '[]');

    function formatPeso(value) {
        return '₱' + Number(value || 0).toLocaleString('en-PH');
    }

    function getStatusValue(item) {
        return String(
            item.status ||
            item.booking_status ||
            item.bookingStatus ||
            item.reservation_status ||
            item.payment_status ||
            ''
        ).trim().toLowerCase();
    }

    function getCountValue(item) {
        return Number(
            item.count ||
            item.total ||
            item.total_count ||
            item.total_bookings ||
            item.booking_count ||
            0
        );
    }

    function getRevenueValue(item) {
        return Number(item.monthly_total || item.revenue || item.total_revenue || item.total || 0);
    }

    function getBookingValue(item) {
        return Number(item.total_bookings || item.bookings || item.count || item.booking_count || 0);
    }

    const revenueBookingCanvas = document.getElementById('revenueBookingChart');

    if (revenueBookingCanvas && window.Chart) {
        const labels = revenueData.length > 0
            ? revenueData.map(function (item) {
                return item.month || item.label || 'N/A';
            })
            : ['No Data'];

        const bookingValues = revenueData.length > 0
            ? revenueData.map(getBookingValue)
            : [0];

        const revenueValues = revenueData.length > 0
            ? revenueData.map(getRevenueValue)
            : [0];

        new Chart(revenueBookingCanvas.getContext('2d'), {
            data: {
                labels: labels,
                datasets: [
                    {
                        type: 'bar',
                        label: 'Bookings',
                        data: bookingValues,
                        backgroundColor: 'rgba(20, 184, 166, 0.72)',
                        borderRadius: 12,
                        yAxisID: 'yBooking'
                    },
                    {
                        type: 'line',
                        label: 'Revenue',
                        data: revenueValues,
                        borderColor: '#0891b2',
                        backgroundColor: 'rgba(8, 145, 178, 0.14)',
                        fill: true,
                        tension: 0.42,
                        pointRadius: 5,
                        pointHoverRadius: 8,
                        pointBackgroundColor: '#ffffff',
                        pointBorderColor: '#0891b2',
                        pointBorderWidth: 3,
                        yAxisID: 'yRevenue'
                    }
                ]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                interaction: {
                    mode: 'index',
                    intersect: false
                },
                plugins: {
                    legend: {
                        position: 'bottom',
                        labels: {
                            usePointStyle: true,
                            padding: 20,
                            color: '#64748b',
                            font: {
                                weight: '700'
                            }
                        }
                    },
                    tooltip: {
                        callbacks: {
                            label: function (context) {
                                if (context.dataset.label === 'Revenue') {
                                    return 'Revenue: ' + formatPeso(context.raw);
                                }

                                return 'Bookings: ' + Number(context.raw || 0).toLocaleString('en-PH');
                            }
                        }
                    }
                },
                scales: {
                    yRevenue: {
                        type: 'linear',
                        position: 'left',
                        beginAtZero: true,
                        ticks: {
                            callback: function (value) {
                                return formatPeso(value);
                            },
                            color: '#64748b'
                        },
                        grid: {
                            color: 'rgba(226,232,240,0.82)'
                        }
                    },
                    yBooking: {
                        type: 'linear',
                        position: 'right',
                        beginAtZero: true,
                        ticks: {
                            precision: 0,
                            color: '#64748b'
                        },
                        grid: {
                            drawOnChartArea: false
                        }
                    },
                    x: {
                        ticks: {
                            color: '#64748b'
                        },
                        grid: {
                            display: false
                        }
                    }
                }
            }
        });
    }

    const statusCanvas = document.getElementById('statusChart');

    const normalizedStatusData = {
        approved: 0,
        pending: 0,
        rejected: 0
    };

    chartData.forEach(function (item) {
        const status = getStatusValue(item);
        const count = getCountValue(item);

        if (
            status.includes('approved') ||
            status.includes('approve') ||
            status.includes('confirmed') ||
            status.includes('confirm')
        ) {
            normalizedStatusData.approved += count;
        } else if (
            status.includes('pending') ||
            status.includes('waiting') ||
            status.includes('processing')
        ) {
            normalizedStatusData.pending += count;
        } else if (
            status.includes('rejected') ||
            status.includes('reject') ||
            status.includes('cancelled') ||
            status.includes('canceled') ||
            status.includes('declined') ||
            status.includes('denied')
        ) {
            normalizedStatusData.rejected += count;
        }
    });

    const statusLabels = ['Approved', 'Pending', 'Rejected'];
    const statusCounts = [
        normalizedStatusData.approved,
        normalizedStatusData.pending,
        normalizedStatusData.rejected
    ];
    const statusColors = ['#10b981', '#f59e0b', '#f43f5e'];
    const totalBookings = statusCounts.reduce(function (sum, value) {
        return sum + Number(value || 0);
    }, 0);

    const centerTextPlugin = {
        id: 'reportCenterText',
        beforeDraw: function (chart) {
            const chartArea = chart.chartArea;
            const ctx = chart.ctx;

            if (!chartArea) return;

            const centerX = (chartArea.left + chartArea.right) / 2;
            const centerY = (chartArea.top + chartArea.bottom) / 2;

            ctx.save();
            ctx.textAlign = 'center';
            ctx.textBaseline = 'middle';

            ctx.font = '800 34px Inter, Arial, sans-serif';
            ctx.fillStyle = '#0f172a';
            ctx.fillText(totalBookings, centerX, centerY - 10);

            ctx.font = '700 13px Inter, Arial, sans-serif';
            ctx.fillStyle = '#64748b';
            ctx.fillText('Total Bookings', centerX, centerY + 20);

            ctx.restore();
        }
    };

    if (statusCanvas && window.Chart) {
        new Chart(statusCanvas.getContext('2d'), {
            type: 'doughnut',
            data: {
                labels: totalBookings > 0 ? statusLabels : ['No Data'],
                datasets: [{
                    data: totalBookings > 0 ? statusCounts : [1],
                    backgroundColor: totalBookings > 0 ? statusColors : ['#e2e8f0'],
                    borderColor: '#ffffff',
                    borderWidth: 6,
                    hoverOffset: 12,
                    cutout: '72%'
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                plugins: {
                    legend: {
                        position: 'bottom',
                        labels: {
                            usePointStyle: true,
                            padding: 22,
                            color: '#64748b',
                            font: {
                                weight: '700'
                            }
                        }
                    },
                    tooltip: {
                        callbacks: {
                            label: function (context) {
                                if (totalBookings === 0) {
                                    return 'No booking data yet';
                                }

                                const value = Number(context.raw || 0);
                                const percentage = Math.round((value / totalBookings) * 100);

                                return context.label + ': ' + value + ' booking' + (value === 1 ? '' : 's') + ' (' + percentage + '%)';
                            }
                        }
                    }
                }
            },
            plugins: [centerTextPlugin]
        });
    }
});
</script>
