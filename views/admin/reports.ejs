<style>
/* --- Gradient Stat Cards --- */
.stats-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 28px;
    margin-bottom: 40px;
}

.stat-card {
    background: linear-gradient(135deg, #0ea5e9, #2563eb);
    color: white;
    border-radius: 20px;
    padding: 28px;
    box-shadow: 0 20px 50px rgba(0,0,0,0.12);
    transition: transform 0.3s ease;
}
.stat-card:hover { transform: translateY(-4px); }

.stat-card .stat-icon {
    font-size: 2rem;
    margin-bottom: 12px;
    background: rgba(255,255,255,0.2);
    width: 48px;
    height: 48px;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 12px;
}

.stat-card h3 {
    margin: 0;
    font-size: 0.85rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 1px;
}

.stat-card .value {
    margin-top: 8px;
    font-size: 2rem;
    font-weight: 700;
}

/* Chart Card Styling */
.admin-card {
    background: #ffffff;
    border-radius: 20px;
    padding: 28px;
    box-shadow: 0 20px 50px rgba(0,0,0,0.08);
    transition: transform 0.3s ease;
}
.admin-card:hover { transform: translateY(-3px); }

.admin-card h3 {
    margin-top: 0;
    font-size: 0.85rem;
    text-transform: uppercase;
    color: #64748b;
    font-weight: 700;
    letter-spacing: 1px;
}

.admin-card canvas {
    width: 100% !important;
    height: 320px !important;
}

/* Facility row */
.facility-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 14px 0;
    border-bottom: 1px solid #f1f5f9;
    transition: all 0.3s ease;
}
.facility-row:hover {
    background: #f1f5f9;
    transform: translateY(-2px);
}

.facility-rank { color: #94a3b8; font-weight: 700; margin-right: 12px; }
.status-pill { 
    padding: 6px 14px; 
    border-radius: 99px; 
    font-weight: 700; 
    font-size: 0.75rem; 
    text-transform: uppercase; 
    display: inline-block;
}

.status-approved { background: #dcfce7; color: #166534; border: 1px solid #22c55e; }
.status-pending { background: #fef3c7; color: #a16207; border: 1px solid #fde68a; }
.status-rejected { background: #fee2e2; color: #991b1b; border: 1px solid #fecaca; }

/* Buttons */
.btn-export {
    background: linear-gradient(135deg, #0ea5e9, #2563eb);
    color: white;
    border-radius: 12px;
    border: none;
    padding: 12px 24px;
    font-weight: 700;
    cursor: pointer;
    transition: 0.3s;
}
.btn-export:hover { background: linear-gradient(135deg, #0284c7, #1d4ed8); }

/* Responsive */
@media (max-width: 768px) {
    .stats-grid { grid-template-columns: 1fr; }
    .facility-row { flex-direction: column; align-items: flex-start; gap: 6px; }
}
</style>

<div class="admin-header" style="display:flex; justify-content:space-between; align-items:center; margin-bottom:32px;">
    <h2>Business Analytics</h2>
    <div style="display:flex; gap:12px;">
        <button onclick="window.print()" class="btn-primary" style="background: linear-gradient(135deg, #64748b, #1e293b); color:white; padding:12px 20px; border-radius:12px; font-weight:700; cursor:pointer; border:none;">🖨️ Print Summary</button>
        <button onclick="window.location.href='/admin/reports/export'" class="btn-export" style="background: linear-gradient(135deg, #0ea5e9, #2563eb); color:white; padding:12px 20px; border-radius:12px; font-weight:700; cursor:pointer; border:none;">📥 Export CSV</button>
    </div>
</div>

<section class="stats-grid" style="display:grid; grid-template-columns:2fr 1fr; gap:32px; margin-bottom:40px;">

    <!-- Revenue & Bookings Trend -->
    <div class="admin-card" style="background:white; border-radius:20px; padding:28px; box-shadow:0 20px 50px rgba(0,0,0,0.08); transition:transform 0.3s;">
        <h3 style="margin-top:0; color:#64748b; font-size:0.85rem; text-transform:uppercase; letter-spacing:1px;">Revenue & Bookings Trend (Last 6 Months)</h3>
        <div style="height:320px; margin-top:20px;">
            <canvas id="revenueBookingChart"></canvas>
        </div>
    </div>

    <!-- Top Performing Facilities -->
    <div class="admin-card" style="background:white; border-radius:20px; padding:28px; box-shadow:0 20px 50px rgba(0,0,0,0.08);">
        <h3 style="margin-top:0; color:#64748b; font-size:0.85rem; text-transform:uppercase; letter-spacing:1px;">Top Performing Facilities</h3>
        <div style="margin-top:20px;">
            <% if (popularityData.length > 0) { %>
                <% popularityData.slice(0,5).forEach((item,index) => { %>
                    <div class="facility-row" style="display:flex; justify-content:space-between; align-items:center; padding:12px 0; border-bottom:1px solid #f1f5f9; transition:all 0.3s; border-radius:12px;">
                        <div style="display:flex; align-items:center; gap:12px;">
                            <span class="facility-rank" style="color:#94a3b8; font-weight:700;"><%= String(index + 1).padStart(2,'0') %></span>
                            <span style="font-weight:600; color:#1e293b;"><%= item.name %></span>
                        </div>
                        <span class="status-pill" style="background:#dcfce7; color:#166534; padding:6px 12px; border-radius:99px; font-weight:700; font-size:0.75rem;"><%= item.total_bookings %> Booking<%= item.total_bookings===1?'':'s' %></span>
                    </div>
                <% }) %>
            <% } else { %>
                <div style="text-align:center; padding:30px; color:#94a3b8;">No facility data yet.</div>
            <% } %>
        </div>
    </div>

</section>

<!-- Booking Status Distribution -->
<div class="admin-card" style="background:white; border-radius:20px; padding:28px; box-shadow:0 20px 50px rgba(0,0,0,0.08); margin-bottom:40px;">
    <h3 style="margin-top:0; color:#64748b; font-size:0.85rem; text-transform:uppercase; letter-spacing:1px;">Booking Status Distribution</h3>
    <div style="height:320px; margin-top:20px;">
        <canvas id="statusChart"></canvas>
    </div>
</div>

<!-- Data for JS Charts -->
<div id="report-data" style="display:none;"
    data-revenue="<%- encodeURIComponent(JSON.stringify(revenueData || [])) %>"
    data-popularity="<%- encodeURIComponent(JSON.stringify(popularityData || [])) %>"
    data-chart="<%- encodeURIComponent(JSON.stringify(chartData || [])) %>">
</div>

<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
<script>
const reportDataEl = document.getElementById('report-data');
const revenueData = JSON.parse(decodeURIComponent(reportDataEl.dataset.revenue || '[]'));
const popularityData = JSON.parse(decodeURIComponent(reportDataEl.dataset.popularity || '[]'));
const chartData = JSON.parse(decodeURIComponent(reportDataEl.dataset.chart || '[]'));

// --- Revenue vs Bookings Combo Chart ---
const revBookingCtx = document.getElementById('revenueBookingChart').getContext('2d');

new Chart(revBookingCtx, {
    data: {
        labels: revenueData.map(d => d.month),
        datasets: [
            {
                type: 'bar',
                label: 'Bookings',
                data: revenueData.map(d => Number(d.total_bookings || 0)),
                backgroundColor: '#22c55e',
                borderRadius: 8,
                yAxisID: 'yBooking'
            },
            {
                type: 'line',
                label: 'Revenue (₱)',
                data: revenueData.map(d => Number(d.monthly_total || 0)),
                borderColor: '#0ea5e9',
                backgroundColor: 'rgba(14,165,233,0.1)',
                fill:true,
                tension:0.3,
                pointRadius:4,
                pointBackgroundColor:'#0ea5e9',
                yAxisID: 'yRevenue'
            }
        ]
    },
    options: {
        responsive:true,
        maintainAspectRatio:false,
        interaction: { mode:'index', intersect:false },
        scales: {
            yRevenue: { type:'linear', position:'left', beginAtZero:true, ticks:{ callback: v=>'₱'+v.toLocaleString() }, grid:{ color:'#f1f5f9' } },
            yBooking: { type:'linear', position:'right', beginAtZero:true, ticks:{ precision:0 }, grid:{ drawOnChartArea:false } },
            x:{ grid:{ display:false } }
        },
        plugins: { legend:{ position:'bottom' } }
    }
});

// --- Booking Status Doughnut Chart ---
const statusCtx = document.getElementById('statusChart').getContext('2d');
const getCount = (statusName) => {
    const found = chartData.find(item => item.status.toLowerCase()===statusName.toLowerCase());
    return found ? found.count : 0;
};
new Chart(statusCtx, {
    type:'doughnut',
    data:{
        labels:['Approved','Pending','Rejected'],
        datasets:[{
            data:[getCount('approved'), getCount('pending'), getCount('rejected')],
            backgroundColor:['#22c55e','#eab308','#ef4444'],
            borderWidth:0,
            cutout:'70%'
        }]
    },
    options:{ responsive:true, plugins:{ legend:{ position:'bottom', labels:{ usePointStyle:true, padding:20, color:'#64748b' } } } }
});
</script>