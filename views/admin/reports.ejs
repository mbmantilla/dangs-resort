    const safeRevenueData = typeof revenueData !== 'undefined' && Array.isArray(revenueData) ? revenueData : [];
    const safePopularityData = typeof popularityData !== 'undefined' && Array.isArray(popularityData) ? popularityData : [];
    const safeChartData = typeof chartData !== 'undefined' && Array.isArray(chartData) ? chartData : [];

    const pesoFormat = function (value) {
        return Number(value || 0).toLocaleString('en-PH', {
            minimumFractionDigits: 0,
            maximumFractionDigits: 2
        });
    };

    const getRevenueValue = function (item) {
        return Number(item.monthly_total || item.revenue || item.total_revenue || item.total || 0);
    };

    const getBookingValue = function (item) {
        return Number(item.total_bookings || item.bookings || item.count || item.booking_count || 0);
    };

    const getStatusValueServer = function (item) {
        return String(
            item.status ||
            item.booking_status ||
            item.bookingStatus ||
            item.reservation_status ||
            item.payment_status ||
            ''
        ).trim().toLowerCase();
    };

    const getCountValueServer = function (item) {
        return Number(
            item.count ||
            item.total ||
            item.total_count ||
            item.total_bookings ||
            item.booking_count ||
            0
        );
    };

    const statusTotals = {
        approved: 0,
        pending: 0,
        rejected: 0
    };

    safeChartData.forEach(function (item) {
        const status = getStatusValueServer(item);
        const count = getCountValueServer(item);

        if (
            status.includes('approved') ||
            status.includes('approve') ||
            status.includes('confirmed') ||
            status.includes('confirm')
        ) {
            statusTotals.approved += count;
        } else if (
            status.includes('pending') ||
            status.includes('waiting') ||
            status.includes('processing')
        ) {
            statusTotals.pending += count;
        } else if (
            status.includes('rejected') ||
            status.includes('reject') ||
            status.includes('cancelled') ||
            status.includes('canceled') ||
            status.includes('declined') ||
            status.includes('denied')
        ) {
            statusTotals.rejected += count;
        }
    });

    const totalStatusBookings = statusTotals.approved + statusTotals.pending + statusTotals.rejected;

    const totalRevenue = safeRevenueData.reduce(function (sum, item) {
        return sum + getRevenueValue(item);
    }, 0);

    const totalBookings = safeRevenueData.reduce(function (sum, item) {
        return sum + getBookingValue(item);
    }, 0);

    const averageRevenue = safeRevenueData.length > 0 ? totalRevenue / safeRevenueData.length : 0;

    const topFacility = safePopularityData.length > 0 ? safePopularityData[0] : null;
    const topFacilityBookings = topFacility ? Number(topFacility.total_bookings || topFacility.count || topFacility.total || 0) : 0;

    const approvedPercentage = totalStatusBookings > 0 ? Math.round((statusTotals.approved / totalStatusBookings) * 100) : 0;
    const pendingPercentage = totalStatusBookings > 0 ? Math.round((statusTotals.pending / totalStatusBookings) * 100) : 0;
    const rejectedPercentage = totalStatusBookings > 0 ? Math.round((statusTotals.rejected / totalStatusBookings) * 100) : 0;
